@page
@model PagesObrasApp.Pages.Empleado.IndexModel
@using System.Linq
@{
    Layout = "_EmpleadoLayout";
    ViewData["Title"] = "Inicio";

    // --- Datos de muestra (mock) — reemplazar por Model.* cuando conectemos la API vía DTOs ---
    var today = new DateTime(2026, 6, 22);
    var nombreEmp = "Carlos Espínola";
    var horaActual = 9;

    var asignaciones = new[]
    {
        new { IdAsig=7, Obra="Edificio Las Acacias",     Codigo="OB-2026-014", Rol="Oficial",  Estado="En Progreso", Avance=62 },
        new { IdAsig=8, Obra="Galpón Industrial Ruta 5", Codigo="OB-2026-011", Rol="Oficial",  Estado="En Progreso", Avance=38 },
    };

    var inicioSemana = today.AddDays(-6);
    var registrosSemana = new[]
    {
        new { IdAsig=7, Fecha=today,             C=8m, E=1m },
        new { IdAsig=7, Fecha=today.AddDays(-1), C=8m, E=0m },
        new { IdAsig=7, Fecha=today.AddDays(-2), C=8m, E=0m },
        new { IdAsig=7, Fecha=today.AddDays(-3), C=8m, E=0m },
        new { IdAsig=8, Fecha=today.AddDays(-5), C=8m, E=2m },
        new { IdAsig=8, Fecha=today.AddDays(-6), C=8m, E=0m },
    };

    var misNovedades = new[]
    {
        new { Id=1, Tipo="Falta de Material",  Obra="Edificio Las Acacias",     Fecha=today.AddDays(-2), Estado="Revisado"  },
        new { Id=2, Tipo="Rotura Equipo",      Obra="Galpón Industrial Ruta 5", Fecha=today.AddDays(-4), Estado="Revisado"  },
        new { Id=3, Tipo="Incidencia Personal",Obra="Edificio Las Acacias",     Fecha=today.AddDays(-1), Estado="Pendiente" },
    };

    var horasHoy = registrosSemana.Where(r => r.Fecha.Date == today.Date).Sum(r => r.C + r.E);
    var horasSemana = registrosSemana.Sum(r => r.C + r.E);
    var yaRegistroHoy = horasHoy > 0;
    var novPendientes = misNovedades.Count(n => n.Estado == "Pendiente");

    var saludo = horaActual < 12 ? "Buenos días" : horaActual < 19 ? "Buenas tardes" : "Buenas noches";
}

<div class="emp-dashboard">

    <!-- HERO SALUDO -->
    <div class="emp-hero">
        <div class="emp-hero-bg"></div>
        <div class="emp-hero-content">
            <p class="emp-saludo">@saludo,</p>
            <h1 class="emp-nombre">@nombreEmp</h1>
            <p class="emp-fecha">@today.ToString("dddd d 'de' MMMM", new System.Globalization.CultureInfo("es-ES"))</p>
        </div>
        <div class="emp-hero-status">
            @if (yaRegistroHoy)
            {
                <div class="emp-status emp-status--ok">
                    <svg viewBox="0 0 24 24"><path d="M20 6L9 17l-5-5" /></svg>
                    <span>@horasHoy.ToString("0.#")h cargadas hoy</span>
                </div>
            }
            else
            {
                <div class="emp-status emp-status--pend">
                    <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" /></svg>
                    <span>Sin horas cargadas hoy</span>
                </div>
            }
        </div>
    </div>

    <!-- STATS RÁPIDAS -->
    <div class="row g-2 mb-4">
        <div class="col-4">
            <div class="emp-stat-card">
                <span class="emp-stat-label">Hoy</span>
                <span class="emp-stat-num">@horasHoy.ToString("0.#")<small>h</small></span>
            </div>
        </div>
        <div class="col-4">
            <div class="emp-stat-card">
                <span class="emp-stat-label">Semana</span>
                <span class="emp-stat-num">@horasSemana.ToString("0.#")<small>h</small></span>
            </div>
        </div>
        <div class="col-4">
            <div class="emp-stat-card @(novPendientes > 0 ? "emp-stat-card--alerta" : "")">
                <span class="emp-stat-label">Novedades</span>
                <span class="emp-stat-num @(novPendientes > 0 ? "emp-stat-num--amber" : "")">
                    @novPendientes
                </span>
            </div>
        </div>
    </div>

    <!-- MIS OBRAS -->
    <section class="emp-section">
        <span class="emp-eyebrow">Mis obras asignadas</span>
        <div class="d-flex flex-column gap-2 mt-2">
            @foreach (var a in asignaciones)
            {
                <div class="emp-obra-card">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <div class="emp-obra-nombre">@a.Obra</div>
                            <span class="emp-mono emp-steel">@a.Codigo</span>
                            <span class="emp-rol-badge">@a.Rol</span>
                        </div>
                        <span class="emp-avance-num">@a.Avance%</span>
                    </div>
                    <div class="emp-progress-wrap">
                        <div class="emp-progress">
                            <div class="emp-progress-fill" style="width:@a.Avance%"></div>
                        </div>
                    </div>
                    <div class="d-flex justify-content-between mt-1">
                        <span class="emp-mono emp-steel" style="font-size:.68rem">@a.Estado</span>
                        <span class="emp-mono emp-steel" style="font-size:.68rem">Avance: @a.Avance%</span>
                    </div>
                </div>
            }
        </div>
    </section>

    <!-- ACCIONES RÁPIDAS -->
    <section class="emp-section">
        <span class="emp-eyebrow">Acciones</span>
        <div class="row g-2 mt-1">
            <div class="col-6">
                <a href="/Empleado/RegistroHoras" class="emp-action-card">
                    <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" /></svg>
                    <span class="emp-action-title">Cargar horas</span>
                    <span class="emp-action-desc">Registrá tu jornada de hoy</span>
                    @if (!yaRegistroHoy)
                    {
                        <span class="emp-action-dot"></span>
                    }
                </a>
            </div>
            <div class="col-6">
                <a href="/Empleado/Novedades" class="emp-action-card">
                    <svg viewBox="0 0 24 24"><path d="M12 3l10 18H2L12 3z" /><path d="M12 9v5M12 17h.01" /></svg>
                    <span class="emp-action-title">Reportar novedad</span>
                    <span class="emp-action-desc">Material, equipo o incidencia</span>
                </a>
            </div>
        </div>
    </section>

    <!-- MIS ÚLTIMAS NOVEDADES -->
    <section class="emp-section">
        <span class="emp-eyebrow">Mis últimos reportes</span>
        <div class="d-flex flex-column gap-2 mt-2">
            @foreach (var n in misNovedades.OrderByDescending(x => x.Fecha).Take(3))
            {
                var dias = (today - n.Fecha).Days;
                var fechaLbl = dias == 0 ? "Hoy" : dias == 1 ? "Ayer" : $"Hace {dias} días";
                <div class="emp-novedad-row">
                    <div class="flex-grow-1 min-w-0">
                        <div class="emp-nov-tipo">@n.Tipo</div>
                        <div class="emp-mono emp-steel">@n.Obra · @fechaLbl</div>
                    </div>
                    <span class="emp-estado-badge emp-estado-badge--@n.Estado.ToLower()">
                        @n.Estado
                    </span>
                </div>
            }
        </div>
        <a href="/Empleado/Novedades" class="emp-ver-mas">Ver todos mis reportes →</a>
    </section>

</div>

<style>
    .emp-dashboard {
        --bp-blueprint: #1B3A5C;
        --bp-blueprint-light: #2D5C8C;
        --bp-concrete: #F1EFEA;
        --bp-steel: #5B6670;
        --bp-safety: #F2A900;
        --bp-ink: #181B1F;
        --bp-line: #D8D3C8;
        --bp-ok: #2E7D52;
        font-family: 'Inter', sans-serif;
        color: var(--bp-ink);
    }

    .emp-eyebrow {
        font-family: 'JetBrains Mono',monospace;
        font-size: .68rem;
        letter-spacing: .12em;
        text-transform: uppercase;
        color: var(--bp-steel);
    }

    .emp-mono {
        font-family: 'JetBrains Mono',monospace;
        font-size: .78rem;
    }

    .emp-steel {
        color: var(--bp-steel);
    }

    .emp-section {
        margin-bottom: 1.75rem;
    }

    /* Hero */
    .emp-hero {
        position: relative;
        background: var(--bp-blueprint);
        border-radius: 12px;
        padding: 1.25rem 1.25rem 1rem;
        overflow: hidden;
        margin-bottom: 1.25rem;
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        flex-wrap: wrap;
        gap: .75rem;
    }

    .emp-hero-bg {
        position: absolute;
        inset: 0;
        background-image: repeating-linear-gradient(0deg,rgba(255,255,255,.05) 0 1px,transparent 1px 28px), repeating-linear-gradient(90deg,rgba(255,255,255,.05) 0 1px,transparent 1px 28px);
        pointer-events: none;
    }

    .emp-hero-content {
        position: relative;
    }

    .emp-saludo {
        font-size: .8rem;
        color: rgba(255,255,255,.6);
        margin-bottom: .1rem;
    }

    .emp-nombre {
        font-family: 'Barlow Condensed',sans-serif;
        font-weight: 700;
        font-size: 1.7rem;
        color: #fff;
        margin-bottom: .1rem;
    }

    .emp-fecha {
        font-family: 'JetBrains Mono',monospace;
        font-size: .72rem;
        color: rgba(255,255,255,.5);
        text-transform: capitalize;
    }

    .emp-hero-status {
        position: relative;
    }

    .emp-status {
        display: flex;
        align-items: center;
        gap: .4rem;
        font-size: .78rem;
        font-weight: 600;
        background: rgba(255,255,255,.12);
        border-radius: 8px;
        padding: .4rem .75rem;
        border: 1px solid rgba(255,255,255,.15);
    }

        .emp-status svg {
            width: 14px;
            height: 14px;
            fill: none;
            stroke: currentColor;
            stroke-width: 2.2;
            stroke-linecap: round;
        }

    .emp-status--ok {
        color: #6fcf97;
    }

    .emp-status--pend {
        color: var(--bp-safety);
    }

    /* Stat cards */
    .emp-stat-card {
        background: #fff;
        border: 1px solid var(--bp-line);
        border-radius: 8px;
        padding: .75rem .8rem;
        text-align: center;
        display: flex;
        flex-direction: column;
        gap: .1rem;
    }

    .emp-stat-card--alerta {
        border-color: var(--bp-safety);
    }

    .emp-stat-label {
        font-family: 'JetBrains Mono',monospace;
        font-size: .62rem;
        letter-spacing: .1em;
        text-transform: uppercase;
        color: var(--bp-steel);
    }

    .emp-stat-num {
        font-family: 'Barlow Condensed',sans-serif;
        font-weight: 700;
        font-size: 1.8rem;
        color: var(--bp-blueprint);
        line-height: 1;
    }

        .emp-stat-num small {
            font-size: .85rem;
            font-weight: 500;
            color: var(--bp-steel);
        }

    .emp-stat-num--amber {
        color: var(--bp-safety);
    }

    /* Cards de obra */
    .emp-obra-card {
        background: #fff;
        border: 1px solid var(--bp-line);
        border-radius: 8px;
        padding: 1rem;
    }

    .emp-obra-nombre {
        font-family: 'Barlow Condensed',sans-serif;
        font-weight: 600;
        font-size: 1.1rem;
    }

    .emp-avance-num {
        font-family: 'Barlow Condensed',sans-serif;
        font-weight: 700;
        font-size: 1.8rem;
        color: var(--bp-blueprint-light);
        line-height: 1;
        flex-shrink: 0;
    }

    .emp-rol-badge {
        font-size: .65rem;
        font-weight: 600;
        padding: .1rem .4rem;
        background: #E8EFF6;
        color: var(--bp-blueprint);
        border-radius: 4px;
        margin-left: .4rem;
    }

    .emp-progress-wrap {
        margin: .65rem 0 .3rem;
    }

    .emp-progress {
        height: 7px;
        background: var(--bp-concrete);
        border-radius: 4px;
        overflow: hidden;
    }

    .emp-progress-fill {
        height: 100%;
        background: var(--bp-blueprint-light);
        border-radius: 4px;
    }

    /* Acciones rápidas */
    .emp-action-card {
        position: relative;
        display: flex;
        flex-direction: column;
        gap: .25rem;
        background: #fff;
        border: 1px solid var(--bp-line);
        border-radius: 10px;
        padding: 1rem .9rem;
        text-decoration: none;
        color: var(--bp-ink);
        height: 100%;
        transition: border-color .15s, box-shadow .15s;
    }

        .emp-action-card:hover {
            border-color: var(--bp-blueprint-light);
            box-shadow: 0 3px 12px rgba(27,58,92,.1);
            color: var(--bp-ink);
        }

        .emp-action-card svg {
            width: 22px;
            height: 22px;
            fill: none;
            stroke: var(--bp-blueprint);
            stroke-width: 1.7;
            stroke-linecap: round;
            stroke-linejoin: round;
            margin-bottom: .15rem;
        }

    .emp-action-title {
        font-family: 'Barlow Condensed',sans-serif;
        font-weight: 600;
        font-size: 1.05rem;
    }

    .emp-action-desc {
        font-size: .75rem;
        color: var(--bp-steel);
    }

    .emp-action-dot {
        position: absolute;
        top: 8px;
        right: 8px;
        width: 9px;
        height: 9px;
        border-radius: 50%;
        background: var(--bp-safety);
        animation: empPulse 1.8s ease-in-out infinite;
    }

    @@keyframes empPulse {
        0%, 100% {
            box-shadow: 0 0 0 0 rgba(242,169,0,.5)
        }

        50% {
            box-shadow: 0 0 0 5px rgba(242,169,0,0)
        }
    }

    /* Novedades */
    .emp-novedad-row {
        display: flex;
        align-items: center;
        gap: .75rem;
        background: #fff;
        border: 1px solid var(--bp-line);
        border-radius: 8px;
        padding: .75rem 1rem;
    }

    .emp-nov-tipo {
        font-weight: 600;
        font-size: .85rem;
        margin-bottom: .1rem;
    }

    .emp-estado-badge {
        font-size: .68rem;
        font-weight: 600;
        padding: .18rem .5rem;
        border-radius: 100px;
        white-space: nowrap;
        flex-shrink: 0;
    }

    .emp-estado-badge--pendiente {
        background: #FFF8E8;
        color: #92670a;
    }

    .emp-estado-badge--revisado {
        background: #EAF4EE;
        color: var(--bp-ok);
    }

    .emp-ver-mas {
        display: block;
        text-align: center;
        margin-top: .75rem;
        font-size: .82rem;
        color: var(--bp-blueprint);
        text-decoration: none;
        font-weight: 500;
    }

        .emp-ver-mas:hover {
            color: var(--bp-safety);
        }
</style>