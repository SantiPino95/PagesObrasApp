@page
@model PagesObrasApp.Pages.Empleado.NovedadesModel
@using System.Linq
@{
    Layout = "_EmpleadoLayout";
    ViewData["Title"] = "Novedades";

    // --- Datos de muestra (mock) — reemplazar por Model.* cuando conectemos la API vía DTOs ---
    var today = new DateTime(2026, 6, 22);

    var asignaciones = new[]
    {
        new { IdAsig=7, Obra="Edificio Las Acacias",     Codigo="OB-2026-014" },
        new { IdAsig=8, Obra="Galpón Industrial Ruta 5", Codigo="OB-2026-011" },
    };

    var tipos = new[]
    {
        new { Val="Falta de Material",  Icon="📦", Desc="Falta un material para continuar el trabajo"  },
        new { Val="Rotura Equipo",      Icon="🔧", Desc="Una herramienta o equipo dejó de funcionar"  },
        new { Val="Incidencia Personal",Icon="🚨", Desc="Accidente, lesión o conflicto en obra"        },
        new { Val="Clima",              Icon="🌧", Desc="Condiciones climáticas que detienen el avance" },
        new { Val="Otro",               Icon="📋", Desc="Cualquier otro imprevisto"                    },
    };

    var misNovedades = new[]
    {
        new { Id=1,  IdAsig=7, Tipo="Falta de Material",   Fecha=new DateTime(2026,6,20), Desc="Se agotó el cemento Portland. Quedan aproximadamente 2 bolsas. Necesitamos reposición urgente para continuar con la losa.", Estado="Revisado"  },
        new { Id=2,  IdAsig=8, Tipo="Rotura Equipo",       Fecha=new DateTime(2026,6,18), Desc="La amoladora angular HER-0045 dejó de funcionar durante el trabajo. Se generó un cortocircuito.", Estado="Revisado"  },
        new { Id=3,  IdAsig=7, Tipo="Incidencia Personal", Fecha=new DateTime(2026,6,21), Desc="Compañero Ríos sufrió un corte leve al manipular hierro. Se le realizaron primeros auxilios.", Estado="Pendiente" },
    };

    var tipoCls = new Dictionary<string, string>
    {
        {"Falta de Material",   "material"  },
        {"Rotura Equipo",       "rotura"    },
        {"Incidencia Personal", "incidencia"},
        {"Clima",               "clima"     },
        {"Otro",                "otro"      },
    };

    var pendientes = misNovedades.Count(n => n.Estado == "Pendiente");
}

<div class="emp-dashboard">

    <!-- HEADER -->
    <div class="mb-3">
        <span class="emp-eyebrow">Mis reportes</span>
        <h1 class="emp-page-title">
            Novedades
            @if (pendientes > 0)
            {
                <span class="emp-title-badge">@pendientes sin respuesta</span>
            }
        </h1>
    </div>

    <!-- FORM NUEVA NOVEDAD -->
    <section class="emp-section">
        <div class="emp-form-card">
            <div class="emp-form-header">
                <span class="emp-eyebrow" style="color:rgba(255,255,255,.65)">Nuevo reporte</span>
                <h2 class="emp-form-title">Reportar una novedad</h2>
            </div>
            <div class="emp-form-body">
                <!-- TODO: conectar a OnPostCrearNovedad cuando esté el HttpClient hacia la API -->
                <!-- Selector de tipo visual -->
                <label class="emp-label">¿Qué pasó?</label>
                <div class="emp-tipo-grid" id="tipoGrid">
                    @foreach (var t in tipos)
                    {
                        var cls = tipoCls.ContainsKey(t.Val) ? tipoCls[t.Val] : "otro";
                        <button type="button"
                                class="emp-tipo-btn emp-tipo-btn--@cls"
                                data-tipo="@t.Val"
                                onclick="seleccionarTipo(this)"
                                title="@t.Desc">
                            <span class="emp-tipo-icon">@t.Icon</span>
                            <span class="emp-tipo-lbl">@t.Val</span>
                        </button>
                    }
                </div>
                <input type="hidden" id="tipoSelected" value="">
                <p class="emp-tipo-desc" id="tipoDesc">Seleccioná el tipo de novedad arriba.</p>

                <!-- Obra -->
                <div class="mb-3">
                    <label class="emp-label">Obra donde ocurrió</label>
                    <select class="emp-select">
                        @foreach (var a in asignaciones)
                        {
                            <option value="@a.IdAsig">@a.Obra (@a.Codigo)</option>
                        }
                    </select>
                </div>

                <!-- Descripción -->
                <div class="mb-3">
                    <label class="emp-label">Describí qué pasó</label>
                    <textarea class="emp-textarea" rows="4"
                              placeholder="Contá con el mayor detalle posible: qué material falta, qué equipo se rompió, qué herramientas se necesitan..."></textarea>
                    <p class="emp-char-count"><span id="charCount">0</span> / 500 caracteres</p>
                </div>

                <button class="emp-btn-guardar w-100" id="btnEnviar" disabled>
                    Enviar reporte
                </button>

            </div>
        </div>
    </section>

    <!-- MIS REPORTES ANTERIORES -->
    <section class="emp-section">
        <span class="emp-eyebrow">Mis reportes anteriores</span>
        <div class="d-flex flex-column gap-2 mt-2">
            @foreach (var n in misNovedades.OrderByDescending(x => x.Fecha))
            {
                var tipoIcon = tipos.FirstOrDefault(t => t.Val == n.Tipo)?.Icon ?? "📋";
                var cls = tipoCls.ContainsKey(n.Tipo) ? tipoCls[n.Tipo] : "otro";
                var asig = asignaciones.FirstOrDefault(a => a.IdAsig == n.IdAsig);
                var diasAtras = (today - n.Fecha).Days;
                var fechaLbl = diasAtras == 0 ? "Hoy" : diasAtras == 1 ? "Ayer" : $"Hace {diasAtras} días";

                <div class="emp-rep-card emp-rep-card--@cls">
                    <div class="emp-rep-top">
                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            <span class="emp-rep-icon">@tipoIcon</span>
                            <span class="emp-rep-tipo">@n.Tipo</span>
                            <span class="emp-rep-obra">@asig?.Obra</span>
                        </div>
                        <div class="d-flex align-items-center gap-2 flex-shrink-0">
                            <span class="emp-mono emp-steel" style="font-size:.65rem">@fechaLbl</span>
                            <span class="emp-est-badge emp-est-badge--@n.Estado.ToLower()">
                                @if (n.Estado == "Revisado")
                                {
                                    <text>✓ Revisado</text>
                                }
                                else
                                {
                                    <text>● Pendiente</text>
                                }
                            </span>
                        </div>
                    </div>
                    <p class="emp-rep-desc">@n.Desc</p>
                </div>
            }
        </div>
    </section>

</div>

<style>
    .emp-dashboard {
        --bp-blueprint: #1B3A5C;
        --bp-blueprint-light: #2D5C8C;
        --bp-concrete: #F1EFEA;
        --bp-steel: #5B6670;
        --bp-safety: #F2A900;
        --bp-ink: #181B1F;
        --bp-line: #D8D3C8;
        --bp-ok: #2E7D52;
        font-family: 'Inter',sans-serif;
        color: var(--bp-ink);
    }

    .emp-eyebrow {
        font-family: 'JetBrains Mono',monospace;
        font-size: .68rem;
        letter-spacing: .12em;
        text-transform: uppercase;
        color: var(--bp-steel);
    }

    .emp-mono {
        font-family: 'JetBrains Mono',monospace;
        font-size: .78rem;
    }

    .emp-steel {
        color: var(--bp-steel);
    }

    .emp-section {
        margin-bottom: 1.75rem;
    }

    .emp-page-title {
        font-family: 'Barlow Condensed',sans-serif;
        font-weight: 600;
        font-size: 1.8rem;
        margin: .1rem 0 0;
        display: flex;
        align-items: center;
        gap: .5rem;
        flex-wrap: wrap;
    }

    .emp-title-badge {
        font-family: 'Inter',sans-serif;
        font-size: .72rem;
        font-weight: 700;
        background: var(--bp-safety);
        color: var(--bp-ink);
        padding: .12rem .6rem;
        border-radius: 100px;
    }

    /* Form */
    .emp-form-card {
        background: #fff;
        border: 1px solid var(--bp-line);
        border-radius: 12px;
        overflow: hidden;
    }

    .emp-form-header {
        background: var(--bp-blueprint);
        padding: .85rem 1rem;
    }

    .emp-form-title {
        font-family: 'Barlow Condensed',sans-serif;
        font-weight: 600;
        font-size: 1.3rem;
        color: #fff;
        margin-top: .1rem;
    }

    .emp-form-body {
        padding: 1rem;
    }

    .emp-label {
        display: block;
        font-family: 'JetBrains Mono',monospace;
        font-size: .65rem;
        letter-spacing: .08em;
        text-transform: uppercase;
        color: var(--bp-steel);
        margin-bottom: .35rem;
    }

    .emp-select, .emp-textarea {
        width: 100%;
        font-family: 'Inter',sans-serif;
        font-size: .88rem;
        border: 1px solid var(--bp-line);
        border-radius: 6px;
        padding: .5rem .75rem;
        background: #fff;
        color: var(--bp-ink);
    }

        .emp-select:focus, .emp-textarea:focus {
            outline: none;
            border-color: var(--bp-blueprint-light);
            box-shadow: 0 0 0 3px rgba(45,92,140,.12);
        }

    .emp-textarea {
        resize: vertical;
    }

    .emp-char-count {
        font-size: .72rem;
        color: var(--bp-steel);
        text-align: right;
        margin: .25rem 0 0;
    }

    /* Selector de tipo */
    .emp-tipo-grid {
        display: grid;
        grid-template-columns: repeat(5,1fr);
        gap: .35rem;
        margin-bottom: .6rem;
    }

    .emp-tipo-btn {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: .2rem;
        background: var(--bp-concrete);
        border: 2px solid transparent;
        border-radius: 8px;
        padding: .5rem .25rem;
        cursor: pointer;
        transition: all .15s;
    }

        .emp-tipo-btn:hover {
            border-color: var(--bp-blueprint-light);
            background: #EAF0F8;
        }

        .emp-tipo-btn.selected {
            background: #fff;
            border-width: 2px;
        }

    .emp-tipo-btn--material.selected {
        border-color: #2D6CDF;
    }

    .emp-tipo-btn--rotura.selected {
        border-color: #B23A2E;
    }

    .emp-tipo-btn--incidencia.selected {
        border-color: #8B4E9E;
    }

    .emp-tipo-btn--clima.selected {
        border-color: #3890C8;
    }

    .emp-tipo-btn--otro.selected {
        border-color: var(--bp-steel);
    }

    .emp-tipo-icon {
        font-size: 1.3rem;
    }

    .emp-tipo-lbl {
        font-size: .58rem;
        font-weight: 600;
        text-align: center;
        color: var(--bp-steel);
        line-height: 1.2;
    }

    .emp-tipo-desc {
        font-size: .78rem;
        color: var(--bp-steel);
        margin: 0 0 .9rem;
        min-height: 1.2em;
    }

    .emp-btn-guardar {
        font-family: 'Inter',sans-serif;
        font-weight: 700;
        font-size: .95rem;
        background: var(--bp-safety);
        color: var(--bp-ink);
        border: none;
        border-radius: 8px;
        padding: .7rem;
        cursor: pointer;
        transition: background .2s, opacity .2s;
    }

        .emp-btn-guardar:disabled {
            opacity: .45;
            cursor: not-allowed;
        }

        .emp-btn-guardar:not(:disabled):hover {
            background: #d99500;
        }

    /* Cards de reportes */
    .emp-rep-card {
        background: #fff;
        border: 1px solid var(--bp-line);
        border-radius: 8px;
        overflow: hidden;
        padding: 0;
    }

    .emp-rep-card--material {
        border-left: 4px solid #2D6CDF;
    }

    .emp-rep-card--rotura {
        border-left: 4px solid #B23A2E;
    }

    .emp-rep-card--incidencia {
        border-left: 4px solid #8B4E9E;
    }

    .emp-rep-card--clima {
        border-left: 4px solid #3890C8;
    }

    .emp-rep-card--otro {
        border-left: 4px solid var(--bp-steel);
    }

    .emp-rep-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: .5rem;
        flex-wrap: wrap;
        padding: .75rem .9rem .4rem;
    }

    .emp-rep-icon {
        font-size: 1rem;
    }

    .emp-rep-tipo {
        font-weight: 600;
        font-size: .82rem;
    }

    .emp-rep-obra {
        font-size: .75rem;
        color: var(--bp-steel);
        background: var(--bp-concrete);
        padding: .1rem .45rem;
        border-radius: 100px;
    }

    .emp-rep-desc {
        font-size: .82rem;
        line-height: 1.5;
        color: var(--bp-ink);
        padding: .3rem .9rem .75rem;
        margin: 0;
    }

    .emp-est-badge {
        font-size: .68rem;
        font-weight: 600;
        padding: .15rem .5rem;
        border-radius: 100px;
        white-space: nowrap;
    }

    .emp-est-badge--pendiente {
        background: #FFF8E8;
        color: #92670a;
    }

    .emp-est-badge--revisado {
        background: #EAF4EE;
        color: var(--bp-ok);
    }
</style>

<script>
    const tipoDescripciones = {
        'Falta de Material':   'Indicá qué material falta, qué cantidad aproximada queda, y qué trabajo se ve afectado.',
        'Rotura Equipo':       'Indicá qué equipo o herramienta se averió, el código de inventario si lo sabés, y cómo afecta el trabajo.',
        'Incidencia Personal': 'Describí qué pasó, quién estuvo involucrado y qué medidas se tomaron en el momento.',
        'Clima':               'Indicá qué condiciones climáticas se presentaron y cuánto tiempo se perdió de trabajo.',
        'Otro':                'Describí con el mayor detalle posible qué ocurrió.',
    };

    (function () {
        const btnEnviar = document.getElementById('btnEnviar');
        const tipoInput = document.getElementById('tipoSelected');
        const textarea  = document.querySelector('.emp-textarea');
        const charCount = document.getElementById('charCount');
        const tipoDesc  = document.getElementById('tipoDesc');

        window.seleccionarTipo = function(btn) {
            document.querySelectorAll('.emp-tipo-btn').forEach(b => b.classList.remove('selected'));
            btn.classList.add('selected');
            const tipo = btn.dataset.tipo;
            tipoInput.value = tipo;
            tipoDesc.textContent = tipoDescripciones[tipo] || '';
            validarForm();
        };

        textarea?.addEventListener('input', () => {
            const len = textarea.value.length;
            charCount.textContent = len;
            charCount.style.color = len > 450 ? '#B23A2E' : 'var(--bp-steel)';
            validarForm();
        });

        function validarForm() {
            const tipoOk = tipoInput.value !== '';
            const descOk = (textarea?.value.trim().length ?? 0) > 10;
            btnEnviar.disabled = !(tipoOk && descOk);
        }
    })();
</script>