@page
@model PagesObrasApp.Pages.Admin.SeguimientoObraModel
@using System.Linq
@using System.Globalization
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Seguimiento de Obra";

    var today = new DateTime(2026, 6, 22);
    var cultura = new CultureInfo("es-ES");

    var obras = new[]
    {
        new { Id=1, Codigo="OB-2026-014", Nombre="Edificio Las Acacias",     Estado="En Progreso", Cliente="Inmobiliaria Sur S.A.", Inicio=new DateTime(2026,2,10)  },
        new { Id=2, Codigo="OB-2026-002", Nombre="Torre Mirador",            Estado="En Progreso", Cliente="Inmobiliaria Sur S.A.", Inicio=new DateTime(2026,5,2)   },
        new { Id=3, Codigo="OB-2026-011", Nombre="Galpón Industrial Ruta 5", Estado="En Progreso", Cliente="Logística del Este",    Inicio=new DateTime(2026,4,22)  },
        new { Id=4, Codigo="OB-2026-019", Nombre="Casa Familia Pérez",       Estado="Planificada", Cliente="Marcos Pérez",          Inicio=new DateTime(2026,7,1)   },
        new { Id=5, Codigo="OB-2025-087", Nombre="Reforma Local Comercial",  Estado="Pausada",     Cliente="Comercial Andina",      Inicio=new DateTime(2026,1,15)  },
    };

    // --- Datos de muestra (mock) — reemplazar por Model.* cuando conectemos la API vía DTOs ---
    var seguimientos = new[]
    {
        // Edificio Las Acacias (1)
        new { Id=1,  IdObra=1, Fecha=new DateTime(2026,2,12), Pct=5,  Desc="Limpieza de terreno e inicio de excavaciones. Se marcó el perímetro y se instaló el cerco de obra.",          Img=(string)null },
        new { Id=2,  IdObra=1, Fecha=new DateTime(2026,2,28), Pct=12, Desc="Excavaciones completadas. Inicio del encofrado para la losa de fundación. Hormigón previsto para el lunes.",    Img=(string)null },
        new { Id=3,  IdObra=1, Fecha=new DateTime(2026,3,20), Pct=22, Desc="Losa de fundación hormigonada y curada. Comenzó el armado de columnas de planta baja.",                        Img=(string)null },
        new { Id=4,  IdObra=1, Fecha=new DateTime(2026,4,15), Pct=38, Desc="Columnas y vigas planta baja finalizadas. Inicio de mampostería del primer piso.",                             Img=(string)null },
        new { Id=5,  IdObra=1, Fecha=new DateTime(2026,5,10), Pct=50, Desc="Mampostería primer piso al 70%. Se iniciaron las instalaciones eléctricas en cañería embutida.",               Img=(string)null },
        new { Id=6,  IdObra=1, Fecha=new DateTime(2026,6,8),  Pct=58, Desc="Instalaciones eléctricas primera etapa aprobadas por inspector. Inicio de revoques exteriores.",              Img=(string)null },
        new { Id=7,  IdObra=1, Fecha=new DateTime(2026,6,20), Pct=62, Desc="Revoques exteriores planta baja terminados. Comenzó encofrado de losa para segundo piso.",                    Img=(string)null },
        // Torre Mirador (2)
        new { Id=8,  IdObra=2, Fecha=new DateTime(2026,5,5),  Pct=5,  Desc="Inicio oficial de obra. Cerco perimetral instalado y primer acopio de materiales en depósito.",               Img=(string)null },
        new { Id=9,  IdObra=2, Fecha=new DateTime(2026,5,22), Pct=12, Desc="Excavaciones para fundaciones completadas. Aprobación técnica de cimientos por parte del director de obra.",  Img=(string)null },
        new { Id=10, IdObra=2, Fecha=new DateTime(2026,6,10), Pct=18, Desc="Losa de fundación en proceso. Se hormigonó el 60% de la superficie total.",                                   Img=(string)null },
        new { Id=11, IdObra=2, Fecha=new DateTime(2026,6,20), Pct=21, Desc="Fundaciones completas al 100%. Inicio del armado de estructura de hierro para planta baja.",                  Img=(string)null },
        // Galpón Industrial (3)
        new { Id=12, IdObra=3, Fecha=new DateTime(2026,4,25), Pct=10, Desc="Perfiles estructurales en obra. Inicio del armado de la estructura metálica principal.",                       Img=(string)null },
        new { Id=13, IdObra=3, Fecha=new DateTime(2026,5,15), Pct=24, Desc="Estructura metálica principal al 60%. Llegaron las chapas galvanizadas para la cubierta.",                    Img=(string)null },
        new { Id=14, IdObra=3, Fecha=new DateTime(2026,6,5),  Pct=32, Desc="Estructura metálica completada al 100%. Inicio de colocación de cubierta de chapa.",                          Img=(string)null },
        new { Id=15, IdObra=3, Fecha=new DateTime(2026,6,18), Pct=38, Desc="Cubierta al 40%. Se instalaron portones laterales y cerramientos en sector norte.",                           Img=(string)null },
        // Casa Pérez (4)
        new { Id=16, IdObra=4, Fecha=new DateTime(2026,6,5),  Pct=3,  Desc="Limpieza de terreno iniciada. Replanteo y marcado de ejes de la vivienda según plano.",                       Img=(string)null },
        new { Id=17, IdObra=4, Fecha=new DateTime(2026,6,18), Pct=7,  Desc="Excavaciones para vigas de fundación al 50%. Se esperan materiales para continuar el lunes.",                 Img=(string)null },
        // Reforma Local (5) — pausada
        new { Id=18, IdObra=5, Fecha=new DateTime(2026,1,20), Pct=15, Desc="Inicio de trabajos de demolición interior. Retiro de piso existente y limpieza de capas.",                    Img=(string)null },
        new { Id=19, IdObra=5, Fecha=new DateTime(2026,2,18), Pct=30, Desc="Nivelación y preparación de contrapiso. Colocación de cerámica al 20% del local.",                           Img=(string)null },
        new { Id=20, IdObra=5, Fecha=new DateTime(2026,3,10), Pct=42, Desc="Piso cerámico al 80%. Inicio de trabajos de pintura en paredes y cielo raso.",                                Img=(string)null },
        new { Id=21, IdObra=5, Fecha=new DateTime(2026,3,25), Pct=45, Desc="Obra pausada por falta de materiales específicos del cliente. Se reanuda cuando llegue el pedido pendiente.", Img=(string)null },
    };

    var vistaObras = obras.Select(o =>
    {
        var desc = seguimientos.Where(s => s.IdObra == o.Id)
                               .OrderByDescending(s => s.Fecha).ToList();
        var asc = desc.AsEnumerable().Reverse().ToList();

        // Pre-calcular delta por entrada
        var conDelta = desc.Select((s, i) => new
        {
            s.Id,
            s.Fecha,
            s.Pct,
            s.Desc,
            s.Img,
            Delta = i < desc.Count - 1 ? s.Pct - desc[i + 1].Pct : s.Pct,
            EsPrimera = i == desc.Count - 1,
        }).ToList();

        return new
        {
            o.Id,
            o.Codigo,
            o.Nombre,
            o.Estado,
            o.Cliente,
            o.Inicio,
            UltimoPct = desc.Any() ? desc.First().Pct : 0,
            UltimaFecha = desc.Any() ? (DateTime?)desc.First().Fecha : null,
            TotalRegistros = desc.Count,
            Entradas = conDelta,
            SparkAsc = asc,
        };
    }).OrderByDescending(o => o.UltimoPct).ToList();

    var totalRegistros = seguimientos.Length;
    var registrosMes = seguimientos.Count(s => s.Fecha.Year == today.Year && s.Fecha.Month == today.Month);
    var obrasConSeg = seguimientos.Select(s => s.IdObra).Distinct().Count();
}

<div class="admin-dashboard">

    <!-- HEADER -->
    <section class="bp-section">
        <div class="d-flex justify-content-between align-items-end flex-wrap gap-2">
            <div>
                <span class="bp-eyebrow">Control de avance</span>
                <h1 class="bp-title bp-title-dark">Seguimiento de obra</h1>
            </div>
            <button type="button" class="bp-btn-primary" data-bs-toggle="modal" data-bs-target="#modalRegistrar">
                + Registrar avance
            </button>
        </div>
    </section>

    <!-- STAT CARDS -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-4">
            <div class="bp-stat-card">
                <span class="bp-stat-label">Registros totales</span>
                <span class="bp-stat-num">@totalRegistros</span>
                <span class="bp-stat-sub">en todas las obras</span>
            </div>
        </div>
        <div class="col-6 col-md-4">
            <div class="bp-stat-card bp-stat-card--accent">
                <span class="bp-stat-label">Registros este mes</span>
                <span class="bp-stat-num bp-stat-num--amber">@registrosMes</span>
                <span class="bp-stat-sub">@today.ToString("MMMM yyyy", cultura)</span>
            </div>
        </div>
        <div class="col-6 col-md-4">
            <div class="bp-stat-card">
                <span class="bp-stat-label">Obras en seguimiento</span>
                <span class="bp-stat-num">@obrasConSeg</span>
                <span class="bp-stat-sub">de @obras.Length obras activas</span>
            </div>
        </div>
    </div>

    <!-- FILTRO -->
    <div class="bp-filterbar mb-4">
        <select id="bpFiltroObra" class="bp-select">
            <option value="">Todas las obras</option>
            @foreach (var o in obras)
            {
                <option value="@o.Id">@o.Nombre</option>
            }
        </select>
        <select id="bpFiltroEstado" class="bp-select">
            <option value="">Todos los estados</option>
            <option value="enprogreso">En Progreso</option>
            <option value="planificada">Planificada</option>
            <option value="pausada">Pausada</option>
        </select>
    </div>

    <!-- CARDS POR OBRA -->
    <div id="bpCards">
        @foreach (var o in vistaObras)
        {
            var estadoCls = o.Estado.Replace(" ", "").ToLower();
            var pctCls = o.UltimoPct >= 75 ? "alto" : o.UltimoPct >= 40 ? "medio" : "bajo";
            var maxSpark = o.SparkAsc.Any() ? o.SparkAsc.Max(s => s.Pct) : 1;

            <div class="bp-obra-card mb-3"
                 data-obra="@o.Id"
                 data-estado="@estadoCls">

                <!-- ENCABEZADO CARD -->
                <div class="bp-card-header">
                    <div class="flex-grow-1 min-w-0">
                        <span class="bp-badge bp-badge--@estadoCls me-2">@o.Estado</span>
                        <span class="bp-obra-nombre">@o.Nombre</span>
                        <div class="d-flex align-items-center gap-2 mt-1">
                            <span class="bp-mono bp-steel">@o.Codigo</span>
                            <span class="bp-sep">·</span>
                            <span class="bp-mono bp-steel">@o.Cliente</span>
                            <span class="bp-sep">·</span>
                            <span class="bp-mono bp-steel">Inicio @o.Inicio.ToString("dd/MM/yyyy")</span>
                        </div>
                    </div>
                    <div class="bp-pct-display">
                        <span class="bp-pct-num bp-pct--@pctCls">@o.UltimoPct</span>
                        <span class="bp-pct-sym">%</span>
                    </div>
                </div>

                <!-- BARRA DE PROGRESO -->
                <div class="bp-card-progress-wrap">
                    <div class="bp-card-progress">
                        <div class="bp-card-progress-fill bp-card-progress-fill--@pctCls"
                             style="width:@o.UltimoPct%"></div>
                    </div>
                    <div class="d-flex justify-content-between mt-1">
                        <span class="bp-mono bp-steel" style="font-size:.68rem">
                            Última actualización:
                            @(o.UltimaFecha.HasValue
                                ? o.UltimaFecha.Value.ToString("dd 'de' MMMM 'de' yyyy", cultura)
                                : "Sin registros")
                        </span>
                        <span class="bp-mono bp-steel" style="font-size:.68rem">
                            @o.TotalRegistros registro@(o.TotalRegistros != 1 ? "s" : "")
                        </span>
                    </div>
                </div>

                <!-- SPARKLINE -->
                @if (o.SparkAsc.Any())
                {
                    <div class="bp-spark-wrap">
                        <span class="bp-spark-label">Evolución</span>
                        <div class="bp-sparkline">
                            @foreach (var s in o.SparkAsc)
                            {
                                var sparH = maxSpark > 0 ? (int)Math.Round((double)s.Pct / maxSpark * 100) : 0;
                                var esUlt = s == o.SparkAsc.Last();
                                <div class="bp-spark-bar @(esUlt ? "bp-spark-bar--last" : "")"
                                     style="height:@sparH%"
                                     title="@s.Fecha.ToString("dd/MM/yyyy"): @s.Pct%">
                                </div>
                            }
                        </div>
                        <div class="bp-spark-pcts">
                            @{
                                var primero = o.SparkAsc.First(); var ultimo = o.SparkAsc.Last();
                            }
                            <span class="bp-mono" style="font-size:.65rem">@primero.Pct%</span>
                            <span class="bp-mono" style="font-size:.65rem">@ultimo.Pct%</span>
                        </div>
                    </div>
                }

                <!-- TIMELINE -->
                @if (o.Entradas.Any())
                {
                    <div class="bp-tl-wrap">
                        <div class="bp-tl-header-row">
                            <span class="bp-eyebrow">Historial de avance</span>
                            @if (o.Entradas.Count > 2)
                            {
                                <button class="bp-tl-toggle" onclick="toggleTl(@o.Id)">
                                    Ver @(o.Entradas.Count - 2) entradas anteriores ↓
                                </button>
                            }
                        </div>

                        <div class="bp-timeline">
                            @for (int i = 0; i < o.Entradas.Count; i++)
                            {
                                var e = o.Entradas[i];
                                var hidden = i >= 2 ? "bp-tl-hidden" : "";
                                var diasAtras = (today - e.Fecha).Days;
                                var fechaLabel = diasAtras == 0 ? "Hoy"
                                               : diasAtras == 1 ? "Ayer"
                                               : $"Hace {diasAtras} días";

                                <div class="bp-tl-entry @hidden" data-obra-tl="@o.Id">
                                    <div class="bp-tl-left">
                                        <div class="bp-tl-dot @(i == 0 ? "bp-tl-dot--latest" : "")"></div>
                                        @if (i < o.Entradas.Count - 1)
                                        {
                                            <div class="bp-tl-line"></div>
                                        }
                                    </div>
                                    <div class="bp-tl-content">
                                        <div class="bp-tl-top">
                                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                                <span class="bp-tl-pct @(i == 0 ? "bp-tl-pct--latest" : "")">
                                                    @e.Pct%
                                                </span>
                                                @if (e.Delta > 0)
                                                {
                                                    <span class="bp-tl-delta">+@e.Delta%</span>
                                                }
                                                <span class="bp-tl-fecha">
                                                    @fechaLabel · @e.Fecha.ToString("dd/MM/yyyy")
                                                </span>
                                            </div>
                                            @if (!string.IsNullOrEmpty(e.Img))
                                            {
                                                <span class="bp-tl-img-badge" title="Con foto: @e.Img">📷</span>
                                            }
                                        </div>
                                        <p class="bp-tl-desc">@e.Desc</p>
                                        @if (!string.IsNullOrEmpty(e.Img))
                                        {
                                            <img src="@e.Img" alt="Foto de avance" class="bp-tl-img">
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
                else
                {
                    <div class="bp-sin-registros">
                        Sin registros de avance aún.
                        <button class="bp-link-btn" data-bs-toggle="modal" data-bs-target="#modalRegistrar"
                                onclick="preseleccionarObra(@o.Id)">
                            Cargar primero →
                        </button>
                    </div>
                }

            </div>
        }
    </div>
    <p id="bpEmpty" class="bp-empty d-none">No hay obras que coincidan con el filtro.</p>

</div>

<!-- MODAL: Registrar avance -->
<div class="modal fade" id="modalRegistrar" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content bp-modal">
            <div class="modal-header bp-modal-header">
                <div>
                    <span class="bp-eyebrow" style="color:rgba(255,255,255,.65)">Control de avance</span>
                    <h5 class="modal-title bp-title">Registrar avance de obra</h5>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body bp-modal-body">
                <!-- TODO: conectar a OnPostRegistrarAvance cuando esté el HttpClient hacia la API -->
                <div class="row g-3">

                    <div class="col-md-8">
                        <label class="bp-label">Obra</label>
                        <select id="modalObraSelect" class="bp-select w-100">
                            <option value="">Seleccionar obra...</option>
                            @foreach (var o in vistaObras)
                            {
                                <option value="@o.Id" data-pct="@o.UltimoPct">
                                    @o.Nombre (@o.Codigo) — actual @o.UltimoPct%
                                </option>
                            }
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label class="bp-label">Fecha</label>
                        <input type="date" class="bp-input w-100" id="modalFecha"
                               value="@today.ToString("yyyy-MM-dd")">
                    </div>

                    <!-- Slider de porcentaje -->
                    <div class="col-12">
                        <label class="bp-label">
                            Porcentaje de avance
                            <span class="bp-pct-actual-hint" id="pctActualHint"></span>
                        </label>
                        <div class="bp-slider-wrap">
                            <input type="range" id="pctSlider" class="bp-slider"
                                   min="0" max="100" value="0" step="1">
                            <div class="bp-slider-display">
                                <span id="pctDisplay" class="bp-pct-display-val">0%</span>
                            </div>
                        </div>
                        <div class="bp-slider-track-labels">
                            <span>0%</span>
                            <span>25%</span>
                            <span>50%</span>
                            <span>75%</span>
                            <span>100%</span>
                        </div>
                    </div>

                    <div class="col-12">
                        <label class="bp-label">Descripción del avance</label>
                        <textarea class="bp-textarea w-100" rows="4"
                                  placeholder="Describí qué se realizó, qué materiales se usaron, qué etapa se completó..."></textarea>
                    </div>

                    <div class="col-12">
                        <label class="bp-label">URL de foto (opcional)</label>
                        <input type="text" id="modalImgUrl" class="bp-input w-100"
                               placeholder="https://... o ruta de archivo">
                        <div id="imgPreview" class="bp-img-preview d-none">
                            <img id="imgPreviewEl" src="" alt="Preview">
                        </div>
                    </div>

                </div>
            </div>
            <div class="modal-footer bp-modal-footer">
                <button type="button" class="bp-btn-ghost" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="bp-btn-primary">Guardar avance</button>
            </div>
        </div>
    </div>
</div>

<style>
    .admin-dashboard {
        --bp-blueprint: #1B3A5C;
        --bp-blueprint-light: #2D5C8C;
        --bp-concrete: #F1EFEA;
        --bp-steel: #5B6670;
        --bp-safety: #F2A900;
        --bp-ink: #181B1F;
        --bp-line: #D8D3C8;
        --bp-ok: #2E7D52;
        font-family: 'Inter', sans-serif;
        color: var(--bp-ink);
    }

        .admin-dashboard .bp-eyebrow {
            font-family: 'JetBrains Mono', monospace;
            font-size: .72rem;
            letter-spacing: .12em;
            text-transform: uppercase;
            color: var(--bp-steel);
        }

    .bp-title {
        font-family: 'Barlow Condensed', sans-serif;
        font-weight: 600;
        letter-spacing: .01em;
        margin: .15rem 0;
    }

    .bp-title-dark {
        font-size: 2rem;
        color: var(--bp-ink);
    }

    .bp-section {
        margin-bottom: 1.75rem;
    }

    .bp-mono {
        font-family: 'JetBrains Mono', monospace;
        font-size: .82rem;
    }

    .bp-steel {
        color: var(--bp-steel);
    }

    .bp-sep {
        color: var(--bp-line);
    }

    /* Botones */
    .bp-btn-primary {
        font-family: 'Inter', sans-serif;
        font-weight: 600;
        font-size: .88rem;
        background: var(--bp-safety);
        color: var(--bp-ink);
        border: none;
        border-radius: 6px;
        padding: .55rem 1.1rem;
        cursor: pointer;
        transition: background .2s;
    }

        .bp-btn-primary:hover {
            background: #d99500;
        }

    .bp-btn-ghost {
        font-family: 'Inter', sans-serif;
        font-weight: 500;
        font-size: .88rem;
        background: transparent;
        color: var(--bp-steel);
        border: 1px solid var(--bp-line);
        border-radius: 6px;
        padding: .55rem 1.1rem;
        cursor: pointer;
    }

        .bp-btn-ghost:hover {
            border-color: var(--bp-steel);
            color: var(--bp-ink);
        }

    .bp-link-btn {
        background: none;
        border: none;
        padding: 0;
        color: var(--bp-blueprint);
        font-size: .82rem;
        font-weight: 500;
        cursor: pointer;
    }

        .bp-link-btn:hover {
            color: var(--bp-safety);
        }

    /* Stat cards */
    .bp-stat-card {
        background: #fff;
        border: 1px solid var(--bp-line);
        border-radius: 8px;
        padding: 1rem 1.1rem;
        height: 100%;
        display: flex;
        flex-direction: column;
        gap: .15rem;
    }

    .bp-stat-card--accent {
        border-left: 3px solid var(--bp-safety);
    }

    .bp-stat-label {
        font-family: 'JetBrains Mono', monospace;
        font-size: .68rem;
        letter-spacing: .08em;
        text-transform: uppercase;
        color: var(--bp-steel);
    }

    .bp-stat-num {
        font-family: 'Barlow Condensed', sans-serif;
        font-size: 2rem;
        font-weight: 600;
        color: var(--bp-ink);
        line-height: 1.1;
    }

    .bp-stat-num--amber {
        color: var(--bp-safety);
    }

    .bp-stat-sub {
        font-size: .75rem;
        color: var(--bp-steel);
    }

    /* Filtros */
    .bp-filterbar {
        display: flex;
        gap: .75rem;
        flex-wrap: wrap;
    }

    .bp-input, .bp-select {
        font-family: 'Inter', sans-serif;
        font-size: .88rem;
        border: 1px solid var(--bp-line);
        border-radius: 6px;
        padding: .5rem .8rem;
        background: #fff;
        color: var(--bp-ink);
    }

        .bp-input:focus, .bp-select:focus {
            outline: none;
            border-color: var(--bp-blueprint-light);
            box-shadow: 0 0 0 3px rgba(45,92,140,.12);
        }

    /* Badge estado */
    .bp-badge {
        display: inline-block;
        font-size: .68rem;
        font-weight: 600;
        padding: .18rem .55rem;
        border-radius: 100px;
        white-space: nowrap;
    }

    .bp-badge--enprogreso {
        background: #E8F0FC;
        color: #2D6CDF;
    }

    .bp-badge--planificada {
        background: #EAECEE;
        color: var(--bp-steel);
    }

    .bp-badge--pausada {
        background: #FFF8E8;
        color: #92670a;
    }

    .bp-badge--finalizada {
        background: #EAF4EE;
