<script>
    // Datos de obras para el slider (pct actual por obra)
    const obrasPct = {
        @foreach (var o in vistaObras)
        {
                @Html.Raw($"{o.Id}: {o.UltimoPct},\n")
        }
    };

    (function () {
        // ── Filtros
        const filtroObra   = document.getElementById('bpFiltroObra');
        const filtroEstado = document.getElementById('bpFiltroEstado');
        const cards        = Array.from(document.querySelectorAll('.bp-obra-card'));
        const empty        = document.getElementById('bpEmpty');

        function aplicarFiltros() {
            const obra   = filtroObra.value;
            const estado = filtroEstado.value;
            let vis = 0;
            cards.forEach(card => {
                const ok = (!obra   || card.dataset.obra   === obra)
                        && (!estado || card.dataset.estado  === estado);
                card.style.display = ok ? '' : 'none';
                if (ok) vis++;
            });
            empty.classList.toggle('d-none', vis > 0);
        }
        filtroObra.addEventListener('change', aplicarFiltros);
        filtroEstado.addEventListener('change', aplicarFiltros);

        // ── Toggle de historial por obra
        window.toggleTl = function(obraId) {
            const entries = document.querySelectorAll(`.bp-tl-hidden[data-obra-tl="${obraId}"]`);
            const btn     = document.querySelector(`[onclick="toggleTl(${obraId})"]`);
            const ocultos = Array.from(entries);
            const estaOculto = ocultos.length > 0 && ocultos[0].style.display !== 'flex' && ocultos[0].style.display !== 'block';

            ocultos.forEach(el => el.style.display = estaOculto ? 'flex' : 'none');

            if (btn) {
                const total = document.querySelectorAll(`[data-obra-tl="${obraId}"]`).length;
                btn.textContent = estaOculto
                    ? 'Ocultar entradas anteriores ↑'
                    : `Ver ${ocultos.length} entradas anteriores ↓`;
            }
        };

        // ── Slider de porcentaje en modal
        const slider    = document.getElementById('pctSlider');
        const display   = document.getElementById('pctDisplay');
        const obraSelect = document.getElementById('modalObraSelect');
        const hint      = document.getElementById('pctActualHint');

        slider.addEventListener('input', () => {
            display.textContent = slider.value + '%';
        });

        obraSelect.addEventListener('change', () => {
            const id  = parseInt(obraSelect.value);
            const pct = obrasPct[id] || 0;
            slider.value = pct;
            display.textContent = pct + '%';
            hint.textContent = pct > 0 ? `(actual: ${pct}%)` : '';
        });

        // ── Preview de imagen en modal
        const imgInput = document.getElementById('modalImgUrl');
        const preview  = document.getElementById('imgPreview');
        const previewEl = document.getElementById('imgPreviewEl');

        imgInput.addEventListener('input', () => {
            const url = imgInput.value.trim();
            if (url) {
                previewEl.src = url;
                preview.classList.remove('d-none');
            } else {
                preview.classList.add('d-none');
            }
        });

        // ── Pre-seleccionar obra desde botón "Cargar primero"
        window.preseleccionarObra = function(id) {
            obraSelect.value = id;
            obraSelect.dispatchEvent(new Event('change'));
        };
    })();
</script>