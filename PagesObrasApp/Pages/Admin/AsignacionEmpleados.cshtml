<script>
    (function () {
        // ── Toggle de vista
        const btnObras    = document.querySelector('[data-vista="obras"]');
        const btnEmp      = document.querySelector('[data-vista="empleados"]');
        const vistaObras  = document.getElementById('vistaObras');
        const vistaEmp    = document.getElementById('vistaEmpleados');

        btnObras.addEventListener('click', () => {
            btnObras.classList.add('active'); btnEmp.classList.remove('active');
            vistaObras.classList.remove('d-none'); vistaEmp.classList.add('d-none');
            aplicarFiltro();
        });
        btnEmp.addEventListener('click', () => {
            btnEmp.classList.add('active'); btnObras.classList.remove('active');
            vistaEmp.classList.remove('d-none'); vistaObras.classList.add('d-none');
            aplicarFiltro();
        });

        // ── Búsqueda unificada
        const search = document.getElementById('bpSearch');

        function aplicarFiltro() {
            const txt = search.value.trim().toLowerCase();
            const enObras = !vistaObras.classList.contains('d-none');

            if (enObras) {
                const cards  = document.querySelectorAll('.bp-obra-wrap');
                const empty  = document.getElementById('bpEmptyObras');
                let vis = 0;
                cards.forEach(c => {
                    const ok = !txt || c.dataset.search.includes(txt);
                    c.style.display = ok ? '' : 'none';
                    if (ok) vis++;
                });
                empty.classList.toggle('d-none', vis > 0);
            } else {
                const rows  = document.querySelectorAll('#bpTbodyEmp tr');
                const empty = document.getElementById('bpEmptyEmp');
                let vis = 0;
                rows.forEach(r => {
                    const ok = !txt || r.dataset.search.includes(txt);
                    r.classList.toggle('d-none', !ok);
                    if (ok) vis++;
                });
                empty.classList.toggle('d-none', vis > 0);
            }
        }

        search.addEventListener('input', aplicarFiltro);

        // ── Preseleccionar empleado desde vista por empleado
        window.preseleccionarEmp = function(id) {
            const sel = document.getElementById('selectEmpModal');
            if (sel) sel.value = id;
        };

        // ── Confirmar quitar asignación
        window.confirmarQuitar = function(id, empNombre, obraNombre) {
            document.getElementById('quitarMsg').innerHTML =
                `¿Confirmás quitar a <strong>${empNombre}</strong> de la obra <strong>${obraNombre}</strong>?
                 <br><small style="color:#5B6670;margin-top:.4rem;display:block">Esta acción no se puede deshacer.</small>`;
            new bootstrap.Modal(document.getElementById('modalQuitar')).show();
            // TODO: al confirmar, llamar a OnPostQuitarAsignacion(id) via fetch hacia la API
        };
    })();
</script>