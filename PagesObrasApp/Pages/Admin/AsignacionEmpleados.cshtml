@page
@model PagesObrasApp.Pages.Admin.AsignacionEmpleadosModel
@using System.Linq
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Asignación de Empleados";

    // --- Datos de muestra (mock) — reemplazar por Model.* cuando conectemos la API vía DTOs ---
    var empleados = new[]
    {
        new { Id=1, Nombre="Rodrigo Méndez",    Cedula="4.521.887-3", ValorHora=320m },
        new { Id=2, Nombre="Sebastián Ferreira", Cedula="3.987.654-1", ValorHora=280m },
        new { Id=3, Nombre="Marcelo Suárez",     Cedula="5.123.456-7", ValorHora=240m },
        new { Id=4, Nombre="Diego Pereira",      Cedula="4.789.012-5", ValorHora=280m },
        new { Id=5, Nombre="Luciana Torres",     Cedula="3.456.789-2", ValorHora=320m },
        new { Id=6, Nombre="Pablo Ríos",         Cedula="5.654.321-9", ValorHora=200m },
        new { Id=7, Nombre="Carlos Espínola",    Cedula="4.111.222-6", ValorHora=280m },
        new { Id=8, Nombre="Fabian Núñez",       Cedula="4.333.111-8", ValorHora=200m },
    };

    var obras = new[]
    {
        new { Id=1, Codigo="OB-2026-014", Nombre="Edificio Las Acacias",     Estado="En Progreso" },
        new { Id=2, Codigo="OB-2026-002", Nombre="Torre Mirador",            Estado="En Progreso" },
        new { Id=3, Codigo="OB-2026-011", Nombre="Galpón Industrial Ruta 5", Estado="En Progreso" },
        new { Id=4, Codigo="OB-2026-019", Nombre="Casa Familia Pérez",       Estado="Planificada" },
        new { Id=5, Codigo="OB-2025-087", Nombre="Reforma Local Comercial",  Estado="Pausada"     },
    };

    // Tabla Empleado_obra (mock)
    var asignaciones = new[]
    {
        new { Id=1,  IdEmp=1, IdObra=1, Rol="Capataz",  FechaAsig=new DateTime(2026,2,10), ValorHoraAsig=340m },
        new { Id=2,  IdEmp=2, IdObra=1, Rol="Oficial",  FechaAsig=new DateTime(2026,2,10), ValorHoraAsig=280m },
        new { Id=3,  IdEmp=7, IdObra=1, Rol="Oficial",  FechaAsig=new DateTime(2026,3,15), ValorHoraAsig=280m },
        new { Id=4,  IdEmp=6, IdObra=1, Rol="Ayudante", FechaAsig=new DateTime(2026,4,1),  ValorHoraAsig=200m },
        new { Id=5,  IdEmp=5, IdObra=2, Rol="Capataz",  FechaAsig=new DateTime(2026,5,2),  ValorHoraAsig=320m },
        new { Id=6,  IdEmp=3, IdObra=2, Rol="Ayudante", FechaAsig=new DateTime(2026,5,2),  ValorHoraAsig=240m },
        new { Id=7,  IdEmp=4, IdObra=3, Rol="Oficial",  FechaAsig=new DateTime(2026,4,22), ValorHoraAsig=280m },
        new { Id=8,  IdEmp=8, IdObra=3, Rol="Ayudante", FechaAsig=new DateTime(2026,4,22), ValorHoraAsig=200m },
        new { Id=9,  IdEmp=7, IdObra=3, Rol="Oficial",  FechaAsig=new DateTime(2026,5,10), ValorHoraAsig=280m },
        new { Id=10, IdEmp=2, IdObra=4, Rol="Oficial",  FechaAsig=new DateTime(2026,6,1),  ValorHoraAsig=280m },
        new { Id=11, IdEmp=8, IdObra=5, Rol="Ayudante", FechaAsig=new DateTime(2026,1,15), ValorHoraAsig=200m },
    };

    // Vista por obra
    var porObra = obras.Select(o => new
    {
        o.Id,
        o.Codigo,
        o.Nombre,
        o.Estado,
        Equipo = asignaciones
            .Where(a => a.IdObra == o.Id)
            .Select(a => new
            {
                a.Id,
                Empleado = empleados.FirstOrDefault(e => e.Id == a.IdEmp),
                a.Rol,
                a.FechaAsig,
                a.ValorHoraAsig
            })
            .OrderBy(x => x.Rol)
            .ToList()
    }).OrderByDescending(o => o.Equipo.Count).ToList();

    // Vista por empleado
    var porEmpleado = empleados.Select(e => new
    {
        e.Id,
        e.Nombre,
        e.Cedula,
        e.ValorHora,
        Asigs = asignaciones
            .Where(a => a.IdEmp == e.Id)
            .Select(a => new
            {
                a.Id,
                Obra = obras.FirstOrDefault(o => o.Id == a.IdObra),
                a.Rol,
                a.FechaAsig,
                a.ValorHoraAsig
            })
            .OrderByDescending(x => x.FechaAsig)
            .ToList()
    }).OrderByDescending(e => e.Asigs.Count).ToList();

    var totalAsignaciones = asignaciones.Length;
    var empleadosAsignados = asignaciones.Select(a => a.IdEmp).Distinct().Count();
    var empleadosSinObra = empleados.Length - empleadosAsignados;
    var obrasConEquipo = asignaciones.Select(a => a.IdObra).Distinct().Count();

    var rolColores = new Dictionary<string, string>
    {
        {"Capataz",  "capataz"},
        {"Oficial",  "oficial"},
        {"Ayudante", "ayudante"},
    };
}

<div class="admin-dashboard">

    <!-- HEADER -->
    <section class="bp-section">
        <div class="d-flex justify-content-between align-items-end flex-wrap gap-2">
            <div>
                <span class="bp-eyebrow">Gestión de personal</span>
                <h1 class="bp-title bp-title-dark">Asignación de empleados</h1>
            </div>
            <button type="button" class="bp-btn-primary" data-bs-toggle="modal" data-bs-target="#modalAsignar">
                + Nueva asignación
            </button>
        </div>
    </section>

    <!-- STAT CARDS -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="bp-stat-card">
                <span class="bp-stat-label">Asignaciones activas</span>
                <span class="bp-stat-num">@totalAsignaciones</span>
                <span class="bp-stat-sub">registros totales</span>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="bp-stat-card bp-stat-card--accent">
                <span class="bp-stat-label">Empleados asignados</span>
                <span class="bp-stat-num bp-stat-num--amber">@empleadosAsignados</span>
                <span class="bp-stat-sub">de @empleados.Length en nómina</span>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="bp-stat-card">
                <span class="bp-stat-label">Obras con equipo</span>
                <span class="bp-stat-num">@obrasConEquipo</span>
                <span class="bp-stat-sub">de @obras.Length obras</span>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="bp-stat-card @(empleadosSinObra > 0 ? "bp-stat-card--alerta" : "")">
                <span class="bp-stat-label">Sin asignar</span>
                <span class="bp-stat-num @(empleadosSinObra > 0 ? "bp-stat-num--rojo" : "")">@empleadosSinObra</span>
                <span class="bp-stat-sub">empleados disponibles</span>
            </div>
        </div>
    </div>

    <!-- TOGGLE DE VISTA -->
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-3">
        <div class="bp-vista-toggle" role="group">
            <button class="bp-vista-btn active" data-vista="obras">
                <svg viewBox="0 0 24 24"><path d="M7 21h10M7 21V5l5-2 5 2v16" /></svg>
                Por obra
            </button>
            <button class="bp-vista-btn" data-vista="empleados">
                <svg viewBox="0 0 24 24"><circle cx="8" cy="7" r="3" /><path d="M3 20c0-3 2-5 5-5s5 2 5 5" /><circle cx="17" cy="8" r="2.3" /><path d="M14.2 20c.3-2.3 1.7-4 3.8-4s3.4 1.3 3.7 3.4" /></svg>
                Por empleado
            </button>
        </div>
        <input type="text" id="bpSearch" class="bp-input" placeholder="Buscar...">
    </div>

    <!-- VISTA: POR OBRA -->
    <div id="vistaObras">
        <div class="row g-3">
            @foreach (var o in porObra)
            {
                var estadoCls = o.Estado.Replace(" ", "").ToLower();
                <div class="col-12 col-xl-6 bp-obra-wrap"
                     data-search="@o.Nombre.ToLower() @o.Codigo.ToLower() @string.Join(" ", o.Equipo.Select(e => e.Empleado?.Nombre.ToLower()))">

                    <div class="bp-obra-card">

                        <!-- Header obra -->
                        <div class="bp-obra-header">
                            <div class="d-flex align-items-start gap-2 flex-grow-1 min-w-0">
                                <div class="min-w-0">
                                    <div class="bp-obra-nombre">@o.Nombre</div>
                                    <span class="bp-mono bp-steel">@o.Codigo</span>
                                </div>
                            </div>
                            <div class="d-flex align-items-center gap-2 flex-shrink-0">
                                <span class="bp-badge bp-badge--@estadoCls">@o.Estado</span>
                                <span class="bp-equipo-count">@o.Equipo.Count <small>pers.</small></span>
                            </div>
                        </div>

                        <!-- Equipo -->
                        @if (o.Equipo.Any())
                        {
                            <div class="bp-equipo-tabla">
                                <div class="bp-equipo-head">
                                    <span>Empleado</span>
                                    <span>Rol</span>
                                    <span>$/h</span>
                                    <span>Desde</span>
                                    <span></span>
                                </div>
                                @foreach (var a in o.Equipo)
                                {
                                    var rolCls = rolColores.ContainsKey(a.Rol) ? rolColores[a.Rol] : "oficial";
                                    <div class="bp-equipo-row">
                                        <div>
                                            <div class="bp-emp-nombre">@a.Empleado?.Nombre</div>
                                            <div class="bp-mono bp-steel">@a.Empleado?.Cedula</div>
                                        </div>
                                        <div>
                                            <span class="bp-rol bp-rol--@rolCls">@a.Rol</span>
                                        </div>
                                        <div class="bp-mono">$@a.ValorHoraAsig.ToString("N0")</div>
                                        <div class="bp-mono bp-steel">@a.FechaAsig.ToString("dd/MM/yy")</div>
                                        <div>
                                            <button class="bp-remove-btn" title="Quitar asignación"
                                                    onclick="confirmarQuitar(@a.Id, '@(a.Empleado?.Nombre.Replace("'", "\\'"))', '@o.Nombre.Replace("'", "\\'")')">
                                                ×
                                            </button>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="bp-sin-equipo">
                                <span>Sin personal asignado</span>
                                <button class="bp-link-btn" data-bs-toggle="modal" data-bs-target="#modalAsignar">
                                    Asignar empleado →
                                </button>
                            </div>
                        }

                    </div>
                </div>
            }
        </div>
        <p id="bpEmptyObras" class="bp-empty d-none">No hay obras que coincidan.</p>
    </div>

    <!-- VISTA: POR EMPLEADO -->
    <div id="vistaEmpleados" class="d-none">
        <div class="bp-table-wrap">
            <table class="bp-table">
                <thead>
                    <tr>
                        <th>Empleado</th>
                        <th>Cédula</th>
                        <th>Obras asignadas</th>
                        <th>Roles</th>
                        <th class="text-end">$/h base</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody id="bpTbodyEmp">
                    @foreach (var e in porEmpleado)
                    {
                        var searchVal = $"{e.Nombre.ToLower()} {e.Cedula} {string.Join(" ", e.Asigs.Select(a => a.Obra?.Nombre.ToLower()))}";
                        <tr data-search="@searchVal">
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="bp-avatar-sm">@e.Nombre.Substring(0, 1)</div>
                                    <span class="bp-emp-nombre">@e.Nombre</span>
                                </div>
                            </td>
                            <td class="bp-mono bp-steel">@e.Cedula</td>
                            <td>
                                @if (e.Asigs.Any())
                                {
                                    <div class="bp-chips-col">
                                        @foreach (var a in e.Asigs)
                                        {
                                            <span class="bp-chip-obra">
                                                <span class="bp-chip-dot bp-chip-dot--@(a.Obra?.Estado.Replace(" ", "").ToLower())"></span>
                                                @a.Obra?.Nombre
                                                <span class="bp-mono" style="font-size:.68rem;opacity:.7">@a.Obra?.Codigo</span>
                                            </span>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <span class="bp-sin-asig">Sin asignación</span>
                                }
                            </td>
                            <td>
                                <div class="d-flex gap-1 flex-wrap">
                                    @foreach (var a in e.Asigs)
                                    {
                                        var rolCls = rolColores.ContainsKey(a.Rol) ? rolColores[a.Rol] : "oficial";
                                        <span class="bp-rol bp-rol--@rolCls">@a.Rol</span>
                                    }
                                    @if (!e.Asigs.Any())
                                    {
                                        <span class="bp-disponible">Disponible</span>
                                    }
                                </div>
                            </td>
                            <td class="text-end bp-mono">$@e.ValorHora.ToString("N0")</td>
                            <td class="text-end">
                                <button class="bp-action-btn"
                                        data-bs-toggle="modal"
                                        data-bs-target="#modalAsignar"
                                        onclick="preseleccionarEmp(@e.Id)">
                                    + Asignar
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <p id="bpEmptyEmp" class="bp-empty d-none">No hay empleados que coincidan.</p>
    </div>

</div>

<!-- Modal: Nueva asignación -->
<div class="modal fade" id="modalAsignar" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content bp-modal">
            <div class="modal-header bp-modal-header">
                <div>
                    <span class="bp-eyebrow" style="color:rgba(255,255,255,.65)">Movimiento de personal</span>
                    <h5 class="modal-title bp-title">Nueva asignación</h5>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body bp-modal-body">
                <!-- TODO: conectar a OnPostCrearAsignacion cuando esté el HttpClient hacia la API -->
                <div class="row g-3">
                    <div class="col-12">
                        <label class="bp-label">Empleado</label>
                        <select id="selectEmpModal" class="bp-select w-100">
                            <option value="">Seleccionar empleado...</option>
                            @foreach (var e in empleados)
                            {
                                <option value="@e.Id">@e.Nombre (@e.Cedula)</option>
                            }
                        </select>
                    </div>
                    <div class="col-12">
                        <label class="bp-label">Obra de destino</label>
                        <select class="bp-select w-100">
                            <option value="">Seleccionar obra...</option>
                            @foreach (var o in obras)
                            {
                                <option value="@o.Id">@o.Nombre (@o.Codigo)</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="bp-label">Rol en obra</label>
                        <select id="selectRolModal" class="bp-select w-100">
                            <option value="Oficial" selected>Oficial</option>
                            <option value="Capataz">Capataz</option>
                            <option value="Ayudante">Ayudante</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="bp-label">Valor hora asignado ($)</label>
                        <input type="number" id="inputValorHora" min="1" step="10" class="bp-input w-100" placeholder="Ej: 280">
                    </div>
                    <div class="col-12">
                        <label class="bp-label">Fecha de asignación</label>
                        <input type="date" class="bp-input w-100" value="@DateTime.Today.ToString("yyyy-MM-dd")">
                    </div>
                </div>
            </div>
            <div class="modal-footer bp-modal-footer">
                <button type="button" class="bp-btn-ghost" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="bp-btn-primary">Confirmar asignación</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Confirmar quitar asignación -->
<div class="modal fade" id="modalQuitar" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-sm">
        <div class="modal-content bp-modal">
            <div class="modal-header bp-modal-header bp-modal-header--danger">
                <h5 class="modal-title bp-title">Quitar asignación</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body bp-modal-body">
                <p id="quitarMsg" style="font-size:.9rem;margin:0"></p>
            </div>
            <div class="modal-footer bp-modal-footer">
                <button type="button" class="bp-btn-ghost" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="bp-btn-danger">Confirmar</button>
            </div>
        </div>
    </div>
</div>

<style>
    .admin-dashboard {
        --bp-blueprint: #1B3A5C;
        --bp-blueprint-light: #2D5C8C;
        --bp-concrete: #F1EFEA;
        --bp-steel: #5B6670;
        --bp-safety: #F2A900;
        --bp-ink: #181B1F;
        --bp-line: #D8D3C8;
        --bp-ok: #2E7D52;
        --bp-danger: #B23A2E;
        font-family: 'Inter', sans-serif;
        color: var(--bp-ink);
    }

        .admin-dashboard .bp-eyebrow {
            font-family: 'JetBrains Mono', monospace;
            font-size: .72rem;
            letter-spacing: .12em;
            text-transform: uppercase;
            color: var(--bp-steel);
        }

    .bp-title {
        font-family: 'Barlow Condensed', sans-serif;
        font-weight: 600;
        letter-spacing: .01em;
        margin: .15rem 0;
    }

    .bp-title-dark {
        font-size: 2rem;
        color: var(--bp-ink);
    }

    .bp-section {
        margin-bottom: 1.75rem;
    }

    .bp-mono {
        font-family: 'JetBrains Mono', monospace;
        font-size: .82rem;
    }

    .bp-steel {
        color: var(--bp-steel);
    }

    /* Botones */
    .bp-btn-primary {
        font-family: 'Inter', sans-serif;
        font-weight: 600;
        font-size: .88rem;
        background: var(--bp-safety);
        color: var(--bp-ink);
        border: none;
        border-radius: 6px;
        padding: .55rem 1.1rem;
        transition: background .2s;
        cursor: pointer;
    }

        .bp-btn-primary:hover {
            background: #d99500;
        }

    .bp-btn-ghost {
        font-family: 'Inter', sans-serif;
        font-weight: 500;
        font-size: .88rem;
        background: transparent;
        color: var(--bp-steel);
        border: 1px solid var(--bp-line);
        border-radius: 6px;
        padding: .55rem 1.1rem;
        cursor: pointer;
    }

        .bp-btn-ghost:hover {
            border-color: var(--bp-steel);
            color: var(--bp-ink);
        }

    .bp-btn-danger {
        font-family: 'Inter', sans-serif;
        font-weight: 600;
        font-size: .88rem;
        background: var(--bp-danger);
        color: #fff;
        border: none;
        border-radius: 6px;
        padding: .55rem 1.1rem;
        cursor: pointer;
    }

        .bp-btn-danger:hover {
            background: #8f2d23;
        }

    .bp-action-btn {
        background: none;
        border: 1px solid var(--bp-line);
        border-radius: 5px;
        padding: .2rem .6rem;
        font-size: .8rem;
        cursor: pointer;
        color: var(--bp-steel);
        transition: border-color .15s, color .15s;
        white-space: nowrap;
    }

        .bp-action-btn:hover {
            border-color: var(--bp-blueprint);
            color: var(--bp-blueprint);
        }

    .bp-remove-btn {
        background: none;
        border: 1px solid transparent;
        border-radius: 4px;
        width: 22px;
        height: 22px;
        font-size: 1rem;
        line-height: 1;
        color: var(--bp-steel);
        cursor: pointer;
        transition: all .15s;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .bp-remove-btn:hover {
            border-color: var(--bp-danger);
            color: var(--bp-danger);
            background: #fbf0ef;
        }

    .bp-link-btn {
        background: none;
        border: none;
        padding: 0;
        color: var(--bp-blueprint);
        font-size: .82rem;
        font-weight: 500;
        cursor: pointer;
        text-decoration: none;
    }

        .bp-link-btn:hover {
            color: var(--bp-safety);
        }

    /* Stat cards */
    .bp-stat-card {
        background: #fff;
        border: 1px solid var(--bp-line);
        border-radius: 8px;
        padding: 1rem 1.1rem;
        height: 100%;
        display: flex;
        flex-direction: column;
        gap: .15rem;
    }

    .bp-stat-card--accent {
        border-left: 3px solid var(--bp-safety);
    }

    .bp-stat-card--alerta {
        border-left: 3px solid var(--bp-blueprint-light);
    }

    .bp-stat-label {
        font-family: 'JetBrains Mono', monospace;
        font-size: .68rem;
        letter-spacing: .08em;
        text-transform: uppercase;
        color: var(--bp-steel);
    }

    .bp-stat-num {
        font-family: 'Barlow Condensed', sans-serif;
        font-size: 2rem;
        font-weight: 600;
        color: var(--bp-ink);
        line-height: 1.1;
    }

    .bp-stat-num--amber {
        color: var(--bp-safety);
    }

    .bp-stat-num--rojo {
        color: var(--bp-blueprint-light);
    }

    .bp-stat-sub {
        font-size: .75rem;
        color: var(--bp-steel);
    }

    /* Toggle de vista */
    .bp-vista-toggle {
        display: flex;
        background: var(--bp-concrete);
        border: 1px solid var(--bp-line);
        border-radius: 8px;
        padding: 3px;
        gap: 3px;
    }

    .bp-vista-btn {
        display: flex;
        align-items: center;
        gap: .4rem;
        font-family: 'Inter', sans-serif;
        font-weight: 500;
        font-size: .85rem;
        background: transparent;
        border: none;
        border-radius: 6px;
        padding: .38rem .85rem;
        color: var(--bp-steel);
        cursor: pointer;
        transition: background .15s, color .15s;
    }

        .bp-vista-btn svg {
            width: 15px;
            height: 15px;
            fill: none;
            stroke: currentColor;
            stroke-width: 1.8;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

        .bp-vista-btn.active {
            background: #fff;
            color: var(--bp-blueprint);
