@page
@model PagesObrasApp.Pages.Admin.AsignacionEmpleadosModel
@using System.Linq
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Asignación de Empleados";

    var obraPorId = Model.Obras.ToDictionary(o => o.IdObra, o => o);

    var porObra = Model.Obras.Select(o => new
    {
        o.IdObra,
        o.CodigoFormateado,
        o.NombreObra,
        o.Estado,
        Equipo = Model.Asignaciones.Where(a => a.IdObra == o.IdObra).ToList()
    }).OrderByDescending(o => o.Equipo.Count).ToList();

    var porEmpleado = Model.Empleados.Select(e => new
    {
        e.IdEmpleado,
        e.NombreCompleto,
        e.Categoria,
        Telefono = e.Telefono ?? "",
        Asigs = Model.Asignaciones.Where(a => a.IdEmpleado == e.IdEmpleado).ToList()
    }).OrderByDescending(e => e.Asigs.Count).ToList();

    var totalAsignaciones = Model.Asignaciones.Count;
    var empleadosAsignados = Model.Asignaciones.Select(a => a.IdEmpleado).Distinct().Count();
    var empleadosSinObra = Model.Empleados.Count - empleadosAsignados;
    var obrasConEquipo = Model.Asignaciones.Select(a => a.IdObra).Distinct().Count();
}

<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

<div class="admin-dashboard">

    @if (!string.IsNullOrEmpty(Model.Mensaje))
    {
        <div class="alert @(Model.MensajeTipo == "ok" ? "alert-success" : "alert-danger")">@Model.Mensaje</div>
    }

    <!-- HEADER -->
    <section class="bp-section">
        <div class="d-flex justify-content-between align-items-end flex-wrap gap-2">
            <div>
                <span class="bp-eyebrow">Gestión de personal</span>
                <h1 class="bp-title bp-title-dark">Asignación de empleados</h1>
            </div>
            <button type="button" class="bp-btn-primary" data-bs-toggle="modal" data-bs-target="#modalAsignar">
                + Nueva asignación
            </button>
        </div>
    </section>

    <p class="bp-nota mb-3">
        La API todavía no devuelve rol, valor hora asignado ni fecha por cada asignación en <code>GET /api/Empleado/asignados</code> — por eso esta vista solo muestra empleado + obra. Tampoco existe un endpoint para quitar una asignación.
    </p>

    <!-- STAT CARDS -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="bp-stat-card">
                <span class="bp-stat-label">Asignaciones activas</span>
                <span class="bp-stat-num">@totalAsignaciones</span>
                <span class="bp-stat-sub">registros totales</span>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="bp-stat-card bp-stat-card--accent">
                <span class="bp-stat-label">Empleados asignados</span>
                <span class="bp-stat-num bp-stat-num--amber">@empleadosAsignados</span>
                <span class="bp-stat-sub">de @Model.Empleados.Count en nómina</span>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="bp-stat-card">
                <span class="bp-stat-label">Obras con equipo</span>
                <span class="bp-stat-num">@obrasConEquipo</span>
                <span class="bp-stat-sub">de @Model.Obras.Count obras</span>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="bp-stat-card @(empleadosSinObra > 0 ? "bp-stat-card--alerta" : "")">
                <span class="bp-stat-label">Sin asignar</span>
                <span class="bp-stat-num @(empleadosSinObra > 0 ? "bp-stat-num--rojo" : "")">@empleadosSinObra</span>
                <span class="bp-stat-sub">empleados disponibles</span>
            </div>
        </div>
    </div>

    <!-- TOGGLE DE VISTA -->
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-3">
        <div class="bp-vista-toggle" role="group">
            <button class="bp-vista-btn active" data-vista="obras" type="button">
                <svg viewBox="0 0 24 24"><path d="M7 21h10M7 21V5l5-2 5 2v16" /></svg>
                Por obra
            </button>
            <button class="bp-vista-btn" data-vista="empleados" type="button">
                <svg viewBox="0 0 24 24"><circle cx="8" cy="7" r="3" /><path d="M3 20c0-3 2-5 5-5s5 2 5 5" /><circle cx="17" cy="8" r="2.3" /><path d="M14.2 20c.3-2.3 1.7-4 3.8-4s3.4 1.3 3.7 3.4" /></svg>
                Por empleado
            </button>
        </div>
        <input type="text" id="bpSearch" class="bp-input" placeholder="Buscar...">
    </div>

    <!-- VISTA: POR OBRA -->
    <div id="vistaObras">
        <div class="row g-3">
            @foreach (var o in porObra)
            {
                var estadoCls = (o.Estado ?? "").Replace(" ", "").ToLower();
                <div class="col-12 col-xl-6 bp-obra-wrap"
                     data-search="@o.NombreObra.ToLower() @o.CodigoFormateado.ToLower() @string.Join(" ", o.Equipo.Select(e => e.NombreCompleto.ToLower()))">

                    <div class="bp-obra-card">

                        <!-- Header obra -->
                        <div class="bp-obra-header">
                            <div class="d-flex align-items-start gap-2 flex-grow-1 min-w-0">
                                <div class="min-w-0">
                                    <div class="bp-obra-nombre">@o.NombreObra</div>
                                    <span class="bp-mono bp-steel">@o.CodigoFormateado</span>
                                </div>
                            </div>
                            <div class="d-flex align-items-center gap-2 flex-shrink-0">
                                <span class="bp-badge bp-badge--@estadoCls">@o.Estado</span>
                                <span class="bp-equipo-count">@o.Equipo.Count <small>pers.</small></span>
                            </div>
                        </div>

                        <!-- Equipo -->
                        @if (o.Equipo.Any())
                        {
                            <div class="bp-equipo-tabla">
                                <div class="bp-equipo-head">
                                    <span>Empleado</span>
                                    <span>Categoría</span>
                                    <span>Teléfono</span>
                                </div>
                                @foreach (var a in o.Equipo)
                                {
                                    <div class="bp-equipo-row" style="grid-template-columns: 1fr auto auto;">
                                        <div class="bp-emp-nombre">@a.NombreCompleto</div>
                                        <div><span class="bp-rol bp-rol--oficial">@a.Categoria</span></div>
                                        <div class="bp-mono bp-steel">@a.Telefono</div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="bp-sin-equipo">
                                <span>Sin personal asignado</span>
                                <button class="bp-link-btn" data-bs-toggle="modal" data-bs-target="#modalAsignar">
                                    Asignar empleado →
                                </button>
                            </div>
                        }

                    </div>
                </div>
            }
        </div>
        <p id="bpEmptyObras" class="bp-empty d-none">No hay obras que coincidan.</p>
    </div>

    <!-- VISTA: POR EMPLEADO -->
    <div id="vistaEmpleados" class="d-none">
        <div class="bp-table-wrap">
            <table class="bp-table">
                <thead>
                    <tr>
                        <th>Empleado</th>
                        <th>Categoría</th>
                        <th>Obras asignadas</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody id="bpTbodyEmp">
                    @foreach (var e in porEmpleado)
                    {
                        var searchVal = $"{e.NombreCompleto.ToLower()} {string.Join(" ", e.Asigs.Select(a => a.NombreObra.ToLower()))}";
                        <tr data-search="@searchVal">
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="bp-avatar-sm">@e.NombreCompleto.Substring(0, 1)</div>
                                    <span class="bp-emp-nombre">@e.NombreCompleto</span>
                                </div>
                            </td>
                            <td><span class="bp-rol bp-rol--oficial">@e.Categoria</span></td>
                            <td>
                                @if (e.Asigs.Any())
                                {
                                    <div class="bp-chips-col">
                                        @foreach (var a in e.Asigs)
                                        {
                                            var estObra = obraPorId.TryGetValue(a.IdObra, out var ob) ? (ob.Estado ?? "") : "";
                                            <span class="bp-chip-obra">
                                                <span class="bp-chip-dot bp-chip-dot--@estObra.Replace(" ", "").ToLower()"></span>
                                                @a.NombreObra
                                            </span>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <span class="bp-sin-asig">Sin asignación</span>
                                }
                            </td>
                            <td class="text-end">
                                <button class="bp-action-btn"
                                        data-bs-toggle="modal"
                                        data-bs-target="#modalAsignar"
                                        onclick="preseleccionarEmp(@e.IdEmpleado)">
                                    + Asignar
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <p id="bpEmptyEmp" class="bp-empty d-none">No hay empleados que coincidan.</p>
    </div>

</div>

<!-- Modal: Nueva asignación -->
<div class="modal fade" id="modalAsignar" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content bp-modal">
            <form method="post" asp-page-handler="CrearAsignacion">
                <div class="modal-header bp-modal-header">
                    <div>
                        <span class="bp-eyebrow" style="color:rgba(255,255,255,.65)">Movimiento de personal</span>
                        <h5 class="modal-title bp-title">Nueva asignación</h5>
                    </div>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body bp-modal-body">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="bp-label">Empleado</label>
                            <select id="selectEmpModal" name="idEmpleado" class="bp-select w-100" required>
                                <option value="">Seleccionar empleado...</option>
                                @foreach (var e in Model.Empleados)
                                {
                                    <option value="@e.IdEmpleado">@e.NombreCompleto</option>
                                }
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="bp-label">Obra de destino</label>
                            <select name="idObra" class="bp-select w-100" required>
                                <option value="">Seleccionar obra...</option>
                                @foreach (var o in Model.Obras)
                                {
                                    <option value="@o.IdObra">@o.NombreObra (@o.CodigoFormateado)</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="bp-label">Rol en obra</label>
                            <select name="rolEnObra" class="bp-select w-100">
                                <option value="Oficial" selected>Oficial</option>
                                <option value="Capataz">Capataz</option>
                                <option value="Ayudante">Ayudante</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="bp-label">Valor hora asignado ($)</label>
                            <input type="number" name="valorHoraAsignado" min="1" step="10" class="bp-input w-100" placeholder="Ej: 280" required>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bp-modal-footer">
                    <button type="button" class="bp-btn-ghost" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="bp-btn-primary">Confirmar asignación</button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .admin-dashboard {
        --bp-blueprint: #1B3A5C;
        --bp-blueprint-light: #2D5C8C;
        --bp-concrete: #F1EFEA;
        --bp-steel: #5B6670;
        --bp-safety: #F2A900;
        --bp-ink: #181B1F;
        --bp-line: #D8D3C8;
        --bp-ok: #2E7D52;
        --bp-danger: #B23A2E;
        font-family: 'Inter', sans-serif;
        color: var(--bp-ink);
    }

        .admin-dashboard .bp-eyebrow {
            font-family: 'JetBrains Mono', monospace;
            font-size: .72rem;
            letter-spacing: .12em;
            text-transform: uppercase;
            color: var(--bp-steel);
        }

    .bp-title {
        font-family: 'Barlow Condensed', sans-serif;
        font-weight: 600;
        letter-spacing: .01em;
        margin: .15rem 0;
    }

    .bp-title-dark { font-size: 2rem; color: var(--bp-ink); }
    .bp-section { margin-bottom: 1.75rem; }
    .bp-mono { font-family: 'JetBrains Mono', monospace; font-size: .82rem; }
    .bp-steel { color: var(--bp-steel); }

    .bp-nota {
        font-size: 0.82rem;
        color: var(--bp-steel);
        background: var(--bp-concrete);
        border: 1px dashed var(--bp-line);
        border-radius: 6px;
        padding: 0.6rem 0.9rem;
    }

    .bp-btn-primary {
        font-family: 'Inter', sans-serif; font-weight: 600; font-size: .88rem;
        background: var(--bp-safety); color: var(--bp-ink); border: none;
        border-radius: 6px; padding: .55rem 1.1rem; transition: background .2s; cursor: pointer;
    }
    .bp-btn-primary:hover { background: #d99500; }

    .bp-btn-ghost {
        font-family: 'Inter', sans-serif; font-weight: 500; font-size: .88rem;
        background: transparent; color: var(--bp-steel); border: 1px solid var(--bp-line);
        border-radius: 6px; padding: .55rem 1.1rem; cursor: pointer;
    }
    .bp-btn-ghost:hover { border-color: var(--bp-steel); color: var(--bp-ink); }

    .bp-action-btn {
        background: none; border: 1px solid var(--bp-line); border-radius: 5px;
        padding: .2rem .6rem; font-size: .8rem; cursor: pointer; color: var(--bp-steel);
        transition: border-color .15s, color .15s; white-space: nowrap;
    }
    .bp-action-btn:hover { border-color: var(--bp-blueprint); color: var(--bp-blueprint); }

    .bp-link-btn {
        background: none; border: none; padding: 0; color: var(--bp-blueprint);
        font-size: .82rem; font-weight: 500; cursor: pointer; text-decoration: none;
    }
    .bp-link-btn:hover { color: var(--bp-safety); }

    .bp-stat-card {
        background: #fff; border: 1px solid var(--bp-line); border-radius: 8px;
        padding: 1rem 1.1rem; height: 100%; display: flex; flex-direction: column; gap: .15rem;
    }
    .bp-stat-card--accent { border-left: 3px solid var(--bp-safety); }
    .bp-stat-card--alerta { border-left: 3px solid var(--bp-blueprint-light); }
    .bp-stat-label {
        font-family: 'JetBrains Mono', monospace; font-size: .68rem; letter-spacing: .08em;
        text-transform: uppercase; color: var(--bp-steel);
    }
    .bp-stat-num {
        font-family: 'Barlow Condensed', sans-serif; font-size: 2rem; font-weight: 600;
        color: var(--bp-ink); line-height: 1.1;
    }
    .bp-stat-num--amber { color: var(--bp-safety); }
    .bp-stat-num--rojo { color: var(--bp-blueprint-light); }
    .bp-stat-sub { font-size: .75rem; color: var(--bp-steel); }

    .bp-vista-toggle {
        display: flex; background: var(--bp-concrete); border: 1px solid var(--bp-line);
        border-radius: 8px; padding: 3px; gap: 3px;
    }
    .bp-vista-btn {
        display: flex; align-items: center; gap: .4rem; font-family: 'Inter', sans-serif;
        font-weight: 500; font-size: .85rem; background: transparent; border: none;
        border-radius: 6px; padding: .38rem .85rem; color: var(--bp-steel); cursor: pointer;
        transition: background .15s, color .15s;
    }
    .bp-vista-btn svg {
        width: 15px; height: 15px; fill: none; stroke: currentColor;
        stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round;
    }
    .bp-vista-btn.active { background: #fff; color: var(--bp-blueprint); box-shadow: 0 1px 4px rgba(0,0,0,.1); }

    .bp-input, .bp-select {
        font-family: 'Inter', sans-serif; font-size: .88rem; border: 1px solid var(--bp-line);
        border-radius: 6px; padding: .5rem .8rem; background: #fff; color: var(--bp-ink);
    }
    .bp-input:focus, .bp-select:focus {
        outline: none; border-color: var(--bp-blueprint-light); box-shadow: 0 0 0 3px rgba(45,92,140,.12);
    }
    #bpSearch { min-width: 220px; }

    .bp-obra-card { background: #fff; border: 1px solid var(--bp-line); border-radius: 10px; overflow: hidden; height: 100%; }
    .bp-obra-header {
        display: flex; align-items: center; justify-content: space-between; gap: 1rem;
        padding: 1rem 1.1rem; border-bottom: 1px solid var(--bp-line); background: var(--bp-concrete);
    }
    .bp-obra-nombre { font-family: 'Barlow Condensed', sans-serif; font-weight: 600; font-size: 1.05rem; }
    .bp-equipo-count {
        font-family: 'Barlow Condensed', sans-serif; font-weight: 700; font-size: 1.5rem;
        color: var(--bp-blueprint); line-height: 1;
    }
    .bp-equipo-count small { font-size: .65rem; font-weight: 500; color: var(--bp-steel); }

    .bp-equipo-tabla { padding: .5rem 0; }
    .bp-equipo-head {
        display: grid; grid-template-columns: 1fr auto auto; gap: .5rem; padding: .4rem 1rem;
        font-family: 'JetBrains Mono', monospace; font-size: .62rem; letter-spacing: .1em;
        text-transform: uppercase; color: var(--bp-steel); border-bottom: 1px solid var(--bp-line);
    }
    .bp-equipo-row {
        display: grid; gap: .5rem; padding: .6rem 1rem; align-items: center;
        border-bottom: 1px solid var(--bp-line); transition: background .1s;
    }
    .bp-equipo-row:last-child { border-bottom: none; }
    .bp-equipo-row:hover { background: #fafaf8; }
    .bp-emp-nombre { font-weight: 600; font-size: .88rem; }

    .bp-badge { font-size: .68rem; font-weight: 600; padding: .18rem .55rem; border-radius: 100px; white-space: nowrap; }
    .bp-badge--enprogreso { background: #E8F0FC; color: #2D6CDF; }
    .bp-badge--planificada { background: #EAECEE; color: var(--bp-steel); }
    .bp-badge--pausada { background: #FFF8E8; color: #92670a; }
    .bp-badge--finalizada { background: #EAF4EE; color: var(--bp-ok); }
    .bp-badge--cancelada { background: #FBF0EF; color: var(--bp-danger); }

    .bp-rol { font-size: .68rem; font-weight: 600; padding: .15rem .5rem; border-radius: 4px; white-space: nowrap; }
    .bp-rol--capataz { background: #E8EFF6; color: var(--bp-blueprint); }
    .bp-rol--oficial { background: #EAECEE; color: var(--bp-steel); }
    .bp-rol--ayudante { background: var(--bp-concrete); color: #888; border: 1px solid var(--bp-line); }

    .bp-sin-equipo {
        padding: 1.25rem; display: flex; align-items: center; justify-content: space-between;
        gap: 1rem; color: var(--bp-steel); font-size: .85rem;
    }

    .bp-table-wrap { background: #fff; border: 1px solid var(--bp-line); border-radius: 8px; overflow: hidden; }
    .bp-table { width: 100%; border-collapse: collapse; font-size: .88rem; }
    .bp-table thead th {
        font-family: 'JetBrains Mono', monospace; font-size: .68rem; letter-spacing: .08em;
        text-transform: uppercase; color: var(--bp-steel); text-align: left; padding: .75rem 1rem;
        background: var(--bp-concrete); border-bottom: 1px solid var(--bp-line);
    }
    .bp-table tbody td { padding: .75rem 1rem; border-bottom: 1px solid var(--bp-line); vertical-align: middle; }
    .bp-table tbody tr:hover { background: #fafaf8; }
    .bp-table tbody tr:last-child td { border-bottom: none; }

    .bp-avatar-sm {
        width: 32px; height: 32px; border-radius: 6px; flex-shrink: 0; background: var(--bp-blueprint);
        color: #fff; font-family: 'Barlow Condensed', sans-serif; font-weight: 700; font-size: 1rem;
        display: flex; align-items: center; justify-content: center;
    }

    .bp-chips-col { display: flex; flex-direction: column; gap: .3rem; }
    .bp-chip-obra { display: flex; align-items: center; gap: .4rem; font-size: .78rem; }
    .bp-chip-dot { width: 7px; height: 7px; border-radius: 50%; flex-shrink: 0; }
    .bp-chip-dot--enprogreso { background: #2D6CDF; }
    .bp-chip-dot--planificada { background: var(--bp-steel); }
    .bp-chip-dot--pausada { background: var(--bp-safety); }
    .bp-chip-dot--finalizada { background: var(--bp-ok); }
    .bp-chip-dot--cancelada { background: var(--bp-danger); }

    .bp-sin-asig { font-size: .8rem; color: var(--bp-steel); font-style: italic; }

    .bp-modal { border: none; border-radius: 10px; overflow: hidden; }
    .bp-modal-header { background: var(--bp-blueprint); border: none; padding: 1.25rem 1.5rem; }
    .bp-modal-header .bp-title { color: #fff; font-size: 1.4rem; }
    .bp-modal-body { padding: 1.5rem; background: var(--bp-concrete); }
    .bp-modal-footer { border-top: 1px solid var(--bp-line); padding: 1rem 1.5rem; }
    .bp-label {
        display: block; font-family: 'JetBrains Mono', monospace; font-size: .68rem;
        letter-spacing: .08em; text-transform: uppercase; color: var(--bp-steel); margin-bottom: .3rem;
    }
    .bp-empty { text-align: center; padding: 2.5rem; color: var(--bp-steel); }

    @@media (max-width: 576px) {
        .bp-equipo-head, .bp-equipo-row { grid-template-columns: 1fr auto !important; }
        .bp-equipo-head span:nth-child(3), .bp-equipo-row div:nth-child(3) { display: none; }
    }
</style>

<script>
    (function () {
        const btnObras   = document.querySelector('[data-vista="obras"]');
        const btnEmp     = document.querySelector('[data-vista="empleados"]');
        const vistaObras = document.getElementById('vistaObras');
        const vistaEmp   = document.getElementById('vistaEmpleados');

        btnObras.addEventListener('click', () => {
            btnObras.classList.add('active'); btnEmp.classList.remove('active');
            vistaObras.classList.remove('d-none'); vistaEmp.classList.add('d-none');
            aplicarFiltro();
        });
        btnEmp.addEventListener('click', () => {
            btnEmp.classList.add('active'); btnObras.classList.remove('active');
            vistaEmp.classList.remove('d-none'); vistaObras.classList.add('d-none');
            aplicarFiltro();
        });

        const search = document.getElementById('bpSearch');

        function aplicarFiltro() {
            const txt = search.value.trim().toLowerCase();
            const enObras = !vistaObras.classList.contains('d-none');

            if (enObras) {
                const cards = document.querySelectorAll('.bp-obra-wrap');
                const empty = document.getElementById('bpEmptyObras');
                let vis = 0;
                cards.forEach(c => {
                    const ok = !txt || c.dataset.search.includes(txt);
                    c.style.display = ok ? '' : 'none';
                    if (ok) vis++;
                });
                empty.classList.toggle('d-none', vis > 0);
            } else {
                const rows = document.querySelectorAll('#bpTbodyEmp tr');
                const empty = document.getElementById('bpEmptyEmp');
                let vis = 0;
                rows.forEach(r => {
                    const ok = !txt || r.dataset.search.includes(txt);
                    r.classList.toggle('d-none', !ok);
                    if (ok) vis++;
                });
                empty.classList.toggle('d-none', vis > 0);
            }
        }

        search.addEventListener('input', aplicarFiltro);

        window.preseleccionarEmp = function (id) {
            const sel = document.getElementById('selectEmpModal');
            if (sel) sel.value = id;
        };
    })();
</script>
