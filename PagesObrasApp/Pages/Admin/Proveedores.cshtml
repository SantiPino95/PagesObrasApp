@page
@model PagesObrasApp.Pages.Admin.ProveedoresModel
@using System.Linq
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Proveedores";

    // --- Datos de muestra (mock) — reemplazar por Model.* cuando conectemos la API vía DTOs ---
    var proveedores = new[]
    {
        new { Id=1, Nombre="Materiales del Norte S.A.", RUT="21-345678-0001",  Tel="02 401 2233", Email="ventas@matdelnorte.com.uy",    Ordenes=6, MontoTotal=142000m },
        new { Id=2, Nombre="Distribuidora Ferpal",      RUT="21-112233-0002",  Tel="02 508 4455", Email="ferpal@distribuidora.uy",       Ordenes=4, MontoTotal=98500m  },
        new { Id=3, Nombre="Hierros Uruguay S.A.",      RUT="21-667788-0003",  Tel="099 345 678", Email="contacto@hierrosuruguay.com.uy",Ordenes=3, MontoTotal=75200m  },
        new { Id=4, Nombre="Pinturas Rex",              RUT="21-223344-0004",  Tel="098 112 233", Email="rex@pinturas.com.uy",           Ordenes=2, MontoTotal=18400m  },
        new { Id=5, Nombre="Alquileres Técnicos SRL",   RUT="21-556677-0005",  Tel="02 602 9988", Email="info@alquilertech.uy",          Ordenes=5, MontoTotal=61800m  },
        new { Id=6, Nombre="Cerámica del Sur",          RUT="21-889900-0006",  Tel="091 667 788", Email="ventas@ceramicadelsur.uy",      Ordenes=1, MontoTotal=9500m   },
        new { Id=7, Nombre="Transportes Vidal",         RUT="21-334455-0007",  Tel="094 778 899", Email="transporte@vidal.uy",           Ordenes=3, MontoTotal=22700m  },
    };

    var totalProveedores = proveedores.Length;
    var totalOrdenes = proveedores.Sum(p => p.Ordenes);
    var totalCompras = proveedores.Sum(p => p.MontoTotal);
    var provMasActivo = proveedores.OrderByDescending(p => p.MontoTotal).First();
}

<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

<div class="admin-dashboard">

    <!-- HEADER -->
    <section class="bp-section">
        <div class="d-flex justify-content-between align-items-end flex-wrap gap-2">
            <div>
                <span class="bp-eyebrow">Gestión de compras</span>
                <h1 class="bp-title bp-title-dark">Proveedores</h1>
            </div>
            <button type="button" class="bp-btn-primary" data-bs-toggle="modal" data-bs-target="#modalNuevoProveedor">
                + Nuevo proveedor
            </button>
        </div>
    </section>

    <!-- STAT CARDS -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="bp-stat-card">
                <span class="bp-stat-label">Proveedores</span>
                <span class="bp-stat-num">@totalProveedores</span>
                <span class="bp-stat-sub">registrados</span>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="bp-stat-card">
                <span class="bp-stat-label">Órdenes emitidas</span>
                <span class="bp-stat-num">@totalOrdenes</span>
                <span class="bp-stat-sub">en total</span>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="bp-stat-card bp-stat-card--accent">
                <span class="bp-stat-label">Total compras</span>
                <span class="bp-stat-num bp-stat-num--amber">$@totalCompras.ToString("N0")</span>
                <span class="bp-stat-sub">acumulado</span>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="bp-stat-card">
                <span class="bp-stat-label">Mayor proveedor</span>
                <span class="bp-stat-num-sm">@provMasActivo.Nombre</span>
                <span class="bp-stat-sub">$@provMasActivo.MontoTotal.ToString("N0") en compras</span>
            </div>
        </div>
    </div>

    <!-- TABLA -->
    <section class="bp-section">
        <div class="bp-filterbar mb-3">
            <input type="text" id="bpSearch" class="bp-input" placeholder="Buscar por nombre, RUT o email...">
        </div>

        <div class="bp-table-wrap">
            <table class="bp-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Proveedor</th>
                        <th>RUT</th>
                        <th>Teléfono</th>
                        <th>Email</th>
                        <th class="text-center">Órdenes</th>
                        <th class="text-end">Total compras</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody id="bpTbody">
                    @foreach (var p in proveedores.OrderByDescending(x => x.MontoTotal))
                    {
                        var pct = totalCompras > 0
                            ? (int)Math.Round(p.MontoTotal / totalCompras * 100)
                            : 0;
                        <tr data-search="@($"{p.Nombre} {p.RUT} {p.Email}".ToLower())">
                            <!-- ID -->
                            <td class="bp-mono bp-steel">@p.Id.ToString("D4")</td>

                            <!-- Nombre + barra proporción -->
                            <td>
                                <div class="bp-prov-nombre">@p.Nombre</div>
                                <div class="bp-prop-wrap">
                                    <div class="bp-prop-bar">
                                        <div class="bp-prop-fill" style="width:@pct%"></div>
                                    </div>
                                    <span class="bp-mono bp-steel">@pct%</span>
                                </div>
                            </td>

                            <!-- RUT -->
                            <td class="bp-mono">@p.RUT</td>

                            <!-- Teléfono -->
                            <td>
                                <a href="tel:@p.Tel.Replace(" ", "")" class="bp-tel-link">
                                    @p.Tel
                                </a>
                            </td>

                            <!-- Email -->
                            <td>
                                <a href="mailto:@p.Email" class="bp-email-link" title="@p.Email">
                                    @p.Email
                                </a>
                            </td>

                            <!-- Órdenes -->
                            <td class="text-center">
                                <span class="bp-orden-badge">@p.Ordenes</span>
                            </td>

                            <!-- Total -->
                            <td class="text-end bp-monto">$@p.MontoTotal.ToString("N0")</td>

                            <!-- Acciones -->
                            <td class="text-end">
                                <div class="bp-actions">
                                    <button class="bp-action-btn"
                                            title="Editar"
                                            onclick="abrirEditar(@p.Id, '@p.Nombre.Replace("'", "\\'")', '@p.RUT', '@p.Tel', '@p.Email')">
                                        ✏
                                    </button>
                                    <a href="#" class="bp-link">Ver →</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <p id="bpEmpty" class="bp-empty d-none">No se encontraron proveedores.</p>
        </div>
        <p class="bp-count">Mostrando <span id="bpCount">@proveedores.Length</span> de @proveedores.Length proveedores</p>
    </section>

</div>

<!-- Modal: Nuevo proveedor -->
<div class="modal fade" id="modalNuevoProveedor" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content bp-modal">
            <div class="modal-header bp-modal-header">
                <div>
                    <span class="bp-eyebrow" style="color:rgba(255,255,255,.65)">Alta de proveedor</span>
                    <h5 class="modal-title bp-title">Nuevo proveedor</h5>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body bp-modal-body">
                <!-- TODO: conectar a OnPostCrearProveedor cuando esté el HttpClient hacia la API -->
                <div class="row g-3">
                    <div class="col-12">
                        <label class="bp-label">Nombre o razón social</label>
                        <input type="text" class="bp-input w-100" placeholder="Ej: Materiales del Norte S.A.">
                    </div>
                    <div class="col-md-6">
                        <label class="bp-label">RUT</label>
                        <input type="text" class="bp-input w-100" placeholder="Ej: 21-123456-0001">
                    </div>
                    <div class="col-md-6">
                        <label class="bp-label">Teléfono</label>
                        <input type="text" class="bp-input w-100" placeholder="Ej: 099 000 111">
                    </div>
                    <div class="col-12">
                        <label class="bp-label">Email</label>
                        <input type="email" class="bp-input w-100" placeholder="Ej: ventas@proveedor.com.uy">
                    </div>
                </div>
            </div>
            <div class="modal-footer bp-modal-footer">
                <button type="button" class="bp-btn-ghost" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="bp-btn-primary">Guardar proveedor</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Editar proveedor -->
<div class="modal fade" id="modalEditarProveedor" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content bp-modal">
            <div class="modal-header bp-modal-header">
                <div>
                    <span class="bp-eyebrow" style="color:rgba(255,255,255,.65)">Edición de proveedor</span>
                    <h5 class="modal-title bp-title">Editar proveedor</h5>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body bp-modal-body">
                <!-- TODO: conectar a OnPostEditarProveedor cuando esté el HttpClient hacia la API -->
                <div class="row g-3">
                    <div class="col-12">
                        <label class="bp-label">Nombre o razón social</label>
                        <input type="text" id="editNombre" class="bp-input w-100">
                    </div>
                    <div class="col-md-6">
                        <label class="bp-label">RUT</label>
                        <input type="text" id="editRUT" class="bp-input w-100">
                    </div>
                    <div class="col-md-6">
                        <label class="bp-label">Teléfono</label>
                        <input type="text" id="editTel" class="bp-input w-100">
                    </div>
                    <div class="col-12">
                        <label class="bp-label">Email</label>
                        <input type="email" id="editEmail" class="bp-input w-100">
                    </div>
                </div>
            </div>
            <div class="modal-footer bp-modal-footer">
                <button type="button" class="bp-btn-ghost" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="bp-btn-primary">Guardar cambios</button>
            </div>
        </div>
    </div>
</div>

<style>
    .admin-dashboard {
        --bp-blueprint: #1B3A5C;
        --bp-blueprint-light: #2D5C8C;
        --bp-concrete: #F1EFEA;
        --bp-steel: #5B6670;
        --bp-safety: #F2A900;
        --bp-ink: #181B1F;
        --bp-line: #D8D3C8;
        font-family: 'Inter', sans-serif;
        color: var(--bp-ink);
    }

        .admin-dashboard .bp-eyebrow {
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.72rem;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            color: var(--bp-steel);
        }

    .bp-title {
        font-family: 'Barlow Condensed', sans-serif;
        font-weight: 600;
        letter-spacing: 0.01em;
        margin: 0.15rem 0;
    }

    .bp-title-dark {
        font-size: 2rem;
        color: var(--bp-ink);
    }

    .bp-section {
        margin-bottom: 2rem;
    }

    .bp-mono {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.82rem;
    }

    .bp-steel {
        color: var(--bp-steel);
    }

    .bp-strong {
        font-weight: 600;
    }

    /* Botones */
    .bp-btn-primary {
        font-family: 'Inter', sans-serif;
        font-weight: 600;
        font-size: 0.88rem;
        background: var(--bp-safety);
        color: var(--bp-ink);
        border: none;
        border-radius: 6px;
        padding: 0.55rem 1.1rem;
        transition: background .2s;
    }

        .bp-btn-primary:hover {
            background: #d99500;
        }

    .bp-btn-ghost {
        font-family: 'Inter', sans-serif;
        font-weight: 500;
        font-size: 0.88rem;
        background: transparent;
        color: var(--bp-steel);
        border: 1px solid var(--bp-line);
        border-radius: 6px;
        padding: 0.55rem 1.1rem;
    }

        .bp-btn-ghost:hover {
            border-color: var(--bp-steel);
            color: var(--bp-ink);
        }

    /* Stat cards */
    .bp-stat-card {
        background: #fff;
        border: 1px solid var(--bp-line);
        border-radius: 8px;
        padding: 1rem 1.1rem;
        height: 100%;
        display: flex;
        flex-direction: column;
        gap: 0.15rem;
    }

    .bp-stat-card--accent {
        border-left: 3px solid var(--bp-safety);
    }

    .bp-stat-label {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.68rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--bp-steel);
    }

    .bp-stat-num {
        font-family: 'Barlow Condensed', sans-serif;
        font-size: 2rem;
        font-weight: 600;
        color: var(--bp-ink);
        line-height: 1.1;
    }

    .bp-stat-num--amber {
        color: var(--bp-safety);
    }

    .bp-stat-num-sm {
        font-family: 'Barlow Condensed', sans-serif;
        font-size: 1.05rem;
        font-weight: 600;
        color: var(--bp-blueprint);
        line-height: 1.2;
    }

    .bp-stat-sub {
        font-size: 0.75rem;
        color: var(--bp-steel);
    }

    /* Filtro */
    .bp-filterbar {
        display: flex;
        gap: 0.75rem;
        flex-wrap: wrap;
    }

    .bp-input, .bp-select {
        font-family: 'Inter', sans-serif;
        font-size: 0.88rem;
        border: 1px solid var(--bp-line);
        border-radius: 6px;
        padding: 0.5rem 0.8rem;
        background: #fff;
        color: var(--bp-ink);
    }

        .bp-input:focus, .bp-select:focus {
            outline: none;
            border-color: var(--bp-blueprint-light);
            box-shadow: 0 0 0 3px rgba(45,92,140,0.12);
        }

    #bpSearch {
        min-width: 280px;
        flex: 1;
    }

    /* Tabla */
    .bp-table-wrap {
        background: #fff;
        border: 1px solid var(--bp-line);
        border-radius: 8px;
        overflow: hidden;
    }

    .bp-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.88rem;
    }

        .bp-table thead th {
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.68rem;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            color: var(--bp-steel);
            text-align: left;
            padding: 0.75rem 1rem;
            background: var(--bp-concrete);
            border-bottom: 1px solid var(--bp-line);
        }

        .bp-table tbody td {
            padding: 0.75rem 1rem;
            border-bottom: 1px solid var(--bp-line);
            vertical-align: middle;
        }

        .bp-table tbody tr:hover {
            background: #fafaf8;
        }

        .bp-table tbody tr:last-child td {
            border-bottom: none;
        }

    .bp-empty {
        text-align: center;
        padding: 2rem;
        color: var(--bp-steel);
        margin: 0;
    }

    .bp-count {
        font-size: 0.8rem;
        color: var(--bp-steel);
        margin-top: 0.6rem;
    }

    /* Nombre + barra proporción */
    .bp-prov-nombre {
        font-weight: 600;
        font-size: 0.92rem;
        margin-bottom: 0.3rem;
    }

    .bp-prop-wrap {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .bp-prop-bar {
        width: 80px;
        height: 5px;
        background: var(--bp-concrete);
        border-radius: 3px;
        overflow: hidden;
        flex-shrink: 0;
    }

    .bp-prop-fill {
        height: 100%;
        background: var(--bp-blueprint-light);
    }

    /* Links de contacto */
    .bp-tel-link, .bp-email-link {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.8rem;
        color: var(--bp-blueprint);
        text-decoration: none;
        transition: color .15s;
    }

        .bp-tel-link:hover, .bp-email-link:hover {
            color: var(--bp-safety);
        }

    .bp-email-link {
        display: inline-block;
        max-width: 190px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        vertical-align: middle;
    }

    /* Badge órdenes */
    .bp-orden-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 28px;
        height: 28px;
        border-radius: 50%;
        background: var(--bp-concrete);
        border: 1px solid var(--bp-line);
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.82rem;
        font-weight: 600;
        color: var(--bp-blueprint);
    }

    /* Monto */
    .bp-monto {
        font-family: 'Barlow Condensed', sans-serif;
        font-weight: 700;
        font-size: 1rem;
        color: var(--bp-ink);
    }

    /* Acciones */
    .bp-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 0.6rem;
    }

    .bp-action-btn {
        background: none;
        border: 1px solid var(--bp-line);
        border-radius: 5px;
        padding: 0.2rem 0.45rem;
        font-size: 0.82rem;
        cursor: pointer;
        color: var(--bp-steel);
        transition: border-color .15s, color .15s;
    }

        .bp-action-btn:hover {
            border-color: var(--bp-blueprint);
            color: var(--bp-blueprint);
        }

    .bp-link {
        font-size: 0.85rem;
        color: var(--bp-blueprint);
        text-decoration: none;
        font-weight: 500;
        white-space: nowrap;
    }

        .bp-link:hover {
            color: var(--bp-safety);
        }

    /* Modal */
    .bp-modal {
        border: none;
        border-radius: 10px;
        overflow: hidden;
    }

    .bp-modal-header {
        background: var(--bp-blueprint);
        border: none;
        padding: 1.25rem 1.5rem;
    }

        .bp-modal-header .bp-title {
            color: #fff;
            font-size: 1.4rem;
        }

    .bp-modal-body {
        padding: 1.5rem;
        background: var(--bp-concrete);
    }

    .bp-modal-footer {
        border-top: 1px solid var(--bp-line);
        padding: 1rem 1.5rem;
    }

    .bp-label {
        display: block;
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.68rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--bp-steel);
        margin-bottom: 0.3rem;
    }

    @@media (max-width: 768px) {
        .bp-table thead th:nth-child(7),
        .bp-table tbody td:nth-child(7) {
            display: none;
        }
    }

    @@media (max-width: 576px) {
        .bp-table thead th:nth-child(5),
        .bp-table tbody td:nth-child(5) {
            display: none;
        }
    }
</style>

<script>
    (function () {
        // Búsqueda
        const search = document.getElementById('bpSearch');
        const rows   = Array.from(document.querySelectorAll('#bpTbody tr'));
        const empty  = document.getElementById('bpEmpty');
        const count  = document.getElementById('bpCount');

        search.addEventListener('input', () => {
            const txt = search.value.trim().toLowerCase();
            let vis = 0;
            rows.forEach(row => {
                const ok = !txt || row.dataset.search.includes(txt);
                row.classList.toggle('d-none', !ok);
                if (ok) vis++;
            });
            count.textContent = vis;
            empty.classList.toggle('d-none', vis > 0);
        });

        // Abrir modal de edición con datos pre-cargados
        window.abrirEditar = function(id, nombre, rut, tel, email) {
            document.getElementById('editNombre').value = nombre;
            document.getElementById('editRUT').value    = rut;
            document.getElementById('editTel').value    = tel;
            document.getElementById('editEmail').value  = email;
            new bootstrap.Modal(document.getElementById('modalEditarProveedor')).show();
        };
    })();
</script>