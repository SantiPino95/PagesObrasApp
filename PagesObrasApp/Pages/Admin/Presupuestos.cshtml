        background: var(--bp-danger);
    }

    /* Tabla de detalle en modal */
    .bp-table--detalle thead th {
        background: var(--bp-blueprint);
        color: rgba(255,255,255,.8);
    }

    .bp-detalle-header {
        display: flex;
        flex-wrap: wrap;
        gap: 1.5rem;
        padding: 1rem 1.25rem;
        background: var(--bp-concrete);
        border-bottom: 1px solid var(--bp-line);
        font-size: .85rem;
    }

    .bp-dh-item {
        display: flex;
        flex-direction: column;
        gap: .15rem;
    }

    .bp-dh-label {
        font-family: 'JetBrains Mono', monospace;
        font-size: .62rem;
        letter-spacing: .1em;
        text-transform: uppercase;
        color: var(--bp-steel);
    }

    .bp-dh-val {
        font-weight: 600;
    }

    /* Fila de total */
    .bp-total-row td {
        padding: .75rem 1rem;
        background: var(--bp-concrete);
        border-top: 2px solid var(--bp-line);
    }

    .bp-total-label {
        font-family: 'JetBrains Mono', monospace;
        font-size: .68rem;
        letter-spacing: .08em;
        text-transform: uppercase;
        color: var(--bp-steel);
    }

    .bp-total-num {
        font-family: 'Barlow Condensed', sans-serif;
        font-weight: 700;
        font-size: 1.3rem;
        color: var(--bp-blueprint);
    }

    /* Tabla de formulario (nuevo presupuesto) */
    .bp-items-wrap {
        background: #fff;
        border: 1px solid var(--bp-line);
        border-radius: 8px;
        overflow: hidden;
        margin-bottom: .5rem;
    }

    .bp-table--form thead th {
        background: var(--bp-blueprint);
        color: rgba(255,255,255,.8);
    }

    .col-num {
        width: 140px;
    }

    .col-del {
        width: 40px;
    }

    .bp-form-input {
        font-family: 'Inter', sans-serif;
        font-size: .85rem;
        border: 1px solid transparent;
        border-radius: 4px;
        padding: .35rem .5rem;
        width: 100%;
        background: transparent;
        transition: border-color .15s, background .15s;
    }

        .bp-form-input:focus {
            outline: none;
            border-color: var(--bp-blueprint-light);
            background: #fff;
            box-shadow: 0 0 0 2px rgba(45,92,140,.1);
        }

        .bp-form-input.text-end {
            text-align: right;
        }

    .bp-del-btn {
        background: none;
        border: none;
        cursor: pointer;
        color: var(--bp-steel);
        font-size: 1.1rem;
        line-height: 1;
        padding: .2rem .4rem;
        border-radius: 4px;
        transition: color .15s, background .15s;
    }

        .bp-del-btn:hover {
            color: var(--bp-danger);
            background: #fbf0ef;
        }

    .bp-subtotal-cell {
        font-family: 'JetBrains Mono', monospace;
        font-size: .82rem;
        text-align: right;
        color: var(--bp-steel);
        padding: .5rem;
    }

    .bp-items-hint {
        font-size: .75rem;
        color: var(--bp-steel);
        margin: 0;
    }

    /* Modal */
    .bp-modal {
        border: none;
        border-radius: 10px;
        overflow: hidden;
    }

    .bp-modal-header {
        background: var(--bp-blueprint);
        border: none;
        padding: 1.25rem 1.5rem;
    }

        .bp-modal-header .bp-title {
            color: #fff;
            font-size: 1.4rem;
        }

    .bp-modal-body {
        padding: 1.5rem;
        background: var(--bp-concrete);
    }

    .bp-modal-footer {
        border-top: 1px solid var(--bp-line);
        padding: 1rem 1.5rem;
    }

    .bp-label {
        display: block;
        font-family: 'JetBrains Mono', monospace;
        font-size: .68rem;
        letter-spacing: .08em;
