</style>

<script>
    // Datos embebidos para el modal de detalle
    const dataPres = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                vista.Select(p => new
                {
                        id = p.Id,
                        numero = $"PRES-{p.Id:D4}",
                        obra = p.Obra?.Nombre,
                        codigo = p.Obra?.Codigo,
                        cliente = p.Obra?.Cliente,
                        fecha = p.FechaEmision.ToString("dd/MM/yyyy"),
                        total = p.MontoTotal,
                        estado = p.Estado,
                        detalles = p.Detalles.Select(d => new
                        {
                                d.Id,
                                desc = d.Desc,
                                cant = d.Cant,
                                pu = d.PU,
                                sub = d.Sub
                        })
                })
        ));

    (function () {
        // ── Filtros
        const search     = document.getElementById('bpSearch');
        const filtroEst  = document.getElementById('bpFiltroEstado');
        const filtroObra = document.getElementById('bpFiltroObra');
        const rows       = Array.from(document.querySelectorAll('#bpTbody tr'));
        const empty      = document.getElementById('bpEmpty');
        const count      = document.getElementById('bpCount');

        function fmt(n) { return '$' + Math.round(n).toLocaleString('es-UY'); }

        function aplicarFiltros() {
            const txt  = search.value.trim().toLowerCase();
            const est  = filtroEst.value;
            const obra = filtroObra.value;
            let vis = 0;
            rows.forEach(r => {
                const ok = (!txt  || r.dataset.search.includes(txt))
                        && (!est  || r.dataset.estado === est)
                        && (!obra || r.dataset.obra === obra);
                r.classList.toggle('d-none', !ok);
                if (ok) vis++;
            });
            count.textContent = vis;
            empty.classList.toggle('d-none', vis > 0);
        }
        search.addEventListener('input', aplicarFiltros);
        filtroEst.addEventListener('change', aplicarFiltros);
        filtroObra.addEventListener('change', aplicarFiltros);

        // ── Modal de detalle
        window.verDetalle = function(id) {
            const p = dataPres.find(x => x.id === id);
            if (!p) return;

            document.getElementById('detalleEyebrow').textContent = p.numero;
            document.getElementById('detalleTitulo').textContent  = p.obra;

            // Cabecera info
            const estadoCls = { Pendiente: 'bp-badge--pendiente', Aprobado: 'bp-badge--aprobado', Rechazado: 'bp-badge--rechazado' };
            document.getElementById('detalleCabecera').innerHTML = `
                <div class="bp-dh-item"><span class="bp-dh-label">Obra</span><span class="bp-dh-val">${p.obra}</span></div>
                <div class="bp-dh-item"><span class="bp-dh-label">Código</span><span class="bp-dh-val bp-mono">${p.codigo}</span></div>
                <div class="bp-dh-item"><span class="bp-dh-label">Cliente</span><span class="bp-dh-val">${p.cliente}</span></div>
                <div class="bp-dh-item"><span class="bp-dh-label">Fecha emisión</span><span class="bp-dh-val bp-mono">${p.fecha}</span></div>
                <div class="bp-dh-item"><span class="bp-dh-label">Estado</span><span class="bp-badge ${estadoCls[p.estado] || ''}">${p.estado}</span></div>
            `;

            // Ítems
            document.getElementById('detalleTbody').innerHTML = p.detalles.map((d, i) => `
                <tr>
                    <td class="bp-mono bp-steel">${i + 1}</td>
                    <td>${d.desc}</td>
                    <td class="text-end bp-mono">${d.cant.toLocaleString('es-UY')}</td>
                    <td class="text-end bp-mono">${fmt(d.pu)}</td>
                    <td class="text-end bp-mono" style="font-weight:600">${fmt(d.sub)}</td>
                </tr>
            `).join('');

            document.getElementById('detalleTotal').textContent = fmt(p.total);

            // Footer con acciones según estado
            const footer = document.getElementById('detalleFooter');
            if (p.estado === 'Pendiente') {
                footer.innerHTML = `
                    <button class="bp-btn-ghost" data-bs-dismiss="modal">Cerrar</button>
                    <button class="bp-btn-primary" style="background:#B23A2E;color:#fff"
                            onclick="cambiarEstado(${p.id},'Rechazar');bootstrap.Modal.getInstance(document.getElementById('modalDetalle')).hide()">
                        ✗ Rechazar
                    </button>
                    <button class="bp-btn-primary"
                            onclick="cambiarEstado(${p.id},'Aprobar');bootstrap.Modal.getInstance(document.getElementById('modalDetalle')).hide()">
                        ✓ Aprobar
                    </button>`;
            } else {
                footer.innerHTML = `<button class="bp-btn-ghost" data-bs-dismiss="modal">Cerrar</button>`;
            }

            new bootstrap.Modal(document.getElementById('modalDetalle')).show();
        };

        // ── Modal Aprobar / Rechazar
        window.cambiarEstado = function(id, accion) {
            const p = dataPres.find(x => x.id === id);
            if (!p) return;

            const esAprobar = accion === 'Aprobar';
            const header  = document.getElementById('confirmarHeader');
            const titulo  = document.getElementById('confirmarTitulo');
            const msg     = document.getElementById('confirmarMsg');
            const btn     = document.getElementById('confirmarBtn');

            header.style.background = esAprobar ? '#2E7D52' : '#B23A2E';
            titulo.textContent       = esAprobar ? 'Aprobar presupuesto' : 'Rechazar presupuesto';
            msg.innerHTML = `¿Confirmás ${accion.toLowerCase()} el presupuesto <strong>PRES-${String(id).padStart(4,'0')}</strong>
                             de la obra <strong>${p.obra}</strong>?
                             <br><span style="font-family:JetBrains Mono,monospace;font-size:.82rem;color:#5B6670">
                             Monto: $${Math.round(p.total).toLocaleString('es-UY')}</span>`;
            btn.style.background  = esAprobar ? '#2E7D52' : '#B23A2E';
            btn.textContent       = esAprobar ? '✓ Aprobar' : '✗ Rechazar';

            // TODO: conectar a OnPostCambiarEstado(id, accion) via fetch hacia la API
            btn.onclick = () => {
                bootstrap.Modal.getInstance(document.getElementById('modalConfirmar')).hide();
                // Actualización optimista visual
                const row = document.querySelector(`#bpTbody tr[data-obra]`);
                // (se refrescará del servidor cuando esté conectado)
            };

            new bootstrap.Modal(document.getElementById('modalConfirmar')).show();
        };

        // ── Tabla dinámica de ítems (nuevo presupuesto)
        let itemCount = 0;

        function agregarFila() {
            itemCount++;
            const tbody = document.getElementById('itemsTbody');
            const tr = document.createElement('tr');
            tr.id = `item-${itemCount}`;
            tr.innerHTML = `
                <td><input type="text" class="bp-form-input" placeholder="Descripción del ítem..."></td>
                <td><input type="number" class="bp-form-input text-end bp-cant" min="0.01" step="0.01" placeholder="0"></td>
                <td><input type="number" class="bp-form-input text-end bp-pu" min="0" step="0.01" placeholder="0"></td>
                <td class="bp-subtotal-cell" id="sub-${itemCount}">$0</td>
                <td><button type="button" class="bp-del-btn" onclick="eliminarFila(${itemCount})">×</button></td>
            `;
            tbody.appendChild(tr);

            // Calcular subtotal al cambiar cant o pu
            tr.querySelectorAll('.bp-cant, .bp-pu').forEach(inp => {
                inp.addEventListener('input', () => calcularFila(itemCount));
            });
            actualizarTotal();
        }

        window.eliminarFila = function(id) {
            const tr = document.getElementById(`item-${id}`);
            if (tr) { tr.remove(); actualizarTotal(); }
        };

        function calcularFila(id) {
            const tr  = document.getElementById(`item-${id}`);
            const cant = parseFloat(tr.querySelector('.bp-cant').value) || 0;
            const pu   = parseFloat(tr.querySelector('.bp-pu').value)   || 0;
            const sub  = cant * pu;
            document.getElementById(`sub-${id}`).textContent = fmt(sub);
            actualizarTotal();
        }

        function actualizarTotal() {
            let total = 0;
            document.querySelectorAll('[id^="sub-"]').forEach(cell => {
                const v = cell.textContent.replace(/[$.,\s]/g, '');
                total += parseInt(v) || 0;
            });
            document.getElementById('nuevoTotal').textContent = fmt(total);
        }

        document.getElementById('btnAgregarItem').addEventListener('click', agregarFila);

        // Arrancar con una fila vacía al abrir el modal
        document.getElementById('modalNuevo').addEventListener('show.bs.modal', () => {
            document.getElementById('itemsTbody').innerHTML = '';
            itemCount = 0;
            document.getElementById('nuevoTotal').textContent = '$0';
            agregarFila();
        });

    })();
</script>