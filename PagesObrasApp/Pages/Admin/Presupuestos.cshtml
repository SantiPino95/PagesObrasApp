@page
@model PagesObrasApp.Pages.Admin.PresupuestosModel
@using System.Linq
@using System.Globalization
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Presupuestos";

    // --- Datos de muestra (mock) — reemplazar por Model.* cuando conectemos la API vía DTOs ---
    var cultura = new CultureInfo("es-UY");

    var obras = new[]
    {
        new { Id=1, Codigo="OB-2026-014", Nombre="Edificio Las Acacias",     Cliente="Inmobiliaria Sur S.A."  },
        new { Id=2, Codigo="OB-2026-002", Nombre="Torre Mirador",            Cliente="Inmobiliaria Sur S.A."  },
        new { Id=3, Codigo="OB-2026-011", Nombre="Galpón Industrial Ruta 5", Cliente="Logística del Este"     },
        new { Id=4, Codigo="OB-2026-019", Nombre="Casa Familia Pérez",       Cliente="Marcos Pérez"           },
        new { Id=5, Codigo="OB-2025-087", Nombre="Reforma Local Comercial",  Cliente="Comercial Andina"       },
    };

    var presupuestos = new[]
    {
        new { Id=1, IdObra=1, FechaEmision=new DateTime(2026,2,5),  MontoTotal=485000m, Estado="Aprobado"  },
        new { Id=2, IdObra=1, FechaEmision=new DateTime(2026,5,18), MontoTotal=92000m,  Estado="Pendiente" },
        new { Id=3, IdObra=2, FechaEmision=new DateTime(2026,4,30), MontoTotal=320000m, Estado="Aprobado"  },
        new { Id=4, IdObra=3, FechaEmision=new DateTime(2026,4,20), MontoTotal=780000m, Estado="Aprobado"  },
        new { Id=5, IdObra=3, FechaEmision=new DateTime(2026,6,10), MontoTotal=45000m,  Estado="Pendiente" },
        new { Id=6, IdObra=4, FechaEmision=new DateTime(2026,5,28), MontoTotal=135000m, Estado="Pendiente" },
        new { Id=7, IdObra=5, FechaEmision=new DateTime(2026,1,8),  MontoTotal=98500m,  Estado="Rechazado" },
        new { Id=8, IdObra=5, FechaEmision=new DateTime(2026,2,14), MontoTotal=112000m, Estado="Aprobado"  },
    };

    // Detalles por presupuesto
    var detalles = new[]
    {
        new { Id=1,  IdPres=1, Desc="Estructura de hormigón armado",    Cant=1m,   PU=180000m, Sub=180000m },
        new { Id=2,  IdPres=1, Desc="Mampostería y revoques",           Cant=1m,   PU=95000m,  Sub=95000m  },
        new { Id=3,  IdPres=1, Desc="Instalación eléctrica completa",   Cant=1m,   PU=75000m,  Sub=75000m  },
        new { Id=4,  IdPres=1, Desc="Instalación sanitaria",            Cant=1m,   PU=55000m,  Sub=55000m  },
        new { Id=5,  IdPres=1, Desc="Carpintería y aberturas",          Cant=1m,   PU=48000m,  Sub=48000m  },
        new { Id=6,  IdPres=1, Desc="Pintura general",                  Cant=850m, PU=38m,     Sub=32300m  },
        new { Id=7,  IdPres=2, Desc="Ampliación planta baja",           Cant=1m,   PU=62000m,  Sub=62000m  },
        new { Id=8,  IdPres=2, Desc="Materiales adicionales",           Cant=1m,   PU=30000m,  Sub=30000m  },
        new { Id=9,  IdPres=3, Desc="Estructura torre — pisos 1 a 5",   Cant=1m,   PU=200000m, Sub=200000m },
        new { Id=10, IdPres=3, Desc="Fachada y revestimiento",          Cant=600m, PU=120m,    Sub=72000m  },
        new { Id=11, IdPres=3, Desc="Instalaciones generales",          Cant=1m,   PU=48000m,  Sub=48000m  },
        new { Id=12, IdPres=4, Desc="Estructura metálica galpón",       Cant=1m,   PU=450000m, Sub=450000m },
        new { Id=13, IdPres=4, Desc="Cubierta de chapa galvanizada",    Cant=800m, PU=185m,    Sub=148000m },
        new { Id=14, IdPres=4, Desc="Portón y cerramientos",            Cant=4m,   PU=18000m,  Sub=72000m  },
        new { Id=15, IdPres=4, Desc="Instalación eléctrica trifásica",  Cant=1m,   PU=110000m, Sub=110000m },
        new { Id=16, IdPres=5, Desc="Refuerzo de cimientos adicional",  Cant=1m,   PU=45000m,  Sub=45000m  },
        new { Id=17, IdPres=6, Desc="Construcción vivienda tipo A",     Cant=1m,   PU=95000m,  Sub=95000m  },
        new { Id=18, IdPres=6, Desc="Cerco perimetral",                 Cant=80m,  PU=350m,    Sub=28000m  },
        new { Id=19, IdPres=6, Desc="Garage techado",                   Cant=1m,   PU=12000m,  Sub=12000m  },
        new { Id=20, IdPres=7, Desc="Reforma interior completa",        Cant=120m, PU=450m,    Sub=54000m  },
        new { Id=21, IdPres=7, Desc="Piso flotante y cerámicos",        Cant=120m, PU=370m,    Sub=44400m  },
        new { Id=22, IdPres=8, Desc="Reforma interior v2 (ajustada)",   Cant=120m, PU=500m,    Sub=60000m  },
        new { Id=23, IdPres=8, Desc="Piso cerámico premium",            Cant=120m, PU=420m,    Sub=50400m, },
        new { Id=24, IdPres=8, Desc="Pintura especializada",            Cant=1m,   PU=1600m,   Sub=1600m   },
    };

    var vista = presupuestos.Select(p => new
    {
        p.Id,
        p.IdObra,
        p.FechaEmision,
        p.MontoTotal,
        p.Estado,
        Obra = obras.FirstOrDefault(o => o.Id == p.IdObra),
        Detalles = detalles.Where(d => d.IdPres == p.Id).ToList(),
    }).OrderByDescending(p => p.FechaEmision).ToList();

    var totalPresupuestos = presupuestos.Length;
    var pendientes = presupuestos.Count(p => p.Estado == "Pendiente");
    var aprobados = presupuestos.Count(p => p.Estado == "Aprobado");
    var rechazados = presupuestos.Count(p => p.Estado == "Rechazado");
    var montoAprobado = presupuestos.Where(p => p.Estado == "Aprobado").Sum(p => p.MontoTotal);
    var montoPendiente = presupuestos.Where(p => p.Estado == "Pendiente").Sum(p => p.MontoTotal);
}

<div class="admin-dashboard">

    <!-- HEADER -->
    <section class="bp-section">
        <div class="d-flex justify-content-between align-items-end flex-wrap gap-2">
            <div>
                <span class="bp-eyebrow">Gestión comercial</span>
                <h1 class="bp-title bp-title-dark">
                    Presupuestos
                    @if (pendientes > 0)
                    {
                        <span class="bp-header-badge">@pendientes pendiente@(pendientes > 1 ? "s" : "")</span>
                    }
                </h1>
            </div>
            <button type="button" class="bp-btn-primary" data-bs-toggle="modal" data-bs-target="#modalNuevo">
                + Nuevo presupuesto
            </button>
        </div>
    </section>

    <!-- STAT CARDS -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="bp-stat-card">
                <span class="bp-stat-label">Total</span>
                <span class="bp-stat-num">@totalPresupuestos</span>
                <span class="bp-stat-sub">emitidos</span>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="bp-stat-card bp-stat-card--pend">
                <span class="bp-stat-label">Pendientes</span>
                <span class="bp-stat-num bp-stat-num--amber">@pendientes</span>
                <span class="bp-stat-sub">$@montoPendiente.ToString("N0") en espera</span>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="bp-stat-card bp-stat-card--ok">
                <span class="bp-stat-label">Aprobados</span>
                <span class="bp-stat-num bp-stat-num--ok">@aprobados</span>
                <span class="bp-stat-sub">$@montoAprobado.ToString("N0") confirmados</span>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="bp-stat-card">
                <span class="bp-stat-label">Rechazados</span>
                <span class="bp-stat-num bp-stat-num--steel">@rechazados</span>
                <span class="bp-stat-sub">revisar y re-emitir</span>
            </div>
        </div>
    </div>

    <!-- FILTROS -->
    <div class="bp-filterbar mb-3">
        <input type="text" id="bpSearch" class="bp-input" placeholder="Buscar por obra o cliente...">
        <select id="bpFiltroEstado" class="bp-select">
            <option value="">Todos los estados</option>
            <option value="pendiente">Pendiente</option>
            <option value="aprobado">Aprobado</option>
            <option value="rechazado">Rechazado</option>
        </select>
        <select id="bpFiltroObra" class="bp-select">
            <option value="">Todas las obras</option>
            @foreach (var o in obras)
            {
                <option value="@o.Id">@o.Nombre</option>
            }
        </select>
    </div>

    <!-- TABLA -->
    <div class="bp-table-wrap">
        <table class="bp-table">
            <thead>
                <tr>
                    <th>N° Presupuesto</th>
                    <th>Obra</th>
                    <th>Cliente</th>
                    <th>Emisión</th>
                    <th>Ítems</th>
                    <th class="text-end">Monto total</th>
                    <th class="text-center">Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody id="bpTbody">
                @foreach (var p in vista)
                {
                    var estadoCls = p.Estado.ToLower();
                    <tr data-estado="@estadoCls"
                        data-obra="@p.IdObra"
                        data-search="@($"{p.Obra?.Nombre.ToLower()} {p.Obra?.Cliente.ToLower()} {p.Obra?.Codigo.ToLower()}")">

                        <!-- N° -->
                        <td class="bp-mono">PRES-@p.Id.ToString("D4")</td>

                        <!-- Obra -->
                        <td>
                            <div class="bp-strong">@p.Obra?.Nombre</div>
                            <div class="bp-mono bp-steel">@p.Obra?.Codigo</div>
                        </td>

                        <!-- Cliente -->
                        <td class="bp-cliente">@p.Obra?.Cliente</td>

                        <!-- Fecha -->
                        <td class="bp-mono">@p.FechaEmision.ToString("dd/MM/yyyy")</td>

                        <!-- Items -->
                        <td class="text-center">
                            <span class="bp-items-count">@p.Detalles.Count</span>
                        </td>

                        <!-- Monto -->
                        <td class="text-end bp-monto">$@p.MontoTotal.ToString("N0")</td>

                        <!-- Estado -->
                        <td class="text-center">
                            <span class="bp-badge bp-badge--@estadoCls">@p.Estado</span>
                        </td>

                        <!-- Acciones -->
                        <td class="text-end">
                            <div class="bp-actions">
                                <button class="bp-action-btn bp-action-btn--detail"
                                        onclick="verDetalle(@p.Id)"
                                        title="Ver detalle">
                                    Ver
                                </button>
                                @if (p.Estado == "Pendiente")
                                {
                                    <button class="bp-action-btn bp-action-btn--ok"
                                            onclick="cambiarEstado(@p.Id, 'Aprobar')"
                                            title="Aprobar">
                                        ✓
                                    </button>
                                    <button class="bp-action-btn bp-action-btn--danger"
                                            onclick="cambiarEstado(@p.Id, 'Rechazar')"
                                            title="Rechazar">
                                        ✗
                                    </button>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <p id="bpEmpty" class="bp-empty d-none">No hay presupuestos que coincidan.</p>
    </div>
    <p class="bp-count mt-2">Mostrando <span id="bpCount">@vista.Count</span> de @vista.Count presupuestos</p>

</div>

<!-- ═══════════════════════════════════════════
     MODAL: Ver detalle del presupuesto
═══════════════════════════════════════════ -->
<div class="modal fade" id="modalDetalle" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content bp-modal">
            <div class="modal-header bp-modal-header">
                <div>
                    <span class="bp-eyebrow" style="color:rgba(255,255,255,.65)" id="detalleEyebrow">Detalle</span>
                    <h5 class="modal-title bp-title" id="detalleTitulo">Presupuesto</h5>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body bp-modal-body p-0">

                <!-- Info cabecera -->
                <div class="bp-detalle-header" id="detalleCabecera"></div>

                <!-- Tabla de ítems -->
                <div class="p-0">
                    <table class="bp-table bp-table--detalle">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Descripción</th>
                                <th class="text-end">Cantidad</th>
                                <th class="text-end">Precio unitario</th>
                                <th class="text-end">Subtotal</th>
                            </tr>
                        </thead>
                        <tbody id="detalleTbody"></tbody>
                        <tfoot>
                            <tr class="bp-total-row">
                                <td colspan="4" class="bp-total-label">Total del presupuesto</td>
                                <td class="text-end bp-total-num" id="detalleTotal"></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>

            </div>
            <div class="modal-footer bp-modal-footer" id="detalleFooter"></div>
        </div>
    </div>
</div>

<!-- ═══════════════════════════════════════════
     MODAL: Aprobar / Rechazar
═══════════════════════════════════════════ -->
<div class="modal fade" id="modalConfirmar" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-sm">
        <div class="modal-content bp-modal">
            <div class="modal-header bp-modal-header" id="confirmarHeader">
                <h5 class="modal-title bp-title" id="confirmarTitulo"></h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body bp-modal-body">
                <p id="confirmarMsg" style="font-size:.9rem;margin:0;line-height:1.5"></p>
            </div>
            <div class="modal-footer bp-modal-footer">
                <button type="button" class="bp-btn-ghost" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="bp-btn-confirm" id="confirmarBtn">Confirmar</button>
            </div>
        </div>
    </div>
</div>

<!-- ═══════════════════════════════════════════
     MODAL: Nuevo presupuesto
═══════════════════════════════════════════ -->
<div class="modal fade" id="modalNuevo" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content bp-modal">
            <div class="modal-header bp-modal-header">
                <div>
                    <span class="bp-eyebrow" style="color:rgba(255,255,255,.65)">Alta de presupuesto</span>
                    <h5 class="modal-title bp-title">Nuevo presupuesto</h5>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body bp-modal-body">
                <!-- TODO: conectar a OnPostCrearPresupuesto cuando esté el HttpClient hacia la API -->
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label class="bp-label">Obra</label>
                        <select class="bp-select w-100">
                            <option value="">Seleccionar obra...</option>
                            @foreach (var o in obras)
                            {
                                <option value="@o.Id">@o.Nombre (@o.Codigo)</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="bp-label">Fecha de emisión</label>
                        <input type="date" class="bp-input w-100" value="@DateTime.Today.ToString("yyyy-MM-dd")">
                    </div>
                </div>

                <!-- Tabla de ítems dinámica -->
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="bp-eyebrow">Ítems del presupuesto</span>
                    <button type="button" class="bp-btn-add" id="btnAgregarItem">+ Agregar ítem</button>
                </div>

                <div class="bp-items-wrap">
                    <table class="bp-table bp-table--form" id="tablaItems">
                        <thead>
                            <tr>
                                <th>Descripción</th>
                                <th class="col-num">Cantidad</th>
                                <th class="col-num">Precio unitario</th>
                                <th class="col-num">Subtotal</th>
                                <th class="col-del"></th>
                            </tr>
                        </thead>
                        <tbody id="itemsTbody">
                            <!-- Las filas se agregan dinámicamente -->
                        </tbody>
                        <tfoot>
                            <tr class="bp-total-row">
                                <td colspan="3" class="bp-total-label">Total del presupuesto</td>
                                <td class="text-end bp-total-num" id="nuevoTotal">$0</td>
                                <td></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>

                <p class="bp-items-hint">El subtotal de cada ítem se calcula automáticamente. El total se actualiza al instante.</p>

            </div>
            <div class="modal-footer bp-modal-footer">
                <button type="button" class="bp-btn-ghost" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="bp-btn-primary" id="btnGuardarPres">Guardar presupuesto</button>
            </div>
        </div>
    </div>
</div>

<style>
    .admin-dashboard {
        --bp-blueprint: #1B3A5C;
        --bp-blueprint-light: #2D5C8C;
        --bp-concrete: #F1EFEA;
        --bp-steel: #5B6670;
        --bp-safety: #F2A900;
        --bp-ink: #181B1F;
        --bp-line: #D8D3C8;
        --bp-ok: #2E7D52;
        --bp-danger: #B23A2E;
        font-family: 'Inter', sans-serif;
        color: var(--bp-ink);
    }

        .admin-dashboard .bp-eyebrow {
            font-family: 'JetBrains Mono', monospace;
            font-size: .72rem;
            letter-spacing: .12em;
            text-transform: uppercase;
            color: var(--bp-steel);
        }

    .bp-title {
        font-family: 'Barlow Condensed', sans-serif;
        font-weight: 600;
        letter-spacing: .01em;
        margin: .15rem 0;
        display: flex;
        align-items: center;
        gap: .5rem;
        flex-wrap: wrap;
    }

    .bp-title-dark {
        font-size: 2rem;
        color: var(--bp-ink);
    }

    .bp-section {
        margin-bottom: 1.75rem;
    }

    .bp-mono {
        font-family: 'JetBrains Mono', monospace;
        font-size: .82rem;
    }

    .bp-steel {
        color: var(--bp-steel);
    }

    .bp-strong {
        font-weight: 600;
    }

    /* Header badge */
    .bp-header-badge {
        font-family: 'Inter', sans-serif;
        font-size: .75rem;
        font-weight: 700;
        background: var(--bp-safety);
        color: var(--bp-ink);
        padding: .15rem .65rem;
        border-radius: 100px;
    }

    /* Botones */
    .bp-btn-primary {
        font-family: 'Inter', sans-serif;
        font-weight: 600;
        font-size: .88rem;
        background: var(--bp-safety);
        color: var(--bp-ink);
        border: none;
        border-radius: 6px;
        padding: .55rem 1.1rem;
        cursor: pointer;
        transition: background .2s;
    }

        .bp-btn-primary:hover {
            background: #d99500;
        }

    .bp-btn-ghost {
        font-family: 'Inter', sans-serif;
        font-weight: 500;
        font-size: .88rem;
        background: transparent;
        color: var(--bp-steel);
        border: 1px solid var(--bp-line);
        border-radius: 6px;
        padding: .55rem 1.1rem;
        cursor: pointer;
    }

        .bp-btn-ghost:hover {
            border-color: var(--bp-steel);
            color: var(--bp-ink);
        }

    .bp-btn-add {
        font-family: 'Inter', sans-serif;
        font-weight: 600;
        font-size: .8rem;
        background: var(--bp-blueprint);
        color: #fff;
        border: none;
        border-radius: 5px;
        padding: .35rem .85rem;
        cursor: pointer;
        transition: background .15s;
    }

        .bp-btn-add:hover {
            background: var(--bp-blueprint-light);
        }

    .bp-btn-confirm {
        font-family: 'Inter', sans-serif;
        font-weight: 600;
        font-size: .88rem;
        border: none;
        border-radius: 6px;
        padding: .55rem 1.1rem;
        cursor: pointer;
        color: #fff;
    }

    /* Stat cards */
    .bp-stat-card {
        background: #fff;
        border: 1px solid var(--bp-line);
        border-radius: 8px;
        padding: 1rem 1.1rem;
        height: 100%;
        display: flex;
        flex-direction: column;
        gap: .15rem;
    }

    .bp-stat-card--pend {
        border-left: 3px solid var(--bp-safety);
    }

    .bp-stat-card--ok {
        border-left: 3px solid var(--bp-ok);
    }

    .bp-stat-label {
        font-family: 'JetBrains Mono', monospace;
        font-size: .68rem;
        letter-spacing: .08em;
        text-transform: uppercase;
        color: var(--bp-steel);
    }

    .bp-stat-num {
        font-family: 'Barlow Condensed', sans-serif;
        font-size: 2rem;
        font-weight: 600;
        color: var(--bp-ink);
        line-height: 1.1;
    }

    .bp-stat-num--amber {
        color: var(--bp-safety);
    }

    .bp-stat-num--ok {
        color: var(--bp-ok);
    }

    .bp-stat-num--steel {
        color: var(--bp-steel);
    }

    .bp-stat-sub {
        font-size: .75rem;
        color: var(--bp-steel);
    }

    /* Filtros */
    .bp-filterbar {
        display: flex;
        gap: .75rem;
        flex-wrap: wrap;
    }

    .bp-input, .bp-select {
        font-family: 'Inter', sans-serif;
        font-size: .88rem;
        border: 1px solid var(--bp-line);
        border-radius: 6px;
        padding: .5rem .8rem;
        background: #fff;
        color: var(--bp-ink);
    }

        .bp-input:focus, .bp-select:focus {
            outline: none;
            border-color: var(--bp-blueprint-light);
            box-shadow: 0 0 0 3px rgba(45,92,140,.12);
        }

    #bpSearch {
        flex: 1;
        min-width: 220px;
    }

    /* Tabla principal */
    .bp-table-wrap {
        background: #fff;
        border: 1px solid var(--bp-line);
        border-radius: 8px;
        overflow: hidden;
    }

    .bp-table {
        width: 100%;
        border-collapse: collapse;
        font-size: .88rem;
    }

        .bp-table thead th {
            font-family: 'JetBrains Mono', monospace;
            font-size: .68rem;
            letter-spacing: .08em;
            text-transform: uppercase;
            color: var(--bp-steel);
            text-align: left;
            padding: .75rem 1rem;
            background: var(--bp-concrete);
            border-bottom: 1px solid var(--bp-line);
        }

