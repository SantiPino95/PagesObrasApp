        margin-bottom: .3rem;
    }

    @@media (max-width: 768px) {
        .bp-filterbar {
            flex-direction: column;
        }

        .bp-table thead th:nth-child(4),
        .bp-table tbody td:nth-child(4),
        .bp-table thead th:nth-child(5),
        .bp-table tbody td:nth-child(5) {
            display: none;
        }
