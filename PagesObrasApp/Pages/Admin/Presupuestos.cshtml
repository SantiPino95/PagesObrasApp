    }

    .bp-action-btn--detail:hover {
        border-color: var(--bp-blueprint);
        color: var(--bp-blueprint);
    }

    .bp-action-btn--ok:hover {
        border-color: var(--bp-ok);
        color: #fff;
        background: var(--bp-ok);
    }

    .bp-action-btn--danger:hover {
        border-color: var(--bp-danger);
