<script>
    (function () {
        const search     = document.getElementById('bpSearch');
        const filtroObra = document.getElementById('bpFiltroObra');
        const filtroMes  = document.getElementById('bpFiltroMes');
        const filtroCat  = document.getElementById('bpFiltroCat');
        const rows       = Array.from(document.querySelectorAll('#bpTbody tr'));
        const empty      = document.getElementById('bpEmpty');
        const count      = document.getElementById('bpCount');
        const totalVis   = document.getElementById('bpTotalVisible');

        function aplicarFiltros() {
            const txt  = search.value.trim().toLowerCase();
            const obra = filtroObra.value;
            const mes  = filtroMes.value;
            const cat  = filtroCat.value;
            let vis = 0, sumaVisible = 0;

            rows.forEach(row => {
                const ok = (!txt  || row.dataset.search.includes(txt))
                        && (!obra || row.dataset.obra === obra)
                        && (!mes  || row.dataset.mes  === mes)
                        && (!cat  || row.dataset.cat  === cat);
                row.classList.toggle('d-none', !ok);
                if (ok) {
                    vis++;
                    // extraer monto de la celda
                    const montoTxt = row.querySelector('.bp-monto')?.textContent.replace(/[$.,\s]/g, '') ?? '0';
                    sumaVisible += parseInt(montoTxt) || 0;
                }
            });

            count.textContent = vis;
            empty.classList.toggle('d-none', vis > 0);

            // Formatear total visible
            totalVis.textContent = '$' + sumaVisible.toLocaleString('es-UY');
        }

        search.addEventListener('input', aplicarFiltros);
        filtroObra.addEventListener('change', aplicarFiltros);
        filtroMes.addEventListener('change', aplicarFiltros);
        filtroCat.addEventListener('change', aplicarFiltros);
    })();
</script>