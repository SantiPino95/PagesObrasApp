@page
@model PagesObrasApp.Pages.Admin.GastosModel
@using System.Linq
@using System.Globalization
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Gastos de Obra";

    // --- Datos de muestra (mock) — reemplazar por Model.* cuando conectemos la API vía DTOs ---
    var today = new DateTime(2026, 6, 22);
    var cultura = new CultureInfo("es-UY");

    var obras = new[]
    {
        new { Id = 1, Nombre = "Edificio Las Acacias",     Codigo = "OB-2026-014" },
        new { Id = 2, Nombre = "Torre Mirador",            Codigo = "OB-2026-002" },
        new { Id = 3, Nombre = "Galpón Industrial Ruta 5", Codigo = "OB-2026-011" },
        new { Id = 4, Nombre = "Casa Familia Pérez",       Codigo = "OB-2026-019" },
        new { Id = 5, Nombre = "Reforma Local Comercial",  Codigo = "OB-2025-087" },
    };

    var gastos = new[]
    {
        // Edificio Las Acacias (1)
        new{Id=1,  IdObra=1, Fecha=new DateTime(2026,4,3),  Monto=45000m, Desc="Cemento y arena primera entrega",  Cat="Materiales",       Comp="FC-001123"},
        new{Id=2,  IdObra=1, Fecha=new DateTime(2026,4,10), Monto=18500m, Desc="Jornales semana del 7 al 11",      Cat="Mano de Obra",     Comp="RH-0041"},
        new{Id=3,  IdObra=1, Fecha=new DateTime(2026,4,18), Monto=8200m,  Desc="Alquiler andamio modular mes",     Cat="Alquiler Equipos", Comp="ALQ-0022"},
        new{Id=4,  IdObra=1, Fecha=new DateTime(2026,5,5),  Monto=32000m, Desc="Hierro Ø10 y Ø8 segunda entrega", Cat="Materiales",       Comp="FC-001455"},
        new{Id=5,  IdObra=1, Fecha=new DateTime(2026,5,14), Monto=21000m, Desc="Jornales quincena mayo",           Cat="Mano de Obra",     Comp="RH-0058"},
        new{Id=6,  IdObra=1, Fecha=new DateTime(2026,5,22), Monto=3400m,  Desc="Flete materiales",                Cat="Transporte",       Comp="FLT-0009"},
        new{Id=7,  IdObra=1, Fecha=new DateTime(2026,6,2),  Monto=28000m, Desc="Ladrillos y bloques",             Cat="Materiales",       Comp="FC-001789"},
        new{Id=8,  IdObra=1, Fecha=new DateTime(2026,6,10), Monto=19500m, Desc="Jornales primera quincena",       Cat="Mano de Obra",     Comp="RH-0071"},
        new{Id=9,  IdObra=1, Fecha=new DateTime(2026,6,18), Monto=5600m,  Desc="Instalación eléctrica parcial",   Cat="Servicios",        Comp="SRV-0014"},
        // Torre Mirador (2)
        new{Id=10, IdObra=2, Fecha=new DateTime(2026,5,8),  Monto=22000m, Desc="Cemento y cal",                   Cat="Materiales",       Comp="FC-002001"},
        new{Id=11, IdObra=2, Fecha=new DateTime(2026,5,20), Monto=15000m, Desc="Jornales mayo",                   Cat="Mano de Obra",     Comp="RH-0061"},
        new{Id=12, IdObra=2, Fecha=new DateTime(2026,6,5),  Monto=11000m, Desc="Hierros y alambre",               Cat="Materiales",       Comp="FC-002210"},
        new{Id=13, IdObra=2, Fecha=new DateTime(2026,6,14), Monto=14500m, Desc="Jornales primera quincena",       Cat="Mano de Obra",     Comp="RH-0074"},
        new{Id=14, IdObra=2, Fecha=new DateTime(2026,6,19), Monto=2800m,  Desc="Transporte equipos",              Cat="Transporte",       Comp="FLT-0012"},
        // Galpón (3)
        new{Id=15, IdObra=3, Fecha=new DateTime(2026,4,22), Monto=55000m, Desc="Chapa galvanizada y perfiles",    Cat="Materiales",       Comp="FC-003011"},
        new{Id=16, IdObra=3, Fecha=new DateTime(2026,4,29), Monto=24000m, Desc="Mano de obra montaje estructura", Cat="Mano de Obra",     Comp="RH-0045"},
        new{Id=17, IdObra=3, Fecha=new DateTime(2026,5,10), Monto=18000m, Desc="Soldadora y herramientas alquil", Cat="Alquiler Equipos", Comp="ALQ-0031"},
        new{Id=18, IdObra=3, Fecha=new DateTime(2026,5,25), Monto=12000m, Desc="Jornales mayo segunda quincena",  Cat="Mano de Obra",     Comp="RH-0066"},
        new{Id=19, IdObra=3, Fecha=new DateTime(2026,6,8),  Monto=9500m,  Desc="Pintura anticorrosiva",           Cat="Materiales",       Comp="FC-003312"},
        new{Id=20, IdObra=3, Fecha=new DateTime(2026,6,20), Monto=7200m,  Desc="Jornales junio",                  Cat="Mano de Obra",     Comp="RH-0078"},
        // Casa Pérez (4)
        new{Id=21, IdObra=4, Fecha=new DateTime(2026,6,3),  Monto=14000m, Desc="Ladrillos y mortero",             Cat="Materiales",       Comp="FC-004001"},
        new{Id=22, IdObra=4, Fecha=new DateTime(2026,6,12), Monto=8500m,  Desc="Jornales inicio obra",            Cat="Mano de Obra",     Comp="RH-0072"},
        // Reforma Local (5)
        new{Id=23, IdObra=5, Fecha=new DateTime(2026,1,10), Monto=9000m,  Desc="Pintura y revestimiento",         Cat="Materiales",       Comp="FC-005001"},
        new{Id=24, IdObra=5, Fecha=new DateTime(2026,2,14), Monto=7500m,  Desc="Piso cerámico",                   Cat="Materiales",       Comp="FC-005120"},
        new{Id=25, IdObra=5, Fecha=new DateTime(2026,2,20), Monto=6000m,  Desc="Mano de obra colocación",         Cat="Mano de Obra",     Comp="RH-0030"},
        new{Id=26, IdObra=5, Fecha=new DateTime(2026,3,5),  Monto=4200m,  Desc="Instalación sanitaria",           Cat="Servicios",        Comp="SRV-0008"},
    };

    var categorias = new[] { "Materiales", "Mano de Obra", "Herramientas", "Transporte", "Alquiler Equipos", "Servicios", "Otro" };

    // Meses con datos para el filtro
    var mesesConDatos = gastos
        .Select(g => new DateTime(g.Fecha.Year, g.Fecha.Month, 1))
        .Distinct()
        .OrderByDescending(m => m)
        .ToList();

    // Vista por obra: total acumulado + desglose por mes (últimos 3)
    var ultMeses = Enumerable.Range(0, 3)
        .Select(i => new DateTime(today.Year, today.Month, 1).AddMonths(-i))
        .OrderBy(m => m)
        .ToList();

    var resumenObras = obras.Select(o =>
    {
        var gg = gastos.Where(g => g.IdObra == o.Id).ToList();
        var total = gg.Sum(g => g.Monto);
        var porMes = ultMeses.Select(m => new
        {
            Mes = m,
            MesLbl = m.ToString("MMM", cultura),
            Total = gg.Where(g => g.Fecha.Year == m.Year && g.Fecha.Month == m.Month).Sum(g => g.Monto)
        }).ToList();
        var maxMes = porMes.Max(m => m.Total);
        var porCat = gg.GroupBy(g => g.Cat)
                        .Select(gc => new { Cat = gc.Key, Total = gc.Sum(g => g.Monto) })
                        .OrderByDescending(x => x.Total)
                        .ToList();
        return new { o.Id, o.Nombre, o.Codigo, Total = total, PorMes = porMes, MaxMes = maxMes, PorCat = porCat, CantGastos = gg.Count };
    }).OrderByDescending(o => o.Total).ToList();

    var totalGeneral = gastos.Sum(g => g.Monto);
    var totalEstesMes = gastos.Where(g => g.Fecha.Year == today.Year && g.Fecha.Month == today.Month).Sum(g => g.Monto);
    var totalObrasActivas = resumenObras.Count(o => o.Total > 0);

    // Colores por categoría
    var catColores = new Dictionary<string, string>
    {
        {"Materiales",       "#2D6CDF"},
        {"Mano de Obra",     "#1B3A5C"},
        {"Herramientas",     "#5B6670"},
        {"Transporte",       "#F2A900"},
        {"Alquiler Equipos", "#2E7D52"},
        {"Servicios",        "#8B4E9E"},
        {"Otro",             "#B23A2E"},
    };
}

<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

<div class="admin-dashboard">

    <!-- HEADER -->
    <section class="bp-section">
        <div class="d-flex justify-content-between align-items-end flex-wrap gap-2">
            <div>
                <span class="bp-eyebrow">Control de costos</span>
                <h1 class="bp-title bp-title-dark">Gastos de obra</h1>
            </div>
            <button type="button" class="bp-btn-primary" data-bs-toggle="modal" data-bs-target="#modalNuevoGasto">
                + Registrar gasto
            </button>
        </div>
    </section>

    <!-- STAT CARDS -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-4">
            <div class="bp-stat-card">
                <span class="bp-stat-label">Total acumulado</span>
                <span class="bp-stat-num">$@totalGeneral.ToString("N0")</span>
                <span class="bp-stat-sub">en todas las obras</span>
            </div>
        </div>
        <div class="col-6 col-md-4">
            <div class="bp-stat-card bp-stat-card--accent">
                <span class="bp-stat-label">Gasto en @today.ToString("MMMM", cultura)</span>
                <span class="bp-stat-num bp-stat-num--amber">$@totalEstesMes.ToString("N0")</span>
                <span class="bp-stat-sub">mes en curso</span>
            </div>
        </div>
        <div class="col-6 col-md-4">
            <div class="bp-stat-card">
                <span class="bp-stat-label">Obras con gastos</span>
                <span class="bp-stat-num">@totalObrasActivas</span>
                <span class="bp-stat-sub">de @obras.Length en seguimiento</span>
            </div>
        </div>
    </div>

    <!-- RESUMEN POR OBRA -->
    <section class="bp-section">
        <span class="bp-eyebrow">Gasto por obra — últimos 3 meses</span>
        <div class="row g-3 mt-1">
            @foreach (var o in resumenObras)
            {
                var pct = totalGeneral > 0 ? (int)Math.Round(o.Total / totalGeneral * 100) : 0;

                <div class="col-12 col-lg-6">
                    <div class="bp-obra-card">

                        <!-- Encabezado -->
                        <div class="d-flex justify-content-between align-items-start gap-2 mb-3">
                            <div>
                                <span class="bp-obra-nombre">@o.Nombre</span>
                                <span class="bp-mono bp-steel d-block">@o.Codigo</span>
                            </div>
                            <div class="text-end">
                                <span class="bp-obra-total">$@o.Total.ToString("N0")</span>
                                <span class="bp-mono bp-steel d-block">@o.CantGastos @(o.CantGastos == 1 ? "registro" : "registros")</span>
                            </div>
                        </div>

                        <!-- Barra de proporción del total general -->
                        <div class="bp-proporcion-wrap">
                            <div class="bp-proporcion-bar">
                                <div class="bp-proporcion-fill" style="width:@pct%"></div>
                            </div>
                            <span class="bp-mono bp-steel">@pct% del total</span>
                        </div>

                        <!-- Mini gráfico de barras por mes -->
                        <div class="bp-bars-wrap">
                            @foreach (var m in o.PorMes)
                            {
                                var barPct = o.MaxMes > 0 ? (int)Math.Round(m.Total / o.MaxMes * 100) : 0;
                                var esMesActual = m.Mes.Month == today.Month && m.Mes.Year == today.Year;
                                <div class="bp-bar-col">
                                    <div class="bp-bar-label-top bp-mono">
                                        @if (m.Total > 0)
                                        {
                                            @($"${(m.Total / 1000m):0.#}k")
                                        }
                                        else
                                        {

                                            <text>—</text>
                                        }
                                    </div>
                                    <div class="bp-bar-track">
                                        <div class="bp-bar-fill @(esMesActual ? "bp-bar-fill--actual" : "")"
                                             style="height:@(barPct)%"></div>
                                    </div>
                                    <span class="bp-bar-mes @(esMesActual ? "bp-bar-mes--actual" : "")">@m.MesLbl</span>
                                </div>
                            }
                        </div>

                        <!-- Top categorías -->
                        @if (o.PorCat.Any())
                        {
                            <div class="bp-chip-row mt-2">
                                @foreach (var c in o.PorCat.Take(3))
                                {
                                    var col = catColores.ContainsKey(c.Cat) ? catColores[c.Cat] : "#5B6670";
                                    <span class="bp-chip-cat" style="--cat-color:@col">
                                        <span class="bp-chip-dot"></span>@c.Cat
                                        <strong>$@c.Total.ToString("N0")</strong>
                                    </span>
                                }
                            </div>
                        }

                    </div>
                </div>
            }
        </div>
    </section>

    <!-- TABLA DETALLE -->
    <section class="bp-section">
        <span class="bp-eyebrow">Detalle de gastos</span>

        <div class="bp-filterbar mt-2">
            <input type="text" id="bpSearch" class="bp-input" placeholder="Buscar descripción o comprobante...">
            <select id="bpFiltroObra" class="bp-select">
                <option value="">Todas las obras</option>
                @foreach (var o in obras)
                {
                    <option value="@o.Id">@o.Nombre</option>
                }
            </select>
            <select id="bpFiltroMes" class="bp-select">
                <option value="">Todos los meses</option>
                @foreach (var m in mesesConDatos)
                {
                    <option value="@m.ToString("yyyy-MM")">@m.ToString("MMMM yyyy", cultura)</option>
                }
            </select>
            <select id="bpFiltroCat" class="bp-select">
                <option value="">Todas las categorías</option>
                @foreach (var c in categorias)
                {
                    <option value="@c.ToLower()">@c</option>
                }
            </select>
        </div>

        <div class="bp-table-wrap mt-2">
            <table class="bp-table">
                <thead>
                    <tr>
                        <th>Fecha</th>
                        <th>Obra</th>
                        <th>Descripción</th>
                        <th>Categoría</th>
                        <th>Comprobante</th>
                        <th class="text-end">Monto</th>
                    </tr>
                </thead>
                <tbody id="bpTbody">
                    @foreach (var g in gastos.OrderByDescending(x => x.Fecha))
                    {
                        var obraG = obras.FirstOrDefault(o => o.Id == g.IdObra);
                        var col = catColores.ContainsKey(g.Cat) ? catColores[g.Cat] : "#5B6670";
                        var mesKey = g.Fecha.ToString("yyyy-MM");
                        <tr data-obra="@g.IdObra"
                            data-mes="@mesKey"
                            data-cat="@g.Cat.ToLower()"
                            data-search="@($"{g.Desc} {g.Comp}".ToLower())">
                            <td class="bp-mono">@g.Fecha.ToString("dd/MM/yyyy")</td>
                            <td>
                                <div class="bp-strong">@obraG?.Nombre</div>
                                <div class="bp-mono bp-steel">@obraG?.Codigo</div>
                            </td>
                            <td>@g.Desc</td>
                            <td>
                                <span class="bp-cat-badge" style="--cat-color:@col">
                                    <span class="bp-chip-dot"></span>@g.Cat
                                </span>
                            </td>
                            <td class="bp-mono">@(string.IsNullOrEmpty(g.Comp) ? "—" : g.Comp)</td>
                            <td class="text-end bp-monto">$@g.Monto.ToString("N0")</td>
                        </tr>
                    }
                </tbody>
                <tfoot id="bpTfoot">
                    <tr class="bp-total-row">
                        <td colspan="5" class="bp-total-label">Total visible</td>
                        <td class="text-end bp-total-num" id="bpTotalVisible">
                            $@gastos.Sum(g => g.Monto).ToString("N0")
                        </td>
                    </tr>
                </tfoot>
            </table>
            <p id="bpEmpty" class="bp-empty d-none">No hay gastos que coincidan con los filtros.</p>
        </div>
        <p class="bp-count">Mostrando <span id="bpCount">@gastos.Length</span> de @gastos.Length registros</p>
    </section>

</div>

<!-- Modal: Registrar gasto -->
<div class="modal fade" id="modalNuevoGasto" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content bp-modal">
            <div class="modal-header bp-modal-header">
                <div>
                    <span class="bp-eyebrow" style="color:rgba(255,255,255,.65)">Control de costos</span>
                    <h5 class="modal-title bp-title">Registrar gasto</h5>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body bp-modal-body">
                <!-- TODO: conectar a OnPostRegistrarGasto cuando esté el HttpClient hacia la API -->
                <div class="row g-3">
                    <div class="col-12">
                        <label class="bp-label">Obra</label>
                        <select class="bp-select w-100">
                            <option value="">Seleccionar obra...</option>
                            @foreach (var o in obras)
                            {
                                <option value="@o.Id">@o.Nombre (@o.Codigo)</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="bp-label">Fecha del gasto</label>
                        <input type="date" class="bp-input w-100" value="@today.ToString("yyyy-MM-dd")">
                    </div>
                    <div class="col-md-6">
                        <label class="bp-label">Categoría</label>
                        <select class="bp-select w-100">
                            <option value="">Seleccionar categoría...</option>
                            @foreach (var c in categorias)
                            {
                                <option value="@c">@c</option>
                            }
                        </select>
                    </div>
                    <div class="col-12">
                        <label class="bp-label">Descripción</label>
                        <input type="text" class="bp-input w-100" placeholder="Ej: Cemento y arena segunda entrega">
                    </div>
                    <div class="col-md-6">
                        <label class="bp-label">Monto ($)</label>
                        <input type="number" min="0.01" step="0.01" class="bp-input w-100" placeholder="0.00">
                    </div>
                    <div class="col-md-6">
                        <label class="bp-label">Nº Comprobante (opcional)</label>
                        <input type="text" class="bp-input w-100" placeholder="Ej: FC-001234">
                    </div>
                </div>
            </div>
            <div class="modal-footer bp-modal-footer">
                <button type="button" class="bp-btn-ghost" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="bp-btn-primary">Guardar gasto</button>
            </div>
        </div>
    </div>
</div>

<style>
    .admin-dashboard {
        --bp-blueprint: #1B3A5C;
        --bp-blueprint-light: #2D5C8C;
        --bp-concrete: #F1EFEA;
        --bp-steel: #5B6670;
        --bp-safety: #F2A900;
        --bp-ink: #181B1F;
        --bp-line: #D8D3C8;
        font-family: 'Inter', sans-serif;
        color: var(--bp-ink);
    }

        .admin-dashboard .bp-eyebrow {
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.72rem;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            color: var(--bp-steel);
        }

    .bp-title {
        font-family: 'Barlow Condensed', sans-serif;
        font-weight: 600;
        letter-spacing: 0.01em;
        margin: 0.15rem 0;
    }

    .bp-title-dark {
        font-size: 2rem;
        color: var(--bp-ink);
    }

    .bp-section {
        margin-bottom: 2rem;
    }

    .bp-mono {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.82rem;
    }

    .bp-steel {
        color: var(--bp-steel);
    }

    .bp-strong {
        font-weight: 600;
    }

    /* Botones */
    .bp-btn-primary {
        font-family: 'Inter', sans-serif;
        font-weight: 600;
        font-size: 0.88rem;
        background: var(--bp-safety);
        color: var(--bp-ink);
        border: none;
        border-radius: 6px;
        padding: 0.55rem 1.1rem;
        transition: background .2s;
    }

        .bp-btn-primary:hover {
            background: #d99500;
        }

    .bp-btn-ghost {
        font-family: 'Inter', sans-serif;
        font-weight: 500;
        font-size: 0.88rem;
        background: transparent;
        color: var(--bp-steel);
        border: 1px solid var(--bp-line);
        border-radius: 6px;
        padding: 0.55rem 1.1rem;
    }

        .bp-btn-ghost:hover {
            border-color: var(--bp-steel);
            color: var(--bp-ink);
        }

    /* Stat cards */
    .bp-stat-card {
        background: #fff;
        border: 1px solid var(--bp-line);
        border-radius: 8px;
        padding: 1rem 1.1rem;
        height: 100%;
        display: flex;
        flex-direction: column;
        gap: 0.15rem;
    }

    .bp-stat-card--accent {
        border-left: 3px solid var(--bp-safety);
    }

    .bp-stat-label {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.68rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--bp-steel);
    }

    .bp-stat-num {
        font-family: 'Barlow Condensed', sans-serif;
        font-size: 2rem;
        font-weight: 600;
        color: var(--bp-ink);
        line-height: 1.1;
    }

    .bp-stat-num--amber {
        color: var(--bp-safety);
    }

    .bp-stat-sub {
        font-size: 0.75rem;
        color: var(--bp-steel);
    }

    /* Cards por obra */
    .bp-obra-card {
        background: #fff;
        border: 1px solid var(--bp-line);
        border-radius: 8px;
        padding: 1.25rem;
        height: 100%;
    }

    .bp-obra-nombre {
        font-family: 'Barlow Condensed', sans-serif;
        font-weight: 600;
        font-size: 1.1rem;
    }

    .bp-obra-total {
        font-family: 'Barlow Condensed', sans-serif;
        font-weight: 700;
        font-size: 1.4rem;
        color: var(--bp-blueprint);
    }

    /* Barra proporción */
    .bp-proporcion-wrap {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin-bottom: 1rem;
    }

    .bp-proporcion-bar {
        flex: 1;
        height: 6px;
        background: var(--bp-concrete);
        border-radius: 4px;
        overflow: hidden;
    }

    .bp-proporcion-fill {
        height: 100%;
        background: var(--bp-blueprint-light);
        border-radius: 4px;
    }

    /* Mini gráfico de barras por mes */
    .bp-bars-wrap {
        display: flex;
        gap: 0.5rem;
        align-items: flex-end;
        height: 80px;
        padding: 0 0 0.25rem;
        border-bottom: 1px solid var(--bp-line);
        margin-bottom: 0.75rem;
    }

    .bp-bar-col {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        height: 100%;
        gap: 0.2rem;
    }

    .bp-bar-label-top {
