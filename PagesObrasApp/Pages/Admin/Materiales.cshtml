@page
@model PagesObrasApp.Pages.Admin.MaterialesModel
@using System.Linq
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Materiales";

    // --- Datos de muestra (mock) — reemplazar por Model.* cuando conectemos la API vía DTOs ---
    var materiales = new[]
    {
        new { Id = 1, Nombre = "Cemento Portland",     Unidad = "kg",     Disponible = 2400m, Minimo = 500m  },
        new { Id = 2, Nombre = "Arena fina",            Unidad = "m³",     Disponible = 18m,   Minimo = 10m   },
        new { Id = 3, Nombre = "Ladrillo común",        Unidad = "unidad", Disponible = 1200m, Minimo = 2000m },
        new { Id = 4, Nombre = "Hierro Ø10mm",          Unidad = "kg",     Disponible = 850m,  Minimo = 300m  },
        new { Id = 5, Nombre = "Hierro Ø8mm",           Unidad = "kg",     Disponible = 120m,  Minimo = 200m  },
        new { Id = 6, Nombre = "Pintura látex blanca",  Unidad = "litro",  Disponible = 45m,   Minimo = 20m   },
        new { Id = 7, Nombre = "Piso cerámico 45×45",  Unidad = "m²",     Disponible = 0m,    Minimo = 50m   },
        new { Id = 8, Nombre = "Cal",                   Unidad = "kg",     Disponible = 600m,  Minimo = 150m  },
    };

    var consumos = new[]
    {
        new { IdMaterial = 1, Obra = "Edificio Las Acacias",    Cantidad = 1800m, Fecha = new DateTime(2026,6,10) },
        new { IdMaterial = 1, Obra = "Torre Mirador",           Cantidad = 420m,  Fecha = new DateTime(2026,6,15) },
        new { IdMaterial = 2, Obra = "Edificio Las Acacias",    Cantidad = 12m,   Fecha = new DateTime(2026,6,8)  },
        new { IdMaterial = 2, Obra = "Galpón Industrial Ruta 5",Cantidad = 5m,    Fecha = new DateTime(2026,6,12) },
        new { IdMaterial = 3, Obra = "Reforma Local Comercial", Cantidad = 3200m, Fecha = new DateTime(2026,5,30) },
        new { IdMaterial = 4, Obra = "Torre Mirador",           Cantidad = 320m,  Fecha = new DateTime(2026,6,14) },
        new { IdMaterial = 4, Obra = "Edificio Las Acacias",    Cantidad = 150m,  Fecha = new DateTime(2026,6,9)  },
        new { IdMaterial = 5, Obra = "Galpón Industrial Ruta 5",Cantidad = 280m,  Fecha = new DateTime(2026,6,11) },
        new { IdMaterial = 6, Obra = "Casa Familia Pérez",      Cantidad = 30m,   Fecha = new DateTime(2026,6,18) },
        new { IdMaterial = 8, Obra = "Edificio Las Acacias",    Cantidad = 200m,  Fecha = new DateTime(2026,6,10) },
    };

    var vista = materiales.Select(m => new
    {
        m.Id,
        m.Nombre,
        m.Unidad,
        m.Disponible,
        m.Minimo,
        SinStock = m.Disponible == 0m,
        StockBajo = m.Disponible > 0m && m.Disponible <= m.Minimo,
        StockOk = m.Disponible > m.Minimo,
        PorObra = consumos
            .Where(c => c.IdMaterial == m.Id)
            .GroupBy(c => c.Obra)
            .Select(g => new { Obra = g.Key, Total = g.Sum(c => c.Cantidad), Ultima = g.Max(c => c.Fecha) })
            .OrderByDescending(x => x.Total)
            .ToList()
    }).ToList();

    var alertaCount = vista.Count(m => m.SinStock || m.StockBajo);
    var obrasMock = new[] { "Edificio Las Acacias", "Casa Familia Pérez", "Galpón Industrial Ruta 5", "Reforma Local Comercial", "Torre Mirador" };
}

<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

<div class="admin-dashboard">

    <!-- HEADER -->
    <section class="bp-section">
        <div class="d-flex justify-content-between align-items-end flex-wrap gap-2">
            <div>
                <span class="bp-eyebrow">Inventario</span>
                <h1 class="bp-title bp-title-dark">Materiales</h1>
            </div>
            <div class="d-flex gap-2">
                <button type="button" class="bp-btn-ghost" data-bs-toggle="modal" data-bs-target="#modalEntradaStock">
                    ↑ Registrar entrada
                </button>
                <button type="button" class="bp-btn-primary" data-bs-toggle="modal" data-bs-target="#modalNuevoMaterial">
                    + Nuevo material
                </button>
            </div>
        </div>
    </section>

    <!-- BANNER DE ALERTA -->
    @if (alertaCount > 0)
    {
        <div class="bp-alert-banner">
            <span class="bp-alert-icon">⚠</span>
            <span>
                <strong>@alertaCount @(alertaCount == 1 ? "material" : "materiales")</strong>
                @(alertaCount == 1 ? "está" : "están") por debajo del stock mínimo o sin existencias.
                Revisá las tarjetas marcadas en rojo o amarillo.
            </span>
        </div>
    }

    <!-- RESUMEN POR MATERIAL -->
    <section class="bp-section">
        <span class="bp-eyebrow">Estado de stock por material</span>

        <!-- Filtros de tarjetas -->
        <div class="bp-filterbar mt-2">
            <input type="text" id="bpSearchCard" class="bp-input" placeholder="Buscar material...">
            <select id="bpFiltroStockCard" class="bp-select">
                <option value="">Todos los estados</option>
                <option value="sinstock">Sin stock</option>
                <option value="bajo">Stock bajo</option>
                <option value="ok">Stock OK</option>
            </select>
        </div>

        <div class="row g-3 mt-1" id="bpCards">
            @foreach (var m in vista)
            {
                var pct = m.Disponible == 0 ? 0
                        : m.Minimo == 0 ? 100
                        : (int)Math.Min(100, Math.Round(m.Disponible / m.Minimo * 100));

                var estadoClass = m.SinStock ? "sinstock" : m.StockBajo ? "bajo" : "ok";
                var searchVal = m.Nombre.ToLower();

                <div class="col-12 col-md-6 col-xl-4 bp-card-wrap"
                     data-stock="@estadoClass"
                     data-search="@searchVal">
                    <div class="bp-mat-card bp-mat-card--@estadoClass">

                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <span class="bp-mat-nombre">@m.Nombre</span>
                                <span class="bp-mat-unidad">/ @m.Unidad</span>
                            </div>
                            <span class="bp-stock-badge bp-stock-badge--@estadoClass">
                                @(m.SinStock ? "Sin stock" : m.StockBajo ? "Stock bajo" : "OK")
                            </span>
                        </div>

                        <!-- Barra de stock -->
                        <div class="bp-stockbar-wrap">
                            <div class="bp-stockbar">
                                <div class="bp-stockbar-fill bp-stockbar-fill--@estadoClass" style="width:@(pct)%"></div>
                                <div class="bp-stockbar-min-marker" title="Mínimo: @m.Minimo @m.Unidad"></div>
                            </div>
                            <div class="bp-stockbar-nums">
                                <span class="bp-mono">@m.Disponible.ToString("N0") <small>disp.</small></span>
                                <span class="bp-mono bp-steel">@m.Minimo.ToString("N0") <small>mín.</small></span>
                            </div>
                        </div>

                        <!-- Consumo por obra -->
                        @if (m.PorObra.Any())
                        {
                            <div class="bp-chip-row">
                                @foreach (var po in m.PorObra)
                                {
                                    <span class="bp-chip" title="Último consumo: @po.Ultima.ToString("dd/MM/yyyy")">
                                        @po.Obra
                                        <strong>@po.Total.ToString("N0") @m.Unidad</strong>
                                    </span>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="bp-sin-consumo">Sin consumo registrado</p>
                        }

                    </div>
                </div>
            }
        </div>
        <p id="bpCardsEmpty" class="bp-empty d-none">No hay materiales que coincidan con el filtro.</p>
    </section>

    <!-- LISTADO COMPLETO -->
    <section class="bp-section">
        <span class="bp-eyebrow">Listado completo</span>
        <div class="bp-table-wrap mt-2">
            <table class="bp-table">
                <thead>
                    <tr>
                        <th>Material</th>
                        <th>Unidad</th>
                        <th>Disponible</th>
                        <th>Mínimo</th>
                        <th>Estado stock</th>
                        <th>Obras con consumo</th>
                        <th>Total consumido</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in vista)
                    {
                        var estadoClass = m.SinStock ? "sinstock" : m.StockBajo ? "bajo" : "ok";
                        var totalConsumido = m.PorObra.Sum(p => p.Total);

                        <tr>
                            <td class="bp-strong">@m.Nombre</td>
                            <td class="bp-mono">@m.Unidad</td>
                            <td class="bp-mono">@m.Disponible.ToString("N0")</td>
                            <td class="bp-mono bp-steel">@m.Minimo.ToString("N0")</td>
                            <td>
                                <span class="bp-stock-badge bp-stock-badge--@estadoClass">
                                    @(m.SinStock ? "Sin stock" : m.StockBajo ? "Stock bajo" : "OK")
                                </span>
                            </td>
                            <td>
                                @if (m.PorObra.Any())
                                {
                                    <span class="bp-mono">@m.PorObra.Count obra@(m.PorObra.Count > 1 ? "s" : "")</span>
                                    <span class="bp-steel"> — </span>
                                    @string.Join(", ", m.PorObra.Select(p => p.Obra))
                                }
                                else
                                {
                                    <span class="bp-steel">—</span>
                                }
                            </td>
                            <td class="bp-mono">
                                @if (totalConsumido > 0)
                                {
                                    @totalConsumido.ToString("N0")
                                    <small class="bp-steel"> @m.Unidad</small>
                                }
                                else
                                {
                                    <span class="bp-steel">—</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

</div>

<!-- Modal: Registrar entrada de stock -->
<div class="modal fade" id="modalEntradaStock" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content bp-modal">
            <div class="modal-header bp-modal-header">
                <div>
                    <span class="bp-eyebrow" style="color:rgba(255,255,255,.65)">Movimiento de stock</span>
                    <h5 class="modal-title bp-title">Registrar entrada de material</h5>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body bp-modal-body">
                <!-- TODO: conectar a OnPostEntradaStock cuando esté el HttpClient hacia la API -->
                <div class="row g-3">
                    <div class="col-12">
                        <label class="bp-label">Material</label>
                        <select class="bp-select w-100">
                            <option value="">Seleccionar material...</option>
                            @foreach (var m in materiales)
                            {
                                <option value="@m.Id">@m.Nombre (@m.Unidad)</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="bp-label">Cantidad a ingresar</label>
                        <input type="number" min="0.01" step="0.01" class="bp-input w-100" placeholder="0.00">
                    </div>
                    <div class="col-md-6">
                        <label class="bp-label">Fecha de ingreso</label>
                        <input type="date" class="bp-input w-100">
                    </div>
                    <div class="col-12">
                        <label class="bp-label">Proveedor</label>
                        <select class="bp-select w-100">
                            <option value="">Seleccionar proveedor...</option>
                            <option>Materiales del Norte S.A.</option>
                            <option>Distribuidora Ferpal</option>
                            <option>Hierros Uruguay</option>
                        </select>
                    </div>
                    <div class="col-12">
                        <label class="bp-label">Nº Comprobante (opcional)</label>
                        <input type="text" class="bp-input w-100" placeholder="Ej: FC-000123">
                    </div>
                </div>
            </div>
            <div class="modal-footer bp-modal-footer">
                <button type="button" class="bp-btn-ghost" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="bp-btn-primary">Registrar entrada</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Nuevo material -->
<div class="modal fade" id="modalNuevoMaterial" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content bp-modal">
            <div class="modal-header bp-modal-header">
                <div>
                    <span class="bp-eyebrow" style="color:rgba(255,255,255,.65)">Alta de inventario</span>
                    <h5 class="modal-title bp-title">Nuevo material</h5>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body bp-modal-body">
                <!-- TODO: conectar a OnPostCrearMaterial cuando esté el HttpClient hacia la API -->
                <div class="row g-3">
                    <div class="col-12">
                        <label class="bp-label">Nombre del material</label>
                        <input type="text" class="bp-input w-100" placeholder="Ej: Cemento Portland">
                    </div>
                    <div class="col-md-6">
                        <label class="bp-label">Unidad de medida</label>
                        <select class="bp-select w-100">
                            <option>kg</option>
                            <option>litro</option>
                            <option>m²</option>
                            <option>m³</option>
                            <option>unidad</option>
                            <option>bolsa</option>
                            <option>rollo</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="bp-label">Stock mínimo</label>
                        <input type="number" min="0" step="0.01" class="bp-input w-100" placeholder="0.00">
                    </div>
                    <div class="col-12">
                        <label class="bp-label">Stock inicial disponible</label>
                        <input type="number" min="0" step="0.01" class="bp-input w-100" placeholder="0.00">
                    </div>
                </div>
            </div>
            <div class="modal-footer bp-modal-footer">
                <button type="button" class="bp-btn-ghost" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="bp-btn-primary">Guardar material</button>
            </div>
        </div>
    </div>
</div>

<style>
    .admin-dashboard {
        --bp-blueprint: #1B3A5C;
        --bp-blueprint-light: #2D5C8C;
        --bp-concrete: #F1EFEA;
        --bp-steel: #5B6670;
        --bp-safety: #F2A900;
        --bp-ink: #181B1F;
        --bp-line: #D8D3C8;
        --bp-ok: #2E7D52;
        --bp-ok-bg: #EAF4EE;
        --bp-bajo-bg: #FFF8E8;
        --bp-sinstock-bg: #FBF0EF;
        --bp-sinstock: #B23A2E;
        font-family: 'Inter', sans-serif;
        color: var(--bp-ink);
    }

        .admin-dashboard .bp-eyebrow {
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.72rem;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            color: var(--bp-steel);
        }

    .bp-title {
        font-family: 'Barlow Condensed', sans-serif;
        font-weight: 600;
        letter-spacing: 0.01em;
        margin: 0.15rem 0;
    }

    .bp-title-dark {
        font-size: 2rem;
        color: var(--bp-ink);
    }

    .bp-section {
        margin-bottom: 2rem;
    }

    .bp-mono {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.82rem;
    }

    .bp-steel {
        color: var(--bp-steel);
    }

    .bp-strong {
        font-weight: 600;
    }

    /* Botones */
    .bp-btn-primary {
        font-family: 'Inter', sans-serif;
        font-weight: 600;
        font-size: 0.88rem;
        background: var(--bp-safety);
        color: var(--bp-ink);
        border: none;
        border-radius: 6px;
        padding: 0.55rem 1.1rem;
        transition: background .2s;
    }

        .bp-btn-primary:hover {
            background: #d99500;
        }

    .bp-btn-ghost {
        font-family: 'Inter', sans-serif;
        font-weight: 500;
        font-size: 0.88rem;
        background: transparent;
        color: var(--bp-steel);
        border: 1px solid var(--bp-line);
        border-radius: 6px;
        padding: 0.55rem 1.1rem;
    }

        .bp-btn-ghost:hover {
            border-color: var(--bp-steel);
            color: var(--bp-ink);
        }

    /* Banner alerta */
    .bp-alert-banner {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        background: #FFF8E8;
        border: 1px solid #e8c96a;
        border-radius: 8px;
        padding: 0.75rem 1rem;
        margin-bottom: 1.5rem;
        font-size: 0.88rem;
        color: #7a5400;
    }

    .bp-alert-icon {
        font-size: 1.1rem;
    }

    /* Filtros */
    .bp-filterbar {
        display: flex;
        gap: 0.75rem;
        flex-wrap: wrap;
    }

    .bp-input, .bp-select {
        font-family: 'Inter', sans-serif;
        font-size: 0.88rem;
        border: 1px solid var(--bp-line);
        border-radius: 6px;
        padding: 0.5rem 0.8rem;
        background: #fff;
        color: var(--bp-ink);
    }

        .bp-input:focus, .bp-select:focus {
            outline: none;
            border-color: var(--bp-blueprint-light);
            box-shadow: 0 0 0 3px rgba(45,92,140,0.12);
        }

    #bpSearchCard {
        flex: 1;
        min-width: 200px;
    }

    /* Tarjetas de material */
    .bp-mat-card {
        background: #fff;
        border: 1px solid var(--bp-line);
        border-radius: 8px;
        padding: 1.1rem;
        height: 100%;
        border-left-width: 3px;
    }

    .bp-mat-card--ok {
        border-left-color: var(--bp-ok);
    }

    .bp-mat-card--bajo {
        border-left-color: var(--bp-safety);
    }

    .bp-mat-card--sinstock {
        border-left-color: var(--bp-sinstock);
        background: var(--bp-sinstock-bg);
    }

    .bp-mat-nombre {
        font-family: 'Barlow Condensed', sans-serif;
        font-weight: 600;
        font-size: 1.05rem;
    }

    .bp-mat-unidad {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.75rem;
        color: var(--bp-steel);
        margin-left: 0.2rem;
    }

    /* Badge de estado stock */
    .bp-stock-badge {
        font-size: 0.7rem;
        font-weight: 600;
        padding: 0.18rem 0.55rem;
        border-radius: 100px;
        white-space: nowrap;
    }

    .bp-stock-badge--ok {
        background: var(--bp-ok-bg);
        color: var(--bp-ok);
    }

    .bp-stock-badge--bajo {
        background: var(--bp-bajo-bg);
        color: #92670a;
    }

    .bp-stock-badge--sinstock {
        background: #f5dedd;
        color: var(--bp-sinstock);
    }

    /* Barra de stock */
    .bp-stockbar-wrap {
        margin: 0.8rem 0 0.6rem;
    }

    .bp-stockbar {
        position: relative;
        height: 8px;
        background: var(--bp-concrete);
        border-radius: 4px;
        overflow: visible;
        margin-bottom: 0.35rem;
    }

    .bp-stockbar-fill {
        height: 100%;
        border-radius: 4px;
        transition: width .3s ease;
    }

    .bp-stockbar-fill--ok {
        background: var(--bp-ok);
    }

    .bp-stockbar-fill--bajo {
        background: var(--bp-safety);
    }

    .bp-stockbar-fill--sinstock {
        background: var(--bp-sinstock);
        width: 0 !important;
    }

    .bp-stockbar-nums {
        display: flex;
        justify-content: space-between;
        font-size: 0.8rem;
    }

        .bp-stockbar-nums small {
            font-size: 0.68rem;
            color: var(--bp-steel);
        }

    /* Chips de obra */
    .bp-chip-row {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
        margin-top: 0.7rem;
        padding-top: 0.7rem;
        border-top: 1px dashed var(--bp-line);
    }

    .bp-chip {
        font-size: 0.73rem;
        background: var(--bp-concrete);
        color: var(--bp-ink);
        border-radius: 100px;
        padding: 0.22rem 0.65rem;
        max-width: 100%;
        white-space: normal;
    }

        .bp-chip strong {
            font-family: 'JetBrains Mono', monospace;
            color: var(--bp-blueprint);
            margin-left: 0.25rem;
        }

    .bp-sin-consumo {
        font-size: 0.78rem;
        color: var(--bp-steel);
        margin: 0.7rem 0 0;
    }

    .bp-empty {
        text-align: center;
        padding: 2rem;
        color: var(--bp-steel);
        margin: 0;
    }

    /* Tabla */
    .bp-table-wrap {
        background: #fff;
        border: 1px solid var(--bp-line);
        border-radius: 8px;
        overflow: hidden;
    }

    .bp-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.88rem;
    }

        .bp-table thead th {
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.68rem;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            color: var(--bp-steel);
            text-align: left;
            padding: 0.75rem 1rem;
            background: var(--bp-concrete);
            border-bottom: 1px solid var(--bp-line);
        }

        .bp-table tbody td {
            padding: 0.7rem 1rem;
            border-bottom: 1px solid var(--bp-line);
            vertical-align: middle;
        }

        .bp-table tbody tr:last-child td {
            border-bottom: none;
        }

    /* Modal */
    .bp-modal {
        border: none;
        border-radius: 10px;
        overflow: hidden;
    }

    .bp-modal-header {
        background: var(--bp-blueprint);
        border: none;
        padding: 1.25rem 1.5rem;
    }

        .bp-modal-header .bp-title {
            color: #fff;
            font-size: 1.4rem;
        }

    .bp-modal-body {
        padding: 1.5rem;
        background: var(--bp-concrete);
    }

    .bp-modal-footer {
        border-top: 1px solid var(--bp-line);
        padding: 1rem 1.5rem;
    }

    .bp-label {
        display: block;
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.68rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--bp-steel);
        margin-bottom: 0.3rem;
    }

    @@media (max-width: 576px) {
        .bp-filterbar {
            flex-direction: column;
        }
    }
</style>

<script>
    (function () {
        const searchInput = document.getElementById('bpSearchCard');
        const filtroStock = document.getElementById('bpFiltroStockCard');
        const cards       = Array.from(document.querySelectorAll('.bp-card-wrap'));
        const emptyMsg    = document.getElementById('bpCardsEmpty');

        function filtrar() {
            const texto = searchInput.value.trim().toLowerCase();
            const stock = filtroStock.value;
            let visibles = 0;

            cards.forEach(card => {
                const coincideTexto = card.dataset.search.includes(texto);
                const coincideStock = !stock || card.dataset.stock === stock;
                const visible = coincideTexto && coincideStock;
                card.style.display = visible ? '' : 'none';
                if (visible) visibles++;
            });

            emptyMsg.classList.toggle('d-none', visibles > 0);
        }

        searchInput.addEventListener('input', filtrar);
        filtroStock.addEventListener('change', filtrar);
    })();
</script>