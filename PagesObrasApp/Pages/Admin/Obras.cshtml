@page
@model PagesObrasApp.Pages.Admin.ObrasModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Obras";

    // --- Datos de muestra (mock) — reemplazar por Model.Obras cuando conectemos la API vía DTOs ---
    var obras = new[]
    {
        new { Codigo = "OB-2026-014", Nombre = "Edificio Las Acacias", Cliente = "Inmobiliaria Sur S.A.", Estado = "En Progreso", Avance = 62, Inicio = new DateTime(2026,2,10) },
        new { Codigo = "OB-2026-019", Nombre = "Casa Familia Pérez", Cliente = "Marcos Pérez", Estado = "Planificada", Avance = 0, Inicio = new DateTime(2026,7,1) },
        new { Codigo = "OB-2026-011", Nombre = "Galpón Industrial Ruta 5", Cliente = "Logística del Este", Estado = "En Progreso", Avance = 38, Inicio = new DateTime(2026,4,22) },
        new { Codigo = "OB-2025-087", Nombre = "Reforma Local Comercial", Cliente = "Comercial Andina", Estado = "Pausada", Avance = 45, Inicio = new DateTime(2026,1,15) },
        new { Codigo = "OB-2025-072", Nombre = "Vivienda Costa Azul", Cliente = "Lucía Fernández", Estado = "Finalizada", Avance = 100, Inicio = new DateTime(2025,9,3) },
        new { Codigo = "OB-2025-061", Nombre = "Ampliación Depósito Norte", Cliente = "Distribuidora Ferpal", Estado = "Cancelada", Avance = 15, Inicio = new DateTime(2025,8,18) },
        new { Codigo = "OB-2026-002", Nombre = "Torre Mirador", Cliente = "Inmobiliaria Sur S.A.", Estado = "En Progreso", Avance = 21, Inicio = new DateTime(2026,5,2) },
        new { Codigo = "OB-2026,021", Nombre = "Local Gastronómico Plaza", Cliente = "Grupo Sabores", Estado = "Planificada", Avance = 0, Inicio = new DateTime(2026,8,12) },
    };

    var clientesMock = new[] { "Inmobiliaria Sur S.A.", "Marcos Pérez", "Logística del Este", "Comercial Andina", "Lucía Fernández", "Distribuidora Ferpal", "Grupo Sabores" };
}

<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

<div class="admin-dashboard">

    <section class="bp-section">
        <div class="d-flex justify-content-between align-items-end flex-wrap gap-2">
            <div>
                <span class="bp-eyebrow">Gestión de proyectos</span>
                <h1 class="bp-title bp-title-dark">Obras</h1>
            </div>
            <button type="button" class="bp-btn-primary" data-bs-toggle="modal" data-bs-target="#modalNuevaObra">
                + Nueva obra
            </button>
        </div>

        <!-- Filtros -->
        <div class="bp-filterbar">
            <input type="text" id="bpSearch" class="bp-input" placeholder="Buscar por obra o cliente...">
            <select id="bpFiltroEstado" class="bp-select">
                <option value="">Todos los estados</option>
                <option value="Planificada">Planificada</option>
                <option value="En Progreso">En Progreso</option>
                <option value="Pausada">Pausada</option>
                <option value="Finalizada">Finalizada</option>
                <option value="Cancelada">Cancelada</option>
            </select>
        </div>

        <div class="bp-table-wrap mt-2">
            <table class="bp-table">
                <thead>
                    <tr>
                        <th>Código</th>
                        <th>Obra</th>
                        <th>Cliente</th>
                        <th>Estado</th>
                        <th>Avance</th>
                        <th>Inicio</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody id="bpTbody">
                    @foreach (var obra in obras)
                    {
                        <tr data-estado="@obra.Estado" data-search="@($"{obra.Nombre} {obra.Cliente}".ToLower())">
                            <td class="bp-mono">@obra.Codigo</td>
                            <td class="bp-strong">@obra.Nombre</td>
                            <td>@obra.Cliente</td>
                            <td><span class="bp-badge bp-badge-@obra.Estado.Replace(" ", "").ToLower()">@obra.Estado</span></td>
                            <td>
                                <div class="bp-progress"><div class="bp-progress-fill" style="width:@(obra.Avance)%"></div></div>
                                <span class="bp-mono bp-progress-num">@obra.Avance%</span>
                            </td>
                            <td class="bp-mono">@obra.Inicio.ToString("dd/MM/yyyy")</td>
                            <td class="text-end"><a href="#" class="bp-link">Ver →</a></td>
                        </tr>
                    }
                </tbody>
            </table>
            <p id="bpEmpty" class="bp-empty d-none">No se encontraron obras con esos filtros.</p>
        </div>

        <p class="bp-count">Mostrando <span id="bpCount">@obras.Length</span> de @obras.Length obras</p>
    </section>

</div>

<!-- Modal: Nueva obra -->
<div class="modal fade" id="modalNuevaObra" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content bp-modal">
            <div class="modal-header bp-modal-header">
                <div>
                    <span class="bp-eyebrow" style="color:rgba(255,255,255,.65)">Alta de proyecto</span>
                    <h5 class="modal-title bp-title">Nueva obra</h5>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body bp-modal-body">
                <!-- TODO: conectar a OnPostCrearObra cuando esté el HttpClient hacia la API -->
                <form id="formNuevaObra">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="bp-label">Nombre de la obra</label>
                            <input type="text" class="bp-input w-100" placeholder="Ej: Edificio Las Acacias">
                        </div>
                        <div class="col-md-6">
                            <label class="bp-label">Cliente</label>
                            <select class="bp-select w-100">
                                <option value="">Seleccionar cliente...</option>
                                @foreach (var c in clientesMock)
                                {
                                    <option value="@c">@c</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="bp-label">Estado inicial</label>
                            <select class="bp-select w-100">
                                <option selected>Planificada</option>
                                <option>En Progreso</option>
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="bp-label">Dirección</label>
                            <input type="text" class="bp-input w-100" placeholder="Ej: Av. Italia 1234">
                        </div>
                        <div class="col-md-6">
                            <label class="bp-label">Fecha de inicio</label>
                            <input type="date" class="bp-input w-100">
                        </div>
                        <div class="col-md-6">
                            <label class="bp-label">Fecha fin prevista</label>
                            <input type="date" class="bp-input w-100">
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer bp-modal-footer">
                <button type="button" class="bp-btn-ghost" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="bp-btn-primary">Guardar obra</button>
            </div>
        </div>
    </div>
</div>

<style>
    .admin-dashboard {
        --bp-blueprint: #1B3A5C;
        --bp-blueprint-light: #2D5C8C;
        --bp-concrete: #F1EFEA;
        --bp-steel: #5B6670;
        --bp-safety: #F2A900;
        --bp-ink: #181B1F;
        --bp-line: #D8D3C8;
        --bp-progreso: #2D6CDF;
        --bp-pausada: #F2A900;
        --bp-finalizada: #2E7D52;
        --bp-cancelada: #B23A2E;
        --bp-planificada: #5B6670;
        font-family: 'Inter', sans-serif;
        color: var(--bp-ink);
    }

        .admin-dashboard .bp-eyebrow {
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.72rem;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            color: var(--bp-steel);
        }

    .bp-title {
        font-family: 'Barlow Condensed', sans-serif;
        font-weight: 600;
        letter-spacing: 0.01em;
        margin: 0.15rem 0;
    }

    .bp-title-dark {
        font-size: 2rem;
        color: var(--bp-ink);
    }

    .bp-section {
        margin-bottom: 1.5rem;
    }

    /* Botones */
    .bp-btn-primary {
        font-family: 'Inter', sans-serif;
        font-weight: 600;
        font-size: 0.88rem;
        background: var(--bp-safety);
        color: var(--bp-ink);
        border: none;
        border-radius: 6px;
        padding: 0.55rem 1.1rem;
        transition: background .2s ease;
    }

        .bp-btn-primary:hover {
            background: #d99500;
            color: var(--bp-ink);
        }

    .bp-btn-ghost {
        font-family: 'Inter', sans-serif;
        font-weight: 500;
        font-size: 0.88rem;
        background: transparent;
        color: var(--bp-steel);
        border: 1px solid var(--bp-line);
        border-radius: 6px;
        padding: 0.55rem 1.1rem;
    }

        .bp-btn-ghost:hover {
            border-color: var(--bp-steel);
            color: var(--bp-ink);
        }

    /* Filtros */
    .bp-filterbar {
        display: flex;
        gap: 0.75rem;
        flex-wrap: wrap;
        margin: 1.25rem 0 0.5rem;
    }

    .bp-input, .bp-select {
        font-family: 'Inter', sans-serif;
        font-size: 0.88rem;
        border: 1px solid var(--bp-line);
        border-radius: 6px;
        padding: 0.5rem 0.8rem;
        background: #fff;
        color: var(--bp-ink);
    }

        .bp-input:focus, .bp-select:focus {
            outline: none;
            border-color: var(--bp-blueprint-light);
            box-shadow: 0 0 0 3px rgba(45,92,140,0.12);
        }

    #bpSearch {
        flex: 1;
        min-width: 220px;
    }

    /* Tabla */
    .bp-table-wrap {
        background: #fff;
        border: 1px solid var(--bp-line);
        border-radius: 8px;
        overflow: hidden;
    }

    .bp-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.88rem;
    }

        .bp-table thead th {
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.68rem;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            color: var(--bp-steel);
            text-align: left;
            padding: 0.75rem 1rem;
            background: var(--bp-concrete);
            border-bottom: 1px solid var(--bp-line);
        }

        .bp-table tbody td {
            padding: 0.7rem 1rem;
            border-bottom: 1px solid var(--bp-line);
            vertical-align: middle;
        }

        .bp-table tbody tr:last-child td {
            border-bottom: none;
        }

    .bp-mono {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.82rem;
        color: var(--bp-steel);
    }

    .bp-strong {
        font-weight: 600;
    }

    .bp-link {
        font-size: 0.85rem;
        color: var(--bp-blueprint);
        text-decoration: none;
        font-weight: 500;
    }

        .bp-link:hover {
            color: var(--bp-safety);
        }

    .bp-empty {
        text-align: center;
        padding: 2rem;
        color: var(--bp-steel);
        margin: 0;
    }

    .bp-count {
        font-size: 0.8rem;
        color: var(--bp-steel);
        margin-top: 0.6rem;
    }

    .bp-badge {
        display: inline-block;
        font-size: 0.72rem;
        font-weight: 500;
        padding: 0.2rem 0.6rem;
        border-radius: 100px;
        color: #fff;
    }

    .bp-badge-enprogreso {
        background: var(--bp-progreso);
    }

    .bp-badge-pausada {
        background: var(--bp-pausada);
        color: var(--bp-ink);
    }

    .bp-badge-finalizada {
        background: var(--bp-finalizada);
    }

    .bp-badge-cancelada {
        background: var(--bp-cancelada);
    }

    .bp-badge-planificada {
        background: var(--bp-planificada);
    }

    .bp-progress {
        display: inline-block;
        width: 90px;
        height: 6px;
        background: var(--bp-concrete);
        border-radius: 4px;
        overflow: hidden;
        vertical-align: middle;
        margin-right: 0.4rem;
    }

    .bp-progress-fill {
        height: 100%;
        background: var(--bp-blueprint-light);
    }

    .bp-progress-num {
        vertical-align: middle;
    }

    /* Modal */
    .bp-modal {
        border: none;
        border-radius: 10px;
        overflow: hidden;
    }

    .bp-modal-header {
        background: var(--bp-blueprint);
        border: none;
        padding: 1.25rem 1.5rem;
    }

        .bp-modal-header .bp-title {
            color: #fff;
            font-size: 1.4rem;
        }

    .bp-modal-body {
        padding: 1.5rem;
        background: var(--bp-concrete);
    }

    .bp-modal-footer {
        border-top: 1px solid var(--bp-line);
        padding: 1rem 1.5rem;
    }

    .bp-label {
        display: block;
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.68rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--bp-steel);
        margin-bottom: 0.3rem;
    }

    @@media (max-width: 576px) {
        .bp-filterbar {
            flex-direction: column;
        }
    }
</style>

<script>
    (function () {
        const search = document.getElementById('bpSearch');
        const estado = document.getElementById('bpFiltroEstado');
        const rows = Array.from(document.querySelectorAll('#bpTbody tr'));
        const empty = document.getElementById('bpEmpty');
        const count = document.getElementById('bpCount');

        function aplicarFiltros() {
            const texto = search.value.trim().toLowerCase();
            const est = estado.value;
            let visibles = 0;

            rows.forEach(row => {
                const coincideTexto = row.dataset.search.includes(texto);
                const coincideEstado = !est || row.dataset.estado === est;
                const visible = coincideTexto && coincideEstado;
                row.classList.toggle('d-none', !visible);
                if (visible) visibles++;
            });

            count.textContent = visibles;
            empty.classList.toggle('d-none', visibles > 0);
        }

        search.addEventListener('input', aplicarFiltros);
        estado.addEventListener('change', aplicarFiltros);
    })();
</script>