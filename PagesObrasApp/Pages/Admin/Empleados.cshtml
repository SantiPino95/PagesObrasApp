@page
@model PagesObrasApp.Pages.Admin.EmpleadosModel
@using System.Linq
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Empleados";

    // --- Datos de muestra (mock) — reemplazar por Model.* cuando conectemos la API vía DTOs ---
    var today = new DateTime(2026, 6, 22);
    var inicioSemana = today.AddDays(-6);   // rolling 7 días
    var inicioMes = new DateTime(today.Year, today.Month, 1);

    var empleados = new[] {
        new { Id=1, Nombre="Rodrigo Méndez",     Cedula="4.521.887-3", Tel="099 112 233", ValorHora=320m },
        new { Id=2, Nombre="Sebastián Ferreira",  Cedula="3.987.654-1", Tel="098 445 566", ValorHora=280m },
        new { Id=3, Nombre="Marcelo Suárez",      Cedula="5.123.456-7", Tel="091 778 899", ValorHora=240m },
        new { Id=4, Nombre="Diego Pereira",       Cedula="4.789.012-5", Tel="097 334 455", ValorHora=280m },
        new { Id=5, Nombre="Luciana Torres",      Cedula="3.456.789-2", Tel="092 667 788", ValorHora=320m },
        new { Id=6, Nombre="Pablo Ríos",          Cedula="5.654.321-9", Tel="094 223 344", ValorHora=200m },
        new { Id=7, Nombre="Carlos Espínola",     Cedula="4.111.222-6", Tel="096 889 900", ValorHora=280m },
    };

    var asignaciones = new[] {
        new { IdAsig=1, IdEmp=1, Obra="Edificio Las Acacias",     Rol="Capataz"  },
        new { IdAsig=2, IdEmp=2, Obra="Edificio Las Acacias",     Rol="Oficial"  },
        new { IdAsig=3, IdEmp=3, Obra="Torre Mirador",            Rol="Ayudante" },
        new { IdAsig=4, IdEmp=4, Obra="Galpón Industrial Ruta 5", Rol="Oficial"  },
        new { IdAsig=5, IdEmp=5, Obra="Torre Mirador",            Rol="Capataz"  },
        new { IdAsig=6, IdEmp=6, Obra="Reforma Local Comercial",  Rol="Ayudante" },
        new { IdAsig=7, IdEmp=7, Obra="Edificio Las Acacias",     Rol="Oficial"  },
        new { IdAsig=8, IdEmp=7, Obra="Galpón Industrial Ruta 5", Rol="Oficial"  },
    };

    // Registro de horas: A=IdAsig  C=Comunes  E=Extras
    var rr = new[] {
        // Rodrigo (1)
        new{A=1,F=today,             C=8m,E=0m}, new{A=1,F=today.AddDays(-1), C=8m,E=2m},
        new{A=1,F=today.AddDays(-2), C=8m,E=0m}, new{A=1,F=today.AddDays(-3), C=8m,E=0m},
        new{A=1,F=today.AddDays(-4), C=8m,E=1m}, new{A=1,F=today.AddDays(-5), C=8m,E=0m},
        new{A=1,F=today.AddDays(-6), C=4m,E=0m}, new{A=1,F=today.AddDays(-8), C=8m,E=0m},
        new{A=1,F=today.AddDays(-9), C=8m,E=2m}, new{A=1,F=today.AddDays(-10),C=8m,E=0m},
        new{A=1,F=today.AddDays(-11),C=8m,E=0m}, new{A=1,F=today.AddDays(-12),C=8m,E=0m},
        new{A=1,F=today.AddDays(-13),C=8m,E=1m}, new{A=1,F=today.AddDays(-15),C=8m,E=0m},
        new{A=1,F=today.AddDays(-16),C=8m,E=0m}, new{A=1,F=today.AddDays(-17),C=8m,E=0m},
        new{A=1,F=today.AddDays(-18),C=8m,E=0m}, new{A=1,F=today.AddDays(-19),C=8m,E=0m},
        new{A=1,F=today.AddDays(-21),C=8m,E=0m},
        // Sebastián (2)
        new{A=2,F=today,             C=8m,E=0m}, new{A=2,F=today.AddDays(-1), C=8m,E=0m},
        new{A=2,F=today.AddDays(-2), C=8m,E=0m}, new{A=2,F=today.AddDays(-3), C=8m,E=0m},
        new{A=2,F=today.AddDays(-4), C=8m,E=0m}, new{A=2,F=today.AddDays(-5), C=8m,E=0m},
        new{A=2,F=today.AddDays(-8), C=8m,E=0m}, new{A=2,F=today.AddDays(-9), C=6m,E=0m},
        new{A=2,F=today.AddDays(-15),C=8m,E=0m}, new{A=2,F=today.AddDays(-16),C=8m,E=0m},
        new{A=2,F=today.AddDays(-17),C=8m,E=0m}, new{A=2,F=today.AddDays(-18),C=8m,E=0m},
        new{A=2,F=today.AddDays(-19),C=8m,E=0m}, new{A=2,F=today.AddDays(-21),C=8m,E=0m},
        // Marcelo (3)
        new{A=3,F=today,             C=6m,E=0m}, new{A=3,F=today.AddDays(-1), C=8m,E=0m},
        new{A=3,F=today.AddDays(-2), C=8m,E=0m}, new{A=3,F=today.AddDays(-3), C=8m,E=0m},
        new{A=3,F=today.AddDays(-4), C=8m,E=0m}, new{A=3,F=today.AddDays(-8), C=8m,E=0m},
        new{A=3,F=today.AddDays(-9), C=8m,E=0m}, new{A=3,F=today.AddDays(-15),C=8m,E=0m},
        new{A=3,F=today.AddDays(-16),C=8m,E=0m},
        // Diego (4) - muchas extras
        new{A=4,F=today,             C=8m,E=2m}, new{A=4,F=today.AddDays(-1), C=8m,E=2m},
        new{A=4,F=today.AddDays(-2), C=8m,E=0m}, new{A=4,F=today.AddDays(-3), C=8m,E=0m},
        new{A=4,F=today.AddDays(-4), C=8m,E=0m}, new{A=4,F=today.AddDays(-5), C=8m,E=0m},
        new{A=4,F=today.AddDays(-6), C=8m,E=0m}, new{A=4,F=today.AddDays(-8), C=8m,E=2m},
        new{A=4,F=today.AddDays(-9), C=8m,E=0m}, new{A=4,F=today.AddDays(-10),C=8m,E=2m},
        new{A=4,F=today.AddDays(-15),C=8m,E=0m}, new{A=4,F=today.AddDays(-16),C=8m,E=0m},
        new{A=4,F=today.AddDays(-17),C=8m,E=0m},
        // Luciana (5)
        new{A=5,F=today,             C=8m,E=0m}, new{A=5,F=today.AddDays(-1), C=8m,E=1m},
        new{A=5,F=today.AddDays(-2), C=8m,E=0m}, new{A=5,F=today.AddDays(-3), C=8m,E=0m},
        new{A=5,F=today.AddDays(-4), C=8m,E=0m}, new{A=5,F=today.AddDays(-5), C=8m,E=0m},
        new{A=5,F=today.AddDays(-6), C=8m,E=0m}, new{A=5,F=today.AddDays(-8), C=8m,E=1m},
        new{A=5,F=today.AddDays(-9), C=8m,E=0m}, new{A=5,F=today.AddDays(-15),C=8m,E=0m},
        new{A=5,F=today.AddDays(-16),C=8m,E=0m},
        // Pablo (6) — ausente hoy
        new{A=6,F=today.AddDays(-1), C=4m,E=0m}, new{A=6,F=today.AddDays(-2), C=8m,E=0m},
        new{A=6,F=today.AddDays(-3), C=8m,E=0m}, new{A=6,F=today.AddDays(-8), C=8m,E=0m},
        new{A=6,F=today.AddDays(-9), C=8m,E=0m}, new{A=6,F=today.AddDays(-15),C=8m,E=0m},
        // Carlos (7=Edificio, 8=Galpón)
        new{A=7,F=today,             C=8m,E=1m}, new{A=7,F=today.AddDays(-1), C=8m,E=0m},
        new{A=7,F=today.AddDays(-2), C=8m,E=0m}, new{A=7,F=today.AddDays(-3), C=8m,E=0m},
        new{A=7,F=today.AddDays(-4), C=8m,E=0m},
        new{A=8,F=today.AddDays(-5), C=8m,E=2m}, new{A=8,F=today.AddDays(-6), C=8m,E=0m},
        new{A=8,F=today.AddDays(-9), C=8m,E=0m}, new{A=8,F=today.AddDays(-15),C=8m,E=0m},
        new{A=8,F=today.AddDays(-16),C=8m,E=0m},
    };

    var vista = empleados.Select(e =>
    {
        var misAsig = asignaciones.Where(a => a.IdEmp == e.Id).ToList();
        var ids = new HashSet<int>(misAsig.Select(a => a.IdAsig));
        var regs = rr.Where(r => ids.Contains(r.A)).ToList();

        var rHoy = regs.Where(r => r.F.Date == today.Date).ToList();
        var rSem = regs.Where(r => r.F.Date >= inicioSemana.Date && r.F.Date <= today.Date).ToList();
        var rMes = regs.Where(r => r.F.Date >= inicioMes.Date && r.F.Date <= today.Date).ToList();

        var hoyC = rHoy.Sum(r => r.C); var hoyE = rHoy.Sum(r => r.E);
        var semC = rSem.Sum(r => r.C); var semE = rSem.Sum(r => r.E);
        var mesC = rMes.Sum(r => r.C); var mesE = rMes.Sum(r => r.E);
        var costo = (mesC + mesE) * e.ValorHora;

        return new
        {
            e.Id,
            e.Nombre,
            e.Cedula,
            e.Tel,
            e.ValorHora,
            Obras = misAsig,
            ObrasStr = string.Join("|", misAsig.Select(a => a.Obra.ToLower())),
            RolesStr = string.Join("|", misAsig.Select(a => a.Rol.ToLower())),
            NombreLow = e.Nombre.ToLower(),
            TrabajandoHoy = hoyC + hoyE > 0,
            // Strings pre-formateados para data attrs
            HoyT = hoyC + hoyE,
            HoyEStr = $"{hoyE:0.#}",
            SemT = semC + semE,
            SemEStr = $"{semE:0.#}",
            MesT = mesC + mesE,
            MesEStr = $"{mesE:0.#}",
            HoyTStr = $"{hoyC + hoyE:0.#}",
            SemTStr = $"{semC + semE:0.#}",
            MesTStr = $"{mesC + mesE:0.#}",
            CostoStr = $"${costo:N0}",
            CostoMes = costo,
        };
    }).OrderByDescending(e => e.HoyT).ThenBy(e => e.Nombre).ToList();

    var totalEmpleados = empleados.Length;
    var trabajandoHoy = vista.Count(e => e.TrabajandoHoy);
    var totalCostoMes = vista.Sum(e => e.CostoMes);
    var totalHoyH = vista.Sum(e => e.HoyT);
    var totalSemH = vista.Sum(e => e.SemT);
    var totalMesH = vista.Sum(e => e.MesT);

    var obrasMock = asignaciones.Select(a => a.Obra).Distinct().OrderBy(o => o).ToArray();
}

<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

<div class="admin-dashboard">

    <!-- HEADER -->
    <section class="bp-section">
        <div class="d-flex justify-content-between align-items-end flex-wrap gap-2">
            <div>
                <span class="bp-eyebrow">Gestión de personal</span>
                <h1 class="bp-title bp-title-dark">Empleados</h1>
            </div>
            <div class="d-flex gap-2">
                <button type="button" class="bp-btn-ghost" data-bs-toggle="modal" data-bs-target="#modalAsignar">
                    Asignar a obra
                </button>
                <button type="button" class="bp-btn-primary" data-bs-toggle="modal" data-bs-target="#modalNuevoEmpleado">
                    + Alta de empleado
                </button>
            </div>
        </div>
    </section>

    <!-- STAT CARDS -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="bp-stat-card">
                <span class="bp-stat-label">Total empleados</span>
                <span class="bp-stat-num">@totalEmpleados</span>
                <span class="bp-stat-sub">en nómina</span>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="bp-stat-card">
                <span class="bp-stat-label">Trabajando hoy</span>
                <div class="d-flex align-items-center gap-2">
                    <span class="bp-stat-num">@trabajandoHoy</span>
                    <span class="bp-pulse-dot"></span>
                </div>
                <span class="bp-stat-sub">de @totalEmpleados asignados</span>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="bp-stat-card">
                <span class="bp-stat-label">
                    Horas equipo
                    <span id="statPeriodoLabel" class="bp-stat-periodo">(hoy)</span>
                </span>
                <span class="bp-stat-num"
                      id="statHorasEquipo"
                      data-hoy="@totalHoyH.ToString("0.#")"
                      data-sem="@totalSemH.ToString("0.#")"
                      data-mes="@totalMesH.ToString("0.#")">@totalHoyH.ToString("0.#")</span>
                <span class="bp-stat-sub">horas acumuladas</span>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="bp-stat-card bp-stat-card--accent">
                <span class="bp-stat-label">Costo estimado mes</span>
                <span class="bp-stat-num bp-stat-num--amber">$@totalCostoMes.ToString("N0")</span>
                <span class="bp-stat-sub">en mano de obra</span>
            </div>
        </div>
    </div>

    <!-- TOGGLE DE PERÍODO + FILTROS -->
    <section class="bp-section">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3">

            <!-- Pill toggle período -->
            <div class="bp-periodo-toggle" role="group" aria-label="Período de horas">
                <button class="bp-periodo-btn active" data-periodo="hoy">Día</button>
                <button class="bp-periodo-btn" data-periodo="sem">Semana (7d)</button>
                <button class="bp-periodo-btn" data-periodo="mes">Mes</button>
            </div>

            <!-- Filtros -->
            <div class="d-flex gap-2 flex-wrap">
                <input type="text" id="bpSearch" class="bp-input" placeholder="Buscar empleado...">
                <select id="bpFiltroObra" class="bp-select">
                    <option value="">Todas las obras</option>
                    @foreach (var o in obrasMock)
                    {
                        <option value="@o.ToLower()">@o</option>
                    }
                </select>
                <select id="bpFiltroRol" class="bp-select">
                    <option value="">Todos los roles</option>
                    <option value="capataz">Capataz</option>
                    <option value="oficial">Oficial</option>
                    <option value="ayudante">Ayudante</option>
                </select>
            </div>
        </div>

        <!-- TABLA -->
        <div class="bp-table-wrap">
            <table class="bp-table" id="bpTabla">
                <thead>
                    <tr>
                        <th>Empleado</th>
                        <th>Obras y rol</th>
                        <th>Hoy</th>
                        <th id="thHoras">Horas <span class="bp-th-periodo">hoy</span></th>
                        <th id="thExtras">Extras</th>
                        <th id="thCosto" class="col-mes d-none">Costo est. mes</th>
                        <th class="text-end">$/h</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody id="bpTbody">
                    @foreach (var e in vista)
                    {
                        <tr data-nombre="@e.NombreLow"
                            data-obras="@e.ObrasStr"
                            data-roles="@e.RolesStr">
                            <!-- Empleado -->
                            <td>
                                <div class="bp-emp-nombre">@e.Nombre</div>
                                <div class="bp-mono bp-steel">@e.Cedula</div>
                                <div class="bp-mono bp-tel">@e.Tel</div>
                            </td>
                            <!-- Obras y rol -->
                            <td>
                                <div class="bp-chip-stack">
                                    @foreach (var a in e.Obras)
                                    {
                                        <div class="bp-obra-row">
                                            <span class="bp-chip">@a.Obra</span>
                                            <span class="bp-rol bp-rol--@a.Rol.ToLower()">@a.Rol</span>
                                        </div>
                                    }
                                </div>
                            </td>
                            <!-- Indicador hoy -->
                            <td>
                                @if (e.TrabajandoHoy)
                                {
                                    <span class="bp-dot bp-dot--on" title="Trabajando hoy"></span>
                                }
                                else
                                {
                                    <span class="bp-dot bp-dot--off" title="Sin registro hoy"></span>
                                }
                            </td>
                            <!-- Horas totales (data-driven) -->
                            <td class="bp-td-horas"
                                data-hoy="@e.HoyTStr"
                                data-sem="@e.SemTStr"
                                data-mes="@e.MesTStr">
                                <span class="bp-horas-num">@e.HoyTStr<small>h</small></span>
                            </td>
                            <!-- Extras (data-driven) -->
                            <td class="bp-td-extras"
                                data-hoy="@e.HoyEStr"
                                data-sem="@e.SemEStr"
                                data-mes="@e.MesEStr">
                                @if (e.HoyT > 0 && decimal.Parse(e.HoyEStr) > 0)
                                {
                                    <span class="bp-extras-num">+@e.HoyEStr<small>h</small></span>
                                }
                                else
                                {
                                    <span class="bp-steel bp-mono">—</span>
                                }
                            </td>
                            <!-- Costo mes (solo visible en período Mes) -->
                            <td class="col-mes d-none bp-mono">
                                @e.CostoStr
                            </td>
                            <!-- Valor hora -->
                            <td class="bp-mono bp-steel text-end">$@e.ValorHora.ToString("N0")</td>
                            <!-- Acción -->
                            <td class="text-end">
                                <a href="#" class="bp-link">Ver →</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <p id="bpEmpty" class="bp-empty d-none">No hay empleados que coincidan con los filtros.</p>
        </div>
        <p class="bp-count">Mostrando <span id="bpCount">@vista.Count</span> de @vista.Count empleados</p>
    </section>

</div>

<!-- Modal: Alta de empleado -->
<div class="modal fade" id="modalNuevoEmpleado" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content bp-modal">
            <div class="modal-header bp-modal-header">
                <div>
                    <span class="bp-eyebrow" style="color:rgba(255,255,255,.65)">Alta de personal</span>
                    <h5 class="modal-title bp-title">Nuevo empleado</h5>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body bp-modal-body">
                <!-- TODO: conectar a OnPostCrearEmpleado cuando esté el HttpClient hacia la API -->
                <div class="row g-3">
                    <div class="col-md-8">
                        <label class="bp-label">Nombre completo</label>
                        <input type="text" class="bp-input w-100" placeholder="Ej: Juan García">
                    </div>
                    <div class="col-md-4">
                        <label class="bp-label">Cédula de identidad</label>
                        <input type="text" class="bp-input w-100" placeholder="Ej: 4.123.456-7">
                    </div>
                    <div class="col-md-6">
                        <label class="bp-label">Teléfono</label>
                        <input type="text" class="bp-input w-100" placeholder="Ej: 099 000 111">
                    </div>
                    <div class="col-md-6">
                        <label class="bp-label">Valor hora ($)</label>
                        <input type="number" min="1" step="10" class="bp-input w-100" placeholder="Ej: 280">
                    </div>
                    <div class="col-12">
                        <hr class="bp-divider">
                        <p class="bp-label mb-2">Asignación a obra (opcional)</p>
                    </div>
                    <div class="col-md-6">
                        <label class="bp-label">Obra</label>
                        <select class="bp-select w-100">
                            <option value="">Sin asignar por ahora</option>
                            @foreach (var o in obrasMock)
                            {
                                <option value="@o">@o</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="bp-label">Rol en obra</label>
                        <select class="bp-select w-100">
                            <option selected>Oficial</option>
                            <option>Capataz</option>
                            <option>Ayudante</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="modal-footer bp-modal-footer">
                <button type="button" class="bp-btn-ghost" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="bp-btn-primary">Guardar empleado</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Asignar a obra -->
<div class="modal fade" id="modalAsignar" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content bp-modal">
            <div class="modal-header bp-modal-header">
                <div>
                    <span class="bp-eyebrow" style="color:rgba(255,255,255,.65)">Movimiento de personal</span>
                    <h5 class="modal-title bp-title">Asignar empleado a obra</h5>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body bp-modal-body">
                <!-- TODO: conectar a OnPostAsignarEmpleado cuando esté el HttpClient hacia la API -->
                <div class="row g-3">
                    <div class="col-12">
                        <label class="bp-label">Empleado</label>
                        <select class="bp-select w-100">
                            <option value="">Seleccionar empleado...</option>
                            @foreach (var e in vista)
                            {
                                <option value="@e.Id">@e.Nombre (@e.Cedula)</option>
                            }
                        </select>
                    </div>
                    <div class="col-12">
                        <label class="bp-label">Obra de destino</label>
                        <select class="bp-select w-100">
                            <option value="">Seleccionar obra...</option>
                            @foreach (var o in obrasMock)
                            {
                                <option value="@o">@o</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="bp-label">Rol en obra</label>
                        <select class="bp-select w-100">
                            <option selected>Oficial</option>
                            <option>Capataz</option>
                            <option>Ayudante</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="bp-label">Valor hora asignado ($)</label>
                        <input type="number" min="1" step="10" class="bp-input w-100" placeholder="Ej: 280">
                    </div>
                    <div class="col-12">
                        <label class="bp-label">Fecha de asignación</label>
                        <input type="date" class="bp-input w-100" value="@today.ToString("yyyy-MM-dd")">
                    </div>
                </div>
            </div>
            <div class="modal-footer bp-modal-footer">
                <button type="button" class="bp-btn-ghost" data-bs-dismiss="modal">Cancelar</button>
