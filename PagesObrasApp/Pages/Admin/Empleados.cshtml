<script>
    (function () {
        // --- TOGGLE DE PERÍODO ---
        const periodoLabels = { hoy: 'hoy', sem: 'semana (7d)', mes: 'mes' };
        const btnsPeriodo   = document.querySelectorAll('.bp-periodo-btn');
        const statHoras     = document.getElementById('statHorasEquipo');
        const statPeriodo   = document.getElementById('statPeriodoLabel');
        const thHoras       = document.getElementById('thHoras');
        const colsMes       = document.querySelectorAll('.col-mes');

        let periodoActual = 'hoy';

        function aplicarPeriodo(periodo) {
            periodoActual = periodo;

            // Stat card de horas equipo
            statHoras.textContent = statHoras.dataset[periodo];
            statPeriodo.textContent = `(${periodoLabels[periodo]})`;

            // Header de la tabla
            const label = periodo === 'hoy' ? 'hoy' : periodo === 'sem' ? 'semana' : 'mes';
            thHoras.querySelector('.bp-th-periodo').textContent = label;

            // Columna Costo: visible solo en "mes"
            colsMes.forEach(el => el.classList.toggle('d-none', periodo !== 'mes'));

            // Celdas de datos
            document.querySelectorAll('#bpTbody tr').forEach(row => {
                const tdHoras  = row.querySelector('.bp-td-horas');
                const tdExtras = row.querySelector('.bp-td-extras');
                if (!tdHoras) return;

                const total  = tdHoras.dataset[periodo];
                const extras = tdExtras.dataset[periodo];
                const extrasNum = parseFloat(extras);

                tdHoras.querySelector('.bp-horas-num').innerHTML =
                    `${total}<small>h</small>`;

                tdExtras.innerHTML = extrasNum > 0
                    ? `<span class="bp-extras-num">+${extras}<small>h</small></span>`
                    : `<span class="bp-steel bp-mono">—</span>`;
            });

            aplicarFiltros();
        }

        btnsPeriodo.forEach(btn => {
            btn.addEventListener('click', () => {
                btnsPeriodo.forEach(b => b.classList.remove('active'));
                btn.classList.add('active');
                aplicarPeriodo(btn.dataset.periodo);
            });
        });

        // --- FILTROS ---
        const search    = document.getElementById('bpSearch');
        const filtroObra = document.getElementById('bpFiltroObra');
        const filtroRol  = document.getElementById('bpFiltroRol');
        const rows      = Array.from(document.querySelectorAll('#bpTbody tr'));
        const empty     = document.getElementById('bpEmpty');
        const count     = document.getElementById('bpCount');

        function aplicarFiltros() {
            const txt  = search.value.trim().toLowerCase();
            const obra = filtroObra.value.toLowerCase();
            const rol  = filtroRol.value.toLowerCase();
            let vis = 0;

            rows.forEach(row => {
                const ok = (!txt  || row.dataset.nombre.includes(txt))
                        && (!obra || row.dataset.obras.includes(obra))
                        && (!rol  || row.dataset.roles.includes(rol));
                row.classList.toggle('d-none', !ok);
                if (ok) vis++;
            });

            count.textContent = vis;
            empty.classList.toggle('d-none', vis > 0);
        }

        search.addEventListener('input', aplicarFiltros);
        filtroObra.addEventListener('change', aplicarFiltros);
        filtroRol.addEventListener('change', aplicarFiltros);
    })();
</script>