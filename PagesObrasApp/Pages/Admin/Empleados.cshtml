@page
@model PagesObrasApp.Pages.Admin.EmpleadosModel
@using System.Linq
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Empleados";

    var asignacionesPorEmpleado = Model.Asignados
        .GroupBy(a => a.IdEmpleado)
        .ToDictionary(g => g.Key, g => g.ToList());

    var vista = Model.Empleados.Select(e => new
    {
        e.IdEmpleado,
        e.NombreCompleto,
        e.Categoria,
        Telefono = e.Telefono ?? "",
        NombreLow = e.NombreCompleto.ToLower(),
        Obras = asignacionesPorEmpleado.TryGetValue(e.IdEmpleado, out var lista) ? lista : new List<PagesObrasApp.Models.EmpleadoObraDto>(),
    }).OrderBy(e => e.NombreCompleto).ToList();

    var totalEmpleados = Model.Empleados.Count;
    var totalAsignados = vista.Count(e => e.Obras.Any());
    var categorias = Model.Empleados.Select(e => e.Categoria).Distinct().OrderBy(c => c).ToList();
}

<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

<div class="admin-dashboard">

    @if (!string.IsNullOrEmpty(Model.Mensaje))
    {
        <div class="alert @(Model.MensajeTipo == "ok" ? "alert-success" : "alert-danger")">@Model.Mensaje</div>
    }

    <!-- HEADER -->
    <section class="bp-section">
        <div class="d-flex justify-content-between align-items-end flex-wrap gap-2">
            <div>
                <span class="bp-eyebrow">Gestión de personal</span>
                <h1 class="bp-title bp-title-dark">Empleados</h1>
            </div>
            <div class="d-flex gap-2">
                <button type="button" class="bp-btn-ghost" data-bs-toggle="modal" data-bs-target="#modalAsignar">
                    Asignar a obra
                </button>
                <button type="button" class="bp-btn-primary" data-bs-toggle="modal" data-bs-target="#modalNuevoEmpleado">
                    + Alta de empleado
                </button>
            </div>
        </div>
    </section>

    <!-- STAT CARDS -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-4">
            <div class="bp-stat-card">
                <span class="bp-stat-label">Total empleados</span>
                <span class="bp-stat-num">@totalEmpleados</span>
                <span class="bp-stat-sub">en nómina</span>
            </div>
        </div>
        <div class="col-6 col-md-4">
            <div class="bp-stat-card">
                <span class="bp-stat-label">Asignados a alguna obra</span>
                <span class="bp-stat-num">@totalAsignados</span>
                <span class="bp-stat-sub">de @totalEmpleados</span>
            </div>
        </div>
    </div>

    <p class="bp-nota mb-3">
        El registro de horas trabajadas y el costeo mensual todavía no están disponibles — dependen de un módulo que la API no expone aún.
    </p>

    <!-- FILTROS -->
    <div class="bp-filterbar mb-3">
        <input type="text" id="bpSearch" class="bp-input" placeholder="Buscar empleado...">
        <select id="bpFiltroCategoria" class="bp-select">
            <option value="">Todas las categorías</option>
            @foreach (var c in categorias)
            {
                <option value="@c.ToLower()">@c</option>
            }
        </select>
    </div>

    <!-- TABLA -->
    <div class="bp-table-wrap">
        <table class="bp-table">
            <thead>
                <tr>
                    <th>Empleado</th>
                    <th>Categoría</th>
                    <th>Teléfono</th>
                    <th>Obras asignadas</th>
                </tr>
            </thead>
            <tbody id="bpTbody">
                @foreach (var e in vista)
                {
                    <tr data-nombre="@e.NombreLow" data-categoria="@e.Categoria.ToLower()">
                        <td class="bp-strong">@e.NombreCompleto</td>
                        <td><span class="bp-tag">@e.Categoria</span></td>
                        <td class="bp-mono">@e.Telefono</td>
                        <td>
                            @if (e.Obras.Any())
                            {
                                <div class="bp-chip-row">
                                    @foreach (var a in e.Obras)
                                    {
                                        <span class="bp-chip">@a.NombreObra</span>
                                    }
                                </div>
                            }
                            else
                            {
                                <span class="bp-steel">Sin asignar</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <p id="bpEmpty" class="bp-empty d-none">No hay empleados que coincidan con los filtros.</p>
    </div>
    <p class="bp-count mt-2">Mostrando <span id="bpCount">@vista.Count</span> de @vista.Count empleados</p>

</div>

<!-- Modal: Alta de empleado -->
<div class="modal fade" id="modalNuevoEmpleado" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content bp-modal">
            <form method="post" asp-page-handler="CrearEmpleado">
                <div class="modal-header bp-modal-header">
                    <div>
                        <span class="bp-eyebrow" style="color:rgba(255,255,255,.65)">Alta de personal</span>
                        <h5 class="modal-title bp-title">Nuevo empleado</h5>
                    </div>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body bp-modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="bp-label">Nombre</label>
                            <input type="text" name="nombre" class="bp-input w-100" placeholder="Ej: Juan" required>
                        </div>
                        <div class="col-md-6">
                            <label class="bp-label">Apellido</label>
                            <input type="text" name="apellido" class="bp-input w-100" placeholder="Ej: García" required>
                        </div>
                        <div class="col-md-6">
                            <label class="bp-label">Categoría</label>
                            <input type="text" name="categoria" class="bp-input w-100" placeholder="Ej: Oficial" required>
                        </div>
                        <div class="col-md-6">
                            <label class="bp-label">Teléfono</label>
                            <input type="text" name="telefono" class="bp-input w-100" placeholder="Ej: 099 000 111">
                        </div>
                    </div>
                </div>
                <div class="modal-footer bp-modal-footer">
                    <button type="button" class="bp-btn-ghost" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="bp-btn-primary">Guardar empleado</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Asignar a obra -->
<div class="modal fade" id="modalAsignar" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content bp-modal">
            <form method="post" asp-page-handler="AsignarEmpleado">
                <div class="modal-header bp-modal-header">
                    <div>
                        <span class="bp-eyebrow" style="color:rgba(255,255,255,.65)">Movimiento de personal</span>
                        <h5 class="modal-title bp-title">Asignar empleado a obra</h5>
                    </div>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body bp-modal-body">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="bp-label">Empleado</label>
                            <select name="idEmpleado" class="bp-select w-100" required>
                                <option value="">Seleccionar empleado...</option>
                                @foreach (var e in Model.Empleados)
                                {
                                    <option value="@e.IdEmpleado">@e.NombreCompleto</option>
                                }
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="bp-label">Obra de destino</label>
                            <select name="idObra" class="bp-select w-100" required>
                                <option value="">Seleccionar obra...</option>
                                @foreach (var o in Model.Obras)
                                {
                                    <option value="@o.IdObra">@o.NombreObra</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="bp-label">Rol en obra</label>
                            <select name="rolEnObra" class="bp-select w-100">
                                <option selected>Oficial</option>
                                <option>Capataz</option>
                                <option>Ayudante</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="bp-label">Valor hora asignado ($)</label>
                            <input type="number" name="valorHoraAsignado" min="1" step="10" class="bp-input w-100" placeholder="Ej: 280" required>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bp-modal-footer">
                    <button type="button" class="bp-btn-ghost" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="bp-btn-primary">Confirmar asignación</button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .admin-dashboard {
        --bp-blueprint: #1B3A5C;
        --bp-blueprint-light: #2D5C8C;
        --bp-concrete: #F1EFEA;
        --bp-steel: #5B6670;
        --bp-safety: #F2A900;
        --bp-ink: #181B1F;
        --bp-line: #D8D3C8;
        font-family: 'Inter', sans-serif;
        color: var(--bp-ink);
    }

        .admin-dashboard .bp-eyebrow {
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.72rem;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            color: var(--bp-steel);
        }

    .bp-title {
        font-family: 'Barlow Condensed', sans-serif;
        font-weight: 600;
        margin: 0.15rem 0;
    }

    .bp-title-dark {
        font-size: 2rem;
        color: var(--bp-ink);
    }

    .bp-section { margin-bottom: 1.5rem; }

    .bp-btn-primary {
        font-weight: 600;
        font-size: 0.88rem;
        background: var(--bp-safety);
        color: var(--bp-ink);
        border: none;
        border-radius: 6px;
        padding: 0.55rem 1.1rem;
    }

    .bp-btn-ghost {
        font-weight: 500;
        font-size: 0.88rem;
        background: transparent;
        color: var(--bp-steel);
        border: 1px solid var(--bp-line);
        border-radius: 6px;
        padding: 0.55rem 1.1rem;
    }

    .bp-stat-card {
        background: #fff;
        border: 1px solid var(--bp-line);
        border-radius: 8px;
        padding: 1rem;
        display: flex;
        flex-direction: column;
    }

    .bp-stat-label { font-size: 0.75rem; color: var(--bp-steel); }
    .bp-stat-num { font-family: 'Barlow Condensed', sans-serif; font-size: 2rem; font-weight: 700; }
    .bp-stat-sub { font-size: 0.72rem; color: var(--bp-steel); }

    .bp-nota {
        font-size: 0.82rem;
        color: var(--bp-steel);
        background: var(--bp-concrete);
        border: 1px dashed var(--bp-line);
        border-radius: 6px;
        padding: 0.6rem 0.9rem;
    }

    .bp-filterbar { display: flex; gap: 0.75rem; flex-wrap: wrap; }

    .bp-input, .bp-select {
        font-size: 0.88rem;
        border: 1px solid var(--bp-line);
        border-radius: 6px;
        padding: 0.5rem 0.8rem;
        background: #fff;
        color: var(--bp-ink);
    }

    #bpSearch { flex: 1; min-width: 220px; }

    .bp-table-wrap {
        background: #fff;
        border: 1px solid var(--bp-line);
        border-radius: 8px;
        overflow: hidden;
    }

    .bp-table { width: 100%; border-collapse: collapse; font-size: 0.88rem; }

        .bp-table thead th {
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.68rem;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            color: var(--bp-steel);
            text-align: left;
            padding: 0.75rem 1rem;
            background: var(--bp-concrete);
            border-bottom: 1px solid var(--bp-line);
        }

        .bp-table tbody td {
            padding: 0.7rem 1rem;
            border-bottom: 1px solid var(--bp-line);
            vertical-align: middle;
        }

        .bp-table tbody tr:last-child td { border-bottom: none; }

    .bp-strong { font-weight: 600; }
    .bp-mono { font-family: 'JetBrains Mono', monospace; font-size: 0.82rem; color: var(--bp-steel); }
    .bp-steel { color: var(--bp-steel); }

    .bp-tag {
        font-size: 0.74rem;
        font-weight: 500;
        padding: 0.18rem 0.55rem;
        border-radius: 4px;
        border: 1px solid var(--bp-line);
        color: var(--bp-steel);
        display: inline-block;
    }

    .bp-chip-row { display: flex; flex-wrap: wrap; gap: 0.35rem; }

    .bp-chip {
        font-size: 0.74rem;
        background: var(--bp-concrete);
        color: var(--bp-ink);
        border-radius: 100px;
        padding: 0.2rem 0.6rem;
    }

    .bp-empty { text-align: center; padding: 2rem; color: var(--bp-steel); margin: 0; }
    .bp-count { font-size: 0.8rem; color: var(--bp-steel); }

    .bp-modal { border: none; border-radius: 10px; overflow: hidden; }
    .bp-modal-header { background: var(--bp-blueprint); border: none; padding: 1.25rem 1.5rem; }
    .bp-modal-header .bp-title { color: #fff; font-size: 1.4rem; }
    .bp-modal-body { padding: 1.5rem; background: var(--bp-concrete); }
    .bp-modal-footer { border-top: 1px solid var(--bp-line); padding: 1rem 1.5rem; }

    .bp-label {
        display: block;
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.68rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--bp-steel);
        margin-bottom: 0.3rem;
    }

    @@media (max-width: 576px) {
        .bp-filterbar { flex-direction: column; }
    }
</style>

<script>
    (function () {
        const search = document.getElementById('bpSearch');
        const categoria = document.getElementById('bpFiltroCategoria');
        const rows = Array.from(document.querySelectorAll('#bpTbody tr'));
        const empty = document.getElementById('bpEmpty');
        const count = document.getElementById('bpCount');

        function aplicarFiltros() {
            const txt = search.value.trim().toLowerCase();
            const cat = categoria.value;
            let visibles = 0;

            rows.forEach(row => {
                const ok = (!txt || row.dataset.nombre.includes(txt)) &&
                           (!cat || row.dataset.categoria === cat);
                row.classList.toggle('d-none', !ok);
                if (ok) visibles++;
            });

            count.textContent = visibles;
            empty.classList.toggle('d-none', visibles > 0);
        }

        search.addEventListener('input', aplicarFiltros);
        categoria.addEventListener('change', aplicarFiltros);
    })();
</script>
