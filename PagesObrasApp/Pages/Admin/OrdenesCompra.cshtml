</style>

<script>
    // Datos serializados para los modales
    const ordenesData = @Html.Raw(JsonSerializer.Serialize(
                                vista.Select(o => new
                                {
                                            id = o.Id,
                                            numero = $"OC-{o.Id:D4}",
                                            proveedor = o.Prov?.Nombre,
                                            fecha = o.FechaPedido.ToString("dd/MM/yyyy"),
                                            total = o.MontoTotal,
                                            estado = o.Estado,
                                            items = o.Items.Select(i => new
                                            {
                                                        material = i.Mat?.Nombre,
                                                        unidad = i.Mat?.Unidad,
                                                        cantPedida = i.Cant,
                                                        precioUnit = i.PU,
                                                        subtotal = i.Sub,
                                                        idMat = i.IdMat,
                                                        stockActual = i.Mat?.Stock ?? 0m,
                                            })
                                })
                ));

    // Materiales disponibles para nueva orden
    const materialesOpts = @Html.Raw(JsonSerializer.Serialize(
                                materiales.Select(m => new { id = m.Id, nombre = m.Nombre, unidad = m.Unidad })
                ));

    (function () {
        const fmt = n => '$' + Math.round(n).toLocaleString('es-UY');

        // ── Filtros
        const search      = document.getElementById('bpSearch');
        const filtroEst   = document.getElementById('bpFiltroEstado');
        const filtroProv  = document.getElementById('bpFiltroProv');
        const rows        = Array.from(document.querySelectorAll('#bpTbody tr'));
        const empty       = document.getElementById('bpEmpty');
        const count       = document.getElementById('bpCount');

        function aplicarFiltros() {
            const txt  = search.value.trim().toLowerCase();
            const est  = filtroEst.value;
            const prov = filtroProv.value;
            let vis = 0;
            rows.forEach(r => {
                const ok = (!txt  || r.dataset.search.includes(txt))
                        && (!est  || r.dataset.estado === est)
                        && (!prov || r.dataset.prov   === prov);
                r.classList.toggle('d-none', !ok);
                if (ok) vis++;
            });
            count.textContent = vis;
            empty.classList.toggle('d-none', vis > 0);
        }
        search.addEventListener('input', aplicarFiltros);
        filtroEst.addEventListener('change', aplicarFiltros);
        filtroProv.addEventListener('change', aplicarFiltros);

        // ── Modal ver detalle
        window.verDetalle = function(id) {
            const o = ordenesData.find(x => x.id === id);
            if (!o) return;

            document.getElementById('detEyebrow').textContent = o.numero;
            document.getElementById('detTitulo').textContent  = o.proveedor;

            const badgeCls = { Pendiente:'bp-badge--pendiente', Parcial:'bp-badge--parcial', Entregado:'bp-badge--entregado', Cancelado:'bp-badge--cancelado' };
            document.getElementById('detHeader').innerHTML = `
                <div class="bp-dh-item"><span class="bp-dh-label">Proveedor</span><span class="bp-dh-val">${o.proveedor}</span></div>
                <div class="bp-dh-item"><span class="bp-dh-label">Fecha pedido</span><span class="bp-dh-val bp-mono">${o.fecha}</span></div>
                <div class="bp-dh-item"><span class="bp-dh-label">Estado</span><span class="bp-badge ${badgeCls[o.estado]||''}">${o.estado}</span></div>
            `;

            document.getElementById('detTbody').innerHTML = o.items.map(i => `
                <tr>
                    <td class="bp-strong">${i.material}</td>
                    <td class="bp-mono bp-steel">${i.unidad}</td>
                    <td class="text-end bp-mono">${i.cantPedida.toLocaleString('es-UY')}</td>
                    <td class="text-end bp-mono">${fmt(i.precioUnit)}</td>
                    <td class="text-end bp-mono" style="font-weight:600">${fmt(i.subtotal)}</td>
                </tr>
            `).join('');

            document.getElementById('detTotal').textContent = fmt(o.total);

            const footer = document.getElementById('detFooter');
            if (o.estado === 'Pendiente' || o.estado === 'Parcial') {
                footer.innerHTML = `
                    <button class="bp-btn-ghost" data-bs-dismiss="modal">Cerrar</button>
                    <button class="bp-btn-entregar"
                            onclick="bootstrap.Modal.getInstance(document.getElementById('modalDetalle')).hide();
                                     setTimeout(()=>abrirConfirmarEntrega(${o.id}),300)">
                        📦 Confirmar entrega
                    </button>`;
            } else {
                footer.innerHTML = `<button class="bp-btn-ghost" data-bs-dismiss="modal">Cerrar</button>`;
            }

            new bootstrap.Modal(document.getElementById('modalDetalle')).show();
        };

        // ── Modal confirmar entrega con impacto en stock
        window.abrirConfirmarEntrega = function(id) {
            const o = ordenesData.find(x => x.id === id);
            if (!o) return;

            document.getElementById('entregaInfo').innerHTML = `
                <span>Orden <strong>${o.numero}</strong></span>
                <span>Proveedor: <strong>${o.proveedor}</strong></span>
                <span>Total: <strong>${fmt(o.total)}</strong></span>
            `;

            document.getElementById('stockTbody').innerHTML = o.items.map(i => {
                const nuevo = i.stockActual + i.cantPedida;
                return `
                    <tr>
                        <td class="bp-strong">${i.material} <span class="bp-mono bp-steel" style="font-size:.72rem">${i.unidad}</span></td>
                        <td class="text-end bp-mono" style="color:var(--bp-ok);font-weight:600">
                            +${i.cantPedida.toLocaleString('es-UY')}
                        </td>
                        <td class="text-end bp-mono bp-steel">${i.stockActual.toLocaleString('es-UY')}</td>
                        <td class="text-end">
                            <span class="bp-stock-nuevo">
                                ${nuevo.toLocaleString('es-UY')}
                            </span>
                            ${i.stockActual === 0 ? '<span style="font-size:.72rem;color:var(--bp-ok);margin-left:.3rem">✓ resuelve alerta</span>' : ''}
                        </td>
                    </tr>`;
            }).join('');

            // Botón confirmar
            document.getElementById('btnEntregarConfirmar').onclick = () => {
                // TODO: conectar a OnPostConfirmarEntrega(id) via HttpClient → API actualiza
                //       Orden_Compra.Estado = 'Entregado' y suma a Stock_Material por cada detalle

                // Optimistic update visual
                const badge = document.getElementById(`badge-${id}`);
                if (badge) {
                    badge.className = 'bp-badge bp-badge--entregado';
                    badge.textContent = 'Entregado';
                }
                const btn = document.getElementById(`btnConfirmar-${id}`);
                if (btn) {
                    btn.disabled = true;
                    btn.textContent = '✓ Entregado';
                    btn.style.background = 'var(--bp-ok)';
                    btn.style.color = '#fff';
                    btn.style.borderColor = 'var(--bp-ok)';
                }

                bootstrap.Modal.getInstance(document.getElementById('modalEntrega')).hide();
            };

            new bootstrap.Modal(document.getElementById('modalEntrega')).show();
        };

        // ── Nueva orden: tabla dinámica
        let itemCount = 0;

        function agregarFila() {
            itemCount++;
            const opts = materialesOpts.map(m =>
                `<option value="${m.id}" data-unidad="${m.unidad}">${m.nombre} (${m.unidad})</option>`
            ).join('');

            const tr = document.createElement('tr');
            tr.id = `item-${itemCount}`;
            tr.innerHTML = `
                <td>
                    <select class="bp-form-select bp-mat-sel" onchange="actualizarTotal()">
                        <option value="">Seleccionar material...</option>${opts}
                    </select>
                </td>
                <td><input type="number" class="bp-form-input text-end bp-cant" min="0.01" step="0.01"
                           placeholder="0" oninput="calcularFila(${itemCount})"></td>
                <td><input type="number" class="bp-form-input text-end bp-pu" min="0" step="0.01"
                           placeholder="0" oninput="calcularFila(${itemCount})"></td>
                <td class="bp-subtotal-cell" id="sub-${itemCount}">$0</td>
                <td><button type="button" class="bp-del-btn" onclick="eliminarFila(${itemCount})">×</button></td>
            `;
            document.getElementById('itemsTbody').appendChild(tr);
            actualizarTotal();
        }

        window.eliminarFila = function(id) {
            document.getElementById(`item-${id}`)?.remove();
            actualizarTotal();
        };

        window.calcularFila = function(id) {
            const tr  = document.getElementById(`item-${id}`);
            const cant = parseFloat(tr.querySelector('.bp-cant').value) || 0;
            const pu   = parseFloat(tr.querySelector('.bp-pu').value)   || 0;
            document.getElementById(`sub-${id}`).textContent = fmt(cant * pu);
            actualizarTotal();
        };

        function actualizarTotal() {
            let total = 0;
            document.querySelectorAll('[id^="sub-"]').forEach(c => {
                total += parseInt(c.textContent.replace(/[$.,\s]/g,'')) || 0;
            });
            document.getElementById('nuevoTotal').textContent = fmt(total);
        }

        document.getElementById('btnAgregarItem').addEventListener('click', agregarFila);
        document.getElementById('modalNueva').addEventListener('show.bs.modal', () => {
            document.getElementById('itemsTbody').innerHTML = '';
            itemCount = 0;
            document.getElementById('nuevoTotal').textContent = '$0';
            agregarFila();
        });
    })();
</script>