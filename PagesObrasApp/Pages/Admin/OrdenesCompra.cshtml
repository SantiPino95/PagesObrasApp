    .bp-del-btn {
        background: none;
        border: none;
        cursor: pointer;
        color: var(--bp-steel);
        font-size: 1.1rem;
        padding: .2rem .4rem;
        border-radius: 4px;
        transition: color .15s,background .15s;
    }

        .bp-del-btn:hover {
            color: var(--bp-danger);
