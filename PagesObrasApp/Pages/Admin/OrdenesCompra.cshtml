@page
@model PagesObrasApp.Pages.Admin.OrdenesCompraModel
@using System.Linq
@using System.Text.Json
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Órdenes de Compra";

    var today = new DateTime(2026, 6, 22);

    // --- Datos de muestra (mock) — reemplazar por Model.* cuando conectemos la API vía DTOs ---
    var proveedores = new[]
    {
        new { Id=1, Nombre="Materiales del Norte S.A." },
        new { Id=2, Nombre="Distribuidora Ferpal"      },
        new { Id=3, Nombre="Hierros Uruguay S.A."      },
        new { Id=4, Nombre="Pinturas Rex"              },
    };

    var materiales = new[]
    {
        new { Id=1, Nombre="Cemento Portland",     Unidad="kg",     Stock=2400m },
        new { Id=2, Nombre="Arena fina",           Unidad="m³",     Stock=18m   },
        new { Id=3, Nombre="Ladrillo común",       Unidad="unidad", Stock=1200m },
        new { Id=4, Nombre="Hierro Ø10mm",         Unidad="kg",     Stock=850m  },
        new { Id=5, Nombre="Hierro Ø8mm",          Unidad="kg",     Stock=120m  },
        new { Id=6, Nombre="Pintura látex blanca", Unidad="litro",  Stock=45m   },
        new { Id=7, Nombre="Piso cerámico 45×45",  Unidad="m²",     Stock=0m    },
        new { Id=8, Nombre="Cal",                  Unidad="kg",     Stock=600m  },
    };

    var ordenes = new[]
    {
        new { Id=1, IdProv=1, FechaPedido=new DateTime(2026,6,5),  MontoTotal=78000m,  Estado="Pendiente" },
        new { Id=2, IdProv=3, FechaPedido=new DateTime(2026,5,20), MontoTotal=196000m, Estado="Entregado" },
        new { Id=3, IdProv=2, FechaPedido=new DateTime(2026,5,28), MontoTotal=52500m,  Estado="Parcial"   },
        new { Id=4, IdProv=1, FechaPedido=new DateTime(2026,6,15), MontoTotal=63600m,  Estado="Pendiente" },
        new { Id=5, IdProv=4, FechaPedido=new DateTime(2026,4,10), MontoTotal=9800m,   Estado="Cancelado" },
        new { Id=6, IdProv=2, FechaPedido=new DateTime(2026,5,5),  MontoTotal=38000m,  Estado="Entregado" },
    };

    var detalles = new[]
    {
        new { IdOrden=1, IdMat=1, Cant=2000m, PU=25m    },
        new { IdOrden=1, IdMat=2, Cant=15m,   PU=1200m  },
        new { IdOrden=2, IdMat=4, Cant=500m,  PU=280m   },
        new { IdOrden=2, IdMat=5, Cant=300m,  PU=220m   },
        new { IdOrden=3, IdMat=3, Cant=5000m, PU=8m     },
        new { IdOrden=3, IdMat=8, Cant=500m,  PU=21m    },
        new { IdOrden=4, IdMat=7, Cant=120m,  PU=480m   },
        new { IdOrden=4, IdMat=6, Cant=80m,   PU=120m   },
        new { IdOrden=5, IdMat=6, Cant=100m,  PU=98m    },
        new { IdOrden=6, IdMat=3, Cant=2000m, PU=7.5m   },
        new { IdOrden=6, IdMat=8, Cant=400m,  PU=20m    },
    };

    var vista = ordenes.Select(o => new
    {
        o.Id,
        o.IdProv,
        o.FechaPedido,
        o.MontoTotal,
        o.Estado,
        Prov = proveedores.FirstOrDefault(p => p.Id == o.IdProv),
        Items = detalles.Where(d => d.IdOrden == o.Id)
                        .Select(d => new
                        {
                            d.IdMat,
                            d.Cant,
                            d.PU,
                            Mat = materiales.FirstOrDefault(m => m.Id == d.IdMat),
                            Sub = d.Cant * d.PU,
                        }).ToList(),
    }).OrderByDescending(o => o.FechaPedido).ToList();

    var totalOrdenes = ordenes.Length;
    var pendientes = ordenes.Count(o => o.Estado == "Pendiente" || o.Estado == "Parcial");
    var entregadas = ordenes.Count(o => o.Estado == "Entregado");
    var montoPend = ordenes.Where(o => o.Estado is "Pendiente" or "Parcial").Sum(o => o.MontoTotal);
    var montoTotal = ordenes.Where(o => o.Estado != "Cancelado").Sum(o => o.MontoTotal);
}

<div class="admin-dashboard">

    <!-- HEADER -->
    <section class="bp-section">
        <div class="d-flex justify-content-between align-items-end flex-wrap gap-2">
            <div>
                <span class="bp-eyebrow">Gestión de compras</span>
                <h1 class="bp-title bp-title-dark">
                    Órdenes de compra
                    @if (pendientes > 0)
                    {
                        <span class="bp-header-badge">@pendientes pendiente@(pendientes > 1 ? "s" : "")</span>
                    }
                </h1>
            </div>
            <button type="button" class="bp-btn-primary" data-bs-toggle="modal" data-bs-target="#modalNueva">
                + Nueva orden
            </button>
        </div>
    </section>

    <!-- STAT CARDS -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="bp-stat-card">
                <span class="bp-stat-label">Total órdenes</span>
                <span class="bp-stat-num">@totalOrdenes</span>
                <span class="bp-stat-sub">emitidas</span>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="bp-stat-card bp-stat-card--pend">
                <span class="bp-stat-label">Pendientes / Parcial</span>
                <span class="bp-stat-num bp-stat-num--amber">@pendientes</span>
                <span class="bp-stat-sub">$@montoPend.ToString("N0") sin recibir</span>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="bp-stat-card bp-stat-card--ok">
                <span class="bp-stat-label">Entregadas</span>
                <span class="bp-stat-num bp-stat-num--ok">@entregadas</span>
                <span class="bp-stat-sub">stock actualizado</span>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="bp-stat-card">
                <span class="bp-stat-label">Monto total</span>
                <span class="bp-stat-num" style="font-size:1.5rem">$@montoTotal.ToString("N0")</span>
                <span class="bp-stat-sub">sin canceladas</span>
            </div>
        </div>
    </div>

    <!-- FILTROS -->
    <div class="bp-filterbar mb-3">
        <input type="text" id="bpSearch" class="bp-input" placeholder="Buscar por proveedor...">
        <select id="bpFiltroEstado" class="bp-select">
            <option value="">Todos los estados</option>
            <option value="pendiente">Pendiente</option>
            <option value="parcial">Parcial</option>
            <option value="entregado">Entregado</option>
            <option value="cancelado">Cancelado</option>
        </select>
        <select id="bpFiltroProv" class="bp-select">
            <option value="">Todos los proveedores</option>
            @foreach (var p in proveedores)
            {
                <option value="@p.Id">@p.Nombre</option>
            }
        </select>
    </div>

    <!-- TABLA -->
    <div class="bp-table-wrap">
        <table class="bp-table">
            <thead>
                <tr>
                    <th>N° Orden</th>
                    <th>Proveedor</th>
                    <th>Fecha pedido</th>
                    <th>Ítems</th>
                    <th class="text-end">Monto total</th>
                    <th class="text-center">Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody id="bpTbody">
                @foreach (var o in vista)
                {
                    var estadoCls = o.Estado.ToLower();
                    var puedeConfirmar = o.Estado is "Pendiente" or "Parcial";
                    <tr id="row-@o.Id"
                        data-estado="@estadoCls"
                        data-prov="@o.IdProv"
                        data-search="@o.Prov?.Nombre.ToLower()">
                        <td class="bp-mono">OC-@o.Id.ToString("D4")</td>
                        <td class="bp-strong">@o.Prov?.Nombre</td>
                        <td class="bp-mono">@o.FechaPedido.ToString("dd/MM/yyyy")</td>
                        <td class="text-center">
                            <span class="bp-items-count">@o.Items.Count</span>
                        </td>
                        <td class="text-end bp-monto">$@o.MontoTotal.ToString("N0")</td>
                        <td class="text-center">
                            <span class="bp-badge bp-badge--@estadoCls" id="badge-@o.Id">@o.Estado</span>
                        </td>
                        <td class="text-end">
                            <div class="bp-actions">
                                <button class="bp-action-btn" onclick="verDetalle(@o.Id)">Ver</button>
                                @if (puedeConfirmar)
                                {
                                    <button class="bp-action-btn bp-action-btn--stock"
                                            id="btnConfirmar-@o.Id"
                                            onclick="abrirConfirmarEntrega(@o.Id)">
                                        📦 Confirmar entrega
                                    </button>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <p id="bpEmpty" class="bp-empty d-none">No hay órdenes que coincidan.</p>
    </div>
    <p class="bp-count mt-2">Mostrando <span id="bpCount">@vista.Count</span> de @vista.Count órdenes</p>

</div>

<!-- ══ MODAL: Ver detalle ══ -->
<div class="modal fade" id="modalDetalle" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content bp-modal">
            <div class="modal-header bp-modal-header">
                <div>
                    <span class="bp-eyebrow" style="color:rgba(255,255,255,.65)" id="detEyebrow">Detalle</span>
                    <h5 class="modal-title bp-title" id="detTitulo">Orden</h5>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body bp-modal-body p-0">
                <div class="bp-det-header" id="detHeader"></div>
                <table class="bp-table">
                    <thead>
                        <tr>
                            <th>Material</th>
                            <th>Unidad</th>
                            <th class="text-end">Cant. pedida</th>
                            <th class="text-end">Precio unit.</th>
                            <th class="text-end">Subtotal</th>
                        </tr>
                    </thead>
                    <tbody id="detTbody"></tbody>
                    <tfoot>
                        <tr class="bp-total-row">
                            <td colspan="4" class="bp-total-label">Total orden</td>
                            <td class="text-end bp-total-num" id="detTotal"></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
            <div class="modal-footer bp-modal-footer" id="detFooter"></div>
        </div>
    </div>
</div>

<!-- ══ MODAL: Confirmar entrega + impacto en stock ══ -->
<div class="modal fade" id="modalEntrega" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content bp-modal">
            <div class="modal-header bp-modal-header" style="background:#2E7D52">
                <div>
                    <span class="bp-eyebrow" style="color:rgba(255,255,255,.65)">Recepción de materiales</span>
                    <h5 class="modal-title bp-title">Confirmar entrega</h5>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body bp-modal-body">

                <div class="bp-entrega-info" id="entregaInfo"></div>

                <div class="bp-stock-impacto-wrap">
                    <p class="bp-stock-impacto-title">
                        <svg viewBox="0 0 24 24"><path d="M20 7H4a2 2 0 00-2 2v6a2 2 0 002 2h16a2 2 0 002-2V9a2 2 0 00-2-2z" /><path d="M16 21V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v16" /></svg>
                        Impacto en stock de materiales
                    </p>
                    <table class="bp-table bp-table--stock">
                        <thead>
                            <tr>
                                <th>Material</th>
                                <th class="text-end">Cant. a recibir</th>
                                <th class="text-end">Stock actual</th>
                                <th class="text-end">Stock tras entrega</th>
                            </tr>
                        </thead>
                        <tbody id="stockTbody"></tbody>
                    </table>
                </div>

                <p class="bp-stock-nota">
                    Al confirmar, el estado de la orden cambia a <strong>Entregado</strong>
                    y las cantidades se suman al stock disponible de cada material.
                    <!-- TODO: conectar a OnPostConfirmarEntrega(id) via HttpClient hacia la API -->
                </p>
            </div>
            <div class="modal-footer bp-modal-footer">
                <button type="button" class="bp-btn-ghost" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="bp-btn-entregar" id="btnEntregarConfirmar">
                    ✓ Confirmar y actualizar stock
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ══ MODAL: Nueva orden ══ -->
<div class="modal fade" id="modalNueva" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content bp-modal">
            <div class="modal-header bp-modal-header">
                <div>
                    <span class="bp-eyebrow" style="color:rgba(255,255,255,.65)">Alta de orden</span>
                    <h5 class="modal-title bp-title">Nueva orden de compra</h5>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body bp-modal-body">
                <!-- TODO: conectar a OnPostCrearOrden cuando esté el HttpClient hacia la API -->
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label class="bp-label">Proveedor</label>
                        <select class="bp-select w-100">
                            <option value="">Seleccionar proveedor...</option>
                            @foreach (var p in proveedores)
                            {
                                <option value="@p.Id">@p.Nombre</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="bp-label">Fecha de pedido</label>
                        <input type="date" class="bp-input w-100" value="@today.ToString("yyyy-MM-dd")">
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="bp-eyebrow">Materiales a pedir</span>
                    <button type="button" class="bp-btn-add" id="btnAgregarItem">+ Agregar material</button>
                </div>

                <div class="bp-items-wrap">
                    <table class="bp-table bp-table--form">
                        <thead>
                            <tr>
                                <th>Material</th>
                                <th class="col-num">Cantidad</th>
                                <th class="col-num">Precio unit. ($)</th>
                                <th class="col-num">Subtotal</th>
                                <th class="col-del"></th>
                            </tr>
                        </thead>
                        <tbody id="itemsTbody"></tbody>
                        <tfoot>
                            <tr class="bp-total-row">
                                <td colspan="3" class="bp-total-label">Total orden</td>
                                <td class="text-end bp-total-num" id="nuevoTotal">$0</td>
                                <td></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
            <div class="modal-footer bp-modal-footer">
                <button type="button" class="bp-btn-ghost" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="bp-btn-primary">Guardar orden</button>
            </div>
        </div>
    </div>
</div>

<style>
    .admin-dashboard {
        --bp-blueprint: #1B3A5C;
        --bp-blueprint-light: #2D5C8C;
        --bp-concrete: #F1EFEA;
        --bp-steel: #5B6670;
        --bp-safety: #F2A900;
        --bp-ink: #181B1F;
        --bp-line: #D8D3C8;
        --bp-ok: #2E7D52;
        --bp-danger: #B23A2E;
        font-family: 'Inter', sans-serif;
        color: var(--bp-ink);
    }

        .admin-dashboard .bp-eyebrow {
            font-family: 'JetBrains Mono',monospace;
            font-size: .72rem;
            letter-spacing: .12em;
            text-transform: uppercase;
            color: var(--bp-steel);
        }

    .bp-title {
        font-family: 'Barlow Condensed',sans-serif;
        font-weight: 600;
        letter-spacing: .01em;
        margin: .15rem 0;
        display: flex;
        align-items: center;
        gap: .5rem;
        flex-wrap: wrap;
    }

    .bp-title-dark {
        font-size: 2rem;
        color: var(--bp-ink);
    }

    .bp-section {
        margin-bottom: 1.75rem;
    }

    .bp-mono {
        font-family: 'JetBrains Mono',monospace;
        font-size: .82rem;
    }

    .bp-steel {
        color: var(--bp-steel);
    }

    .bp-strong {
        font-weight: 600;
    }

    .bp-header-badge {
        font-family: 'Inter',sans-serif;
        font-size: .75rem;
        font-weight: 700;
        background: var(--bp-safety);
        color: var(--bp-ink);
        padding: .15rem .65rem;
        border-radius: 100px;
    }

    /* Stat cards */
    .bp-stat-card {
        background: #fff;
        border: 1px solid var(--bp-line);
        border-radius: 8px;
        padding: 1rem 1.1rem;
        height: 100%;
        display: flex;
        flex-direction: column;
        gap: .15rem;
    }

    .bp-stat-card--pend {
        border-left: 3px solid var(--bp-safety);
    }

    .bp-stat-card--ok {
        border-left: 3px solid var(--bp-ok);
    }

    .bp-stat-label {
        font-family: 'JetBrains Mono',monospace;
        font-size: .68rem;
        letter-spacing: .08em;
        text-transform: uppercase;
        color: var(--bp-steel);
    }

    .bp-stat-num {
        font-family: 'Barlow Condensed',sans-serif;
        font-size: 2rem;
        font-weight: 600;
        color: var(--bp-ink);
        line-height: 1.1;
    }

    .bp-stat-num--amber {
        color: var(--bp-safety);
    }

    .bp-stat-num--ok {
        color: var(--bp-ok);
    }

    .bp-stat-sub {
        font-size: .75rem;
        color: var(--bp-steel);
    }

    /* Filtros */
    .bp-filterbar {
        display: flex;
        gap: .75rem;
        flex-wrap: wrap;
    }

    .bp-input, .bp-select {
        font-family: 'Inter',sans-serif;
        font-size: .88rem;
        border: 1px solid var(--bp-line);
        border-radius: 6px;
        padding: .5rem .8rem;
        background: #fff;
        color: var(--bp-ink);
    }

        .bp-input:focus, .bp-select:focus {
            outline: none;
            border-color: var(--bp-blueprint-light);
            box-shadow: 0 0 0 3px rgba(45,92,140,.12);
        }

    #bpSearch {
        flex: 1;
        min-width: 200px;
    }

    /* Tabla */
    .bp-table-wrap {
        background: #fff;
        border: 1px solid var(--bp-line);
        border-radius: 8px;
        overflow: hidden;
    }

    .bp-table {
        width: 100%;
        border-collapse: collapse;
        font-size: .88rem;
    }

        .bp-table thead th {
            font-family: 'JetBrains Mono',monospace;
            font-size: .68rem;
            letter-spacing: .08em;
            text-transform: uppercase;
            color: var(--bp-steel);
            text-align: left;
            padding: .75rem 1rem;
            background: var(--bp-concrete);
            border-bottom: 1px solid var(--bp-line);
        }

        .bp-table tbody td {
            padding: .72rem 1rem;
            border-bottom: 1px solid var(--bp-line);
            vertical-align: middle;
        }

        .bp-table tbody tr:hover {
            background: #fafaf8;
        }

        .bp-table tbody tr:last-child td {
            border-bottom: none;
        }

    .bp-monto {
        font-family: 'Barlow Condensed',sans-serif;
        font-weight: 700;
        font-size: 1rem;
    }

    .bp-items-count {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 26px;
        height: 26px;
        border-radius: 50%;
        background: var(--bp-concrete);
        border: 1px solid var(--bp-line);
        font-family: 'JetBrains Mono',monospace;
        font-size: .75rem;
        color: var(--bp-steel);
    }

    .bp-empty {
        text-align: center;
        padding: 2rem;
        color: var(--bp-steel);
        margin: 0;
    }

    .bp-count {
        font-size: .8rem;
        color: var(--bp-steel);
    }

    /* Badges */
    .bp-badge {
        display: inline-block;
        font-size: .72rem;
        font-weight: 600;
        padding: .22rem .65rem;
        border-radius: 100px;
        white-space: nowrap;
    }

    .bp-badge--pendiente {
        background: #FFF8E8;
        color: #92670a;
    }

    .bp-badge--parcial {
        background: #EAF0F8;
        color: var(--bp-blueprint-light);
    }

    .bp-badge--entregado {
        background: #EAF4EE;
        color: var(--bp-ok);
    }

    .bp-badge--cancelado {
        background: #FBF0EF;
        color: var(--bp-danger);
    }

    /* Acciones */
    .bp-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: .35rem;
        flex-wrap: wrap;
    }

    .bp-action-btn {
        font-size: .78rem;
        font-weight: 600;
        border-radius: 5px;
        padding: .22rem .6rem;
        border: 1px solid var(--bp-line);
        background: none;
        cursor: pointer;
        transition: all .15s;
        color: var(--bp-steel);
    }

        .bp-action-btn:hover {
            border-color: var(--bp-blueprint);
            color: var(--bp-blueprint);
        }

    .bp-action-btn--stock {
        border-color: #2E7D52;
        color: #2E7D52;
        background: #EAF4EE;
    }

        .bp-action-btn--stock:hover {
            background: #2E7D52;
            color: #fff;
        }

        .bp-action-btn--stock:disabled {
            opacity: .45;
            cursor: not-allowed;
        }

    /* Modal de entrega */
    .bp-entrega-info {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        margin-bottom: 1.25rem;
        padding: .85rem 1rem;
        background: #EAF4EE;
        border-radius: 8px;
        border: 1px solid #c3dfc9;
        font-size: .85rem;
    }

        .bp-entrega-info strong {
            color: var(--bp-ok);
        }

    .bp-stock-impacto-wrap {
        border-radius: 8px;
        overflow: hidden;
        border: 1px solid var(--bp-line);
        margin-bottom: 1rem;
    }

    .bp-stock-impacto-title {
        display: flex;
        align-items: center;
        gap: .5rem;
        font-family: 'JetBrains Mono',monospace;
        font-size: .68rem;
        letter-spacing: .1em;
        text-transform: uppercase;
        color: var(--bp-steel);
        margin-bottom: .6rem;
    }

        .bp-stock-impacto-title svg {
            width: 14px;
            height: 14px;
            fill: none;
