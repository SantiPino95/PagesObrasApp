@page
@model PagesObrasApp.Pages.Admin.ClientesModel
@using System.Linq
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Clientes";

    var vista = Model.Clientes.Select(c => new
    {
        c.IdCliente,
        c.Nombre,
        Tel = c.Telefono ?? "",
        Email = c.Email ?? "",
        Direccion = c.Direccion ?? "",
        NombreLow = c.Nombre.ToLower(),
        EmailLow = (c.Email ?? "").ToLower(),
        Obras = c.Obras,
        TotalObras = c.Obras.Count,
    }).OrderByDescending(c => c.TotalObras).ToList();

    var totalClientes = Model.Clientes.Count;
    var totalConObras = vista.Count(c => c.TotalObras > 0);
}

<div class="admin-dashboard">

    @if (!string.IsNullOrEmpty(Model.Mensaje))
    {
        <div class="alert @(Model.MensajeTipo == "ok" ? "alert-success" : "alert-danger")">@Model.Mensaje</div>
    }

    <!-- HEADER -->
    <section class="bp-section">
        <div class="d-flex justify-content-between align-items-end flex-wrap gap-2">
            <div>
                <span class="bp-eyebrow">Gestión comercial</span>
                <h1 class="bp-title bp-title-dark">Clientes</h1>
            </div>
            <button type="button" class="bp-btn-primary" data-bs-toggle="modal" data-bs-target="#modalNuevoCliente">
                + Nuevo cliente
            </button>
        </div>
    </section>

    <!-- STAT CARDS -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-4">
            <div class="bp-stat-card">
                <span class="bp-stat-label">Total clientes</span>
                <span class="bp-stat-num">@totalClientes</span>
                <span class="bp-stat-sub">registrados</span>
            </div>
        </div>
        <div class="col-6 col-md-4">
            <div class="bp-stat-card">
                <span class="bp-stat-label">Con alguna obra</span>
                <span class="bp-stat-num">@totalConObras</span>
                <span class="bp-stat-sub">de @totalClientes clientes</span>
            </div>
        </div>
    </div>

    <!-- FILTROS -->
    <div class="bp-filterbar mb-3">
        <input type="text" id="bpSearch" class="bp-input" placeholder="Buscar por nombre, email o dirección...">
    </div>

    <!-- CARDS DE CLIENTE -->
    <div class="row g-3" id="bpCards">
        @foreach (var c in vista)
        {
            <div class="col-12 col-md-6 col-xl-4 bp-card-wrap"
                 data-search="@($"{c.NombreLow} {c.EmailLow} {c.Direccion.ToLower()}")">

                <div class="bp-cliente-card @(c.TotalObras > 0 ? "bp-cliente-card--activo" : "")">

                    <!-- Encabezado -->
                    <div class="d-flex justify-content-between align-items-start gap-2">
                        <div class="bp-cliente-avatar">
                            @c.Nombre.Substring(0, 1).ToUpper()
                        </div>
                        <div class="flex-grow-1 min-w-0">
                            <div class="bp-cliente-nombre">@c.Nombre</div>
                            <div class="bp-mono bp-steel bp-id">ID #@c.IdCliente.ToString("D4")</div>
                        </div>
                        <button class="bp-action-btn"
                                title="Editar"
                                onclick="abrirEditar(@c.IdCliente,'@c.Nombre.Replace("'", "\\'")','@c.Tel','@c.Email','@c.Direccion.Replace("'", "\\'")')">
                            ✏
                        </button>
                    </div>

                    <!-- Datos de contacto -->
                    <div class="bp-contacto-grid">
                        <div class="bp-contacto-item">
                            <span class="bp-contacto-label">Teléfono</span>
                            <a href="tel:@c.Tel.Replace(" ", "")" class="bp-contacto-val bp-tel-link">@c.Tel</a>
                        </div>
                        <div class="bp-contacto-item">
                            <span class="bp-contacto-label">Email</span>
                            <a href="mailto:@c.Email" class="bp-contacto-val bp-email-link" title="@c.Email">@c.Email</a>
                        </div>
                        <div class="bp-contacto-item bp-contacto-full">
                            <span class="bp-contacto-label">Dirección</span>
                            <span class="bp-contacto-val">@c.Direccion</span>
                        </div>
                    </div>

                    <!-- Obras (solo nombre: la API todavía no expone Código/Estado en este listado) -->
                    <div class="bp-obras-section">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="bp-obras-label">
                                @c.TotalObras @(c.TotalObras == 1 ? "obra" : "obras")
                            </span>
                        </div>

                        @if (c.Obras.Any())
                        {
                            <div class="bp-obras-list">
                                @foreach (var o in c.Obras)
                                {
                                    <div class="bp-obra-row">
                                        <span class="bp-obra-nom">@o.NombreObra</span>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="bp-sin-obras">Sin obras registradas</p>
                        }
                    </div>

                </div>
            </div>
        }
    </div>
    <p id="bpEmpty" class="bp-empty d-none">No hay clientes que coincidan con la búsqueda.</p>
    <p class="bp-count mt-2">Mostrando <span id="bpCount">@vista.Count</span> de @vista.Count clientes</p>

</div>

<!-- Modal: Nuevo cliente -->
<div class="modal fade" id="modalNuevoCliente" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content bp-modal">
            <form method="post" asp-page-handler="CrearCliente">
                <div class="modal-header bp-modal-header">
                    <div>
                        <span class="bp-eyebrow" style="color:rgba(255,255,255,.65)">Alta de cliente</span>
                        <h5 class="modal-title bp-title">Nuevo cliente</h5>
                    </div>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body bp-modal-body">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="bp-label">Nombre o razón social</label>
                            <input type="text" name="nombre" class="bp-input w-100" placeholder="Ej: Inmobiliaria Sur S.A." required>
                        </div>
                        <div class="col-md-6">
                            <label class="bp-label">Teléfono</label>
                            <input type="text" name="tel" class="bp-input w-100" placeholder="Ej: 099 000 111">
                        </div>
                        <div class="col-md-6">
                            <label class="bp-label">Email</label>
                            <input type="email" name="email" class="bp-input w-100" placeholder="Ej: contacto@empresa.uy" required>
                        </div>
                        <div class="col-12">
                            <label class="bp-label">Dirección</label>
                            <input type="text" name="direccion" class="bp-input w-100" placeholder="Ej: Av. Italia 1234, Montevideo" required>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bp-modal-footer">
                    <button type="button" class="bp-btn-ghost" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="bp-btn-primary">Guardar cliente</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Editar cliente -->
<div class="modal fade" id="modalEditarCliente" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content bp-modal">
            <form method="post" asp-page-handler="EditarCliente">
                <div class="modal-header bp-modal-header">
                    <div>
                        <span class="bp-eyebrow" style="color:rgba(255,255,255,.65)">Edición de cliente</span>
                        <h5 class="modal-title bp-title">Editar cliente</h5>
                    </div>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body bp-modal-body">
                    <input type="hidden" id="editId" name="id">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="bp-label">Nombre o razón social</label>
                            <input type="text" id="editNombre" name="nombre" class="bp-input w-100" required>
                        </div>
                        <div class="col-md-6">
                            <label class="bp-label">Teléfono</label>
                            <input type="text" id="editTel" name="tel" class="bp-input w-100">
                        </div>
                        <div class="col-md-6">
                            <label class="bp-label">Email</label>
                            <input type="email" id="editEmail" name="email" class="bp-input w-100" required>
                        </div>
                        <div class="col-12">
                            <label class="bp-label">Dirección</label>
                            <input type="text" id="editDir" name="direccion" class="bp-input w-100" required>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bp-modal-footer">
                    <button type="button" class="bp-btn-ghost" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="bp-btn-primary">Guardar cambios</button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .admin-dashboard {
        --bp-blueprint: #1B3A5C;
        --bp-blueprint-light: #2D5C8C;
        --bp-concrete: #F1EFEA;
        --bp-steel: #5B6670;
        --bp-safety: #F2A900;
        --bp-ink: #181B1F;
        --bp-line: #D8D3C8;
        --bp-ok: #2E7D52;
        font-family: 'Inter', sans-serif;
        color: var(--bp-ink);
    }

    .admin-dashboard .bp-eyebrow {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.72rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--bp-steel);
    }

    .bp-title {
        font-family: 'Barlow Condensed', sans-serif;
        font-weight: 600;
        letter-spacing: 0.01em;
        margin: 0.15rem 0;
    }

    .bp-title-dark {
        font-size: 2rem;
        color: var(--bp-ink);
    }

    .bp-section {
        margin-bottom: 2rem;
    }

    .bp-mono {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.82rem;
    }

    .bp-steel {
        color: var(--bp-steel);
    }

    .bp-btn-primary {
        font-family: 'Inter', sans-serif;
        font-weight: 600;
        font-size: 0.88rem;
        background: var(--bp-safety);
        color: var(--bp-ink);
        border: none;
        border-radius: 6px;
        padding: 0.55rem 1.1rem;
    }

    .bp-btn-ghost {
        font-family: 'Inter', sans-serif;
        font-weight: 600;
        font-size: 0.85rem;
        background: transparent;
        border: 1px solid var(--bp-line);
        border-radius: 6px;
        padding: 0.5rem 1rem;
    }

    .bp-stat-card {
        background: #fff;
        border: 1px solid var(--bp-line);
        border-radius: 8px;
        padding: 1rem;
        display: flex;
        flex-direction: column;
    }

    .bp-stat-label {
        font-size: 0.75rem;
        color: var(--bp-steel);
    }

    .bp-stat-num {
        font-family: 'Barlow Condensed', sans-serif;
        font-size: 2rem;
        font-weight: 700;
    }

    .bp-stat-sub {
        font-size: 0.72rem;
        color: var(--bp-steel);
    }

    .bp-filterbar {
        display: flex;
        gap: 0.6rem;
    }

    .bp-input, .bp-select {
        border: 1px solid var(--bp-line);
        border-radius: 6px;
        padding: 0.5rem 0.75rem;
        font-size: 0.88rem;
        background: #fff;
    }

    #bpSearch {
        flex: 1;
    }

    .bp-cliente-card {
        background: #fff;
        border: 1px solid var(--bp-line);
        border-radius: 10px;
        padding: 1rem;
        height: 100%;
    }

    .bp-cliente-card--activo {
        border-left: 3px solid var(--bp-ok);
    }

    .bp-cliente-avatar {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: var(--bp-blueprint);
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        flex-shrink: 0;
    }

    .bp-cliente-nombre {
        font-weight: 600;
    }

    .bp-id {
        font-size: 0.72rem;
    }

    .bp-action-btn {
        background: transparent;
        border: none;
        cursor: pointer;
    }

    .bp-contacto-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.5rem;
        margin-top: 0.75rem;
    }

    .bp-contacto-full {
        grid-column: 1 / -1;
    }

    .bp-contacto-label {
        display: block;
        font-size: 0.68rem;
        text-transform: uppercase;
        color: var(--bp-steel);
    }

    .bp-contacto-val {
        font-size: 0.85rem;
        color: var(--bp-ink);
        text-decoration: none;
    }

    .bp-obras-section {
        margin-top: 0.75rem;
        border-top: 1px solid var(--bp-line);
        padding-top: 0.6rem;
    }

    .bp-obras-label {
        font-size: 0.75rem;
        color: var(--bp-steel);
        font-weight: 600;
    }

    .bp-obras-list {
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
        margin-top: 0.5rem;
    }

    .bp-obra-row {
        font-size: 0.8rem;
    }

    .bp-sin-obras {
        font-size: 0.8rem;
        color: var(--bp-steel);
        margin: 0.4rem 0 0;
    }

    .bp-empty {
        text-align: center;
        padding: 3rem;
        color: var(--bp-steel);
    }

    .bp-count {
        font-size: 0.8rem;
        color: var(--bp-steel);
    }

    .bp-modal {
        border: none;
        border-radius: 10px;
        overflow: hidden;
    }

    .bp-modal-header {
        background: var(--bp-blueprint);
        border: none;
        padding: 1.25rem 1.5rem;
    }

    .bp-modal-header .bp-title {
        color: #fff;
        font-size: 1.4rem;
    }

    .bp-modal-body {
        padding: 1.5rem;
        background: var(--bp-concrete);
    }

    .bp-modal-footer {
        border-top: 1px solid var(--bp-line);
        padding: 1rem 1.5rem;
    }

    .bp-label {
        display: block;
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.68rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--bp-steel);
        margin-bottom: 0.3rem;
    }

    @@media (max-width: 576px) {
        .bp-filterbar {
            flex-direction: column;
        }

        .bp-contacto-grid {
            grid-template-columns: 1fr;
        }

        .bp-contacto-full {
            grid-column: unset;
        }
    }
</style>

<script>
    (function () {
        const search = document.getElementById('bpSearch');
        const cards = Array.from(document.querySelectorAll('.bp-card-wrap'));
        const empty = document.getElementById('bpEmpty');
        const count = document.getElementById('bpCount');

        function aplicarFiltros() {
            const txt = search.value.trim().toLowerCase();
            let vis = 0;

            cards.forEach(card => {
                const ok = !txt || card.dataset.search.includes(txt);
                card.style.display = ok ? '' : 'none';
                if (ok) vis++;
            });

            count.textContent = vis;
            empty.classList.toggle('d-none', vis > 0);
        }

        search.addEventListener('input', aplicarFiltros);

        // Pre-cargar modal edición
        window.abrirEditar = function (id, nombre, tel, email, dir) {
            document.getElementById('editId').value = id;
            document.getElementById('editNombre').value = nombre;
            document.getElementById('editTel').value = tel;
            document.getElementById('editEmail').value = email;
            document.getElementById('editDir').value = dir;
            new bootstrap.Modal(document.getElementById('modalEditarCliente')).show();
        };
    })();
</script>
