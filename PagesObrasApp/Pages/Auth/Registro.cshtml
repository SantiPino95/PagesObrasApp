@page
@model PagesObrasApp.Pages.Auth.RegistroModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Registrarse — Constructora Pages y Familia</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700;800&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <style>
        :root {
            --bp-blueprint:       #1B3A5C;
            --bp-blueprint-light: #2D5C8C;
            --bp-blueprint-dark:  #122840;
            --bp-concrete:        #F1EFEA;
            --bp-steel:           #5B6670;
            --bp-safety:          #F2A900;
            --bp-ink:             #181B1F;
            --bp-line:            #D8D3C8;
            --bp-ok:              #2E7D52;
            --bp-danger:          #B23A2E;
        }
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            font-family: 'Inter', sans-serif;
            min-height: 100vh;
            background: var(--bp-blueprint-dark);
            display: flex; flex-direction: column;
        }
        .auth-bg {
            position: fixed; inset: 0; z-index: 0;
            background-image:
                repeating-linear-gradient(0deg, rgba(255,255,255,.04) 0 1px, transparent 1px 36px),
                repeating-linear-gradient(90deg, rgba(255,255,255,.04) 0 1px, transparent 1px 36px);
            pointer-events: none;
        }
        .auth-bg-glow {
            position: fixed; inset: 0; z-index: 0;
            background: radial-gradient(ellipse at 70% 50%, rgba(45,92,140,.35) 0%, transparent 65%);
            pointer-events: none;
        }
        .auth-navbar {
            position: relative; z-index: 10;
            display: flex; align-items: center; justify-content: space-between;
            padding: 0 2rem; height: 52px;
            border-bottom: 1px solid rgba(255,255,255,.06);
        }
        .auth-brand {
            font-family: 'Barlow Condensed', sans-serif;
            font-weight: 700; font-size: 1.05rem; letter-spacing: .03em;
            color: rgba(255,255,255,.8); text-decoration: none;
        }
        .auth-brand span { color: var(--bp-safety); }
        .auth-navbar-link { font-size: .82rem; color: rgba(255,255,255,.55); text-decoration: none; transition: color .15s; }
        .auth-navbar-link:hover { color: rgba(255,255,255,.9); }

        .auth-wrapper {
            position: relative; z-index: 1;
            flex: 1; display: flex; align-items: center; justify-content: center;
            padding: 2rem 1rem;
        }
        .auth-card {
            background: rgba(255,255,255,.97);
            border-radius: 14px; overflow: hidden;
            box-shadow: 0 24px 60px rgba(0,0,0,.35);
            width: 100%; max-width: 420px;
        }
        .auth-card-header {
            background: var(--bp-blueprint); padding: 1.5rem 1.75rem 1.25rem;
            position: relative; overflow: hidden;
        }
        .auth-card-header-grid {
            position: absolute; inset: 0;
            background-image:
                repeating-linear-gradient(0deg, rgba(255,255,255,.05) 0 1px, transparent 1px 20px),
                repeating-linear-gradient(90deg, rgba(255,255,255,.05) 0 1px, transparent 1px 20px);
            pointer-events: none;
        }
        .auth-card-eyebrow {
            position: relative;
            font-family: 'JetBrains Mono', monospace;
            font-size: .65rem; letter-spacing: .14em; text-transform: uppercase;
            color: rgba(255,255,255,.5); display: block; margin-bottom: .3rem;
        }
        .auth-card-title {
            position: relative;
            font-family: 'Barlow Condensed', sans-serif;
            font-weight: 700; font-size: 1.8rem; color: #fff;
            line-height: 1.05; margin-bottom: .15rem;
        }
        .auth-card-sub {
            position: relative; font-size: .8rem; color: rgba(255,255,255,.6); margin: 0;
        }
        .auth-card-body { padding: 1.5rem 1.75rem; }
        .auth-label {
            display: block; font-family: 'JetBrains Mono', monospace;
            font-size: .62rem; letter-spacing: .1em; text-transform: uppercase;
            color: var(--bp-steel); margin-bottom: .3rem;
        }
        .auth-input {
            width: 100%; font-family: 'Inter', sans-serif; font-size: .9rem;
            border: 1px solid var(--bp-line); border-radius: 7px;
            padding: .62rem .9rem; color: var(--bp-ink); background: var(--bp-concrete);
            transition: border-color .15s, box-shadow .15s; margin-bottom: .85rem;
        }
        .auth-input:focus {
            outline: none; border-color: var(--bp-blueprint-light);
            box-shadow: 0 0 0 3px rgba(45,92,140,.12); background: #fff;
        }
        .auth-input.error { border-color: var(--bp-danger); }
        .auth-input.ok    { border-color: var(--bp-ok); }

        /* Indicador de fuerza de contraseña */
        .auth-strength { margin: -.5rem 0 .85rem; display: flex; gap: .3rem; align-items: center; }
        .auth-strength-bar {
            flex: 1; height: 3px; border-radius: 2px; background: var(--bp-line);
            transition: background .3s;
        }
        .auth-strength-label {
            font-family: 'JetBrains Mono', monospace;
            font-size: .62rem; color: var(--bp-steel); white-space: nowrap; min-width: 50px; text-align: right;
        }

        .auth-btn {
            width: 100%; font-family: 'Inter', sans-serif; font-weight: 700; font-size: .95rem;
            background: var(--bp-safety); color: var(--bp-ink);
            border: none; border-radius: 8px; padding: .72rem;
            cursor: pointer; transition: background .2s; margin-top: .25rem;
        }
        .auth-btn:hover { background: #d99500; }
        .auth-btn:disabled { opacity: .5; cursor: not-allowed; }

        .auth-alert {
            display: flex; align-items: flex-start; gap: .5rem;
            background: #FBF0EF; border: 1px solid #e8bcb8; border-radius: 7px;
            padding: .65rem .85rem; font-size: .82rem; color: #7a2d25;
            margin-bottom: 1rem; line-height: 1.4;
        }
        .auth-alert svg { width: 14px; height: 14px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; flex-shrink: 0; margin-top: 1px; }

        /* Info box de aprobación */
        .auth-info-box {
            display: flex; align-items: flex-start; gap: .55rem;
            background: #EAF0F8; border: 1px solid #c5d5e8; border-radius: 7px;
            padding: .65rem .85rem; font-size: .78rem; color: var(--bp-blueprint);
            margin-top: .85rem; line-height: 1.45;
        }
        .auth-info-box svg { width: 14px; height: 14px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; flex-shrink: 0; margin-top: 1px; }

        .auth-card-footer {
            border-top: 1px solid var(--bp-line); padding: .9rem 1.75rem;
            background: var(--bp-concrete);
            display: flex; align-items: center; justify-content: center;
            gap: .35rem; font-size: .8rem; color: var(--bp-steel);
        }
        .auth-card-footer a { color: var(--bp-blueprint); font-weight: 600; text-decoration: none; transition: color .15s; }
        .auth-card-footer a:hover { color: var(--bp-safety); }

        @@media (max-width: 480px) {
            .auth-card-header { padding: 1.25rem 1.25rem 1rem; }
            .auth-card-body   { padding: 1.25rem; }
            .auth-card-footer { padding: .85rem 1.25rem; }
            .auth-navbar { padding: 0 1rem; }
        }
    </style>
</head>
<body>

    <div class="auth-bg"></div>
    <div class="auth-bg-glow"></div>

    <nav class="auth-navbar">
        <a href="/" class="auth-brand">Constructora <span>·</span> Pages y Familia</a>
        <a href="/" class="auth-navbar-link">← Volver al inicio</a>
    </nav>

    <div class="auth-wrapper">
        <div class="auth-card">

            <div class="auth-card-header">
                <div class="auth-card-header-grid"></div>
                <span class="auth-card-eyebrow">Nuevo acceso</span>
                <h1 class="auth-card-title">Crear cuenta</h1>
                <p class="auth-card-sub">El administrador aprobará tu acceso y te asignará un rol</p>
            </div>

            <div class="auth-card-body">

                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="auth-alert">
                        <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M12 8v4M12 16h.01"/></svg>
                        @Model.ErrorMessage
                    </div>
                }

                <form method="post" id="formRegistro">

                    <label class="auth-label" for="nombre">Nombre</label>
                    <input type="text"
                           id="nombre"
                           name="nombre"
                           class="auth-input"
                           placeholder="Ej: Rodrigo"
                           autocomplete="given-name"
                           required>

                    <label class="auth-label" for="apellido">Apellido</label>
                    <input type="text"
                           id="apellido"
                           name="apellido"
                           class="auth-input"
                           placeholder="Ej: Méndez"
                           autocomplete="family-name"
                           required>

                    <label class="auth-label" for="cedula">Cédula</label>
                    <input type="text"
                           id="cedula"
                           name="cedula"
                           class="auth-input"
                           placeholder="Ej: 4.521.887-3"
                           autocomplete="off"
                           required>

                    <label class="auth-label" for="telefono">Teléfono</label>
                    <input type="text"
                           id="telefono"
                           name="telefono"
                           class="auth-input"
                           placeholder="Ej: 099 112 233"
                           autocomplete="tel">

                    <label class="auth-label" for="categoria">Categoría</label>
                    <select id="categoria" name="categoria" class="auth-input" required>
                        <option value="">Seleccioná tu categoría...</option>
                        <option value="Oficial">Oficial</option>
                        <option value="Ayudante">Ayudante</option>
                        <option value="Capataz">Capataz</option>
                        <option value="Ingeniero">Ingeniero</option>
                        <option value="Administrativo">Administrativo</option>
                        <option value="Otro">Otro</option>
                    </select>

                    <label class="auth-label" for="email">Email</label>
                    <input type="email"
                           id="email"
                           name="email"
                           class="auth-input"
                           placeholder="tu@email.com"
                           value="@Model.EmailIngresado"
                           autocomplete="email"
                           required>

                    <label class="auth-label" for="password">Contraseña</label>
                    <input type="password"
                           id="password"
                           name="password"
                           class="auth-input"
                           placeholder="Mínimo 8 caracteres"
                           autocomplete="new-password"
                           oninput="evaluarPassword(this.value)"
                           required>

                    <!-- Indicador de fortaleza -->
                    <div class="auth-strength">
                        <div class="auth-strength-bar" id="bar1"></div>
                        <div class="auth-strength-bar" id="bar2"></div>
                        <div class="auth-strength-bar" id="bar3"></div>
                        <span class="auth-strength-label" id="strengthLabel"></span>
                    </div>

                    <label class="auth-label" for="confirmPassword">Confirmar contraseña</label>
                    <input type="password"
                           id="confirmPassword"
                           name="confirmPassword"
                           class="auth-input"
                           placeholder="Repetí la contraseña"
                           autocomplete="new-password"
                           oninput="validarCoincidencia()"
                           required>

                    <button type="submit" class="auth-btn" id="btnRegistro">
                        Crear mi cuenta
                    </button>

                </form>

                <div class="auth-info-box">
                    <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M12 8v4M12 16h.01"/></svg>
                    Tu cuenta quedará <strong>&nbsp;pendiente de aprobación</strong>&nbsp;
                    hasta que un administrador te habilite y asigne tu rol de acceso.
                </div>

            </div>

            <div class="auth-card-footer">
                ¿Ya tenés cuenta?
                <a href="/Auth/Login">Iniciar sesión</a>
            </div>

        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Indicador de fuerza de contraseña
        function evaluarPassword(val) {
            const bars  = [document.getElementById('bar1'), document.getElementById('bar2'), document.getElementById('bar3')];
            const label = document.getElementById('strengthLabel');

            let nivel = 0;
            if (val.length >= 8)  nivel++;
            if (/[A-Z]/.test(val) || /[0-9]/.test(val)) nivel++;
            if (/[^a-zA-Z0-9]/.test(val) && val.length >= 10) nivel++;

            const colores  = ['', '#B23A2E', '#F2A900', '#2E7D52'];
            const etiquetas = ['', 'Débil', 'Regular', 'Fuerte'];

            bars.forEach((bar, i) => {
                bar.style.background = i < nivel ? colores[nivel] : 'var(--bp-line)';
            });
            label.textContent = val.length > 0 ? etiquetas[nivel] : '';
            label.style.color = colores[nivel];

            validarCoincidencia();
        }

        // Validar que las contraseñas coincidan
        function validarCoincidencia() {
            const pass    = document.getElementById('password').value;
            const confirm = document.getElementById('confirmPassword');
            if (confirm.value.length === 0) { confirm.className = 'auth-input'; return; }
            confirm.className = 'auth-input ' + (pass === confirm.value ? 'ok' : 'error');
        }

        // Feedback de carga al enviar
        document.getElementById('formRegistro').addEventListener('submit', function () {
            const btn = document.getElementById('btnRegistro');
            btn.textContent = 'Creando cuenta...';
            btn.disabled = true;
        });
    </script>
</body>
</html>
