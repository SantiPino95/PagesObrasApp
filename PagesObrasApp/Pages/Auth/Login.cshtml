@page
@model PagesObrasApp.Pages.Auth.LoginModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Iniciar sesión — Constructora Pages y Familia</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700;800&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <style>
            :root {
                --bp-blueprint: #1B3A5C;
                --bp-blueprint-light: #2D5C8C;
                --bp-blueprint-dark: #122840;
                --bp-concrete: #F1EFEA;
                --bp-steel: #5B6670;
                --bp-safety: #F2A900;
                --bp-ink: #181B1F;
                --bp-line: #D8D3C8;
                --bp-ok: #2E7D52;
                --bp-danger: #B23A2E;
            }

            * {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }

            body {
                font-family: 'Inter', sans-serif;
                min-height: 100vh;
                background: var(--bp-blueprint-dark);
                display: flex;
                flex-direction: column;
            }

            /* Fondo con grilla de plano */
            .auth-bg {
                position: fixed;
                inset: 0;
                z-index: 0;
                background-image: repeating-linear-gradient(0deg, rgba(255,255,255,.04) 0 1px, transparent 1px 36px), repeating-linear-gradient(90deg, rgba(255,255,255,.04) 0 1px, transparent 1px 36px);
                pointer-events: none;
            }

            .auth-bg-glow {
                position: fixed;
                inset: 0;
                z-index: 0;
                background: radial-gradient(ellipse at 30% 50%, rgba(45,92,140,.35) 0%, transparent 65%);
                pointer-events: none;
            }

            /* Navbar mínima */
            .auth-navbar {
                position: relative;
                z-index: 10;
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 0 2rem;
                height: 52px;
                border-bottom: 1px solid rgba(255,255,255,.06);
            }

            .auth-brand {
                font-family: 'Barlow Condensed', sans-serif;
                font-weight: 700;
                font-size: 1.05rem;
                letter-spacing: .03em;
                color: rgba(255,255,255,.8);
                text-decoration: none;
            }

                .auth-brand span {
                    color: var(--bp-safety);
                }

            .auth-navbar-link {
                font-size: .82rem;
                color: rgba(255,255,255,.55);
                text-decoration: none;
                transition: color .15s;
            }

                .auth-navbar-link:hover {
                    color: rgba(255,255,255,.9);
                }

            /* Centrado vertical */
            .auth-wrapper {
                position: relative;
                z-index: 1;
                flex: 1;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 2rem 1rem;
            }

            /* Card de auth */
            .auth-card {
                background: rgba(255,255,255,.97);
                border-radius: 14px;
                overflow: hidden;
                box-shadow: 0 24px 60px rgba(0,0,0,.35);
                width: 100%;
                max-width: 400px;
            }

            .auth-card-header {
                background: var(--bp-blueprint);
                padding: 1.5rem 1.75rem 1.25rem;
                position: relative;
                overflow: hidden;
            }

            .auth-card-header-grid {
                position: absolute;
                inset: 0;
                background-image: repeating-linear-gradient(0deg, rgba(255,255,255,.05) 0 1px, transparent 1px 20px), repeating-linear-gradient(90deg, rgba(255,255,255,.05) 0 1px, transparent 1px 20px);
                pointer-events: none;
            }

            .auth-card-eyebrow {
                position: relative;
                font-family: 'JetBrains Mono', monospace;
                font-size: .65rem;
                letter-spacing: .14em;
                text-transform: uppercase;
                color: rgba(255,255,255,.5);
                display: block;
                margin-bottom: .3rem;
            }

            .auth-card-title {
                position: relative;
                font-family: 'Barlow Condensed', sans-serif;
                font-weight: 700;
                font-size: 1.8rem;
                color: #fff;
                line-height: 1.05;
                margin-bottom: .15rem;
            }

            .auth-card-sub {
                position: relative;
                font-size: .8rem;
                color: rgba(255,255,255,.6);
                margin: 0;
            }

            .auth-card-body {
                padding: 1.5rem 1.75rem;
            }

            /* Campos */
            .auth-label {
                display: block;
                font-family: 'JetBrains Mono', monospace;
                font-size: .62rem;
                letter-spacing: .1em;
                text-transform: uppercase;
                color: var(--bp-steel);
                margin-bottom: .3rem;
            }

            .auth-input {
                width: 100%;
                font-family: 'Inter', sans-serif;
                font-size: .9rem;
                border: 1px solid var(--bp-line);
                border-radius: 7px;
                padding: .62rem .9rem;
                color: var(--bp-ink);
                background: var(--bp-concrete);
                transition: border-color .15s, box-shadow .15s;
                margin-bottom: .85rem;
            }

                .auth-input:focus {
                    outline: none;
                    border-color: var(--bp-blueprint-light);
                    box-shadow: 0 0 0 3px rgba(45,92,140,.12);
                    background: #fff;
                }

                .auth-input.error {
                    border-color: var(--bp-danger);
                }

            /* Botón */
            .auth-btn {
                width: 100%;
                font-family: 'Inter', sans-serif;
                font-weight: 700;
                font-size: .95rem;
                background: var(--bp-blueprint);
                color: #fff;
                border: none;
                border-radius: 8px;
                padding: .72rem;
                cursor: pointer;
                transition: background .2s;
                margin-top: .25rem;
            }

                .auth-btn:hover {
                    background: var(--bp-blueprint-light);
                }

            /* Alerta error */
            .auth-alert {
                display: flex;
                align-items: flex-start;
                gap: .5rem;
                background: #FBF0EF;
                border: 1px solid #e8bcb8;
                border-radius: 7px;
                padding: .65rem .85rem;
                font-size: .82rem;
                color: #7a2d25;
                margin-bottom: 1rem;
                line-height: 1.4;
            }

                .auth-alert svg {
                    width: 14px;
                    height: 14px;
                    fill: none;
                    stroke: currentColor;
                    stroke-width: 2;
                    stroke-linecap: round;
                    flex-shrink: 0;
                    margin-top: 1px;
                }

            /* Alerta éxito */
            .auth-success {
                display: flex;
                align-items: flex-start;
                gap: .5rem;
                background: #EAF4EE;
                border: 1px solid #b8ddc3;
                border-radius: 7px;
                padding: .65rem .85rem;
                font-size: .82rem;
                color: #1e5c35;
                margin-bottom: 1rem;
                line-height: 1.4;
            }

            /* Pie del card */
            .auth-card-footer {
                border-top: 1px solid var(--bp-line);
                padding: .9rem 1.75rem;
                background: var(--bp-concrete);
                display: flex;
                align-items: center;
                justify-content: center;
                gap: .35rem;
                font-size: .8rem;
                color: var(--bp-steel);
            }

                .auth-card-footer a {
                    color: var(--bp-blueprint);
                    font-weight: 600;
                    text-decoration: none;
                    transition: color .15s;
                }

                    .auth-card-footer a:hover {
                        color: var(--bp-safety);
                    }

            /* Estado de carga en botón */
            .auth-btn.loading {
                opacity: .75;
                cursor: not-allowed;
            }

            /* Separador "o" */
            .auth-divider {
                display: flex;
                align-items: center;
                gap: .75rem;
                margin: .75rem 0;
                font-size: .75rem;
                color: var(--bp-steel);
            }

                .auth-divider::before, .auth-divider::after {
                    content: '';
                    flex: 1;
                    height: 1px;
                    background: var(--bp-line);
                }

            .auth-btn-ghost {
                width: 100%;
                font-family: 'Inter', sans-serif;
                font-weight: 600;
                font-size: .88rem;
                background: transparent;
                color: var(--bp-blueprint);
                border: 1.5px solid var(--bp-blueprint);
                border-radius: 8px;
                padding: .62rem;
                cursor: pointer;
                transition: all .15s;
                text-decoration: none;
                display: block;
                text-align: center;
            }

                .auth-btn-ghost:hover {
                    background: var(--bp-blueprint);
                    color: #fff;
                }

            @@media (max-width: 480px) {
                .auth-card-header {
                    padding: 1.25rem 1.25rem 1rem;
                }

                .auth-card-body {
                    padding: 1.25rem;
                }

                .auth-card-footer {
                    padding: .85rem 1.25rem;
                }

                .auth-navbar {
                    padding: 0 1rem;
                }
            }
    </style>
</head>
<body>

    <div class="auth-bg"></div>
    <div class="auth-bg-glow"></div>

    <!-- Navbar mínima -->
    <nav class="auth-navbar">
        <a href="/" class="auth-brand">Constructora <span>·</span> Pages y Familia</a>
        <a href="/" class="auth-navbar-link">← Volver al inicio</a>
    </nav>

    <!-- Formulario centrado -->
    <div class="auth-wrapper">
        <div class="auth-card">

            <!-- Header -->
            <div class="auth-card-header">
                <div class="auth-card-header-grid"></div>
                <span class="auth-card-eyebrow">Panel de acceso</span>
                <h1 class="auth-card-title">Bienvenido de vuelta</h1>
                <p class="auth-card-sub">Ingresá con tu cuenta para acceder al sistema</p>
            </div>

            <!-- Body -->
            <div class="auth-card-body">

                @* Mensaje de registro exitoso (viene por TempData desde Registro) *@
                @if (TempData["RegistroExitoso"] != null)
                {
                    <div class="auth-success">
                        ✓ @TempData["RegistroExitoso"]
                    </div>
                }

                @* Error de login *@
                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="auth-alert">
                        <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" /><path d="M12 8v4M12 16h.01" /></svg>
                        @Model.ErrorMessage
                    </div>
                }

                <form method="post">
                    <label class="auth-label" for="email">Email</label>
                    <input type="email"
                           id="email"
                           name="email"
                           class="auth-input @(Model.ErrorMessage != null ? "error" : "")"
                           placeholder="tu@email.com"
                           value="@Model.EmailIngresado"
                           autocomplete="email"
                           required>

                    <label class="auth-label" for="password">Contraseña</label>
                    <input type="password"
                           id="password"
                           name="password"
                           class="auth-input @(Model.ErrorMessage != null ? "error" : "")"
                           placeholder="••••••••"
                           autocomplete="current-password"
                           required>

                    <button type="submit" class="auth-btn" id="btnLogin">
                        Ingresar al sistema
                    </button>
                </form>

                <div class="auth-divider">o</div>

                <a href="/" class="auth-btn-ghost">Buscar mi obra como cliente</a>

            </div>

            <!-- Footer -->
            <div class="auth-card-footer">
                ¿No tenés cuenta?
                <a href="/Auth/Registro">Registrarse</a>
            </div>

        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Feedback visual al enviar
        document.querySelector('form').addEventListener('submit', function () {
        const btn = document.getElementById('btnLogin');
        btn.textContent = 'Ingresando...';
        btn.classList.add('loading');
        btn.disabled = true;
        });
    </script>
</body>
</html>