@page
@model IndexModel
@{
    Layout = null;
    ViewData["Title"] = "Constructora Pages y Familia";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700;800&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <style>
            :root {
                --bp-blueprint: #1B3A5C;
                --bp-blueprint-light: #2D5C8C;
                --bp-blueprint-dark: #122840;
                --bp-concrete: #F1EFEA;
                --bp-steel: #5B6670;
                --bp-safety: #F2A900;
                --bp-ink: #181B1F;
                --bp-line: #D8D3C8;
                --bp-ok: #2E7D52;
            }

            * {
                box-sizing: border-box;
            }

            body {
                font-family: 'Inter', sans-serif;
                background: var(--bp-concrete);
                color: var(--bp-ink);
                margin: 0;
            }

            /* ── NAVBAR ── */
            .bp-navbar {
                position: fixed;
                top: 0;
                left: 0;
                right: 0;
                z-index: 100;
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 0 2rem;
                height: 56px;
                background: rgba(18, 40, 64, 0.92);
                backdrop-filter: blur(8px);
                border-bottom: 1px solid rgba(255,255,255,.07);
            }

            .bp-nav-brand {
                font-family: 'Barlow Condensed', sans-serif;
                font-weight: 700;
                font-size: 1.15rem;
                letter-spacing: .03em;
                color: #fff;
                text-decoration: none;
            }

                .bp-nav-brand span {
                    color: var(--bp-safety);
                }

            .bp-nav-links {
                display: flex;
                align-items: center;
                gap: .5rem;
            }

            .bp-nav-link {
                font-size: .85rem;
                font-weight: 500;
                color: rgba(255,255,255,.75);
                text-decoration: none;
                padding: .35rem .8rem;
                border-radius: 6px;
                transition: color .15s, background .15s;
            }

                .bp-nav-link:hover {
                    color: #fff;
                    background: rgba(255,255,255,.08);
                }

            .bp-nav-btn {
                font-size: .85rem;
                font-weight: 600;
                background: var(--bp-safety);
                color: var(--bp-ink);
                border: none;
                border-radius: 6px;
                padding: .38rem .9rem;
                text-decoration: none;
                cursor: pointer;
                transition: background .15s;
            }

                .bp-nav-btn:hover {
                    background: #d99500;
                    color: var(--bp-ink);
                }

            /* ── HERO ── */
            .bp-hero {
                position: relative;
                min-height: 100vh;
                background-image: url('https://images.unsplash.com/photo-1503387762-592b58a8d16e?w=1800');
                background-size: cover;
                background-position: center;
                display: flex;
                align-items: center;
            }

            .bp-hero-overlay {
                position: absolute;
                inset: 0;
                background: linear-gradient(135deg, rgba(18,40,64,.88) 0%, rgba(18,40,64,.70) 60%, rgba(18,40,64,.60) 100%);
            }

            .bp-hero-grid {
                position: absolute;
                inset: 0;
                background-image: repeating-linear-gradient(0deg, rgba(255,255,255,.04) 0 1px, transparent 1px 40px), repeating-linear-gradient(90deg, rgba(255,255,255,.04) 0 1px, transparent 1px 40px);
                pointer-events: none;
            }

            .bp-hero-content {
                position: relative;
                z-index: 2;
                width: 100%;
                max-width: 1100px;
                margin: 0 auto;
                padding: 5rem 2rem 3rem;
                display: grid;
                grid-template-columns: 1fr 420px;
                gap: 3rem;
                align-items: center;
            }

            /* Lado izquierdo */
            .bp-hero-eyebrow {
                font-family: 'JetBrains Mono', monospace;
                font-size: .72rem;
                letter-spacing: .15em;
                text-transform: uppercase;
                color: var(--bp-safety);
                display: block;
                margin-bottom: .75rem;
            }

            .bp-hero-title {
                font-family: 'Barlow Condensed', sans-serif;
                font-weight: 800;
                font-size: 3.8rem;
                line-height: 1.0;
                color: #fff;
                margin-bottom: 1rem;
                letter-spacing: .01em;
            }

                .bp-hero-title span {
                    color: var(--bp-safety);
                }

            .bp-hero-sub {
                font-size: 1.05rem;
                color: rgba(255,255,255,.72);
                line-height: 1.6;
                max-width: 420px;
                margin-bottom: 2rem;
            }

            .bp-hero-stats {
                display: flex;
                gap: 2rem;
                flex-wrap: wrap;
            }

            .bp-hero-stat {
                display: flex;
                flex-direction: column;
            }

            .bp-hero-stat-num {
                font-family: 'Barlow Condensed', sans-serif;
                font-weight: 700;
                font-size: 2.2rem;
                color: #fff;
                line-height: 1;
            }

            .bp-hero-stat-label {
                font-size: .75rem;
                color: rgba(255,255,255,.55);
                margin-top: .1rem;
            }

            .bp-hero-stat-sep {
                width: 1px;
                background: rgba(255,255,255,.15);
            }

            /* Panel derecho */
            .bp-hero-panel {
                background: rgba(255,255,255,.96);
                border-radius: 14px;
                overflow: hidden;
                box-shadow: 0 24px 60px rgba(0,0,0,.3);
            }

            .bp-panel-tabs {
                display: flex;
                border-bottom: 1px solid var(--bp-line);
            }

            .bp-tab-btn {
                flex: 1;
                padding: .85rem .5rem;
                font-family: 'Inter', sans-serif;
                font-weight: 600;
                font-size: .82rem;
                background: var(--bp-concrete);
                border: none;
                cursor: pointer;
                color: var(--bp-steel);
                transition: all .15s;
                border-bottom: 3px solid transparent;
                display: flex;
                flex-direction: column;
                align-items: center;
                gap: .2rem;
            }

                .bp-tab-btn svg {
                    width: 17px;
                    height: 17px;
                    fill: none;
                    stroke: currentColor;
                    stroke-width: 1.8;
                    stroke-linecap: round;
                    stroke-linejoin: round;
                }

                .bp-tab-btn.active {
                    background: #fff;
                    color: var(--bp-blueprint);
                    border-bottom-color: var(--bp-safety);
                }

            .bp-panel-body {
                padding: 1.5rem;
            }

            .bp-tab-content {
                display: none;
            }

                .bp-tab-content.active {
                    display: block;
                }

            .bp-tab-title {
                font-family: 'Barlow Condensed', sans-serif;
                font-weight: 600;
                font-size: 1.3rem;
                margin-bottom: .25rem;
                color: var(--bp-blueprint);
            }

            .bp-tab-desc {
                font-size: .82rem;
                color: var(--bp-steel);
                margin-bottom: 1.25rem;
                line-height: 1.45;
            }

            .bp-field-label {
                display: block;
                font-family: 'JetBrains Mono', monospace;
                font-size: .65rem;
                letter-spacing: .1em;
                text-transform: uppercase;
                color: var(--bp-steel);
                margin-bottom: .3rem;
            }

            .bp-field-input {
                width: 100%;
                font-family: 'JetBrains Mono', monospace;
                font-size: .95rem;
                border: 1px solid var(--bp-line);
                border-radius: 7px;
                padding: .65rem .9rem;
                color: var(--bp-ink);
                background: var(--bp-concrete);
                letter-spacing: .06em;
                text-transform: uppercase;
                transition: border-color .15s, box-shadow .15s;
                margin-bottom: .9rem;
            }

                .bp-field-input:focus {
                    outline: none;
                    border-color: var(--bp-blueprint-light);
                    box-shadow: 0 0 0 3px rgba(45,92,140,.12);
                    background: #fff;
                }

                .bp-field-input.normal {
                    font-family: 'Inter', sans-serif;
                    font-size: .88rem;
                    text-transform: none;
                    letter-spacing: 0;
                }

            .bp-btn-full {
                width: 100%;
                font-family: 'Inter', sans-serif;
                font-weight: 700;
                font-size: .95rem;
                background: var(--bp-safety);
                color: var(--bp-ink);
                border: none;
                border-radius: 8px;
                padding: .72rem;
                cursor: pointer;
                transition: background .2s;
            }

                .bp-btn-full:hover {
                    background: #d99500;
                }

            .bp-btn-full--blueprint {
                background: var(--bp-blueprint);
                color: #fff;
            }

                .bp-btn-full--blueprint:hover {
                    background: var(--bp-blueprint-light);
                }

            .bp-panel-hint {
                font-size: .75rem;
                color: var(--bp-steel);
                text-align: center;
                margin-top: .85rem;
            }

                .bp-panel-hint a {
                    color: var(--bp-blueprint);
                    font-weight: 600;
                    text-decoration: none;
                }

                    .bp-panel-hint a:hover {
                        color: var(--bp-safety);
                    }

            .bp-alert {
                background: #FBF0EF;
                border: 1px solid #e8bcb8;
                border-radius: 6px;
                padding: .65rem .85rem;
                font-size: .82rem;
                color: #7a2d25;
                margin-bottom: .9rem;
                display: flex;
                align-items: center;
                gap: .5rem;
            }

            .bp-code-hint {
                font-family: 'JetBrains Mono', monospace;
                font-size: .72rem;
                color: var(--bp-steel);
                text-align: center;
                margin-top: .6rem;
            }

            /* ── FEATURES ── */
            .bp-features {
                background: #fff;
                padding: 4rem 2rem;
            }

            .bp-features-inner {
                max-width: 1100px;
                margin: 0 auto;
            }

            .bp-features-header {
                text-align: center;
                margin-bottom: 3rem;
            }

            .bp-features-eyebrow {
                font-family: 'JetBrains Mono', monospace;
                font-size: .72rem;
                letter-spacing: .15em;
                text-transform: uppercase;
                color: var(--bp-steel);
                display: block;
                margin-bottom: .5rem;
            }

            .bp-features-title {
                font-family: 'Barlow Condensed', sans-serif;
                font-weight: 700;
                font-size: 2.4rem;
                color: var(--bp-blueprint);
                margin: 0;
            }

            .bp-features-grid {
                display: grid;
                grid-template-columns: repeat(3, 1fr);
                gap: 1.5rem;
            }

            .bp-feature-card {
                border: 1px solid var(--bp-line);
                border-radius: 10px;
                padding: 1.5rem 1.25rem;
                position: relative;
                overflow: hidden;
                transition: box-shadow .2s, border-color .2s;
            }

                .bp-feature-card:hover {
                    box-shadow: 0 6px 20px rgba(27,58,92,.1);
                    border-color: #bbb;
                }

                .bp-feature-card::before, .bp-feature-card::after {
                    content: '';
                    position: absolute;
                    width: 10px;
                    height: 10px;
                    transition: all .2s;
                }

                .bp-feature-card::before {
                    top: 6px;
                    left: 6px;
                    border-top: 2px solid var(--bp-blueprint);
                    border-left: 2px solid var(--bp-blueprint);
                }

                .bp-feature-card::after {
                    bottom: 6px;
                    right: 6px;
                    border-bottom: 2px solid var(--bp-blueprint);
                    border-right: 2px solid var(--bp-blueprint);
                }

                .bp-feature-card:hover::before, .bp-feature-card:hover::after {
                    width: 16px;
                    height: 16px;
                    border-color: var(--bp-safety);
                }

            .bp-feature-num {
                font-family: 'Barlow Condensed', sans-serif;
                font-weight: 800;
                font-size: 3rem;
                color: var(--bp-blueprint);
                line-height: 1;
                margin-bottom: .35rem;
            }

                .bp-feature-num span {
                    color: var(--bp-safety);
                }

            .bp-feature-title {
                font-family: 'Barlow Condensed', sans-serif;
                font-weight: 600;
                font-size: 1.15rem;
                margin-bottom: .35rem;
            }

            .bp-feature-desc {
                font-size: .82rem;
                color: var(--bp-steel);
                line-height: 1.5;
            }

            /* ── FOOTER ── */
            .bp-footer {
                background: var(--bp-blueprint-dark);
                color: rgba(255,255,255,.6);
                padding: 2.5rem 2rem;
            }

            .bp-footer-inner {
                max-width: 1100px;
                margin: 0 auto;
                display: flex;
                justify-content: space-between;
                align-items: center;
                flex-wrap: wrap;
                gap: 1rem;
            }

            .bp-footer-brand {
                font-family: 'Barlow Condensed', sans-serif;
                font-weight: 700;
                font-size: 1.1rem;
                color: #fff;
                letter-spacing: .03em;
            }

                .bp-footer-brand span {
                    color: var(--bp-safety);
                }

            .bp-footer-info {
                font-size: .78rem;
                line-height: 1.7;
            }

            .bp-footer-copy {
                font-size: .72rem;
                margin-top: .25rem;
            }

            /* ── RESPONSIVE ── */
            @@media (max-width: 900px) {
                .bp-hero-content {
                    grid-template-columns: 1fr;
                    max-width: 540px;
                }

                .bp-hero-title {
                    font-size: 2.8rem;
                }

                .bp-hero-sub {
                    max-width: 100%;
                }

                .bp-features-grid {
                    grid-template-columns: 1fr;
                }

                .bp-hero-stat-sep {
                    display: none;
                }
            }
            @@media (max-width: 576px) {
                .bp-navbar {
                    padding: 0 1rem;
                }

                .bp-nav-link {
                    display: none;
                }

                .bp-hero-content {
                    padding: 4.5rem 1rem 2rem;
                }

                .bp-hero-title {
                    font-size: 2.2rem;
                }

                .bp-footer-inner {
                    flex-direction: column;
                    text-align: center;
                }
            }
    </style>
</head>
<body>

    <!-- NAVBAR -->
    <nav class="bp-navbar">
        <a href="/" class="bp-nav-brand">Constructora <span>·</span> Pages y Familia</a>
        <div class="bp-nav-links">
            <a href="#features" class="bp-nav-link">Nosotros</a>
            <a href="#" class="bp-nav-link" onclick="cambiarTabPorNombre('empleado');return false;">Iniciar sesión</a>
            <a href="#" class="bp-nav-btn" onclick="cambiarTabPorNombre('registro');return false;">Registrarse</a>
        </div>
    </nav>

    <!-- HERO -->
    <section class="bp-hero">
        <div class="bp-hero-overlay"></div>
        <div class="bp-hero-grid"></div>

        <div class="bp-hero-content">

            <!-- Izquierda -->
            <div class="bp-hero-left">
                <span class="bp-hero-eyebrow">Constructora Pages y Familia</span>
                <h1 class="bp-hero-title">
                    Construimos<br>
                    tu <span>proyecto</span><br>
                    con vos
                </h1>
                <p class="bp-hero-sub">
                    Más de 20 años edificando viviendas, locales e industrias.
                    Seguí el avance de tu obra en tiempo real desde cualquier dispositivo.
                </p>
                <div class="bp-hero-stats">
                    <div class="bp-hero-stat">
                        <span class="bp-hero-stat-num">50+</span>
                        <span class="bp-hero-stat-label">Obras completadas</span>
                    </div>
                    <div class="bp-hero-stat-sep"></div>
                    <div class="bp-hero-stat">
                        <span class="bp-hero-stat-num">100+</span>
                        <span class="bp-hero-stat-label">Clientes satisfechos</span>
                    </div>
                    <div class="bp-hero-stat-sep"></div>
                    <div class="bp-hero-stat">
                        <span class="bp-hero-stat-num">20</span>
                        <span class="bp-hero-stat-label">Años de experiencia</span>
                    </div>
                </div>
            </div>

            <!-- Panel derecho con tabs -->
            <div class="bp-hero-panel">
                <div class="bp-panel-tabs">
                    <button class="bp-tab-btn active" onclick="cambiarTab('cliente', this)">
                        <svg viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2" /><circle cx="12" cy="7" r="4" /></svg>
                        Soy cliente
                    </button>
                    <button class="bp-tab-btn" onclick="cambiarTab('empleado', this)">
                        <svg viewBox="0 0 24 24"><rect x="3" y="11" width="18" height="11" rx="2" /><path d="M7 11V7a5 5 0 0110 0v4" /></svg>
                        Iniciar sesión
                    </button>
                    <button class="bp-tab-btn" onclick="cambiarTab('registro', this)">
                        <svg viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 00-4-4H6a4 4 0 00-4 4v2" /><circle cx="9" cy="7" r="4" /><line x1="19" y1="8" x2="19" y2="14" /><line x1="22" y1="11" x2="16" y2="11" /></svg>
                        Registrarse
                    </button>
                </div>

                <div class="bp-panel-body">

                    <!-- Tab: Cliente -->
                    <div class="bp-tab-content active" id="tab-cliente">
                        <p class="bp-tab-title">Seguí tu obra</p>
                        <p class="bp-tab-desc">
                            Ingresá el código que te dio el administrador para ver
                            el avance, fotos y presupuesto de tu proyecto.
                        </p>
                        <form method="post" asp-page-handler="BuscarObra">
                            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                            {
                                <div class="bp-alert">⚠ @Model.ErrorMessage</div>
                            }
                            <label class="bp-field-label" for="codigoObra">Código de obra</label>
                            <input type="text"
                                   id="codigoObra"
                                   name="codigoObra"
                                   class="bp-field-input"
                                   placeholder="OB-2026-014"
                                   autocomplete="off"
                                   required>
                            <button type="submit" class="bp-btn-full">Buscar mi obra →</button>
                        </form>
                        <p class="bp-code-hint">¿No tenés código? Pedíselo al administrador de tu obra.</p>
                    </div>

                    <!-- Tab: Iniciar sesión -->
                    <div class="bp-tab-content" id="tab-empleado">
                        <p class="bp-tab-title">Bienvenido de vuelta</p>
                        <p class="bp-tab-desc">
                            Accedé a tu panel de empleado, capataz o administrador.
                        </p>
                        <form method="post" asp-page-handler="Login">
                            <label class="bp-field-label" for="loginEmail">Email</label>
                            <input type="email" id="loginEmail" name="email"
                                   class="bp-field-input normal"
                                   placeholder="tu@email.com" required>
                            <label class="bp-field-label" for="loginPass">Contraseña</label>
                            <input type="password" id="loginPass" name="password"
                                   class="bp-field-input normal"
                                   placeholder="••••••••" required>
                            <button type="submit" class="bp-btn-full bp-btn-full--blueprint">
                                Ingresar al sistema
                            </button>
                        </form>
                        <p class="bp-panel-hint">
                            ¿No tenés cuenta? <a href="#" onclick="cambiarTabPorNombre('registro');return false;">Registrarse</a>
                        </p>
                    </div>

                    <!-- Tab: Registro -->
                    <div class="bp-tab-content" id="tab-registro">
                        <p class="bp-tab-title">Crear cuenta</p>
                        <p class="bp-tab-desc">
                            Registrate y el administrador te asignará tu rol.
                            Tu cuenta quedará pendiente hasta la aprobación.
                        </p>
                        <form method="post" asp-page-handler="Registro">
                            <label class="bp-field-label" for="regEmail">Email</label>
                            <input type="email" id="regEmail" name="email"
                                   class="bp-field-input normal"
                                   placeholder="tu@email.com" required>
                            <label class="bp-field-label" for="regPass">Contraseña</label>
                            <input type="password" id="regPass" name="password"
                                   class="bp-field-input normal"
                                   placeholder="Mínimo 8 caracteres" required>
                            <label class="bp-field-label" for="regPass2">Confirmar contraseña</label>
                            <input type="password" id="regPass2" name="confirmPassword"
                                   class="bp-field-input normal"
                                   placeholder="Repetí la contraseña" required>
                            <button type="submit" class="bp-btn-full">Crear cuenta</button>
                        </form>
                        <div class="bp-panel-hint" style="margin-top:.75rem">
                            <svg viewBox="0 0 24 24" style="width:13px;height:13px;fill:none;stroke:currentColor;stroke-width:1.8;vertical-align:middle;margin-right:3px"><circle cx="12" cy="12" r="10" /><path d="M12 8v4M12 16h.01" /></svg>
                            Tu cuenta quedará <strong>pendiente de aprobación</strong> hasta que un administrador te habilite.
                        </div>
                        <p class="bp-panel-hint">
                            ¿Ya tenés cuenta? <a href="#" onclick="cambiarTabPorNombre('empleado');return false;">Iniciar sesión</a>
                        </p>
                    </div>

                </div>
            </div>

        </div>
    </section>

    <!-- FEATURES -->
    <section class="bp-features" id="features">
        <div class="bp-features-inner">
            <div class="bp-features-header">
                <span class="bp-features-eyebrow">Por qué elegirnos</span>
                <h2 class="bp-features-title">20 años de obra, calidad y confianza</h2>
            </div>
            <div class="bp-features-grid">
                <div class="bp-feature-card">
                    <div class="bp-feature-num">50<span>+</span></div>
                    <div class="bp-feature-title">Obras completadas</div>
                    <div class="bp-feature-desc">Viviendas, locales comerciales, galpones industriales y ampliaciones entregadas en plazo.</div>
                </div>
                <div class="bp-feature-card">
                    <div class="bp-feature-num">100<span>+</span></div>
                    <div class="bp-feature-title">Clientes satisfechos</div>
                    <div class="bp-feature-desc">Familias y empresas que confiaron en nosotros y volvieron con nuevos proyectos.</div>
                </div>
                <div class="bp-feature-card">
                    <div class="bp-feature-num">20</div>
                    <div class="bp-feature-title">Años de experiencia</div>
                    <div class="bp-feature-desc">Desde 2006 construyendo con los mejores materiales y equipos del mercado local.</div>
                </div>
                <div class="bp-feature-card">
                    <div class="bp-feature-num" style="font-size:2.2rem">En tiempo real</div>
                    <div class="bp-feature-title">Seguimiento de obra</div>
                    <div class="bp-feature-desc">Nuestros clientes pueden ver el avance, fotos y registros de su proyecto desde cualquier dispositivo.</div>
                </div>
                <div class="bp-feature-card">
                    <div class="bp-feature-num" style="font-size:2.2rem">A plazo</div>
                    <div class="bp-feature-title">Entregas puntuales</div>
                    <div class="bp-feature-desc">Planificación rigurosa con cronograma detallado y seguimiento semanal de avances.</div>
                </div>
                <div class="bp-feature-card">
                    <div class="bp-feature-num" style="font-size:2.2rem">Garantía</div>
                    <div class="bp-feature-title">Calidad garantizada</div>
                    <div class="bp-feature-desc">Materiales certificados, mano de obra calificada y supervisión técnica en cada etapa.</div>
                </div>
            </div>
        </div>
    </section>

    <!-- FOOTER -->
    <footer class="bp-footer">
        <div class="bp-footer-inner">
            <div>
                <div class="bp-footer-brand">Constructora <span>·</span> Pages y Familia</div>
                <div class="bp-footer-copy">© 2026 · Todos los derechos reservados</div>
            </div>
            <div class="bp-footer-info">
                <div>📍 Av. Principal 123, Ciudad</div>
                <div>📞 (098) 123-4567</div>
                <div>✉ info@constructora.com</div>
            </div>
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function cambiarTab(nombre, btnActivo) {
        document.querySelectorAll('.bp-tab-btn').forEach(b => b.classList.remove('active'));
        document.querySelectorAll('.bp-tab-content').forEach(c => c.classList.remove('active'));
        btnActivo.classList.add('active');
        document.getElementById('tab-' + nombre).classList.add('active');
        }

        window.cambiarTabPorNombre = function(nombre) {
        const btns = document.querySelectorAll('.bp-tab-btn');
        const map  = { cliente: 0, empleado: 1, registro: 2 };
        if (map[nombre] !== undefined) {
        cambiarTab(nombre, btns[map[nombre]]);
        document.querySelector('.bp-hero-panel').scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
        };

        // Si hay error en la búsqueda, activar tab cliente automáticamente
        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            @:cambiarTabPorNombre('cliente');
        }
    </script>

</body>
</html>