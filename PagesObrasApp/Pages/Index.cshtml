
@page

@model IndexModel
@{
    ViewData["Title"] = "Inicio - Constructora Pages y Familia ";
}

<div class="hero-section">
    <div class="hero-overlay"></div>
    <div class="container hero-content">
        <div class="row justify-content-center">
            <div class="col-lg-8 text-center text-white">
                <h1 class="display-3 fw-bold mb-3">Constructora Pages y Familia</h1>
                <p class="lead mb-4">20 años construyendo los sueños de nuestros clientes</p>

                <div class="cliente-buscador-card bg-white rounded-4 p-4 shadow-lg mx-auto" style="max-width: 500px;">
                    <h5 class="text-dark mb-3">
                        <i class="bi bi-search"></i> ¿Eres cliente?
                    </h5>
                    <p class="text-muted small">Ingresa el código de tu obra para ver el seguimiento</p>

                    <form method="post" asp-page-handler="BuscarObra">
                        <div class="input-group mb-2">
                            <input type="text" class="form-control form-control-lg"
                                   id="codigoObra" name="codigoObra"
                                   placeholder="Ej: OBRA-001" required>
                            <button class="btn btn-warning btn-lg" type="submit">
                                Buscar
                            </button>
                        </div>
                        <small class="text-muted">
                            ⓘ ¿No tienes código? Solicítalo al administrador
                        </small>
                    </form>

                    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                    {
                        <div class="alert alert-danger mt-3 mb-0">
                            <i class="bi bi-exclamation-triangle"></i> @Model.ErrorMessage
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Sección de servicios / características -->
<div class="container py-5">
    <div class="row text-center g-4">
        <div class="col-md-4">
            <div class="feature-card p-4 rounded-4 shadow-sm">
                <i class="bi bi-building fs-1 text-warning"></i>
                <h4 class="mt-3">+50 Obras</h4>
                <p class="text-muted">Proyectos completados con éxito</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="feature-card p-4 rounded-4 shadow-sm">
                <i class="bi bi-people fs-1 text-warning"></i>
                <h4 class="mt-3">+100 Clientes</h4>
                <p class="text-muted">Confían en nuestra calidad</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="feature-card p-4 rounded-4 shadow-sm">
                <i class="bi bi-calendar-check fs-1 text-warning"></i>
                <h4 class="mt-3">Entregas a Tiempo</h4>
                <p class="text-muted">Compromiso con los plazos</p>
            </div>
        </div>
    </div>
</div>

<!-- Footer simple -->
<footer class="bg-dark text-white-50 py-4 mt-5">
    <div class="container text-center">
        <p>&copy; 2026 Constructora Pages y Familia - Todos los derechos reservados</p>
        <p class="small">
            📍 Av. Principal 123, Ciudad | 📞 (098) 123-4567 | ✉️ info@constructora.com
        </p>
    </div>
</footer>

@section Styles {
    <style>
        .hero-section {
            position: relative;
            min-height: 80vh;
            background-image: url('https://images.unsplash.com/photo-1503387762-592b58a8d16e?w=1600');
            background-size: cover;
            background-position: center;
            display: flex;
            align-items: center;
        }

        .hero-overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(135deg, rgba(0,0,0,0.7) 0%, rgba(0,0,0,0.5) 100%);
        }

        .hero-content {
            position: relative;
            z-index: 2;
        }

        .cliente-buscador-card {
            background: rgba(255,255,255,0.95);
            backdrop-filter: blur(5px);
        }

        .feature-card {
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            background: white;
        }

        .feature-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 30px rgba(0,0,0,0.15);
        }

        .btn-warning {
            background-color: #ffc107;
            border-color: #ffc107;
            font-weight: 600;
        }

        .btn-warning:hover {
            background-color: #e0a800;
            border-color: #d39e00;
        }
    </style>
}