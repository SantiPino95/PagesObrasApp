@page
@model PagesObrasApp.Pages.Account.AccesDeniedModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Acceso denegado";
}

@section Styles {
    <style>
        .denied-page {
            min-height: calc(100vh - 160px);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem 1rem;
        }

        .denied-card {
            background: #fff;
            border: 1px solid #D8D3C8;
            border-radius: 14px;
            overflow: hidden;
            width: 100%;
            max-width: 480px;
            box-shadow: 0 8px 32px rgba(27,58,92,.1);
        }

        .denied-header {
            background: #1B3A5C;
            padding: 2rem 2rem 1.5rem;
            text-align: center;
            position: relative;
            overflow: hidden;
        }

        .denied-header-grid {
            position: absolute;
            inset: 0;
            background-image: repeating-linear-gradient(0deg, rgba(255,255,255,.05) 0 1px, transparent 1px 20px), repeating-linear-gradient(90deg, rgba(255,255,255,.05) 0 1px, transparent 1px 20px);
            pointer-events: none;
        }

        .denied-icon {
            position: relative;
            width: 60px;
            height: 60px;
            border-radius: 50%;
            background: rgba(178,58,46,.2);
            border: 2px solid rgba(178,58,46,.4);
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 1rem;
        }

            .denied-icon svg {
                width: 28px;
                height: 28px;
                fill: none;
                stroke: #e8a09a;
                stroke-width: 1.8;
                stroke-linecap: round;
                stroke-linejoin: round;
            }

        .denied-title {
            position: relative;
            font-family: 'Barlow Condensed', sans-serif;
            font-weight: 700;
            font-size: 1.8rem;
            color: #fff;
            margin-bottom: .25rem;
        }

        .denied-sub {
            position: relative;
            font-size: .82rem;
            color: rgba(255,255,255,.6);
        }

        .denied-body {
            padding: 1.75rem 2rem;
        }

        .denied-msg {
            font-size: .9rem;
            color: #5B6670;
            line-height: 1.6;
            text-align: center;
            margin-bottom: 1.5rem;
        }

            .denied-msg strong {
                color: #181B1F;
            }

        .denied-rol-info {
            display: flex;
            flex-direction: column;
            gap: .5rem;
            margin-bottom: 1.5rem;
        }

        .denied-rol-row {
            display: flex;
            align-items: center;
            gap: .75rem;
            background: #F1EFEA;
            border-radius: 7px;
            padding: .6rem .85rem;
            font-size: .82rem;
            color: #5B6670;
        }

            .denied-rol-row svg {
                width: 15px;
                height: 15px;
                fill: none;
                stroke: #1B3A5C;
                stroke-width: 1.8;
                stroke-linecap: round;
                flex-shrink: 0;
            }

        .denied-actions {
            display: flex;
            flex-direction: column;
            gap: .6rem;
        }

        .denied-btn {
            display: block;
            width: 100%;
            text-align: center;
            font-family: 'Inter', sans-serif;
            font-weight: 600;
            font-size: .9rem;
            border-radius: 8px;
            padding: .68rem;
            text-decoration: none;
            transition: all .15s;
            cursor: pointer;
            border: none;
        }

        .denied-btn--primary {
            background: #1B3A5C;
            color: #fff;
        }

            .denied-btn--primary:hover {
                background: #2D5C8C;
                color: #fff;
            }

        .denied-btn--ghost {
            background: transparent;
            color: #5B6670;
            border: 1.5px solid #D8D3C8;
        }

            .denied-btn--ghost:hover {
                border-color: #1B3A5C;
                color: #1B3A5C;
            }

        .denied-btn--safety {
            background: #F2A900;
            color: #181B1F;
        }

            .denied-btn--safety:hover {
                background: #d99500;
                color: #181B1F;
            }

        .denied-footer {
            border-top: 1px solid #D8D3C8;
            padding: .85rem 2rem;
            background: #F1EFEA;
            text-align: center;
            font-family: 'JetBrains Mono', monospace;
            font-size: .65rem;
            letter-spacing: .08em;
            text-transform: uppercase;
            color: #5B6670;
        }
    </style>
}

<div class="denied-page">
    <div class="denied-card">

        <div class="denied-header">
            <div class="denied-header-grid"></div>
            <div class="denied-icon">
                <svg viewBox="0 0 24 24">
                    <rect x="3" y="11" width="18" height="11" rx="2" />
                    <path d="M7 11V7a5 5 0 0110 0v4" />
                    <line x1="12" y1="15" x2="12" y2="17" />
                </svg>
            </div>
            <h1 class="denied-title">Acceso denegado</h1>
            <p class="denied-sub">No tenés permisos para ver esta página</p>
        </div>

        <div class="denied-body">
            <p class="denied-msg">
                Tu cuenta no tiene los permisos necesarios para acceder a esta sección.
                Esto puede pasar porque:
            </p>

            <div class="denied-rol-info">
                <div class="denied-rol-row">
                    <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" /><path d="M12 8v4M12 16h.01" /></svg>
                    Tu cuenta está <strong>&nbsp;pendiente de aprobación</strong>&nbsp; por el administrador
                </div>
                <div class="denied-rol-row">
                    <svg viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2" /><circle cx="9" cy="7" r="4" /></svg>
                    Tu <strong>&nbsp;rol de acceso&nbsp;</strong> no incluye esta sección del sistema
                </div>
                <div class="denied-rol-row">
                    <svg viewBox="0 0 24 24"><rect x="3" y="11" width="18" height="11" rx="2" /><path d="M7 11V7a5 5 0 0110 0v4" /></svg>
                    Tu sesión <strong>&nbsp;expiró&nbsp;</strong> o no estás logueado
                </div>
            </div>

            <div class="denied-actions">
                <button onclick="history.back()" class="denied-btn denied-btn--ghost">
                    ← Volver atrás
                </button>
                <a href="/Auth/Login" class="denied-btn denied-btn--primary">
                    Iniciar sesión con otra cuenta
                </a>
                <a href="/" class="denied-btn denied-btn--safety">
                    Ir al inicio
                </a>
            </div>
        </div>

        <div class="denied-footer">
            Error 403 · Constructora Pages y Familia
        </div>

    </div>
</div>