@page
@model PagesObrasApp.Pages.Admin.UsuariosModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Usuarios";
}

<div class="admin-dashboard">

    @if (!string.IsNullOrEmpty(Model.Mensaje))
    {
        <div class="alert @(Model.MensajeTipo == "ok" ? "alert-success" : "alert-danger") alert-dismissible fade show" role="alert">
            @Model.Mensaje
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <h1>
            Usuarios
            <span class="badge bg-primary ms-2">@Model.Usuarios.Count total</span>
            @if (Model.Usuarios.Count(u => u.Estado == "Pendiente") > 0)
            {
                <span class="badge bg-warning ms-1">@Model.Usuarios.Count(u => u.Estado == "Pendiente") pendientes</span>
            }
        </h1>

        <div class="d-flex gap-2">
            <select id="filtroEstado" class="form-select form-select-sm" style="width:auto;">
                <option value="">Todos</option>
                <option value="Pendiente">Pendientes</option>
                <option value="Activo">Activos</option>
                <option value="Suspendido">Suspendidos</option>
            </select>
            <input type="text" id="buscarUsuario" class="form-control form-control-sm" placeholder="Buscar email..." style="width:200px;">
        </div>
    </div>

    <!-- ============================================================ -->
    <!-- TABLA DE TODOS LOS USUARIOS -->
    <!-- ============================================================ -->
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <strong>Todos los usuarios</strong>
            <span class="badge bg-secondary">@Model.Usuarios.Count</span>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover" id="tablaUsuarios">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Email</th>
                            <th>Empleado</th>
                            <th>Rol</th>
                            <th>Estado</th>
                            <th>Registro</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var u in Model.Usuarios.OrderByDescending(x => x.IdUsuario))
                        {
                            var estadoBadge = u.Estado == "Activo" ? "success" :
                                              u.Estado == "Pendiente" ? "warning" :
                                              u.Estado == "Suspendido" ? "secondary" : "danger";
                            var estadoTexto = u.Estado ?? "Desconocido";

                            <tr data-estado="@u.Estado" data-email="@u.Email.ToLower()">
                                <td><span class="font-monospace">@u.IdUsuario</span></td>
                                <td>@u.Email</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(u.NombreEmpleado))
                                    {
                                        <span>@u.NombreEmpleado @u.ApellidoEmpleado</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Sin empleado</span>
                                    }
                                </td>
                                <td><span class="badge bg-primary">@u.NombreRol</span></td>
                                <td><span class="badge bg-@estadoBadge">@estadoTexto</span></td>
                                <td><span class="font-monospace small">@(u.FechaReg.ToString("dd/MM/yyyy") ?? "—")</span></td>
                                <td class="text-end">
                                    <div class="d-flex gap-1 justify-content-end flex-wrap">
                                        @if (u.Estado == "Pendiente")
                                        {
                                            <form method="post" asp-page-handler="AprobarUsuario" style="display:inline" class="d-flex gap-1">
                                                <input type="hidden" name="id" value="@u.IdUsuario">
                                                <select name="rol" class="form-select form-select-sm" style="width:100px;">
                                                    <option value="Administrador">Admin</option>
                                                    <option value="Supervisor">Supervisor</option>
                                                    <option value="Empleado" selected>Empleado</option>
                                                </select>
                                                <select name="idEmpleado" class="form-select form-select-sm" style="width:120px;">
                                                    <option value="">Sin empleado</option>
                                                    @foreach (var e in Model.Empleados)
                                                    {
                                                        <option value="@e.IdEmpleado">@e.NombreCompleto</option>
                                                    }
                                                </select>
                                                <button type="submit" class="btn btn-sm btn-success">✓</button>
                                            </form>
                                            <form method="post" asp-page-handler="RechazarUsuario" style="display:inline">
                                                <input type="hidden" name="id" value="@u.IdUsuario">
                                                <button type="submit" class="btn btn-sm btn-danger">✗</button>
                                            </form>
                                        }
                                        else
                                        {
                                            <button class="btn btn-sm btn-outline-primary" onclick="abrirEditar(@u.IdUsuario, '@u.Email', '@u.NombreRol', @(u.IdEmpleado ?? 0))">
                                                ✏
                                            </button>
                                            <button class="btn btn-sm btn-outline-secondary" onclick="cambiarRol(@u.IdUsuario, '@u.NombreRol')">
                                                Rol
                                            </button>
                                            @if (u.Estado == "Activo" && u.NombreRol != "Administrador")
                                            {
                                                <form method="post" asp-page-handler="SuspenderUsuario" style="display:inline">
                                                    <input type="hidden" name="id" value="@u.IdUsuario">
                                                    <button type="submit" class="btn btn-sm btn-outline-warning">⏸</button>
                                                </form>
                                            }
                                            @if (u.Estado == "Suspendido")
                                            {
                                                <form method="post" asp-page-handler="ReactivarUsuario" style="display:inline">
                                                    <input type="hidden" name="id" value="@u.IdUsuario">
                                                    <button type="submit" class="btn btn-sm btn-success">▶</button>
                                                </form>
                                            }
                                            @if (u.Estado != "Pendiente")
                                            {
                                                <button class="btn btn-sm btn-outline-danger" onclick="abrirEliminar(@u.IdUsuario, '@u.Email')">
                                                    🗑
                                                </button>
                                            }
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                        @if (!Model.Usuarios.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted py-4">No hay usuarios registrados</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>

<!-- ============================================================ -->
<!-- MODAL: EDITAR USUARIO -->
<!-- ============================================================ -->
<!--
    IMPORTANTE: los "name" de este formulario deben coincidir EXACTAMENTE
    (sin distinguir mayúsculas) con las propiedades de ActualizarUsuarioDto:

    public class ActualizarUsuarioDto
    {
        public int IdUsuario { get; set; }
        public string Email { get; set; } = null!;
        public string? Estado { get; set; }
        public string? Rol { get; set; }
        public int? IdEmpleado { get; set; }
    }
-->
<div class="modal fade" id="modalEditarUsuario" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header" style="background:#1B3A5C;color:white">
                <h5 class="modal-title">Editar Usuario</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-page-handler="EditarUsuario">
                <input type="hidden" name="IdUsuario" id="editUserId">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        <input type="email" name="Email" id="editUserEmail" class="form-control" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Rol</label>
                        <select name="Rol" id="editUserRol" class="form-select" required>
                            <option value="Administrador">Administrador</option>
                            <option value="Supervisor">Supervisor</option>
                            <option value="Empleado">Empleado</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Vincular empleado</label>
                        <select name="IdEmpleado" id="editUserEmpleado" class="form-select">
                            <option value="">Sin empleado</option>
                            @foreach (var e in Model.Empleados)
                            {
                                <option value="@e.IdEmpleado">@e.NombreCompleto</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-warning">Guardar cambios</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ============================================================ -->
<!-- MODAL: CAMBIAR ROL -->
<!-- ============================================================ -->
<div class="modal fade" id="modalCambiarRol" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header" style="background:#1B3A5C;color:white">
                <h5 class="modal-title">Cambiar Rol</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-page-handler="CambiarRol">
                <input type="hidden" name="id" id="cambiarRolId">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Nuevo rol</label>
                        <select name="rol" id="cambiarRolSelect" class="form-select" required>
                            <option value="Administrador">Administrador</option>
                            <option value="Supervisor">Supervisor</option>
                            <option value="Empleado">Empleado</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-warning">Guardar</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ============================================================ -->
<!-- MODAL: ELIMINAR USUARIO -->
<!-- ============================================================ -->
<div class="modal fade" id="modalEliminar" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header" style="background:#B23A2E;color:white">
                <h5 class="modal-title">Eliminar Usuario</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-page-handler="EliminarUsuario">
                <input type="hidden" name="id" id="eliminarId">
                <div class="modal-body">
                    <p>¿Eliminar al usuario <strong id="eliminarEmail"></strong>?</p>
                    <small class="text-muted">Esta acción no se puede deshacer.</small>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-danger">Eliminar</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    // ── FILTROS ──
    document.getElementById('filtroEstado')?.addEventListener('change', function() {
        const val = this.value;
        document.querySelectorAll('#tablaUsuarios tbody tr').forEach(row => {
            const estado = row.dataset.estado || '';
            row.style.display = !val || estado === val ? '' : 'none';
        });
    });

    document.getElementById('buscarUsuario')?.addEventListener('input', function() {
        const txt = this.value.toLowerCase();
        document.querySelectorAll('#tablaUsuarios tbody tr').forEach(row => {
            const email = row.dataset.email || '';
            row.style.display = !txt || email.includes(txt) ? '' : 'none';
        });
    });

    // ── EDITAR USUARIO ──
    function abrirEditar(id, email, rol, idEmpleado) {
        document.getElementById('editUserId').value = id;
        document.getElementById('editUserEmail').value = email;
        document.getElementById('editUserRol').value = rol || 'Empleado';
        document.getElementById('editUserEmpleado').value = idEmpleado || '';
        new bootstrap.Modal(document.getElementById('modalEditarUsuario')).show();
    }

    // ── CAMBIAR ROL ──
    function cambiarRol(id, rolActual) {
        document.getElementById('cambiarRolId').value = id;
        document.getElementById('cambiarRolSelect').value = rolActual || 'Empleado';
        new bootstrap.Modal(document.getElementById('modalCambiarRol')).show();
    }

    // ── ELIMINAR USUARIO ──
    function abrirEliminar(id, email) {
        document.getElementById('eliminarId').value = id;
        document.getElementById('eliminarEmail').textContent = email;
        new bootstrap.Modal(document.getElementById('modalEliminar')).show();
    }
</script>
