@page
@model PagesObrasApp.Pages.Admin.MaterialesModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Materiales";
}

<div class="admin-dashboard">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>Materiales</h1>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#modalReponer">
                + Reponer stock
            </button>
            <button type="button" class="btn btn-warning" data-bs-toggle="modal" data-bs-target="#modalNuevoMaterial">
                + Nuevo material
            </button>
        </div>
    </div>

    <!-- Filtros -->
    <div class="row mb-3">
        <div class="col-md-6">
            <input type="text" id="searchMaterial" class="form-control" placeholder="Buscar material...">
        </div>
        <div class="col-md-3">
            <select id="filtroStock" class="form-select">
                <option value="">Todos</option>
                <option value="critico">Stock crítico</option>
                <option value="ok">Stock suficiente</option>
            </select>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-striped" id="tablaMateriales">
            <thead>
                <tr>
                    <th>Material</th>
                    <th>Unidad</th>
                    <th class="text-end">Stock</th>
                    <th class="text-end">Mínimo</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var m in Model.Materiales.OrderBy(x => x.Nombre))
                {
                    <tr data-nombre="@m.Nombre.ToLower()" data-stock="@(m.RequiereReposicion ? "critico" : "ok")">
                        <td><strong>@m.Nombre</strong></td>
                        <td>@m.UnidadMedida</td>
                        <td class="text-end @(m.RequiereReposicion ? "text-danger fw-bold" : "")">@m.CantidadDisponible.ToString("N2")</td>
                        <td class="text-end">@m.StockMinimo.ToString("N2")</td>
                        <td>
                            <span class="badge @(m.RequiereReposicion ? "bg-danger" : "bg-success")">
                                @(m.RequiereReposicion ? "⚠️ Reponer" : "✅ OK")
                            </span>
                        </td>
                        <td class="text-end">
                            <button class="btn btn-sm btn-outline-primary" onclick="abrirConsumir(@m.IdMaterial, '@m.Nombre', '@m.UnidadMedida')">
                                Consumir
                            </button>
                            <button class="btn btn-sm btn-outline-success" onclick="abrirReponer(@m.IdMaterial, '@m.Nombre')">
                                Reponer
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- MODAL: Nuevo Material -->
<div class="modal fade" id="modalNuevoMaterial" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header" style="background:#1B3A5C;color:white">
                <h5 class="modal-title">Nuevo Material</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-page-handler="CrearMaterial">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Nombre</label>
                        <input type="text" name="nombre" class="form-control" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Unidad de medida</label>
                        <input type="text" name="unidadMedida" class="form-control" placeholder="kg, m³, unidad" required>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Cantidad inicial</label>
                            <input type="number" name="cantidadInicial" class="form-control" step="0.01" required>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Stock mínimo</label>
                            <input type="number" name="stockMinimo" class="form-control" step="0.01" required>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-warning">Guardar</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- MODAL: Reponer Stock -->
<div class="modal fade" id="modalReponer" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header" style="background:#2E7D52;color:white">
                <h5 class="modal-title">Reponer Stock</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-page-handler="ReponerStock">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Material</label>
                        <select name="idMaterial" class="form-select" required>
                            <option value="">Seleccionar...</option>
                            @foreach (var m in Model.Materiales)
                            {
                                <option value="@m.IdMaterial">@m.Nombre (@m.CantidadDisponible.ToString("N2") @m.UnidadMedida)</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Cantidad a agregar</label>
                        <input type="number" name="cantidad" class="form-control" step="0.01" required>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-success">Confirmar</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- MODAL: Consumir -->
<div class="modal fade" id="modalConsumir" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header" style="background:#2D6CDF;color:white">
                <h5 class="modal-title">Consumir Material</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-page-handler="ConsumirMaterial">
                <input type="hidden" name="idMaterial" id="consumirIdMaterial">
                <div class="modal-body">
                    <p><strong id="consumirNombre"></strong> (<span id="consumirUnidad"></span>)</p>
                    <div class="mb-3">
                        <label class="form-label">Obra</label>
                        <select name="idObra" class="form-select" required>
                            <option value="">Seleccionar obra...</option>
                            @foreach (var o in Model.Obras)
                            {
                                <option value="@o.IdObra">@o.NombreObra (@o.CodigoFormateado)</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Cantidad a consumir</label>
                        <input type="number" name="cantidad" class="form-control" step="0.01" required>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Confirmar</button>
                </div>
            </form>
        </div>
    </div>
</div>


<script>
    // Filtros
    document.getElementById('searchMaterial')?.addEventListener('input', function() {
        const txt = this.value.toLowerCase();
        document.querySelectorAll('#tablaMateriales tbody tr').forEach(row => {
            const nombre = row.dataset.nombre || '';
            row.style.display = nombre.includes(txt) ? '' : 'none';
        });
    });

    document.getElementById('filtroStock')?.addEventListener('change', function() {
        const val = this.value;
        document.querySelectorAll('#tablaMateriales tbody tr').forEach(row => {
            const stock = row.dataset.stock || '';
            row.style.display = !val || stock === val ? '' : 'none';
        });
    });

    function abrirConsumir(id, nombre, unidad) {
        document.getElementById('consumirIdMaterial').value = id;
        document.getElementById('consumirNombre').textContent = nombre;
        document.getElementById('consumirUnidad').textContent = unidad;
        new bootstrap.Modal(document.getElementById('modalConsumir')).show();
    }

    function abrirReponer(id, nombre) {
        const select = document.querySelector('#modalReponer select[name="idMaterial"]');
        if (select) select.value = id;
        new bootstrap.Modal(document.getElementById('modalReponer')).show();
    }
</script>