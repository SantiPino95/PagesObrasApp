@page
@model PagesObrasApp.Pages.Admin.SeguimientoObraModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Seguimiento de Obra";
}

<div class="admin-dashboard">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>Seguimiento de Obra</h1>
        <button type="button" class="btn btn-warning fw-bold" data-bs-toggle="modal" data-bs-target="#modalRegistrar">
            + Registrar avance
        </button>
    </div>

    @foreach (var obra in Model.Obras)
    {
        var seguimientos = Model.SeguimientosPorObra.TryGetValue(obra.IdObra, out var list) ? list : new List<PagesObrasApp.Models.DTOs.SeguimientoListadoDto>();

        // 🚀 1. Cambiamos Max por Sum para obtener el porcentaje total acumulado
        var avanceTotal = seguimientos.Any() ? seguimientos.Sum(s => s.PorcentajeAvance) : 0;

        // 🚀 2. Determinamos el color: si llegó a 100% verde (success), si no azul (primary)
        var esCompleta = avanceTotal >= 100;
        var colorBadge = esCompleta ? "bg-success" : "bg-primary";
        var colorBarra = esCompleta ? "bg-success" : ""; // Bootstrap usa bg-success directamente en progress-bar

        <div class="card mb-3 @(esCompleta ? "border-success shadow-sm" : "")">
            <div class="card-header d-flex justify-content-between align-items-center @(esCompleta ? "bg-success bg-opacity-10" : "")">
                <div>
                    <strong>@obra.NombreObra</strong>
                    <span class="badge bg-secondary ms-2">@obra.CodigoFormateado</span>
                    @if (obra.Estado == "Cancelada")
                    {
                        <span class="badge bg-danger ms-1">❌ Cancelada</span>
                    }
                    @if (esCompleta)
                    {
                        <span class="badge bg-success ms-1">✓ Completada</span>
                    }
                </div>
                <span class="badge @colorBadge fs-6">@avanceTotal%</span>
            </div>
            <div class="card-body">
                <div class="progress mb-3" style="height: 20px;">
                    <div class="progress-bar @colorBarra progress-bar-striped progress-bar-animated"
                         role="progressbar"
                         style="width: @avanceTotal%"
                         aria-valuenow="@avanceTotal"
                         aria-valuemin="0"
                         aria-valuemax="100">
                        @avanceTotal%
                    </div>
                </div>

                @if (seguimientos.Any())
                {
                    <h6 class="text-muted small fw-bold mb-2">Últimos reportes de avance:</h6>
                    <div class="list-group list-group-flush">
                        @foreach (var s in seguimientos.OrderByDescending(x => x.Fecha).Take(3))
                        {
                            <div class="list-group-item d-flex justify-content-between align-items-center py-2">
                                <div>
                                    <small class="text-muted fw-bold">@s.Fecha.ToString("dd/MM/yyyy")</small>
                                    <span class="ms-2">@s.DescripcionAvance</span>
                                </div>
                                <span class="badge bg-outline-primary text-dark border">+@s.PorcentajeAvance%</span>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted small mb-0">Sin registros de avance aún.</p>
                }
            </div>
        </div>
    }
</div>

<div class="modal fade" id="modalRegistrar" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header" style="background:#1B3A5C;color:white">
                <h5 class="modal-title">Registrar Avance</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-page-handler="CrearSeguimiento">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Obra</label>
                        <select name="idObra" class="form-select" required>
                            <option value="">Seleccionar obra...</option>
                            @foreach (var o in Model.Obras.Where(o => o.Estado != "Finalizada" && o.Estado != "Cancelada"))
                            {
                                <option value="@o.IdObra">@o.NombreObra (@o.CodigoFormateado)</option>
                            }
                        </select>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Fecha</label>
                            <input type="date" name="fecha" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" required>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Porcentaje a sumar (%)</label>
                            <input type="number" name="porcentajeAvance" class="form-control" min="1" max="100" placeholder="Ej: 15" required>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Descripción / Hito alcanzado</label>
                        <textarea name="descripcionAvance" class="form-control" rows="3" placeholder="Ej: Colocación de revestimientos..." required></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">URL de foto (opcional)</label>
                        <input type="text" name="imgProgreso" class="form-control" placeholder="https://...">
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-warning fw-bold">Guardar Avance</button>
                </div>
            </form>
        </div>
    </div>
</div>