@page
@model PagesObrasApp.Pages.Admin.AsignacionEmpleadosModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Asignación de Empleados";
}

<div class="admin-dashboard">
    @if (Model.Mensaje != null)
    {
        <div class="alert @(Model.MensajeTipo == "ok" ? "alert-success" : "alert-danger") alert-dismissible fade show" role="alert">
            @Model.Mensaje
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>Asignación de Empleados</h1>
        <button type="button" class="btn btn-warning" data-bs-toggle="modal" data-bs-target="#modalAsignar">
            + Nueva asignación
        </button>
    </div>

    <div class="table-responsive">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Empleado</th>
                    <th>Obra</th>
                    <th>Categoría / Rol</th>
                    
                </tr>
            </thead>
            <tbody>
                @foreach (var a in Model.Asignaciones)
                {
                    <tr>
                        <td>@a.NombreCompleto</td>
                        <td>@a.NombreObra</td>
                        <td>
                            <!-- Lógica dinámica -->
                            @if (a.RolEnObra == "Supervisor")
                            {
                                <span class="badge bg-warning text-dark">⭐ Supervisor</span>
                            }
                            else
                            {
                                <span>@a.Categoria</span> <!-- Muestra "Oficial", "Carpintero", etc. -->
                            }
                        </td>
      <td>  <form method="post" asp-page-handler="EliminarAsignacion" onsubmit="return confirm('¿Estás seguro de que deseas Deshacer esta asignación?');">
            <!-- Pasamos los dos IDs ocultos para que coincidan con los parámetros del backend -->
            <input type="hidden" name="idObra" value="@a.IdObra" />
            <input type="hidden" name="idEmpleado" value="@a.IdEmpleado" />

            <button type="submit" class="btn btn-danger btn-sm">
                Desasignar
            </button>
        </form>
                        </td>
                    </tr>
                }
            </tbody>
           
           
           
        </table>
        
    </div>
</div>

<!-- MODAL: Nueva Asignación -->
<div class="modal fade" id="modalAsignar" tabindex="-1" aria-labelledby="modalAsignarLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header" style="background:#1B3A5C;color:white">
                <h5 class="modal-title" id="modalAsignarLabel">Asignar Empleado a Obra</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-page-handler="CrearAsignacion">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Empleado</label>
                        <select name="idEmpleado" class="form-select" required>
                            <option value="">Seleccionar empleado...</option>
                            @foreach (var e in Model.Empleados)
                            {
                                <option value="@e.IdEmpleado">@e.NombreCompleto</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Obra</label>
                        <select name="idObra" class="form-select" required>
                            <option value="">Seleccionar obra...</option>
                            @foreach (var o in Model.Obras)
                            {
                                <option value="@o.IdObra">@o.NombreObra</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Rol en obra</label>
                        <select name="rolEnObra"  id= "rolEnObra" class="form-select" required>
                            <option value="rol">Rol por defecto</option>
                            <option value="Supervisor">Supervisor</option>
                            
                        </select>
                    </div>
                    
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-warning">Confirmar</button>
                </div>
            </form>
        </div>
    </div>
</div>