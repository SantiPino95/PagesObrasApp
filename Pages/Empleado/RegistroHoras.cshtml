@page
@model PagesObrasApp.Pages.Empleado.RegistroHorasModel
@using System.Linq
@using System.Globalization
@{
    Layout = "_EmpleadoLayout";
    ViewData["Title"] = "Mis Horas";

    var cultura = new CultureInfo("es-ES");
    var today = Model.Hoy;

    // Semana actual: lunes a hoy (rolling 7 días)
    var semana = Enumerable.Range(0, 7)
        .Select(i => today.AddDays(-6 + i))
        .ToList();

    var yaRegistroHoy = Model.RegistroHoy != null;
}

<div class="emp-dashboard">

    @if (!string.IsNullOrEmpty(Model.Mensaje))
    {
        <div class="alert @(Model.MensajeTipo == "ok" ? "alert-success" : "alert-danger")">@Model.Mensaje</div>
    }

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-end mb-3">
        <div>
            <span class="emp-eyebrow">Registro personal</span>
            <h1 class="emp-page-title">Mis horas</h1>
        </div>
        <span class="emp-mono emp-steel">@today.ToString("MMMM yyyy", cultura)</span>
    </div>

    <!-- STATS DEL MES -->
    <div class="row g-2 mb-4">
        <div class="col-3">
            <div class="emp-stat-card">
                <span class="emp-stat-label">Total</span>
                <span class="emp-stat-num">@Model.TotalHorasMes.ToString("0.#")<small>h</small></span>
            </div>
        </div>
        <div class="col-3">
            <div class="emp-stat-card">
                <span class="emp-stat-label">Comunes</span>
                <span class="emp-stat-num" style="font-size:1.5rem">@Model.TotalHorasComunes.ToString("0.#")<small>h</small></span>
            </div>
        </div>
        <div class="col-3">
            <div class="emp-stat-card emp-stat-card--alerta">
                <span class="emp-stat-label">Extras</span>
                <span class="emp-stat-num emp-stat-num--amber" style="font-size:1.5rem">@Model.TotalHorasExtras.ToString("0.#")<small>h</small></span>
            </div>
        </div>
        <div class="col-3">
            <div class="emp-stat-card">
                <span class="emp-stat-label">Días</span>
                <span class="emp-stat-num" style="font-size:1.5rem">@Model.DiasTrabajados</span>
            </div>
        </div>
    </div>

    <!-- VISTA SEMANAL -->
    <section class="emp-section">
        <span class="emp-eyebrow">Esta semana</span>
        <div class="emp-semana mt-2">
            @foreach (var dia in semana)
            {
                var regDia = Model.RegistrosMes.FirstOrDefault(r => r.Fecha.Date == dia.Date);
                var hDia = regDia != null ? regDia.HorasComunes + regDia.HorasExtras : 0;
                var esHoy = dia.Date == today.Date;
                var esFuturo = dia.Date > today.Date;
                var pct = hDia > 0 ? (int)Math.Round(hDia / 10m * 100) : 0;
                var diaLbl = dia.ToString("ddd", cultura).Replace(".", "").ToUpper();

                <div class="emp-dia @(esHoy ? "emp-dia--hoy" : "") @(esFuturo ? "emp-dia--futuro" : "")">
                    <span class="emp-dia-label">@diaLbl</span>
                    <span class="emp-dia-num">@dia.Day</span>
                    <div class="emp-dia-bar-wrap">
                        <div class="emp-dia-bar">
                            <div class="emp-dia-fill @(regDia?.HorasExtras > 0 ? "emp-dia-fill--extras" : "")"
                                 style="height:@pct%"></div>
                        </div>
                    </div>
                    <span class="emp-dia-horas">
                        @if (hDia > 0)
                        {
                            @($"{hDia:0.#}h")
                        }
                        else if (!esFuturo)
                        {
                            <span style="color:var(--bp-line)">—</span>
                        }
                    </span>
                </div>
            }
        </div>
    </section>

    <!-- FORM CARGAR HORAS DE HOY -->
    <section class="emp-section">
        <div class="emp-form-card">
            <div class="emp-form-header">
                <span class="emp-eyebrow" style="color:rgba(255,255,255,.65)">
                    @(yaRegistroHoy ? "Editar registro de" : "Cargar horas —")
                    @today.ToString("dddd d 'de' MMMM", cultura)
                </span>
                @if (yaRegistroHoy)
                {
                    <span class="emp-form-ya-badge">✓ Ya registrado</span>
                }
            </div>
            <div class="emp-form-body">
                <form method="post" asp-page-handler="@(yaRegistroHoy ? "EditarHoras" : "CargarHoras")">
                    @if (yaRegistroHoy)
                    {
                        <input type="hidden" name="idRegistro" value="@Model.RegistroHoy?.IdRegistro">
                    }

                    <div class="mb-3">
                        <label class="emp-label">Obra</label>
                        <select name="idEmpleadoObra" class="emp-select" required>
                            <option value="">Seleccionar obra...</option>
                            @foreach (var a in Model.Asignaciones)
                            {
                                if (Model.RegistroHoy?.IdEmpleadoObra == a.IdEmpleado)
                                {
                                    <option value="@a.IdEmpleado" selected>@a.NombreObra</option>
                                }
                                else
                                {
                                    <option value="@a.IdEmpleado">@a.NombreObra</option>
                                }
                            }
                        </select>
                        @if (!Model.Asignaciones.Any())
                        {
                            <p class="emp-hint">No tenés obras asignadas. Contactá al administrador.</p>
                        }
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="emp-label">Horas comunes</label>
                            <div class="emp-hora-input-wrap">
                                <button type="button" class="emp-hora-btn" onclick="ajustarHora('hComunes',-0.5)">−</button>
                                <input type="number" id="hComunes" name="horasComunes" class="emp-hora-input"
                                       min="0" max="24" step="0.5"
                                       value="@(Model.RegistroHoy?.HorasComunes.ToString("0.#") ?? "8")" required>
                                <button type="button" class="emp-hora-btn" onclick="ajustarHora('hComunes',0.5)">+</button>
                            </div>
                        </div>
                        <div class="col-6">
                            <label class="emp-label">Horas extras</label>
                            <div class="emp-hora-input-wrap">
                                <button type="button" class="emp-hora-btn" onclick="ajustarHora('hExtras',-0.5)">−</button>
                                <input type="number" id="hExtras" name="horasExtras" class="emp-hora-input"
                                       min="0" max="12" step="0.5"
                                       value="@(Model.RegistroHoy?.HorasExtras.ToString("0.#") ?? "0")">
                                <button type="button" class="emp-hora-btn" onclick="ajustarHora('hExtras',0.5)">+</button>
                            </div>
                        </div>
                    </div>

                    <!-- Total calculado -->
                    <div class="emp-total-row">
                        <span class="emp-label" style="margin:0">Total jornada</span>
                        <span class="emp-total-horas" id="totalDisplay">
                            @((Model.RegistroHoy != null ? Model.RegistroHoy.HorasComunes + Model.RegistroHoy.HorasExtras : 8m).ToString("0.#"))h
                        </span>
                    </div>

                    <div class="mb-3">
                        <label class="emp-label">Observaciones <span style="font-weight:400;color:var(--bp-steel)">(opcional)</span></label>
                        <textarea name="observaciones" class="emp-textarea" rows="2"
                                  placeholder="Ej: Terminé el encofrado de la columna A3...">@Model.RegistroHoy?.ObservacionesEmpleado</textarea>
                    </div>

                    <button type="submit" class="emp-btn-guardar w-100" @(!Model.Asignaciones.Any() ? "disabled" : "")>
                        @(yaRegistroHoy ? "Actualizar registro" : "Guardar horas de hoy")
                    </button>
                </form>
            </div>
        </div>
    </section>

    <!-- HISTORIAL DEL MES -->
    <section class="emp-section">
        <span class="emp-eyebrow">Historial — @today.ToString("MMMM", cultura)</span>
        <div class="emp-historial mt-2">
            @foreach (var r in Model.RegistrosMes.OrderByDescending(x => x.Fecha))
            {
                var asig = Model.Asignaciones.FirstOrDefault(a => a.IdEmpleado == r.IdEmpleadoObra);
                var diasAtras = (today - r.Fecha).Days;
                var fechaLbl = diasAtras == 0 ? "Hoy" : diasAtras == 1 ? "Ayer" : r.Fecha.ToString("ddd d MMM", cultura);
                <div class="emp-hist-row">
                    <div class="emp-hist-fecha">
                        <span class="emp-hist-dia">@fechaLbl</span>
                    </div>
                    <div class="emp-hist-obra">@asig?.NombreObra ?? "Sin obra"</div>
                    <div class="emp-hist-horas">
                        <span class="emp-hist-h">@r.HorasComunes.ToString("0.#")h</span>
                        @if (r.HorasExtras > 0)
                        {
                            <span class="emp-hist-ext">+@r.HorasExtras.ToString("0.#") ext</span>
                        }
                    </div>
                </div>
            }
            @if (!Model.RegistrosMes.Any())
            {
                <div class="emp-sin-registros">Aún no tenés registros de horas este mes.</div>
            }
        </div>
    </section>

</div>

<style>
    .emp-dashboard {
        --bp-blueprint: #1B3A5C;
        --bp-blueprint-light: #2D5C8C;
        --bp-concrete: #F1EFEA;
        --bp-steel: #5B6670;
        --bp-safety: #F2A900;
        --bp-ink: #181B1F;
        --bp-line: #D8D3C8;
        --bp-ok: #2E7D52;
        --bp-danger: #B23A2E;
        font-family: 'Inter', sans-serif;
        color: var(--bp-ink);
    }

    .emp-eyebrow {
        font-family: 'JetBrains Mono', monospace;
        font-size: .68rem;
        letter-spacing: .12em;
        text-transform: uppercase;
        color: var(--bp-steel);
    }

    .emp-mono {
        font-family: 'JetBrains Mono', monospace;
        font-size: .78rem;
    }

    .emp-steel {
        color: var(--bp-steel);
    }

    .emp-section {
        margin-bottom: 1.75rem;
    }

    .emp-page-title {
        font-family: 'Barlow Condensed', sans-serif;
        font-weight: 600;
        font-size: 1.8rem;
        margin: .1rem 0 0;
    }

    .emp-hint {
        font-size: .74rem;
        color: var(--bp-steel);
        margin-top: .3rem;
    }

    .emp-stat-card {
        background: #fff;
        border: 1px solid var(--bp-line);
        border-radius: 8px;
        padding: .65rem .75rem;
        text-align: center;
        display: flex;
        flex-direction: column;
        gap: .1rem;
    }

    .emp-stat-card--alerta {
        border-color: var(--bp-safety);
    }

    .emp-stat-label {
        font-family: 'JetBrains Mono', monospace;
        font-size: .58rem;
        letter-spacing: .1em;
        text-transform: uppercase;
        color: var(--bp-steel);
    }

    .emp-stat-num {
        font-family: 'Barlow Condensed', sans-serif;
        font-weight: 700;
        font-size: 1.8rem;
        color: var(--bp-blueprint);
        line-height: 1;
    }

        .emp-stat-num small {
            font-size: .8rem;
            font-weight: 500;
            color: var(--bp-steel);
        }

    .emp-stat-num--amber {
        color: var(--bp-safety);
    }

    /* Vista semanal */
    .emp-semana {
        display: flex;
        gap: .3rem;
    }

    .emp-dia {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: .2rem;
        padding: .5rem .25rem;
        background: #fff;
        border: 1px solid var(--bp-line);
        border-radius: 8px;
    }

    .emp-dia--hoy {
        border-color: var(--bp-blueprint);
        background: #EAF0F8;
    }

    .emp-dia--futuro {
        opacity: .45;
    }

    .emp-dia-label {
        font-family: 'JetBrains Mono', monospace;
        font-size: .58rem;
        color: var(--bp-steel);
    }

    .emp-dia-num {
        font-family: 'Barlow Condensed', sans-serif;
        font-weight: 600;
        font-size: .95rem;
    }

    .emp-dia-bar-wrap {
        height: 40px;
        display: flex;
        align-items: flex-end;
    }

    .emp-dia-bar {
        width: 16px;
        height: 40px;
        background: var(--bp-concrete);
        border-radius: 3px 3px 0 0;
        overflow: hidden;
        display: flex;
        align-items: flex-end;
    }

    .emp-dia-fill {
        width: 100%;
        background: var(--bp-blueprint-light);
        border-radius: 3px 3px 0 0;
        min-height: 2px;
    }

    .emp-dia-fill--extras {
        background: var(--bp-safety);
    }

    .emp-dia-horas {
        font-family: 'JetBrains Mono', monospace;
        font-size: .65rem;
        color: var(--bp-ink);
    }

    /* Form */
    .emp-form-card {
        background: #fff;
        border: 1px solid var(--bp-line);
        border-radius: 12px;
        overflow: hidden;
    }

    .emp-form-header {
        background: var(--bp-blueprint);
        padding: .85rem 1rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .emp-form-ya-badge {
        font-size: .72rem;
        font-weight: 600;
        background: #6fcf97;
        color: #1a4a2e;
        padding: .15rem .55rem;
        border-radius: 100px;
    }

    .emp-form-body {
        padding: 1rem;
    }

    .emp-label {
        display: block;
        font-family: 'JetBrains Mono', monospace;
        font-size: .65rem;
        letter-spacing: .08em;
        text-transform: uppercase;
        color: var(--bp-steel);
        margin-bottom: .35rem;
    }

    .emp-select, .emp-textarea {
        width: 100%;
        font-family: 'Inter', sans-serif;
        font-size: .88rem;
        border: 1px solid var(--bp-line);
        border-radius: 6px;
        padding: .5rem .75rem;
        background: #fff;
        color: var(--bp-ink);
    }

        .emp-select:focus, .emp-textarea:focus {
            outline: none;
            border-color: var(--bp-blueprint-light);
            box-shadow: 0 0 0 3px rgba(45,92,140,.12);
        }

    .emp-textarea {
        resize: vertical;
    }

    /* Input de horas */
    .emp-hora-input-wrap {
        display: flex;
        align-items: center;
        gap: .35rem;
    }

    .emp-hora-btn {
        width: 34px;
        height: 34px;
        border-radius: 7px;
        background: var(--bp-concrete);
        border: 1px solid var(--bp-line);
        font-size: 1.2rem;
        font-weight: 700;
        color: var(--bp-blueprint);
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        transition: background .15s;
    }

        .emp-hora-btn:hover {
            background: var(--bp-blueprint);
            color: #fff;
        }

    .emp-hora-input {
        flex: 1;
        font-family: 'Barlow Condensed', sans-serif;
        font-weight: 700;
        font-size: 1.5rem;
        text-align: center;
        border: 1px solid var(--bp-line);
        border-radius: 6px;
        padding: .3rem;
        color: var(--bp-blueprint);
        -moz-appearance: textfield;
        width: 100%;
    }

        .emp-hora-input::-webkit-inner-spin-button {
            display: none;
        }

        .emp-hora-input:focus {
            outline: none;
            border-color: var(--bp-blueprint-light);
        }

    .emp-total-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: var(--bp-concrete);
        border-radius: 6px;
        padding: .6rem .75rem;
        margin-bottom: .85rem;
    }

    .emp-total-horas {
        font-family: 'Barlow Condensed', sans-serif;
        font-weight: 700;
        font-size: 1.5rem;
        color: var(--bp-blueprint);
    }

    .emp-btn-guardar {
        font-family: 'Inter', sans-serif;
        font-weight: 700;
        font-size: .95rem;
        background: var(--bp-safety);
        color: var(--bp-ink);
        border: none;
        border-radius: 8px;
        padding: .7rem;
        cursor: pointer;
        transition: background .2s;
    }

        .emp-btn-guardar:hover:not(:disabled) {
            background: #d99500;
        }

        .emp-btn-guardar:disabled {
            opacity: .45;
            cursor: not-allowed;
        }

    /* Historial */
    .emp-historial {
        display: flex;
        flex-direction: column;
        gap: .4rem;
    }

    .emp-hist-row {
        display: grid;
        grid-template-columns: 80px 1fr auto;
        gap: .5rem;
        align-items: center;
        background: #fff;
        border: 1px solid var(--bp-line);
        border-radius: 7px;
        padding: .6rem .85rem;
    }

    .emp-hist-fecha {
        display: flex;
        flex-direction: column;
        gap: .05rem;
    }

    .emp-hist-dia {
        font-weight: 600;
        font-size: .82rem;
        text-transform: capitalize;
    }

    .emp-hist-obra {
        font-size: .8rem;
        color: var(--bp-steel);
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .emp-hist-horas {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: .1rem;
    }

    .emp-hist-h {
        font-family: 'Barlow Condensed', sans-serif;
        font-weight: 700;
        font-size: 1.05rem;
        color: var(--bp-blueprint);
    }

    .emp-hist-ext {
        font-family: 'JetBrains Mono', monospace;
        font-size: .65rem;
        color: var(--bp-safety);
        font-weight: 600;
    }

    .emp-sin-registros {
        padding: 1.5rem;
        text-align: center;
        color: var(--bp-steel);
        background: #fff;
        border: 1px solid var(--bp-line);
        border-radius: 8px;
    }

    .alert {
        padding: .75rem 1rem;
        border-radius: 6px;
        margin-bottom: 1rem;
    }

    .alert-success {
        background: #EAF4EE;
        color: #1a5a3a;
        border: 1px solid #b8ddc3;
    }

    .alert-danger {
        background: #FBF0EF;
        color: #7a2d25;
        border: 1px solid #e8bcb8;
    }

    @@media (max-width: 576px) {
        .emp-semana {
            gap: .2rem;
        }

        .emp-dia {
            padding: .35rem .15rem;
        }

        .emp-hist-row {
            grid-template-columns: 70px 1fr auto;
            gap: .3rem;
            padding: .5rem .6rem;
        }
    }
</style>

<script>
    (function () {
        const hCom = document.getElementById('hComunes');
        const hExt = document.getElementById('hExtras');
        const disp = document.getElementById('totalDisplay');

        function actualizarTotal() {
            const c = parseFloat(hCom.value) || 0;
            const e = parseFloat(hExt.value) || 0;
            disp.textContent = (c + e).toFixed(1).replace('.0', '') + 'h';
        }

        window.ajustarHora = function (inputId, delta) {
            const inp = document.getElementById(inputId);
            if (!inp) return;
            const val = Math.max(0, Math.min(24, (parseFloat(inp.value) || 0) + delta));
            inp.value = val % 1 === 0 ? val : val.toFixed(1);
            actualizarTotal();
        };

        if (hCom) hCom.addEventListener('input', actualizarTotal);
        if (hExt) hExt.addEventListener('input', actualizarTotal);
    })();
</script>