@page
@model PagesObrasApp.Pages.Empleado.NovedadesModel
@using System.Linq
@{
    Layout = "_EmpleadoLayout";
    ViewData["Title"] = "Novedades";

    var today = DateTime.Today;

    var tipos = new[]
    {
        new { Val = "Falta de Material", Icon = "📦", Desc = "Falta un material para continuar el trabajo" },
        new { Val = "Rotura Equipo", Icon = "🔧", Desc = "Una herramienta o equipo dejó de funcionar" },
        new { Val = "Incidencia Personal", Icon = "🚨", Desc = "Accidente, lesión o conflicto en obra" },
        new { Val = "Clima", Icon = "🌧", Desc = "Condiciones climáticas que detienen el avance" },
        new { Val = "Otro", Icon = "📋", Desc = "Cualquier otro imprevisto" },
    };

    var pendientes = Model.Novedades.Count(n => n.EstadoRevision == "Pendiente");
}

<div class="emp-dashboard">

    @if (!string.IsNullOrEmpty(Model.Mensaje))
    {
        <div class="alert @(Model.MensajeTipo == "ok" ? "alert-success" : "alert-danger")">@Model.Mensaje</div>
    }

    <!-- HEADER -->
    <div class="mb-3">
        <span class="emp-eyebrow">Mis reportes</span>
        <h1 class="emp-page-title">
            Novedades
            @if (pendientes > 0)
            {
                <span class="emp-title-badge">@pendientes sin respuesta</span>
            }
        </h1>
    </div>

    <!-- FORM -->
    <section class="emp-section">
        <div class="emp-form-card">
            <div class="emp-form-header">
                <span class="emp-eyebrow" style="color:rgba(255,255,255,.65)">Nuevo reporte</span>
                <h2 class="emp-form-title">Reportar una novedad</h2>
            </div>
            <form method="post" asp-page-handler="CrearNovedad">
                <div class="emp-form-body">
                    <!-- Tipo -->
                    <label class="emp-label">¿Qué pasó?</label>
                    <div class="emp-tipo-grid">
                        @foreach (var t in tipos)
                        {
                            <button type="button" class="emp-tipo-btn" data-tipo="@t.Val" onclick="seleccionarTipo(this)">
                                <span class="emp-tipo-icon">@t.Icon</span>
                                <span class="emp-tipo-lbl">@t.Val</span>
                            </button>
                        }
                    </div>
                    <input type="hidden" name="tipoNovedad" id="tipoSelected" value="">
                    <p class="emp-tipo-desc" id="tipoDesc">Seleccioná el tipo de novedad arriba.</p>

                    <!-- Obra -->
                    <div class="mb-3">
                        <label class="emp-label">Obra donde ocurrió</label>
                        <select name="idEmpleadoObra" class="emp-select" required>
                            <option value="">Seleccionar obra...</option>
                            @foreach (var a in Model.Asignaciones)
                            {
                                <option value="@a.IdEmpleado">@a.NombreObra</option>
                            }
                        </select>
                    </div>

                    <!-- Fecha -->
                    <div class="mb-3">
                        <label class="emp-label">Fecha</label>
                        <input type="date" name="fecha" class="emp-input" value="@today.ToString("yyyy-MM-dd")" required>
                    </div>

                    <!-- Descripción -->
                    <div class="mb-3">
                        <label class="emp-label">Describí qué pasó</label>
                        <textarea name="descripcion" class="emp-textarea" rows="4"
                                  placeholder="Contá con el mayor detalle posible: qué material falta, qué equipo se rompió..." required></textarea>
                    </div>

                    <button type="submit" class="emp-btn-guardar w-100" id="btnEnviar" disabled>
                        Enviar reporte
                    </button>
                </div>
            </form>
        </div>
    </section>

    <!-- MIS REPORTES -->
    <section class="emp-section">
        <span class="emp-eyebrow">Mis reportes anteriores</span>
        <div class="d-flex flex-column gap-2 mt-2">
            @foreach (var n in Model.Novedades.OrderByDescending(x => x.Fecha))
            {
                var diasAtras = (today - n.Fecha).Days;
                var fechaLbl = diasAtras == 0 ? "Hoy" : diasAtras == 1 ? "Ayer" : $"Hace {diasAtras} días";
                var esPendiente = n.EstadoRevision == "Pendiente";

                <div class="emp-rep-card @(esPendiente ? "emp-rep-card--pendiente" : "emp-rep-card--revisado")">
                    <div class="emp-rep-top">
                        <div>
                            <span class="emp-rep-tipo">@n.TipoNovedad</span>
                            <span class="emp-rep-obra">@n.NombreObra</span>
                        </div>
                        <div>
                            <span class="emp-mono emp-steel" style="font-size:.65rem">@fechaLbl</span>
                            <span class="emp-est-badge @(esPendiente ? "emp-est-badge--pendiente" : "emp-est-badge--revisado")">
                                @(esPendiente ? "● Pendiente" : "✓ Revisado")
                            </span>
                        </div>
                    </div>
                    <p class="emp-rep-desc">@n.Descripcion</p>
                </div>
            }
            @if (!Model.Novedades.Any())
            {
                <div class="emp-sin-registros">Aún no tenés novedades reportadas.</div>
            }
        </div>
    </section>

</div>

<style>
    .emp-dashboard {
        --bp-blueprint: #1B3A5C;
        --bp-steel: #5B6670;
        --bp-safety: #F2A900;
        --bp-ink: #181B1F;
        --bp-line: #D8D3C8;
        --bp-ok: #2E7D52;
        --bp-danger: #B23A2E;
        font-family: 'Inter', sans-serif;
        color: var(--bp-ink);
    }

    .emp-eyebrow {
        font-family: 'JetBrains Mono', monospace;
        font-size: .68rem;
        letter-spacing: .12em;
        text-transform: uppercase;
        color: var(--bp-steel);
    }

    .emp-mono {
        font-family: 'JetBrains Mono', monospace;
        font-size: .78rem;
    }

    .emp-steel {
        color: var(--bp-steel);
    }

    .emp-section {
        margin-bottom: 1.75rem;
    }

    .emp-page-title {
        font-family: 'Barlow Condensed', sans-serif;
        font-weight: 600;
        font-size: 1.8rem;
        margin: .1rem 0 0;
        display: flex;
        align-items: center;
        gap: .5rem;
        flex-wrap: wrap;
    }

    .emp-title-badge {
        font-family: 'Inter', sans-serif;
        font-size: .72rem;
        font-weight: 700;
        background: var(--bp-safety);
        color: var(--bp-ink);
        padding: .12rem .6rem;
        border-radius: 100px;
    }

    .emp-form-card {
        background: #fff;
        border: 1px solid var(--bp-line);
        border-radius: 12px;
        overflow: hidden;
    }

    .emp-form-header {
        background: var(--bp-blueprint);
        padding: .85rem 1rem;
    }

    .emp-form-title {
        font-family: 'Barlow Condensed', sans-serif;
        font-weight: 600;
        font-size: 1.3rem;
        color: #fff;
        margin-top: .1rem;
    }

    .emp-form-body {
        padding: 1rem;
    }

    .emp-label {
        display: block;
        font-family: 'JetBrains Mono', monospace;
        font-size: .65rem;
        letter-spacing: .08em;
        text-transform: uppercase;
        color: var(--bp-steel);
        margin-bottom: .35rem;
    }

    .emp-select, .emp-textarea, .emp-input {
        width: 100%;
        font-family: 'Inter', sans-serif;
        font-size: .88rem;
        border: 1px solid var(--bp-line);
        border-radius: 6px;
        padding: .5rem .75rem;
        background: #fff;
        color: var(--bp-ink);
    }

        .emp-select:focus, .emp-textarea:focus, .emp-input:focus {
            outline: none;
            border-color: #2D5C8C;
            box-shadow: 0 0 0 3px rgba(45,92,140,.12);
        }

    .emp-textarea {
        resize: vertical;
    }

    .emp-tipo-grid {
        display: grid;
        grid-template-columns: repeat(5,1fr);
        gap: .35rem;
        margin-bottom: .6rem;
    }

    .emp-tipo-btn {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: .2rem;
        background: #F1EFEA;
        border: 2px solid transparent;
        border-radius: 8px;
        padding: .5rem .25rem;
        cursor: pointer;
        transition: all .15s;
    }

        .emp-tipo-btn:hover {
            border-color: #2D5C8C;
            background: #EAF0F8;
        }

        .emp-tipo-btn.selected {
            background: #fff;
            border-color: #1B3A5C;
        }

    .emp-tipo-icon {
        font-size: 1.3rem;
    }

    .emp-tipo-lbl {
        font-size: .58rem;
        font-weight: 600;
        text-align: center;
        color: var(--bp-steel);
        line-height: 1.2;
    }

    .emp-tipo-desc {
        font-size: .78rem;
        color: var(--bp-steel);
        margin: 0 0 .9rem;
        min-height: 1.2em;
    }

    .emp-btn-guardar {
        font-family: 'Inter', sans-serif;
        font-weight: 700;
        font-size: .95rem;
        background: var(--bp-safety);
        color: var(--bp-ink);
        border: none;
        border-radius: 8px;
        padding: .7rem;
        cursor: pointer;
        transition: background .2s;
    }

        .emp-btn-guardar:disabled {
            opacity: .45;
            cursor: not-allowed;
        }

        .emp-btn-guardar:not(:disabled):hover {
            background: #d99500;
        }

    .emp-rep-card {
        background: #fff;
        border: 1px solid var(--bp-line);
        border-radius: 8px;
        overflow: hidden;
    }

    .emp-rep-card--pendiente {
        border-left: 4px solid var(--bp-safety);
    }

    .emp-rep-card--revisado {
        border-left: 4px solid var(--bp-ok);
        opacity: .7;
    }

    .emp-rep-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: .5rem;
        flex-wrap: wrap;
        padding: .75rem .9rem .4rem;
    }

    .emp-rep-tipo {
        font-weight: 600;
        font-size: .82rem;
    }

    .emp-rep-obra {
        font-size: .75rem;
        color: var(--bp-steel);
        background: #F1EFEA;
        padding: .1rem .45rem;
        border-radius: 100px;
    }

    .emp-rep-desc {
        font-size: .82rem;
        line-height: 1.5;
        color: var(--bp-ink);
        padding: .3rem .9rem .75rem;
        margin: 0;
    }

    .emp-est-badge {
        font-size: .68rem;
        font-weight: 600;
        padding: .15rem .5rem;
        border-radius: 100px;
        white-space: nowrap;
    }

    .emp-est-badge--pendiente {
        background: #FFF8E8;
        color: #92670a;
    }

    .emp-est-badge--revisado {
        background: #EAF4EE;
        color: var(--bp-ok);
    }

    .emp-sin-registros {
        padding: 1.5rem;
        text-align: center;
        color: var(--bp-steel);
        background: #fff;
        border: 1px solid var(--bp-line);
        border-radius: 8px;
    }

    .alert {
        padding: .75rem 1rem;
        border-radius: 6px;
        margin-bottom: 1rem;
    }

    .alert-success {
        background: #EAF4EE;
        color: #1a5a3a;
        border: 1px solid #b8ddc3;
    }

    .alert-danger {
        background: #FBF0EF;
        color: #7a2d25;
        border: 1px solid #e8bcb8;
    }

    @@media (max-width: 576px) {
        .emp-tipo-grid {
            grid-template-columns: repeat(3,1fr);
        }
    }
</style>

<script>
    const tipoDescripciones = {
        'Falta de Material': 'Indicá qué material falta, qué cantidad aproximada queda, y qué trabajo se ve afectado.',
        'Rotura Equipo': 'Indicá qué equipo o herramienta se averió, el código de inventario si lo sabés, y cómo afecta el trabajo.',
        'Incidencia Personal': 'Describí qué pasó, quién estuvo involucrado y qué medidas se tomaron en el momento.',
        'Clima': 'Indicá qué condiciones climáticas se presentaron y cuánto tiempo se perdió de trabajo.',
        'Otro': 'Describí con el mayor detalle posible qué ocurrió.'
    };

    (function () {
        const btnEnviar = document.getElementById('btnEnviar');
        const tipoInput = document.getElementById('tipoSelected');
        const textarea = document.querySelector('.emp-textarea');
        const tipoDesc = document.getElementById('tipoDesc');

        window.seleccionarTipo = function (btn) {
            document.querySelectorAll('.emp-tipo-btn').forEach(b => b.classList.remove('selected'));
            btn.classList.add('selected');
            const tipo = btn.dataset.tipo;
            tipoInput.value = tipo;
            tipoDesc.textContent = tipoDescripciones[tipo] || '';
            validarForm();
        };

        function validarForm() {
            const tipoOk = tipoInput.value !== '';
            const descOk = (textarea?.value.trim().length ?? 0) > 10;
            if (btnEnviar) btnEnviar.disabled = !(tipoOk && descOk);
        }

        if (textarea) {
            textarea.addEventListener('input', validarForm);
        }
    })();
</script>