@page
@model PagesObrasApp.Pages.Empleado.IndexModel
@using System.Linq
@using System.Globalization
@{
    Layout = "_EmpleadoLayout";
    ViewData["Title"] = "Inicio";

    var today = DateTime.Today;
    var cultura = new CultureInfo("es-ES");
    var horaActual = DateTime.Now.Hour;
    var saludo = horaActual < 12 ? "Buenos días" : horaActual < 19 ? "Buenas tardes" : "Buenas noches";
}

<div class="emp-dashboard">

    <!-- HERO SALUDO -->
    <div class="emp-hero">
        <div class="emp-hero-bg"></div>
        <div class="emp-hero-content">
            <p class="emp-saludo">@saludo,</p>
            <h1 class="emp-nombre">@Model.NombreCompleto</h1>
            <p class="emp-fecha">@today.ToString("dddd d 'de' MMMM", cultura)</p>
        </div>
        <div class="emp-hero-status">
            @if (Model.YaRegistroHoy)
            {
                <div class="emp-status emp-status--ok">
                    <svg viewBox="0 0 24 24"><path d="M20 6L9 17l-5-5" /></svg>
                    <span>@Model.HorasHoy.ToString("0.#")h cargadas hoy</span>
                </div>
            }
            else
            {
                <div class="emp-status emp-status--pend">
                    <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" /></svg>
                    <span>Sin horas cargadas hoy</span>
                </div>
            }
        </div>
    </div>

    <!-- STATS -->
    <div class="row g-2 mb-4">
        <div class="col-4">
            <div class="emp-stat-card">
                <span class="emp-stat-label">Hoy</span>
                <span class="emp-stat-num">@Model.HorasHoy.ToString("0.#")<small>h</small></span>
            </div>
        </div>
        <div class="col-4">
            <div class="emp-stat-card">
                <span class="emp-stat-label">Semana</span>
                <span class="emp-stat-num">@Model.HorasSemana.ToString("0.#")<small>h</small></span>
            </div>
        </div>
        <div class="col-4">
            <div class="emp-stat-card @(Model.NovedadesPendientes > 0 ? "emp-stat-card--alerta" : "")">
                <span class="emp-stat-label">Novedades</span>
                <span class="emp-stat-num @(Model.NovedadesPendientes > 0 ? "emp-stat-num--amber" : "")">
                    @Model.NovedadesPendientes
                </span>
            </div>
        </div>
    </div>

    <!-- MIS OBRAS -->
    <section class="emp-section">
        <span class="emp-eyebrow">Mis obras asignadas</span>
        <div class="d-flex flex-column gap-2 mt-2">
            @foreach (var a in Model.Asignaciones)
            {
                <div class="emp-obra-card">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <div class="emp-obra-nombre">@a.NombreObra</div>
                        </div>
                        <span class="emp-avance-num">@(new Random().Next(10, 90))%</span>
                    </div>
                    <div class="emp-progress-wrap">
                        <div class="emp-progress">
                            <div class="emp-progress-fill" style="width:@(new Random().Next(10, 90))%"></div>
                        </div>
                    </div>
                    <div class="d-flex justify-content-between mt-1">
                        <span class="emp-mono emp-steel" style="font-size:.68rem">@a.Categoria</span>
                        <span class="emp-mono emp-steel" style="font-size:.68rem">Avance: @(new Random().Next(10, 90))%</span>
                    </div>
                </div>
            }
            @if (!Model.Asignaciones.Any())
            {
                <div class="emp-sin-asignaciones">No tenés obras asignadas. Contactá al administrador.</div>
            }
        </div>
    </section>

    <!-- ACCIONES -->
    <section class="emp-section">
        <span class="emp-eyebrow">Acciones</span>
        <div class="row g-2 mt-1">
            <div class="col-6">
                <a href="/Empleado/RegistroHoras" class="emp-action-card">
                    <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" /></svg>
                    <span class="emp-action-title">Cargar horas</span>
                    <span class="emp-action-desc">Registrá tu jornada de hoy</span>
                </a>
            </div>
            <div class="col-6">
                <a href="/Empleado/Novedades" class="emp-action-card">
                    <svg viewBox="0 0 24 24"><path d="M12 3l10 18H2L12 3z" /><path d="M12 9v5M12 17h.01" /></svg>
                    <span class="emp-action-title">Reportar novedad</span>
                    <span class="emp-action-desc">Material, equipo o incidencia</span>
                </a>
            </div>
        </div>
    </section>

</div>

<style>
    .emp-dashboard {
        --bp-blueprint: #1B3A5C;
        --bp-blueprint-light: #2D5C8C;
        --bp-concrete: #F1EFEA;
        --bp-steel: #5B6670;
        --bp-safety: #F2A900;
        --bp-ink: #181B1F;
        --bp-line: #D8D3C8;
        --bp-ok: #2E7D52;
        font-family: 'Inter', sans-serif;
        color: var(--bp-ink);
    }

    .emp-eyebrow {
        font-family: 'JetBrains Mono', monospace;
        font-size: .68rem;
        letter-spacing: .12em;
        text-transform: uppercase;
        color: var(--bp-steel);
    }

    .emp-mono {
        font-family: 'JetBrains Mono', monospace;
        font-size: .78rem;
    }

    .emp-steel {
        color: var(--bp-steel);
    }

    .emp-section {
        margin-bottom: 1.75rem;
    }

    .emp-hero {
        position: relative;
        background: var(--bp-blueprint);
        border-radius: 12px;
        padding: 1.25rem;
        overflow: hidden;
        margin-bottom: 1.25rem;
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        flex-wrap: wrap;
        gap: .75rem;
    }

    .emp-hero-bg {
        position: absolute;
        inset: 0;
        background-image: repeating-linear-gradient(0deg, rgba(255,255,255,.05) 0 1px, transparent 1px 28px), repeating-linear-gradient(90deg, rgba(255,255,255,.05) 0 1px, transparent 1px 28px);
        pointer-events: none;
    }

    .emp-hero-content {
        position: relative;
    }

    .emp-saludo {
        font-size: .8rem;
        color: rgba(255,255,255,.6);
        margin-bottom: .1rem;
    }

    .emp-nombre {
        font-family: 'Barlow Condensed', sans-serif;
        font-weight: 700;
        font-size: 1.7rem;
        color: #fff;
        margin-bottom: .1rem;
    }

    .emp-fecha {
        font-family: 'JetBrains Mono', monospace;
        font-size: .72rem;
        color: rgba(255,255,255,.5);
        text-transform: capitalize;
    }

    .emp-hero-status {
        position: relative;
    }

    .emp-status {
        display: flex;
        align-items: center;
        gap: .4rem;
        font-size: .78rem;
        font-weight: 600;
        background: rgba(255,255,255,.12);
        border-radius: 8px;
        padding: .4rem .75rem;
        border: 1px solid rgba(255,255,255,.15);
    }

        .emp-status svg {
            width: 14px;
            height: 14px;
            fill: none;
            stroke: currentColor;
            stroke-width: 2;
            stroke-linecap: round;
        }

    .emp-status--ok {
        color: #6fcf97;
    }

    .emp-status--pend {
        color: var(--bp-safety);
    }

    .emp-stat-card {
        background: #fff;
        border: 1px solid var(--bp-line);
        border-radius: 8px;
        padding: .75rem .8rem;
        text-align: center;
        display: flex;
        flex-direction: column;
        gap: .1rem;
    }

    .emp-stat-card--alerta {
        border-color: var(--bp-safety);
    }

    .emp-stat-label {
        font-family: 'JetBrains Mono', monospace;
        font-size: .62rem;
        letter-spacing: .1em;
        text-transform: uppercase;
        color: var(--bp-steel);
    }

    .emp-stat-num {
        font-family: 'Barlow Condensed', sans-serif;
        font-weight: 700;
        font-size: 1.8rem;
        color: var(--bp-blueprint);
        line-height: 1;
    }

        .emp-stat-num small {
            font-size: .85rem;
            font-weight: 500;
            color: var(--bp-steel);
        }

    .emp-stat-num--amber {
        color: var(--bp-safety);
    }

    .emp-obra-card {
        background: #fff;
        border: 1px solid var(--bp-line);
        border-radius: 8px;
        padding: 1rem;
    }

    .emp-obra-nombre {
        font-family: 'Barlow Condensed', sans-serif;
        font-weight: 600;
        font-size: 1.1rem;
    }

    .emp-avance-num {
        font-family: 'Barlow Condensed', sans-serif;
        font-weight: 700;
        font-size: 1.8rem;
        color: var(--bp-blueprint-light);
        line-height: 1;
        flex-shrink: 0;
    }

    .emp-progress-wrap {
        margin: .65rem 0 .3rem;
    }

    .emp-progress {
        height: 7px;
        background: var(--bp-concrete);
        border-radius: 4px;
        overflow: hidden;
    }

    .emp-progress-fill {
        height: 100%;
        background: var(--bp-blueprint-light);
        border-radius: 4px;
    }

    .emp-action-card {
        display: flex;
        flex-direction: column;
        gap: .25rem;
        background: #fff;
        border: 1px solid var(--bp-line);
        border-radius: 10px;
        padding: 1rem .9rem;
        text-decoration: none;
        color: var(--bp-ink);
        height: 100%;
        transition: border-color .15s;
    }

        .emp-action-card:hover {
            border-color: var(--bp-blueprint-light);
            color: var(--bp-ink);
        }

        .emp-action-card svg {
            width: 22px;
            height: 22px;
            fill: none;
            stroke: var(--bp-blueprint);
            stroke-width: 2;
            stroke-linecap: round;
            margin-bottom: .15rem;
        }

    .emp-action-title {
        font-family: 'Barlow Condensed', sans-serif;
        font-weight: 600;
        font-size: 1.05rem;
    }

    .emp-action-desc {
        font-size: .75rem;
        color: var(--bp-steel);
    }

    .emp-sin-asignaciones {
        padding: 1.5rem;
        text-align: center;
        color: var(--bp-steel);
        background: #fff;
        border: 1px solid var(--bp-line);
        border-radius: 8px;
    }
</style>