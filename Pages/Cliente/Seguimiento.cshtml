@page
@model PagesObrasApp.Pages.Cliente.SeguimientoModel
@using System.Linq
@using System.Globalization
@{
    Layout = "_Layout";
    ViewData["Title"] = "Seguimiento de obra";

    var cultura = new CultureInfo("es-ES");
    var today = DateTime.Now;

    var obra = Model.Obra;
    var seguimientos = Model.Seguimientos; // ya vienen ordenados desc por fecha desde el PageModel
    var presupuestos = Model.PresupuestosAprobados;

    var diasRestantes = obra.FechaFinPrevista.HasValue ? (int?)(obra.FechaFinPrevista.Value - today).Days : null;
    var diasTranscurridos = (today - obra.FechaInicio).Days;
    var duracionTotal = obra.FechaFinPrevista.HasValue ? (obra.FechaFinPrevista.Value - obra.FechaInicio).Days : 0;
    var pctTiempo = duracionTotal > 0 ? Math.Min(100, (int)Math.Round((double)diasTranscurridos / duracionTotal * 100)) : 0;

    var estadoCls = (obra.Estado ?? "").Replace(" ", "").ToLower();
}

@section Styles {
    <style>
        .cli-page {
            --bp-blueprint: #1B3A5C;
            --bp-blueprint-light: #2D5C8C;
            --bp-concrete: #F1EFEA;
            --bp-steel: #5B6670;
            --bp-safety: #F2A900;
            --bp-ink: #181B1F;
            --bp-line: #D8D3C8;
            --bp-ok: #2E7D52;
            font-family: 'Inter', sans-serif;
            color: var(--bp-ink);
            max-width: 860px;
            margin: 0 auto;
            padding: 2rem 1.25rem 3rem;
        }

        .cli-obra-header {
            background: var(--bp-blueprint);
            border-radius: 12px;
            overflow: hidden;
            margin-bottom: 1.5rem;
            position: relative;
        }

        .cli-obra-grid {
            position: absolute;
            inset: 0;
            background-image: repeating-linear-gradient(0deg,rgba(255,255,255,.04) 0 1px,transparent 1px 28px), repeating-linear-gradient(90deg,rgba(255,255,255,.04) 0 1px,transparent 1px 28px);
            pointer-events: none;
        }

        .cli-obra-header-body {
            position: relative;
            padding: 1.5rem 1.5rem 1.25rem;
        }

        .cli-obra-codigo {
            font-family: 'JetBrains Mono', monospace;
            font-size: .72rem;
            letter-spacing: .12em;
            text-transform: uppercase;
            color: rgba(255,255,255,.5);
            display: block;
            margin-bottom: .4rem;
        }

        .cli-obra-nombre {
            font-family: 'Barlow Condensed', sans-serif;
            font-weight: 700;
            font-size: 2rem;
            color: #fff;
            line-height: 1.1;
            margin-bottom: .5rem;
        }

        .cli-obra-meta {
            display: flex;
            flex-wrap: wrap;
            gap: .5rem .85rem;
            font-size: .82rem;
            color: rgba(255,255,255,.65);
            margin-bottom: 1.25rem;
        }

        .cli-obra-meta-item {
            display: flex;
            align-items: center;
            gap: .3rem;
        }

            .cli-obra-meta-item svg {
                width: 13px;
                height: 13px;
                fill: none;
                stroke: currentColor;
                stroke-width: 1.8;
                stroke-linecap: round;
                opacity: .7;
            }

        .cli-badge {
            display: inline-block;
            font-size: .68rem;
            font-weight: 600;
            padding: .2rem .6rem;
            border-radius: 100px;
            white-space: nowrap;
        }

        .cli-badge--enprogreso {
            background: rgba(45,108,223,.3);
            color: #8cb8f8;
            border: 1px solid rgba(45,108,223,.4);
        }

        .cli-badge--planificada {
            background: rgba(91,102,112,.3);
            color: #c0c5ca;
            border: 1px solid rgba(91,102,112,.4);
        }

        .cli-badge--pausada {
            background: rgba(242,169,0,.25);
            color: var(--bp-safety);
            border: 1px solid rgba(242,169,0,.4);
        }

        .cli-badge--finalizada {
            background: rgba(46,125,82,.3);
            color: #6fcf97;
            border: 1px solid rgba(46,125,82,.4);
        }

        .cli-progress-section {
            border-top: 1px solid rgba(255,255,255,.1);
            padding: 1rem 1.5rem 1.25rem;
            background: rgba(0,0,0,.12);
        }

        .cli-progress-header {
            display: flex;
            justify-content: space-between;
            align-items: baseline;
            margin-bottom: .65rem;
        }

        .cli-progress-label {
            font-family: 'JetBrains Mono', monospace;
            font-size: .68rem;
            letter-spacing: .1em;
            text-transform: uppercase;
            color: rgba(255,255,255,.5);
        }

        .cli-progress-pct {
            font-family: 'Barlow Condensed', sans-serif;
            font-weight: 700;
            font-size: 2rem;
            color: #fff;
            line-height: 1;
        }

            .cli-progress-pct small {
                font-size: 1rem;
                font-weight: 500;
                color: rgba(255,255,255,.5);
            }

        .cli-progress-bar {
            height: 10px;
            background: rgba(255,255,255,.15);
            border-radius: 5px;
            overflow: hidden;
            margin-bottom: .65rem;
        }

        .cli-progress-fill {
            height: 100%;
            background: var(--bp-safety);
            border-radius: 5px;
            transition: width .5s ease;
        }

        .cli-progress-dates {
            display: flex;
            justify-content: space-between;
            font-family: 'JetBrains Mono', monospace;
            font-size: .65rem;
            color: rgba(255,255,255,.4);
        }

        .cli-dias-restantes {
            font-family: 'JetBrains Mono', monospace;
            font-size: .72rem;
            color: var(--bp-safety);
            font-weight: 500;
        }

        .cli-stats {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 1rem;
            margin-bottom: 2rem;
        }

        .cli-stat-card {
            background: #fff;
            border: 1px solid var(--bp-line);
            border-radius: 8px;
            padding: .9rem 1rem;
            text-align: center;
        }

        .cli-stat-label {
            font-family: 'JetBrains Mono', monospace;
            font-size: .62rem;
            letter-spacing: .1em;
            text-transform: uppercase;
            color: var(--bp-steel);
            display: block;
            margin-bottom: .25rem;
        }

        .cli-stat-val {
            font-family: 'Barlow Condensed', sans-serif;
            font-weight: 700;
            font-size: 1.5rem;
            color: var(--bp-blueprint);
            line-height: 1;
        }

        .cli-stat-sub {
            font-size: .72rem;
            color: var(--bp-steel);
            margin-top: .1rem;
        }

        .cli-section-title {
            font-family: 'Barlow Condensed', sans-serif;
            font-weight: 600;
            font-size: 1.4rem;
            color: var(--bp-blueprint);
            margin-bottom: 1rem;
            display: flex;
            align-items: center;
            gap: .6rem;
        }

            .cli-section-title::after {
                content: '';
                flex: 1;
                height: 1px;
                background: var(--bp-line);
            }

        .cli-timeline {
            display: flex;
            flex-direction: column;
        }

        .cli-tl-entry {
            display: flex;
            gap: .85rem;
        }

        .cli-tl-left {
            display: flex;
            flex-direction: column;
            align-items: center;
            flex-shrink: 0;
            width: 14px;
        }

        .cli-tl-dot {
            width: 12px;
            height: 12px;
            border-radius: 50%;
            flex-shrink: 0;
            background: var(--bp-concrete);
            border: 2px solid var(--bp-line);
            z-index: 1;
        }

        .cli-tl-dot--latest {
            background: var(--bp-safety);
            border-color: var(--bp-safety);
        }

        .cli-tl-line {
            width: 2px;
            flex: 1;
            background: var(--bp-line);
            margin-top: 2px;
        }

        .cli-tl-content {
            flex: 1;
            min-width: 0;
            padding-bottom: 1.5rem;
        }

        .cli-tl-top {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: .5rem;
            margin-bottom: .4rem;
        }

        .cli-tl-pct {
            font-family: 'Barlow Condensed', sans-serif;
            font-weight: 700;
            font-size: 1.15rem;
            color: var(--bp-steel);
        }

        .cli-tl-pct--latest {
            color: var(--bp-blueprint);
        }

        .cli-tl-delta {
            font-family: 'JetBrains Mono', monospace;
            font-size: .7rem;
            font-weight: 600;
            background: #EAF4EE;
            color: var(--bp-ok);
            padding: .1rem .4rem;
            border-radius: 100px;
        }

        .cli-tl-fecha {
            font-family: 'JetBrains Mono', monospace;
            font-size: .72rem;
            color: var(--bp-steel);
        }

        .cli-tl-desc {
            font-size: .88rem;
            line-height: 1.6;
            color: var(--bp-ink);
            margin: 0;
        }

        .cli-tl-img {
            margin-top: .75rem;
            width: 100%;
            max-height: 220px;
            object-fit: cover;
            border-radius: 8px;
            border: 1px solid var(--bp-line);
        }

        .cli-ver-mas {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: .4rem;
            margin-top: .5rem;
            background: none;
            border: 1px solid var(--bp-line);
            border-radius: 7px;
            padding: .6rem 1rem;
            font-family: 'Inter', sans-serif;
            font-size: .83rem;
            font-weight: 600;
            color: var(--bp-steel);
            cursor: pointer;
            width: 100%;
            transition: all .15s;
        }

            .cli-ver-mas:hover {
                border-color: var(--bp-blueprint);
                color: var(--bp-blueprint);
            }

            .cli-ver-mas svg {
                width: 14px;
                height: 14px;
                fill: none;
                stroke: currentColor;
                stroke-width: 2;
                stroke-linecap: round;
                transition: transform .2s;
            }

            .cli-ver-mas.abierto svg {
                transform: rotate(180deg);
            }

        .cli-pres-card {
            background: #fff;
            border: 1px solid var(--bp-line);
            border-radius: 10px;
            overflow: hidden;
            margin-bottom: 1rem;
        }

        .cli-pres-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 1rem 1.25rem;
            background: var(--bp-concrete);
            border-bottom: 1px solid var(--bp-line);
            flex-wrap: wrap;
            gap: .5rem;
        }

        .cli-pres-num {
            font-family: 'JetBrains Mono', monospace;
            font-size: .78rem;
            color: var(--bp-steel);
        }

        .cli-pres-fecha {
            font-family: 'JetBrains Mono', monospace;
            font-size: .78rem;
            color: var(--bp-steel);
        }

        .cli-pres-estado {
            font-size: .72rem;
            font-weight: 600;
            padding: .2rem .6rem;
            border-radius: 100px;
        }

        .cli-pres-estado--aprobado {
            background: #EAF4EE;
            color: var(--bp-ok);
        }

        .cli-pres-estado--pendiente {
            background: #FFF8E8;
            color: #92670a;
        }

        .cli-pres-total {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: .85rem 1.25rem;
        }

        .cli-pres-total-label {
            font-family: 'JetBrains Mono', monospace;
            font-size: .68rem;
            letter-spacing: .08em;
            text-transform: uppercase;
            color: var(--bp-steel);
        }

        .cli-pres-total-val {
            font-family: 'Barlow Condensed', sans-serif;
            font-weight: 700;
            font-size: 1.4rem;
            color: var(--bp-blueprint);
        }

        .cli-pres-items-nota {
            padding: 0 1.25rem .9rem;
            font-size: .76rem;
            color: var(--bp-steel);
            font-style: italic;
        }

        .cli-contacto {
            background: var(--bp-blueprint);
            border-radius: 10px;
            padding: 1.25rem 1.5rem;
            margin-top: 2rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 1rem;
        }

        .cli-contacto-text {
            color: rgba(255,255,255,.85);
            font-size: .88rem;
        }

            .cli-contacto-text strong {
                color: #fff;
                display: block;
                font-size: 1rem;
                margin-bottom: .2rem;
            }

        .cli-contacto-btn {
            font-family: 'Inter', sans-serif;
            font-weight: 600;
            font-size: .85rem;
            background: var(--bp-safety);
            color: var(--bp-ink);
            border: none;
            border-radius: 7px;
            padding: .55rem 1.1rem;
            text-decoration: none;
            white-space: nowrap;
            transition: background .15s;
        }

            .cli-contacto-btn:hover {
                background: #d99500;
                color: var(--bp-ink);
            }

        @@media (max-width: 576px) {
            .cli-page {
                padding: 1.25rem .85rem 2rem;
            }

            .cli-stats {
                grid-template-columns: repeat(3,1fr);
                gap: .5rem;
            }

            .cli-stat-card {
                padding: .65rem .5rem;
            }

            .cli-stat-val {
                font-size: 1.25rem;
            }

            .cli-obra-header-body, .cli-progress-section {
                padding-left: 1rem;
                padding-right: 1rem;
            }
        }
    </style>
}

<div class="cli-page">

    <!-- HEADER DE OBRA -->
    <div class="cli-obra-header">
        <div class="cli-obra-grid"></div>
        <div class="cli-obra-header-body">
            <span class="cli-obra-codigo">@obra.CodigoFormateado</span>
            <div class="d-flex align-items-start justify-content-between gap-2 flex-wrap mb-2">
                <h1 class="cli-obra-nombre">@obra.NombreObra</h1>
                <span class="cli-badge cli-badge--@estadoCls">@obra.Estado</span>
            </div>
            <div class="cli-obra-meta">
                <div class="cli-obra-meta-item">
                    <svg viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2" /><circle cx="12" cy="7" r="4" /></svg>
                    @obra.NombreCliente
                </div>
                <div class="cli-obra-meta-item">
                    <svg viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13S3 17 3 10a9 9 0 0118 0z" /><circle cx="12" cy="10" r="3" /></svg>
                    @obra.Direccion
                </div>
                <div class="cli-obra-meta-item">
                    <svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" /><path d="M16 2v4M8 2v4M3 10h18" /></svg>
                    Inicio @obra.FechaInicio.ToString("dd/MM/yyyy")
                </div>
            </div>
        </div>

        <!-- Barra de progreso -->
        <div class="cli-progress-section">
            <div class="cli-progress-header">
                <span class="cli-progress-label">Avance de obra</span>
                <span class="cli-progress-pct">@obra.PorcentajeAvanceActual<small>%</small></span>
            </div>
            <div class="cli-progress-bar">
                <div class="cli-progress-fill" style="width:@obra.PorcentajeAvanceActual%"></div>
            </div>
            <div class="cli-progress-dates">
                <span>@obra.FechaInicio.ToString("MMM yyyy", cultura)</span>
                <span class="cli-dias-restantes">
                    @if (obra.FechaFinPrevista.HasValue)
                    {
                        if (diasRestantes > 0)
                        {
                            @($"{diasRestantes} días para la entrega prevista")
                        }
                        else
                        {
                            <text>Fecha de entrega alcanzada</text>
                        }
                    }
                    else
                    {
                        <text>Fecha de entrega aún no definida</text>
                    }
                </span>
                <span>@(obra.FechaFinPrevista.HasValue ? obra.FechaFinPrevista.Value.ToString("MMM yyyy", cultura) : "—")</span>
            </div>
        </div>
    </div>

    <!-- STATS RÁPIDAS -->
    <div class="cli-stats">
        <div class="cli-stat-card">
            <span class="cli-stat-label">Avance</span>
            <span class="cli-stat-val">@obra.PorcentajeAvanceActual%</span>
            <span class="cli-stat-sub">completado</span>
        </div>
        <div class="cli-stat-card">
            <span class="cli-stat-label">Registros</span>
            <span class="cli-stat-val">@seguimientos.Count</span>
            <span class="cli-stat-sub">actualizaciones</span>
        </div>
        <div class="cli-stat-card">
            <span class="cli-stat-label">Entrega</span>
            <span class="cli-stat-val" style="font-size:1.1rem">
                @(obra.FechaFinPrevista.HasValue ? obra.FechaFinPrevista.Value.ToString("MMM yy", cultura) : "A definir")
            </span>
            <span class="cli-stat-sub">prevista</span>
        </div>
    </div>

    <!-- TIMELINE DE SEGUIMIENTO -->
    <h2 class="cli-section-title">Historial de avance</h2>

    @if (seguimientos.Any())
    {
        <div class="cli-timeline">
            @for (int i = 0; i < seguimientos.Count; i++)
            {
                var s = seguimientos[i];
                var esUltimo = i == 0;
                var delta = i < seguimientos.Count - 1 ? s.PorcentajeAvance - seguimientos[i + 1].PorcentajeAvance : s.PorcentajeAvance;
                var diasAtras = (today.Date - s.Fecha.Date).Days;
                var fechaLbl = diasAtras == 0 ? "Hoy"
                              : diasAtras == 1 ? "Ayer"
                              : s.Fecha.ToString("d 'de' MMMM 'de' yyyy", cultura);
                var oculto = i >= 3 ? "cli-tl-oculto" : "";

                <div class="cli-tl-entry @oculto">
                    <div class="cli-tl-left">
                        <div class="cli-tl-dot @(esUltimo ? "cli-tl-dot--latest" : "")"></div>
                        @if (i < seguimientos.Count - 1)
                        {
                            <div class="cli-tl-line"></div>
                        }
                    </div>
                    <div class="cli-tl-content">
                        <div class="cli-tl-top">
                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                <span class="cli-tl-pct @(esUltimo ? "cli-tl-pct--latest" : "")">@s.PorcentajeAvance%</span>
                                @if (delta > 0)
                                {
                                    <span class="cli-tl-delta">+@delta%</span>
                                }
                            </div>
                            <span class="cli-tl-fecha">@fechaLbl</span>
                        </div>
                        <p class="cli-tl-desc">@s.DescripcionAvance</p>
                        @if (!string.IsNullOrEmpty(s.ImgProgreso))
                        {
                            <img src="@s.ImgProgreso" alt="Foto de avance @s.Fecha.ToString("dd/MM/yyyy")" class="cli-tl-img">
                        }
                    </div>
                </div>
            }
        </div>

        @if (seguimientos.Count > 3)
        {
            <button class="cli-ver-mas" id="btnVerMas" onclick="toggleHistorial()">
                <svg viewBox="0 0 24 24"><path d="M6 9l6 6 6-6" /></svg>
                Ver @(seguimientos.Count - 3) actualizaciones anteriores
            </button>
        }
    }
    else
    {
        <p class="text-muted">Todavía no hay registros de avance para esta obra.</p>
    }

    <!-- PRESUPUESTO -->
    @if (presupuestos.Any())
    {
        <h2 class="cli-section-title" style="margin-top:2.5rem">Presupuesto</h2>

        @foreach (var p in presupuestos)
        {
            <div class="cli-pres-card">
                <div class="cli-pres-header">
                    <div class="d-flex align-items-center gap-2">
                        <span class="cli-pres-num">PRES-@p.IdPresupuesto.ToString("D4")</span>
                        <span class="cli-pres-estado cli-pres-estado--@(p.EstadoPresupuesto ?? "").ToLower()">@p.EstadoPresupuesto</span>
                    </div>
                    <span class="cli-pres-fecha">Emitido el @p.FechaEmision.ToString("dd/MM/yyyy")</span>
                </div>
                <div class="cli-pres-items-nota">
                    @p.CantidadItems ítem@(p.CantidadItems != 1 ? "s" : "") en este presupuesto — el detalle línea por línea todavía no está disponible.
                </div>
                <div class="cli-pres-total">
                    <span class="cli-pres-total-label">Total presupuestado</span>
                    <span class="cli-pres-total-val">$@p.MontoTotal.ToString("N0")</span>
                </div>
            </div>
        }
    }

    <!-- CONTACTO -->
    <div class="cli-contacto">
        <div class="cli-contacto-text">
            <strong>¿Tenés alguna consulta sobre tu obra?</strong>
            Comunicáte con nosotros y te respondemos a la brevedad.
        </div>
        <a href="tel:0981234567" class="cli-contacto-btn">📞 Llamar ahora</a>
    </div>

</div>

@section Scripts {
    <script>
        let historialAbierto = false;

        function toggleHistorial() {
            const ocultos = document.querySelectorAll('.cli-tl-oculto');
            const btn     = document.getElementById('btnVerMas');
            const total   = @(seguimientos.Count > 3 ? seguimientos.Count - 3 : 0);

            historialAbierto = !historialAbierto;

            ocultos.forEach(el => {
                el.style.display = historialAbierto ? 'flex' : 'none';
            });

            btn.innerHTML = historialAbierto
                ? `<svg viewBox="0 0 24 24" style="width:14px;height:14px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;transform:rotate(180deg)"><path d="M6 9l6 6 6-6"/></svg> Ocultar anteriores`
                : `<svg viewBox="0 0 24 24" style="width:14px;height:14px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round"><path d="M6 9l6 6 6-6"/></svg> Ver ${total} actualizaciones anteriores`;

            btn.classList.toggle('abierto', historialAbierto);
        }

        document.querySelectorAll('.cli-tl-oculto').forEach(el => el.style.display = 'none');
    </script>
}
