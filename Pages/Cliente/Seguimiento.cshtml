@page
@model PagesObrasApp.Pages.Cliente.SeguimientoModel
@using System.Linq
@using System.Globalization
@{
    Layout = "_Layout";
    ViewData["Title"] = "Seguimiento de obra";

    var cultura = new CultureInfo("es-ES");
    var today = new DateTime(2026, 6, 22);

    // --- Datos de muestra (mock) — reemplazar por Model.* cuando conectemos la API vía DTOs ---
    // En producción: el codigo viene de Request.Query["codigo"] y el PageModel lo valida
    var codigo = "OB-2026-014";

    var obra = new
    {
        Codigo = "OB-2026-014",
        Nombre = "Edificio Las Acacias",
        Cliente = "Inmobiliaria Sur S.A.",
        Direccion = "Av. Italia 1234, Montevideo",
        Estado = "En Progreso",
        Inicio = new DateTime(2026, 2, 10),
        FinPrevisto = new DateTime(2026, 11, 30),
        AvanceActual = 62,
    };

    var seguimientos = new[]
    {
        new { Fecha=new DateTime(2026,2,12),  Pct=5,  Desc="Limpieza de terreno e inicio de excavaciones. Se marcó el perímetro y se instaló el cerco de obra.",          Img=(string)null },
        new { Fecha=new DateTime(2026,2,28),  Pct=12, Desc="Excavaciones completadas. Inicio del encofrado para la losa de fundación.",                                     Img=(string)null },
        new { Fecha=new DateTime(2026,3,20),  Pct=22, Desc="Losa de fundación hormigonada y curada. Comenzó el armado de columnas de planta baja.",                        Img=(string)null },
        new { Fecha=new DateTime(2026,4,15),  Pct=38, Desc="Columnas y vigas planta baja finalizadas. Inicio de mampostería del primer piso.",                             Img=(string)null },
        new { Fecha=new DateTime(2026,5,10),  Pct=50, Desc="Mampostería primer piso al 70%. Se iniciaron las instalaciones eléctricas en cañería embutida.",               Img=(string)null },
        new { Fecha=new DateTime(2026,6,8),   Pct=58, Desc="Instalaciones eléctricas primera etapa aprobadas por inspector. Inicio de revoques exteriores.",              Img=(string)null },
        new { Fecha=new DateTime(2026,6,20),  Pct=62, Desc="Revoques exteriores planta baja terminados. Comenzó encofrado de losa para segundo piso.",                    Img=(string)null },
    }.OrderByDescending(s => s.Fecha).ToList();

    // Presupuestos aprobados (el cliente solo ve los aprobados)
    var presupuestos = new[]
    {
        new
        {
            Numero     = "PRES-0001",
            Fecha      = new DateTime(2026, 2, 5),
            Estado     = "Aprobado",
            MontoTotal = 485000m,
            Items      = new[]
            {
                new { Desc="Estructura de hormigón armado",  Cant=1m,   PU=180000m, Sub=180000m },
                new { Desc="Mampostería y revoques",         Cant=1m,   PU=95000m,  Sub=95000m  },
                new { Desc="Instalación eléctrica completa", Cant=1m,   PU=75000m,  Sub=75000m  },
                new { Desc="Instalación sanitaria",          Cant=1m,   PU=55000m,  Sub=55000m  },
                new { Desc="Carpintería y aberturas",        Cant=1m,   PU=48000m,  Sub=48000m  },
                new { Desc="Pintura general",                Cant=850m, PU=38m,     Sub=32300m  },
            }
        },
    };

    // Calcular días restantes
    var diasRestantes = (obra.FinPrevisto - today).Days;
    var diasTranscurridos = (today - obra.Inicio).Days;
    var duracionTotal = (obra.FinPrevisto - obra.Inicio).Days;
    var pctTiempo = Math.Min(100, (int)Math.Round((double)diasTranscurridos / duracionTotal * 100));

    var estadoCls = obra.Estado.Replace(" ", "").ToLower();
}

@section Styles {
    <style>
        .cli-page {
            --bp-blueprint: #1B3A5C;
            --bp-blueprint-light: #2D5C8C;
            --bp-concrete: #F1EFEA;
            --bp-steel: #5B6670;
            --bp-safety: #F2A900;
            --bp-ink: #181B1F;
            --bp-line: #D8D3C8;
            --bp-ok: #2E7D52;
            font-family: 'Inter', sans-serif;
            color: var(--bp-ink);
            max-width: 860px;
            margin: 0 auto;
            padding: 2rem 1.25rem 3rem;
        }

        /* ── HEADER DE OBRA ── */
        .cli-obra-header {
            background: var(--bp-blueprint);
            border-radius: 12px;
            overflow: hidden;
            margin-bottom: 1.5rem;
            position: relative;
        }

        .cli-obra-grid {
            position: absolute;
            inset: 0;
            background-image: repeating-linear-gradient(0deg,rgba(255,255,255,.04) 0 1px,transparent 1px 28px), repeating-linear-gradient(90deg,rgba(255,255,255,.04) 0 1px,transparent 1px 28px);
            pointer-events: none;
        }

        .cli-obra-header-body {
            position: relative;
            padding: 1.5rem 1.5rem 1.25rem;
        }

        .cli-obra-codigo {
            font-family: 'JetBrains Mono', monospace;
            font-size: .72rem;
            letter-spacing: .12em;
            text-transform: uppercase;
            color: rgba(255,255,255,.5);
            display: block;
            margin-bottom: .4rem;
        }

        .cli-obra-nombre {
            font-family: 'Barlow Condensed', sans-serif;
            font-weight: 700;
            font-size: 2rem;
            color: #fff;
            line-height: 1.1;
            margin-bottom: .5rem;
        }

        .cli-obra-meta {
            display: flex;
            flex-wrap: wrap;
            gap: .5rem .85rem;
            font-size: .82rem;
            color: rgba(255,255,255,.65);
            margin-bottom: 1.25rem;
        }

        .cli-obra-meta-item {
            display: flex;
            align-items: center;
            gap: .3rem;
        }

            .cli-obra-meta-item svg {
                width: 13px;
                height: 13px;
                fill: none;
                stroke: currentColor;
                stroke-width: 1.8;
                stroke-linecap: round;
                opacity: .7;
            }

        /* Badge de estado */
        .cli-badge {
            display: inline-block;
            font-size: .68rem;
            font-weight: 600;
            padding: .2rem .6rem;
            border-radius: 100px;
            white-space: nowrap;
        }

        .cli-badge--enprogreso {
            background: rgba(45,108,223,.3);
            color: #8cb8f8;
            border: 1px solid rgba(45,108,223,.4);
        }

        .cli-badge--planificada {
            background: rgba(91,102,112,.3);
            color: #c0c5ca;
            border: 1px solid rgba(91,102,112,.4);
        }

        .cli-badge--pausada {
            background: rgba(242,169,0,.25);
            color: var(--bp-safety);
            border: 1px solid rgba(242,169,0,.4);
        }

        .cli-badge--finalizada {
            background: rgba(46,125,82,.3);
            color: #6fcf97;
            border: 1px solid rgba(46,125,82,.4);
        }

        /* Barra de progreso principal */
        .cli-progress-section {
            border-top: 1px solid rgba(255,255,255,.1);
            padding: 1rem 1.5rem 1.25rem;
            background: rgba(0,0,0,.12);
        }

        .cli-progress-header {
            display: flex;
            justify-content: space-between;
            align-items: baseline;
            margin-bottom: .65rem;
        }

        .cli-progress-label {
            font-family: 'JetBrains Mono', monospace;
            font-size: .68rem;
            letter-spacing: .1em;
            text-transform: uppercase;
            color: rgba(255,255,255,.5);
        }

        .cli-progress-pct {
            font-family: 'Barlow Condensed', sans-serif;
            font-weight: 700;
            font-size: 2rem;
            color: #fff;
            line-height: 1;
        }

            .cli-progress-pct small {
                font-size: 1rem;
                font-weight: 500;
                color: rgba(255,255,255,.5);
            }

        .cli-progress-bar {
            height: 10px;
            background: rgba(255,255,255,.15);
            border-radius: 5px;
            overflow: hidden;
            margin-bottom: .65rem;
        }

        .cli-progress-fill {
            height: 100%;
            background: var(--bp-safety);
            border-radius: 5px;
            transition: width .5s ease;
        }

        .cli-progress-dates {
            display: flex;
            justify-content: space-between;
            font-family: 'JetBrains Mono', monospace;
            font-size: .65rem;
            color: rgba(255,255,255,.4);
        }

        .cli-dias-restantes {
            font-family: 'JetBrains Mono', monospace;
            font-size: .72rem;
            color: var(--bp-safety);
            font-weight: 500;
        }

        /* ── STATS RÁPIDAS ── */
        .cli-stats {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 1rem;
            margin-bottom: 2rem;
        }

        .cli-stat-card {
            background: #fff;
            border: 1px solid var(--bp-line);
            border-radius: 8px;
            padding: .9rem 1rem;
            text-align: center;
        }

        .cli-stat-label {
            font-family: 'JetBrains Mono', monospace;
            font-size: .62rem;
            letter-spacing: .1em;
            text-transform: uppercase;
            color: var(--bp-steel);
            display: block;
            margin-bottom: .25rem;
        }

        .cli-stat-val {
            font-family: 'Barlow Condensed', sans-serif;
            font-weight: 700;
            font-size: 1.5rem;
            color: var(--bp-blueprint);
            line-height: 1;
        }

        .cli-stat-sub {
            font-size: .72rem;
            color: var(--bp-steel);
            margin-top: .1rem;
        }

        /* ── TIMELINE ── */
        .cli-section-title {
            font-family: 'Barlow Condensed', sans-serif;
            font-weight: 600;
            font-size: 1.4rem;
            color: var(--bp-blueprint);
            margin-bottom: 1rem;
            display: flex;
            align-items: center;
            gap: .6rem;
        }

            .cli-section-title::after {
                content: '';
                flex: 1;
                height: 1px;
                background: var(--bp-line);
            }

        .cli-timeline {
            display: flex;
            flex-direction: column;
        }

        .cli-tl-entry {
            display: flex;
            gap: .85rem;
        }

        .cli-tl-left {
            display: flex;
            flex-direction: column;
            align-items: center;
            flex-shrink: 0;
            width: 14px;
        }

        .cli-tl-dot {
            width: 12px;
            height: 12px;
            border-radius: 50%;
            flex-shrink: 0;
            background: var(--bp-concrete);
            border: 2px solid var(--bp-line);
            z-index: 1;
        }

        .cli-tl-dot--latest {
            background: var(--bp-safety);
            border-color: var(--bp-safety);
        }

        .cli-tl-line {
            width: 2px;
            flex: 1;
            background: var(--bp-line);
            margin-top: 2px;
        }

        .cli-tl-content {
            flex: 1;
            min-width: 0;
            padding-bottom: 1.5rem;
        }

        .cli-tl-top {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: .5rem;
            margin-bottom: .4rem;
        }

        .cli-tl-pct {
            font-family: 'Barlow Condensed', sans-serif;
            font-weight: 700;
            font-size: 1.15rem;
            color: var(--bp-steel);
        }

        .cli-tl-pct--latest {
            color: var(--bp-blueprint);
        }

        .cli-tl-delta {
            font-family: 'JetBrains Mono', monospace;
            font-size: .7rem;
            font-weight: 600;
            background: #EAF4EE;
            color: var(--bp-ok);
            padding: .1rem .4rem;
            border-radius: 100px;
        }

        .cli-tl-fecha {
            font-family: 'JetBrains Mono', monospace;
            font-size: .72rem;
            color: var(--bp-steel);
        }

        .cli-tl-desc {
            font-size: .88rem;
            line-height: 1.6;
            color: var(--bp-ink);
            margin: 0;
        }

        .cli-tl-img {
            margin-top: .75rem;
            width: 100%;
            max-height: 220px;
            object-fit: cover;
            border-radius: 8px;
            border: 1px solid var(--bp-line);
        }

        /* Botón ver más */
        .cli-ver-mas {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: .4rem;
            margin-top: .5rem;
            background: none;
            border: 1px solid var(--bp-line);
            border-radius: 7px;
            padding: .6rem 1rem;
            font-family: 'Inter', sans-serif;
            font-size: .83rem;
            font-weight: 600;
            color: var(--bp-steel);
            cursor: pointer;
            width: 100%;
            transition: all .15s;
        }

            .cli-ver-mas:hover {
                border-color: var(--bp-blueprint);
                color: var(--bp-blueprint);
            }

            .cli-ver-mas svg {
                width: 14px;
                height: 14px;
                fill: none;
                stroke: currentColor;
                stroke-width: 2;
                stroke-linecap: round;
                transition: transform .2s;
            }

            .cli-ver-mas.abierto svg {
                transform: rotate(180deg);
            }

        /* ── PRESUPUESTO ── */
        .cli-pres-card {
            background: #fff;
            border: 1px solid var(--bp-line);
            border-radius: 10px;
            overflow: hidden;
            margin-bottom: 1rem;
        }

        .cli-pres-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 1rem 1.25rem;
            background: var(--bp-concrete);
            border-bottom: 1px solid var(--bp-line);
            flex-wrap: wrap;
            gap: .5rem;
        }

        .cli-pres-num {
            font-family: 'JetBrains Mono', monospace;
            font-size: .78rem;
            color: var(--bp-steel);
        }

        .cli-pres-fecha {
            font-family: 'JetBrains Mono', monospace;
            font-size: .78rem;
            color: var(--bp-steel);
        }

        .cli-pres-estado {
            font-size: .72rem;
            font-weight: 600;
            padding: .2rem .6rem;
            border-radius: 100px;
        }

        .cli-pres-estado--aprobado {
            background: #EAF4EE;
            color: var(--bp-ok);
        }

        .cli-pres-estado--pendiente {
            background: #FFF8E8;
            color: #92670a;
        }

        .cli-pres-table {
            width: 100%;
            border-collapse: collapse;
            font-size: .85rem;
        }

            .cli-pres-table thead th {
                font-family: 'JetBrains Mono', monospace;
                font-size: .65rem;
                letter-spacing: .08em;
                text-transform: uppercase;
                color: var(--bp-steel);
                text-align: left;
                padding: .65rem 1.25rem;
                background: var(--bp-concrete);
                border-bottom: 1px solid var(--bp-line);
            }

            .cli-pres-table tbody td {
                padding: .65rem 1.25rem;
                border-bottom: 1px solid var(--bp-line);
                vertical-align: middle;
            }

            .cli-pres-table tbody tr:last-child td {
                border-bottom: none;
            }

        .cli-pres-total {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: .85rem 1.25rem;
            border-top: 2px solid var(--bp-line);
            background: var(--bp-concrete);
        }

        .cli-pres-total-label {
            font-family: 'JetBrains Mono', monospace;
            font-size: .68rem;
            letter-spacing: .08em;
            text-transform: uppercase;
            color: var(--bp-steel);
        }

        .cli-pres-total-val {
            font-family: 'Barlow Condensed', sans-serif;
            font-weight: 700;
            font-size: 1.4rem;
            color: var(--bp-blueprint);
        }

        /* ── CONTACTO ── */
        .cli-contacto {
            background: var(--bp-blueprint);
            border-radius: 10px;
            padding: 1.25rem 1.5rem;
            margin-top: 2rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 1rem;
        }

        .cli-contacto-text {
            color: rgba(255,255,255,.85);
            font-size: .88rem;
        }

            .cli-contacto-text strong {
                color: #fff;
                display: block;
                font-size: 1rem;
                margin-bottom: .2rem;
            }

        .cli-contacto-btn {
            font-family: 'Inter', sans-serif;
            font-weight: 600;
            font-size: .85rem;
            background: var(--bp-safety);
            color: var(--bp-ink);
            border: none;
            border-radius: 7px;
            padding: .55rem 1.1rem;
            text-decoration: none;
            white-space: nowrap;
            transition: background .15s;
        }

            .cli-contacto-btn:hover {
                background: #d99500;
                color: var(--bp-ink);
            }

        @@media (max-width: 576px) {
            .cli-page {
                padding: 1.25rem .85rem 2rem;
            }

            .cli-stats {
                grid-template-columns: repeat(3,1fr);
                gap: .5rem;
            }

            .cli-stat-card {
                padding: .65rem .5rem;
            }

            .cli-stat-val {
                font-size: 1.25rem;
            }

            .cli-obra-header-body, .cli-progress-section {
                padding-left: 1rem;
                padding-right: 1rem;
            }

            .cli-pres-table thead th:nth-child(2),
            .cli-pres-table tbody td:nth-child(2),
            .cli-pres-table thead th:nth-child(3),
            .cli-pres-table tbody td:nth-child(3) {
                display: none;
            }
        }
    </style>
}

<div class="cli-page">

    <!-- HEADER DE OBRA -->
    <div class="cli-obra-header">
        <div class="cli-obra-grid"></div>
        <div class="cli-obra-header-body">
            <span class="cli-obra-codigo">@obra.Codigo</span>
            <div class="d-flex align-items-start justify-content-between gap-2 flex-wrap mb-2">
                <h1 class="cli-obra-nombre">@obra.Nombre</h1>
                <span class="cli-badge cli-badge--@estadoCls">@obra.Estado</span>
            </div>
            <div class="cli-obra-meta">
                <div class="cli-obra-meta-item">
                    <svg viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2" /><circle cx="12" cy="7" r="4" /></svg>
                    @obra.Cliente
                </div>
                <div class="cli-obra-meta-item">
                    <svg viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13S3 17 3 10a9 9 0 0118 0z" /><circle cx="12" cy="10" r="3" /></svg>
                    @obra.Direccion
                </div>
                <div class="cli-obra-meta-item">
                    <svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" /><path d="M16 2v4M8 2v4M3 10h18" /></svg>
                    Inicio @obra.Inicio.ToString("dd/MM/yyyy")
                </div>
            </div>
        </div>

        <!-- Barra de progreso -->
        <div class="cli-progress-section">
            <div class="cli-progress-header">
                <span class="cli-progress-label">Avance de obra</span>
                <span class="cli-progress-pct">@obra.AvanceActual<small>%</small></span>
            </div>
            <div class="cli-progress-bar">
                <div class="cli-progress-fill" style="width:@obra.AvanceActual%"></div>
            </div>
            <div class="cli-progress-dates">
                <span>@obra.Inicio.ToString("MMM yyyy", cultura)</span>
                <span class="cli-dias-restantes">
                    @if (diasRestantes > 0)
                    {
                        @($"{diasRestantes} días para la entrega prevista")
                    }
                    else
                    {
                        <text>Fecha de entrega alcanzada</text>
                    }
                </span>
                <span>@obra.FinPrevisto.ToString("MMM yyyy", cultura)</span>
            </div>
        </div>
    </div>

    <!-- STATS RÁPIDAS -->
    <div class="cli-stats">
        <div class="cli-stat-card">
            <span class="cli-stat-label">Avance</span>
            <span class="cli-stat-val">@obra.AvanceActual%</span>
            <span class="cli-stat-sub">completado</span>
        </div>
        <div class="cli-stat-card">
            <span class="cli-stat-label">Registros</span>
            <span class="cli-stat-val">@seguimientos.Count</span>
            <span class="cli-stat-sub">actualizaciones</span>
        </div>
        <div class="cli-stat-card">
            <span class="cli-stat-label">Entrega</span>
            <span class="cli-stat-val" style="font-size:1.1rem">
                @obra.FinPrevisto.ToString("MMM yy", cultura)
            </span>
            <span class="cli-stat-sub">prevista</span>
        </div>
    </div>

    <!-- TIMELINE DE SEGUIMIENTO -->
    <h2 class="cli-section-title">Historial de avance</h2>

    <div class="cli-timeline">
        @for (int i = 0; i < seguimientos.Count; i++)
        {
            var s = seguimientos[i];
            var esUltimo = i == 0;
            var delta = i < seguimientos.Count - 1 ? s.Pct - seguimientos[i + 1].Pct : s.Pct;
            var diasAtras = (today - s.Fecha).Days;
            var fechaLbl = diasAtras == 0 ? "Hoy"
                          : diasAtras == 1 ? "Ayer"
                          : s.Fecha.ToString("d 'de' MMMM 'de' yyyy", cultura);
            var oculto = i >= 3 ? "cli-tl-oculto" : "";

            <div class="cli-tl-entry @oculto">
                <div class="cli-tl-left">
                    <div class="cli-tl-dot @(esUltimo ? "cli-tl-dot--latest" : "")"></div>
                    @if (i < seguimientos.Count - 1)
                    {
                        <div class="cli-tl-line"></div>
                    }
                </div>
                <div class="cli-tl-content">
                    <div class="cli-tl-top">
                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            <span class="cli-tl-pct @(esUltimo ? "cli-tl-pct--latest" : "")">@s.Pct%</span>
                            @if (delta > 0)
                            {
                                <span class="cli-tl-delta">+@delta%</span>
                            }
                        </div>
                        <span class="cli-tl-fecha">@fechaLbl</span>
                    </div>
                    <p class="cli-tl-desc">@s.Desc</p>
                    @if (!string.IsNullOrEmpty(s.Img))
                    {
                        <img src="@s.Img" alt="Foto de avance @s.Fecha.ToString("dd/MM/yyyy")" class="cli-tl-img">
                    }
                </div>
            </div>
        }
    </div>

    @if (seguimientos.Count > 3)
    {
        <button class="cli-ver-mas" id="btnVerMas" onclick="toggleHistorial()">
            <svg viewBox="0 0 24 24"><path d="M6 9l6 6 6-6" /></svg>
            Ver @(seguimientos.Count - 3) actualizaciones anteriores
        </button>
    }

    <!-- PRESUPUESTO -->
    @if (presupuestos.Any())
    {
        <h2 class="cli-section-title" style="margin-top:2.5rem">Presupuesto</h2>

        @foreach (var p in presupuestos)
        {
            <div class="cli-pres-card">
                <div class="cli-pres-header">
                    <div class="d-flex align-items-center gap-2">
                        <span class="cli-pres-num">@p.Numero</span>
                        <span class="cli-pres-estado cli-pres-estado--@p.Estado.ToLower()">@p.Estado</span>
                    </div>
                    <span class="cli-pres-fecha">Emitido el @p.Fecha.ToString("dd/MM/yyyy")</span>
                </div>
                <table class="cli-pres-table">
                    <thead>
                        <tr>
                            <th>Descripción</th>
                            <th>Cantidad</th>
                            <th class="text-end">Precio unit.</th>
                            <th class="text-end">Subtotal</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in p.Items)
                        {
                            <tr>
                                <td>@item.Desc</td>
                                <td style="font-family:'JetBrains Mono',monospace;font-size:.8rem;color:var(--bp-steel)">
                                    @item.Cant.ToString("0.#")
                                </td>
                                <td class="text-end" style="font-family:'JetBrains Mono',monospace;font-size:.8rem;color:var(--bp-steel)">
                                    $@item.PU.ToString("N0")
                                </td>
                                <td class="text-end" style="font-weight:600;font-family:'JetBrains Mono',monospace;font-size:.82rem">
                                    $@item.Sub.ToString("N0")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <div class="cli-pres-total">
                    <span class="cli-pres-total-label">Total presupuestado</span>
                    <span class="cli-pres-total-val">$@p.MontoTotal.ToString("N0")</span>
                </div>
            </div>
        }
    }

    <!-- CONTACTO -->
    <div class="cli-contacto">
        <div class="cli-contacto-text">
            <strong>¿Tenés alguna consulta sobre tu obra?</strong>
            Comunicáte con nosotros y te respondemos a la brevedad.
        </div>
        <a href="tel:0981234567" class="cli-contacto-btn">📞 Llamar ahora</a>
    </div>

</div>

@section Scripts {
    <script>
        let historialAbierto = false;

        function toggleHistorial() {
            const ocultos = document.querySelectorAll('.cli-tl-oculto');
            const btn     = document.getElementById('btnVerMas');
            const total   = @(seguimientos.Count - 3);

            historialAbierto = !historialAbierto;

            ocultos.forEach(el => {
                el.style.display = historialAbierto ? 'flex' : 'none';
            });

            btn.innerHTML = historialAbierto
                ? `<svg viewBox="0 0 24 24" style="width:14px;height:14px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;transform:rotate(180deg)"><path d="M6 9l6 6 6-6"/></svg> Ocultar anteriores`
                : `<svg viewBox="0 0 24 24" style="width:14px;height:14px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round"><path d="M6 9l6 6 6-6"/></svg> Ver ${total} actualizaciones anteriores`;

            btn.classList.toggle('abierto', historialAbierto);
        }

        // Ocultar entradas antiguas al inicio
        document.querySelectorAll('.cli-tl-oculto').forEach(el => el.style.display = 'none');
    </script>
}